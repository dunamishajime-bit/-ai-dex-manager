n":446,"actual_mean_pct":0.24184470527551663,"control_mean_pct":0.5609591646644225,"delta_pp":-0.3191144593889058}}}},"FORWARD_INSPECTED":{"candidates":110,"valid_trades":110,"wallet":{"10":{"n":56,"wins":29,"win_pct":51.785714285714285,"terminal_jpy":11591.8700596447,"max_dd_pct":5.299905876666877,"profit_factor":1.9805087166882047,"stop_count":0,"target_count":0,"blocked":{"SLOTS_TWO":48,"COOLDOWN":5,"SAME_SYMBOL":1},"by_direction":{"SHORT":56}},"30":{"n":56,"wins":28,"win_pct":50,"terminal_jpy":11210.034797460272,"max_dd_pct":5.614834300685557,"profit_factor":1.6837268080687569,"stop_count":0,"target_count":0,"blocked":{"SLOTS_TWO":48,"COOLDOWN":5,"SAME_SYMBOL":1},"by_direction":{"SHORT":56}}},"horizons":{"1":{"n":110,"mean_pct":-0.1326664342941801,"win_pct":33.63636363636363},"3":{"n":110,"mean_pct":0.03209662397177078,"win_pct":43.63636363636363},"6":{"n":110,"mean_pct":0.12001224449360424,"win_pct":48.18181818181818},"12":{"n":110,"mean_pct":-0.035248766994681734,"win_pct":49.09090909090909},"24":{"n":110,"mean_pct":0.16724036222806782,"win_pct":47.27272727272727},"48":{"n":110,"mean_pct":1.1117171311315877,"win_pct":56.36363636363636}},"matched":{"matched_candidates":103,"actual_wallet":{"n":54,"wins":27,"win_pct":50,"terminal_jpy":11035.293865969143,"max_dd_pct":5.6148343006855335,"profit_factor":1.5949595885518613,"stop_count":0,"target_count":0,"blocked":{"SLOTS_TWO":42,"COOLDOWN":6,"SAME_SYMBOL":1},"by_direction":{"SHORT":54}},"control_mean_terminal":11518.598865526274,"control_mean_dd":5.762609965449725,"control_mean_n":58.4375,"actual_beats":5,"matched_horizons":{"1":{"n":103,"actual_mean_pct":-0.12691016176161032,"control_mean_pct":-0.25463741990634686,"delta_pp":0.12772725814473654},"3":{"n":103,"actual_mean_pct":0.05937653775558775,"control_mean_pct":-0.06014811830825106,"delta_pp":0.11952465606383873},"6":{"n":103,"actual_mean_pct":0.13480676257846386,"control_mean_pct":0.08165206702348621,"delta_pp":0.053154695554977635},"12":{"n":103,"actual_mean_pct":-0.05923730541057939,"control_mean_pct":0.287111422814033,"delta_pp":-0.3463487282246126},"24":{"n":103,"actual_mean_pct":0.1320569360263437,"control_mean_pct":0.5546475543311772,"delta_pp":-0.4225906183048335},"48":{"n":103,"actual_mean_pct":1.0058458955643281,"control_mean_pct":1.4273906800794143,"delta_pp":-0.4215447845150859}}}}}}},"source":"import pathlib,json,hashlib,importlib.util,collections,numpy as np,math,time\nR=pathlib.Path(r'C:\\tmp\\disdex-d126-crossrunner-research-20261126')\nSRC=R/'y06_r3_bear_retest_research_v2.py'\nsp=importlib.util.spec_from_file_location('r3',SRC);r3=importlib.util.module_from_spec(sp);sp.loader.exec_module(r3)\nbt=r3.bt;H=bt.H;M=bt.M\nP=R/'Y06_R5_ENTRY_FROZEN_PROTOCOL_20261127.json';O=R/'Y06_R5_ENTRY_RESULTS_20261127.json';I=R/'Y06_R5_ENTRY_STAGE1_20261127.json'\nassert not P.exists() and not O.exists() and not I.exists()\np={'status':'EXPLORATORY_RESEARCH_ONLY_NO_LIVE','source_sha256':hashlib.sha256(SRC.read_bytes()).hexdigest(),'entries':{'TURN_EARLY':'previous 12h return positive; newest confirmed H1 close crosses below EMA12, EMA12 decreasing, close below prior 3h lows','LOWER_HIGH':'two sequential disjoint 6h high windows; recent high lower by >=0.25ATR; recent rebound >=0.5ATR above its local low before peak; newest bearish close below prior 2h lows','BUY_PRESSURE_FADE':'prior 12h positive return; later 6h positive-close candle volume / all volume below prior 6h ratio by >=0.20; newest bearish close below prior 3h lows; positive-close volume is proxy, not taker buy volume','RELATIVE_WEAK_LEAD':'BTC trailing 12h nonnegative; asset BTC-relative 6h return crosses below -1ATR/close while preceding 6h relative >=0; newest bearish candle','RANGE_PREBREAK':'prior 12h high-low <=3ATR, latest close in bottom quartile of prior range but above prior low; two consecutive falling closes and last candle volume >=1.25x median previous12h'},'entry_common':'confirmed H1 only, prior 48h QA and H1-M5 agreement original R3; 12h per-symbol per-arm signal cooldown; no R3 trend gate, no R3 retest dependency; all entries inside previous periods; each diagnostic horizon requires full observed M5 path within fixed data/period boundary','wallet':'original R3 STOP8/24H, 0.30 gross per trade, 2 slots, 12h after exit cooldown, 10/30bps. 24h full data before period boundary except inspected forward original exit extension.','horizons':[1,3,6,12,24,48],'matching':'same symbol, same BTC trailing24h sign and asset trailing24h sign at entry, prior QA, offsets +/-1,3,6,9,12,18,24h, >=2 alternatives, full 24h period availability. 32 account placebo draws seed 2026112706, and candidate-level mean matched returns by horizon. Not independent trials; prior periods inspected.','no_funding':True}\nP.write_text(json.dumps(p,indent=2),encoding='utf8')\nbtc,_=bt.data('BTC','1h');hs={};ms={};qa={};candidates=collections.defaultdict(list)\narms=list(p['entries'])\ndef period_of(t):\n return next((k for k,(a,b) in bt.PERIODS.items() if a<=t<b),None)\ndef boundary(period):\n return bt.PERIODS[period][1] if period!='FORWARD_INSPECTED' else bt.T('2026-11-26T00:00:00Z')\ndef signs(h,i):\n if i<25 or not np.isfinite(h[i-25:i,3]).all() or not np.isfinite(btc[i-25:i,3]).all():return None\n return (bool(btc[i-1,3]>=btc[i-25,3]),bool(h[i-1,3]>=h[i-25,3]))\ndef gen(sym,h,m,good):\n ema=np.full(len(h),np.nan);e=None\n for i,v in enumerate(h[:,3]):\n  e=None if not np.isfinite(v) else float(v) if e is None else e+2/13*(v-e)\n  if e is not None:ema[i]=e\n last={k:-10**20 for k in arms};out=[]\n for i in range(220,len(h)):\n  t=bt.HS+i*H;per=period_of(t)\n  if not per or not good[i] or signs(h,i) is None:continue\n  if not np.isfinite(h[i-25:i,:5]).all() or not np.isfinite(btc[i-25:i,3]).all():continue\n  c=h[i-1];v=h[i-13:i-1];a=r3.calc_atr(h,i)\n  if a is None or a<=0 or c[3]>=c[0]:continue\n  prev=h[i-13:i-7];recent=h[i-7:i-1];j=int(np.argmax(recent[:,1]));rebound=recent[j,1]-np.min(recent[:j+1,2])\n  older_vol=prev[:,4].sum();new_vol=recent[:,4].sum()\n  old_ratio=float(prev[prev[:,3]>prev[:,0],4].sum()/older_vol) if older_vol>0 else np.nan\n  new_ratio=float(recent[recent[:,3]>recent[:,0],4].sum()/new_vol) if new_vol>0 else np.nan\n  rel1=c[3]/h[i-7,3]-btc[i-1,3]/btc[i-7,3];rel0=h[i-7,3]/h[i-13,3]-btc[i-7,3]/btc[i-13,3]\n  floor=float(v[:,2].min());ceil=float(v[:,1].max());vr=float(np.median(v[:,4]))\n  checks={\n   'TURN_EARLY':h[i-2,3]>h[i-14,3] and h[i-2,3]>=ema[i-2] and c[3]<ema[i-1]<ema[i-2] and c[3]<np.min(h[i-4:i-1,2]),\n   'LOWER_HIGH':recent[:,1].max()<=prev[:,1].max()-.25*a and rebound>=.5*a and j>0 and c[3]<np.min(h[i-3:i-1,2]),\n   'BUY_PRESSURE_FADE':h[i-2,3]>h[i-14,3] and old_ratio-new_ratio>=.2 and c[3]<np.min(h[i-4:i-1,2]),\n   'RELATIVE_WEAK_LEAD':btc[i-1,3]>=btc[i-13,3] and rel0>=0 and rel1<-a/c[3],\n   'RANGE_PREBREAK':0<ceil-floor<=3*a and floor<c[3]<=floor+.25*(ceil-floor) and c[3]<h[i-2,3]<h[i-3,3] and vr>0 and c[4]>=1.25*vr}\n  for k,yes in checks.items():\n   if yes and t-last[k]>=12*H:\n    out.append(dict(symbol=sym,period=per,policy=k,entryTs=t,setupTs=t,breakAtr=a,breakFloor=floor,swingHigh=ceil));last[k]=t\n return out\nfor sym in bt.SYMS[1:]:\n h,_=bt.data(sym,'1h');m,_=bt.data(sym,'5m');hs[sym]=h;ms[sym]=m;qa[sym]=r3.prepare_qa(h,m)[0]\n for x in gen(sym,h,m,qa[sym]):candidates[x['policy']].append(x)\n print('LOADED',sym,flush=True)\ndef horiz(x,hr):\n m=ms[x['symbol']];t=x['entryTs'];k=(t-bt.MS)//M;z=k+hr*12\n if k<0 or z>=len(m) or t+hr*H>=boundary(x['period']) or not np.isfinite(m[k:z+1,:4]).all():return None\n return float(100*(1-m[z,0]/m[k,0]-.003))\ndef trade(x):\n z=r3.calc_trade(x,ms[x['symbol']],'STOP8_TIME24')\n return z if z is not None and z['exitTs']<boundary(x['period']) else None\ndef compact(w):return {k:v for k,v in w.items() if k!='accepted'}\ndef hor_summary(xs):\n d={}\n for hr in p['horizons']:\n  a=[z for x in xs if (z:=horiz(x,hr)) is not None]\n  d[str(hr)]={'n':len(a),'mean_pct':float(np.mean(a)) if a else None,'win_pct':float(100*np.mean(np.array(a)>0)) if a else None}\n return d\nres={}\nfor k in arms:\n cs=candidates[k];res[k]={}\n for per in bt.PERIODS:\n  xx=[x for x in cs if x['period']==per];tt=[z for x in xx if (z:=trade(x)) is not None]\n  w={str(f):compact(bt.wallet(tt,per,f,ms)) for f in (10,30)}\n  res[k][per]={'candidates':len(xx),'valid_trades':len(tt),'wallet':w,'horizons':hor_summary(xx)}\n  q=w['30'];print('BT',k,per,len(xx),q['n'],q['wins'],round(q['terminal_jpy'],2),round(q['max_dd_pct'],2),q['profit_factor'],flush=True)\nI.write_text(json.dumps({'protocol':p,'results':res,'candidate_intentions':dict(candidates)},indent=2,allow_nan=False),encoding='utf8')\nprint('STAGE1_SAVED',hashlib.sha256(I.read_bytes()).hexdigest(),flush=True)\nrng=np.random.default_rng(2026112706)\nfor k in arms:\n for per,(beg,end) in bt.PERIODS.items():\n  pairs=[]\n  for x in candidates[k]:\n   if x['period']!=per:continue\n   z=trade(x)\n   if z is None:continue\n   sym=x['symbol'];h=hs[sym];i=(x['entryTs']-bt.HS)//H;state=signs(h,i);alts=[]\n   for off in (-24,-18,-12,-9,-6,-3,-1,1,3,6,9,12,18,24):\n    t=x['entryTs']+off*H;j=(t-bt.HS)//H\n    if not(beg<=t<end and 220<=j<len(h) and qa[sym][j] and signs(h,j)==state):continue\n    a={**x,'entryTs':t};az=trade(a)\n    if az is not None:alts.append((a,az))\n   if len(alts)>=2:pairs.append((x,z,alts))\n  actual=compact(bt.wallet([z for x,z,a in pairs],per,30,ms))\n  ds=[compact(bt.wallet([a[rng.integers(len(a))][1] for x,z,a in pairs],per,30,ms)) for _ in range(32)]\n  vals=[d['terminal_jpy'] for d in ds]\n  hd={}\n  for hr in p['horizons']:\n   aa=[];bb=[]\n   for x,z,a in pairs:\n    v=horiz(x,hr);vs=[r for xx,zz in a if (r:=horiz(xx,hr)) is not None]\n    if v is not None and len(vs)>=2:aa.append(v);bb.append(float(np.mean(vs)))\n   hd[str(hr)]={'n':len(aa),'actual_mean_pct':float(np.mean(aa)) if aa else None,'control_mean_pct':float(np.mean(bb)) if bb else None,'delta_pp':float(np.mean(np.array(aa)-np.array(bb))) if aa else None}\n  info={'matched_candidates':len(pairs),'actual_wallet':actual,'control_mean_terminal':float(np.mean(vals)),'control_mean_dd':float(np.mean([d['max_dd_pct'] for d in ds])),'control_mean_n':float(np.mean([d['n'] for d in ds])),'actual_beats':sum(actual['terminal_jpy']>v for v in vals),'matched_horizons':hd,'draws':ds}\n  res[k][per]['matched']=info\n  print('MATCH',k,per,'pairs',len(pairs),'actual',round(actual['terminal_jpy'],2),'control',round(info['control_mean_terminal'],2),'beats',info['actual_beats'],'delta24',hd['24']['delta_pp'],flush=True)\nO.write_text(json.dumps({'protocol':p,'protocol_sha256':hashlib.sha256(P.read_bytes()).hexdigest(),'stage1_sha256':hashlib.sha256(I.read_bytes()).hexdigest(),'results':res},indent=2,allow_nan=False),encoding='utf8')\nprint('SAVED',hashlib.sha256(O.read_bytes()).hexdigest(),flush=True)\n","sha256":{"Y06_R5_ENTRY_RESULTS_20261127.json":"f1b3fbf9b00eae1f8e75c93b36887e8ae3b13b2c94aabb8dc460bc217838c291","Y06_R5_ENTRY_STAGE1_20261127.json":"02a27a195ca9fd66f97aee798c69408ba5edc23960b1545940c9910bbb25670a","y06_r5_entry_20261127.py":"5060cee29865e6139514742466e0e4236998b9f9df9877a1f1ccc39f4a918bf9"}}
