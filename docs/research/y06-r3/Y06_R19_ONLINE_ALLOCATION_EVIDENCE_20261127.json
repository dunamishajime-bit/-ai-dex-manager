ns,numpy as np,ast,math\nR=pathlib.Path(r'C:\\tmp\\disdex-d126-crossrunner-research-20261126')\nparent=R/'y06_r18_portfolio_repair_20261127.py'\nP19=R/'Y06_R19_ONLINE_ALLOCATION_PROTOCOL_20261127.json';O19=R/'Y06_R19_ONLINE_ALLOCATION_RESULTS_20261127.json';assert not P19.exists() and not O19.exists()\np19={'status':'EXPLORATORY_RESEARCH_ONLY_NO_LIVE','parent_sha256':hashlib.sha256(parent.read_bytes()).hexdigest(),'base':'R18 NO_BULL_STRETCH/FIFO/BASE unchanged candidate tapes and exit. 10/30bps, .30x, 2 slots, 12h same-symbol cooldown. Common R17 periods.','arms':['BASE','MIXED_ONLY','BEAR_ONLY','BEAR_ONE_SLOT','BEAR_ONE_SLOT_BTC3UP_VETO','ONLINE30_VETO','ONLINE60_VETO','ONLINE30_CAP','ONLINE60_CAP','REGIME60_VETO','REGIME60_CAP','ONLINE60_CAP_BEAR_ONE','ONLINE60_CAP_NEW_PRIORITY'],'definition':'Old H24 candidates only, NEW48 never vetoed. Shadow ledger all R18 allowed old signals (including wallet-rejected), group 30/60d prior completed 24h labels by UTC entry day; mean of daily means net30bps. At least 10 distinct prior days; no future exit labels, only scheduled horizon <= current time. If average <=0, veto or cap old concurrency at1. For unknown history cap variants cap at1, veto variants retain base to avoid dropping PRE due to warmup. REGIME uses same BTC24/72 regime. BEAR_ONE uses cap1 on current BTC bearish state. NEW_PRIORITY only sorts simultaneous timestamp new first, does not force close.','limitations':'Exploratory, all periods already inspected; shadow tape source priced only, future missing path selection in legacy source not fully excluded. No funding, no integrated STABLE4. No production.'}\nP19.write_text(json.dumps(p19,indent=2),encoding='utf8')\ns=parent.read_text();start=s.index(\"s=parent.read_text()\");end=s.index(\"out={}\\nfor g\")\n# reuse R18 data, flags, wallet definitions without writing R18 outputs; parent path overwritten for nested load\nparent=R/'y06_r17_old_new_portfolio_20261127.py'\nexec(compile(s[start:end],'r18_replay','exec'))\nold=[x for x,f in oldf if f['NO_BULL_STRETCH']];new=base['NEW48']\ndef state(x):\n i=(x['entryTs']-bt.HS)//H\n a=btc[i-1,3]/btc[i-25,3]-1;b=btc[i-1,3]/btc[i-73,3]-1\n return 'BEAR' if a<0 and b<0 else 'BULL' if a>0 and b>0 else 'MIXED'\ndef up3(x):\n i=(x['entryTs']-bt.HS)//H\n return btc[i-1,3]>btc[i-4,3]\nshadow=sorted(old,key=lambda x:x['entryTs'])\ndef shadow_stat(t,days,reg=None):\n daily=collections.defaultdict(list)\n for x in shadow:\n  et=x['entryTs']\n  if et+24*H>t:break\n  if et<t-days*24*H or (reg is not None and state(x)!=reg):continue\n  daily[et//(24*H)].append(x['rawReturn']-.003)\n a=[float(np.mean(v)) for v in daily.values()]\n return len(a),float(np.mean(a)) if a else None\nmetrics={}\nfor x in old:\n t=x['entryTs'];reg=state(x)\n metrics[(x['symbol'],t)]={'reg':reg,'up3':up3(x),'30':shadow_stat(t,30),'60':shadow_stat(t,60),'reg60':shadow_stat(t,60,reg)}\ndef decision(x,arm):\n if x['route']!='OLD24':return True,2\n m=metrics[(x['symbol'],x['entryTs'])];reg=m['reg']\n if arm=='MIXED_ONLY':return reg=='MIXED',2\n if arm=='BEAR_ONLY':return reg=='BEAR',2\n if arm in ('BEAR_ONE_SLOT','BEAR_ONE_SLOT_BTC3UP_VETO'):\n  return not(arm.endswith('VETO') and m['up3']),1 if reg=='BEAR' else 2\n if arm=='BASE':return True,2\n k='reg60' if arm.startswith('REGIME') else '30' if '30' in arm else '60'\n n,mu=m[k];bad=n>=10 and mu<=0\n if arm.endswith('VETO'):return not bad,2\n cap=1 if n<10 or bad else 2\n if arm=='ONLINE60_CAP_BEAR_ONE' and reg=='BEAR':cap=1\n return True,cap\ndef w(cands,per,fee,arm):\n begin,end=bt.PERIODS[per];eq=np.full((end-begin)//M+1,10000.);active=[];cool={};acc=[];blocked=collections.Counter()\n for x in sorted(cands,key=lambda y:(y['entryTs'],0 if arm.endswith('NEW_PRIORITY') and y['route']=='NEW48' else 1,y['symbol'],y['route'])):\n  t=x['entryTs'];e=x['exitTs'];s=x['symbol'];rt=x['route'];active=[a for a in active if a['exitTs']>t]\n  if not(begin<=t<e<end):continue\n  ok,cap=decision(x,arm)\n  if not ok:blocked[rt+'_VETO']+=1;continue\n  if len(active)>=2:blocked[rt+'_SLOTS']+=1;continue\n  if any(a['symbol']==s for a in active):blocked[rt+'_SAME']+=1;continue\n  if t<cool.get(s,0):blocked[rt+'_COOLDOWN']+=1;continue\n  if rt=='OLD24' and sum(a['route']=='OLD24' for a in active)>=cap:blocked[rt+'_CAP']+=1;continue\n  i=(t-begin)//M;j=(e-begin)//M;mi=(t-bt.MS)//M;nt=.30*eq[i];px=ms[s][mi:mi+j-i,0]\n  if nt<=0 or len(px)!=j-i or not np.isfinite(px).all():continue\n  eq[i:j]+=nt*(1-px/x['entry']-fee/20000);net=nt*(x['rawReturn']-fee/10000);eq[j:]+=net\n  active.append(x);cool[s]=e+12*H;acc.append((rt,float(net),x))\n peak=np.maximum.accumulate(np.r_[10000.,eq])[1:];wins=sum(v>0 for rt,v,x in acc);pos=sum(v for rt,v,x in acc if v>0);neg=-sum(v for rt,v,x in acc if v<0)\n return {'terminal_jpy':float(eq[-1]),'max_dd_pct':float(100*np.max(1-eq/peak)),'n':len(acc),'wins':wins,'win_pct':100*wins/len(acc) if acc else None,'pf':pos/neg if neg else None,'route_pnl':{k:sum(v for a,v,x in acc if a==k) for k in ('OLD24','NEW48')},'route_n':dict(collections.Counter(a for a,v,x in acc)),'blocked':dict(blocked)}\nout={}\nfor arm in p19['arms']:\n out[arm]={}\n for per in bt.PERIODS:out[arm][per]={str(f):w([x for x in old+new if x['period']==per],per,f,arm) for f in (10,30)}\n print('BT',arm,[(round(v['10']['terminal_jpy']),round(v['30']['terminal_jpy']),round(v['30']['max_dd_pct'],2),round(v['30']['win_pct'],2),v['30']['n']) for v in out[arm].values()],flush=True)\nO19.write_text(json.dumps({'protocol':p19,'protocol_sha256':hashlib.sha256(P19.read_bytes()).hexdigest(),'results':out},indent=2,allow_nan=False),encoding='utf8')\nprint('SAVED',hashlib.sha256(O19.read_bytes()).hexdigest(),flush=True)\n","sha256":{"Y06_R19_ONLINE_ALLOCATION_RESULTS_20261127.json":"691166f0bbed9ed7d3ba591a97d920bd749cc9b1630647eeaa2d23419bc97fa7","y06_r19_online_allocation_20261127.py":"8bcbc67766864474eab905554d9760b19d7061c087fc7407b8fed7050f2b072a"}}
