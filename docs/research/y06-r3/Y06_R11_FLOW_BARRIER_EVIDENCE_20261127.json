t_factor":1.100385256918735,"stop_count":71,"target_count":0,"blocked":{"SLOTS_TWO":91,"SAME_SYMBOL":69,"COOLDOWN":89},"by_direction":{"SHORT":149,"LONG":15}},"30":{"n":164,"wins":81,"win_pct":49.390243902439025,"terminal_jpy":9962.67950999714,"max_dd_pct":11.021424780577682,"profit_factor":0.9962298828780777,"stop_count":71,"target_count":0,"blocked":{"SLOTS_TWO":91,"SAME_SYMBOL":69,"COOLDOWN":89},"by_direction":{"SHORT":149,"LONG":15}}},"mean_net_pct":-0.011479866124914681},"FORWARD_INSPECTED":{"intentions":59,"unpriced":0,"wallet":{"10":{"n":22,"wins":10,"win_pct":45.45454545454545,"terminal_jpy":10059.252596680708,"max_dd_pct":4.267671745005885,"profit_factor":1.0460529699402452,"stop_count":10,"target_count":0,"blocked":{"SLOTS_TWO":20,"SAME_SYMBOL":8,"COOLDOWN":9},"by_direction":{"LONG":15,"SHORT":7}},"30":{"n":22,"wins":10,"win_pct":45.45454545454545,"terminal_jpy":9927.13815171548,"max_dd_pct":4.673207412226565,"profit_factor":0.9460901851969034,"stop_count":10,"target_count":0,"blocked":{"SLOTS_TWO":20,"SAME_SYMBOL":8,"COOLDOWN":9},"by_direction":{"LONG":15,"SHORT":7}}},"mean_net_pct":-1.0452734387143694}}}},"source":"import pathlib,json,hashlib,importlib.util,collections,numpy as np,gzip\nR=pathlib.Path(r'C:\\tmp\\disdex-d126-crossrunner-research-20261126')\nSRC=R/'y06_r3_bear_retest_research_v2.py'\nsp=importlib.util.spec_from_file_location('r3',SRC);r3=importlib.util.module_from_spec(sp);sp.loader.exec_module(r3)\nbt=r3.bt;H=bt.H;M=bt.M\nP=R/'Y06_R11_FLOW_BARRIER_PROTOCOL_20261127.json';O=R/'Y06_R11_FLOW_BARRIER_RESULTS_20261127.json'\nassert not P.exists() and not O.exists()\np={'status':'RESEARCH_ONLY','source_sha256':hashlib.sha256(SRC.read_bytes()).hexdigest(),'data':'ASTER raw archived H1 kline fields 5 total base volume, 8 trade count, 9 taker buy base volume per official v3 specification. Check 0<=buy<=total, no negative, align closed H1 with native QA. No Binance/OI/liquidation/board in this phase.','snapshots':'UTC 0/3/6/9/12/15/18/21; 13 alts; original strict R3 QA. At least 48 prior completed hours.','flow':'signed taker imbalance (2*buy-total)/total, recent 3/6/24h, volume ratio 3h vs preceding21h, relative return vs BTC, price 3/6/24/72h, ATR, range compression, count rate. No future access for candidate eligibility.','label':'Future48h M5 3/5/8% favorable touch before opposite8% stop, same bar stop first. Also signed fixed48 and target5/8 with stops4/8; no funding, roundtrip 30bps. Event outcomes only for diagnostics and completed historical training.','arms':{'FLOW_CONT':'3h imbalance >=0.15 in direction and 3h price agrees, volume ratio>=1.5','FLOW_ABSORB':'3h imbalance >=0.15 against 3h price, direction of price, volume ratio>=1.5','FLOW_REVERSAL':'3h imbalance>=0.15 against price, direction of flow, volume ratio>=1.5','FLOW_EXHAUST':'prior21h price moves >=3%, recent3h return opposite, flow follows recent3h with abs>=0.1','WF_PRICE':'weekly 120d ridge model on price+volatility only, predict realized return and probability for TP5 STOP4 /48h both sides','WF_FLOW':'same with actual flow fields','WF_FLOW_STRICT':'same flow model, stricter selection'},'selection':'Each timestamp independently choose at most one eligible symbol/side, highest deterministic signal score or model expected return. Model training 48h label embargo, min 60d and 400 resolved rows; ridge 0.05*n, training-only standardized features, no hyperparameter search. WF model threshold net>=0.5%, estimated positive net>=55%; strict >=1%, >=60%.','fixed_exits':'Rule arms TP5/STOP4, TP8/STOP8 and TIME48/STOP8; adverse opening gaps, stop first same bar. Wallet gross .30, 2 slots, 12h cooldown, 10/30bps; funding absent.','limits':'All time periods already inspected. No untouched OOS. No live change. Selection never uses future availability; missing labels counted.'}\nP.write_text(json.dumps(p,indent=2),encoding='utf8')\nbtc,_=bt.data('BTC','1h');hs={};ms={};qa={};flows={}\ndef flow_data(sym):\n out=np.full((len(btc),3),np.nan)\n for folder,part in bt.HFiles+[(None,'fresh')]:\n  path=bt.ROOT/folder/(sym+'USDT-'+part+'.jsonl.gz') if folder else bt.FEED/bt.mf['candle_counts'][sym+'USDT_1h']['filename']\n  with gzip.open(path,'rt',encoding='utf8') as f:\n   for line in f:\n    a=json.loads(line);t=int(a[0]);i=(t-bt.HS)//H\n    if not(0<=i<len(out)) or (t-bt.HS)%H:continue\n    try:v,b,n=float(a[5]),float(a[9]),float(a[8])\n    except (ValueError,IndexError,TypeError):continue\n    if np.isfinite([v,b,n]).all() and 0<=b<=v+1e-9 and n>=0:out[i]=[v,min(b,v),n]\n return out\nfor sym in bt.SYMS[1:]:\n h,_=bt.data(sym,'1h');m,_=bt.data(sym,'5m');hs[sym]=h;ms[sym]=m;qa[sym]=r3.prepare_qa(h,m)[0];flows[sym]=flow_data(sym);print('LOAD',sym,'FLOW_HOURS',int(np.isfinite(flows[sym][:,0]).sum()),flush=True)\ndef perof(t):return next((k for k,(a,b) in bt.PERIODS.items() if a<=t<b),None)\ndef endof(per):return bt.PERIODS[per][1] if per!='FORWARD_INSPECTED' else bt.T('2026-11-26T00:00:00Z')\ndef ret(h,i,n):return float(h[i-1,3]/h[i-1-n,3]-1)\ndef trade(x,side,tp,sl):\n m=ms[x['symbol']];k=(x['entryTs']-bt.MS)//M;j=k+576\n if k<0 or j>=len(m) or not np.isfinite(m[k:j+1,:4]).all():return None\n ep=float(m[k,0]);stop=ep*(1-side*sl);target=ep*(1+side*tp) if tp else None\n hi=m[k:j,1];lo=m[k:j,2]\n sh=np.flatnonzero(lo<=stop if side==1 else hi>=stop)\n th=np.flatnonzero(hi>=target if side==1 else lo<=target) if tp else []\n si=int(sh[0]) if len(sh) else 576;ti=int(th[0]) if len(th) else 576\n xp=float(m[j,0]);et=bt.MS+j*M;reason='TIME48'\n if si<=ti and si<576:\n  q=k+si;xp=float(min(m[q,0],stop) if side==1 else max(m[q,0],stop));et=bt.MS+(q+1)*M;reason='HARD_STOP8' if sl==.08 else 'EARLY_STOP4'\n elif ti<576:\n  q=k+ti;xp=float(target);et=bt.MS+(q+1)*M;reason='TARGET'\n return {**x,'direction':'LONG' if side==1 else 'SHORT','entry':ep,'exitPrice':xp,'exitTs':et,'rawReturn':side*(xp/ep-1),'exitReason':reason}\ndef compact(w):return {k:v for k,v in w.items() if k!='accepted'}\nrows=[];bytime=collections.defaultdict(list);rules=collections.defaultdict(dict);diag=collections.defaultdict(list)\nfor i in range(220,len(btc)):\n t=bt.HS+i*H;per=perof(t)\n if not per or t%(3*H) or not np.isfinite(btc[i-73:i,3]).all():continue\n br=[ret(btc,i,w) for w in (3,6,24,72)]\n for sym,h in hs.items():\n  f=flows[sym]\n  if not qa[sym][i] or not np.isfinite(h[i-73:i,:5]).all() or not np.isfinite(f[i-48:i]).all():continue\n  if not np.allclose(f[i-48:i,0],h[i-48:i,4],rtol=1e-6,atol=1e-6):continue\n  v=f[i-24:i,0];b=f[i-24:i,1];n=f[i-24:i,2]\n  if min(v[-3:].sum(),v[-6:].sum(),v.sum(),v[:-3].sum())<=0:continue\n  im=[float(2*b[-w:].sum()/v[-w:].sum()-1) for w in (3,6,24)]\n  vr=float(v[-3:].mean()/v[:-3].mean());nr=float(n[-3:].mean()/max(n[:-3].mean(),1))\n  ar=[ret(h,i,w) for w in (1,3,6,24,72)]\n  prior=float(h[i-4,3]/h[i-25,3]-1);atr=r3.calc_atr(h,i)\n  if atr is None or atr<=0:continue\n  rng=float((h[i-24:i,1].max()-h[i-24:i,2].min())/h[i-1,3])\n  px=ar+br+[ar[1]-br[0],ar[3]-br[2],atr/h[i-1,3],rng,min(vr,10)]\n  fl=im+[min(nr,10),im[0]-im[2],im[0]*ar[1]]\n  x=dict(symbol=sym,period=per,entryTs=t)\n  idx=len(rows);row={'x':x,'px':px,'fl':fl,'im3':im[0],'r3':ar[1],'vr':vr,'btc24':br[2],'asset24':ar[3]}\n  labels=[]\n  for side in (1,-1):\n   tr=trade(x,side,.05,.04)\n   labels.append(None if tr is None else tr['rawReturn']-.003)\n   if t+48*H<endof(per):\n    group='FLOW_ALIGNED' if side*im[0]>=.15 and side*ar[1]>0 else 'FLOW_ABSORPTION' if side*im[0]<=-.15 and side*ar[1]>0 else 'OTHER'\n    if tr is not None:\n     for tp in (.03,.05,.08):\n      z=trade(x,side,tp,.08)\n      if z:diag[(per,group,side,tp)].append(int(z['exitReason']=='TARGET'))\n  row['labels']=labels;rows.append(row);bytime[t].append(idx)\n  tests={}\n  if vr>=1.5 and abs(im[0])>=.15 and ar[1]!=0:\n   fs=1 if im[0]>0 else -1;ps=1 if ar[1]>0 else -1\n   if fs==ps:tests['FLOW_CONT']=(ps,abs(im[0])*min(vr,10))\n   else:tests['FLOW_ABSORB']=(ps,abs(im[0])*min(vr,10));tests['FLOW_REVERSAL']=(fs,abs(im[0])*min(vr,10))\n  if abs(prior)>=.03 and ar[1]*prior<0 and im[0]*ar[1]>0 and abs(im[0])>=.1:tests['FLOW_EXHAUST']=(1 if ar[1]>0 else -1,abs(prior)*abs(im[0]))\n  for name,(side,score) in tests.items():\n   old=rules[name].get(t)\n   if old is None or score>old[0]:rules[name][t]=(score,idx,side)\nprint('ROWS',len(rows),'TIMES',len(bytime),flush=True)\nD={}\nfor (per,g,side,tp),v in diag.items():D.setdefault(per,{}).setdefault(g,{}).setdefault('LONG' if side==1 else 'SHORT',{})[str(tp)]={'n':len(v),'hit_pct':100*float(np.mean(v))}\nfor per,d in D.items():print('HIT',per,json.dumps(d),flush=True)\nT=np.array([r['x']['entryTs'] for r in rows],dtype=np.int64);Y0=np.array([[np.nan if v is None else v for v in r['labels']] for r in rows]);Y=np.c_[Y0,np.where(np.isfinite(Y0),(Y0>0).astype(float),np.nan)]\nXP=np.array([r['px'] for r in rows]);XF=np.array([r['px']+r['fl'] for r in rows]);pred={}\nfor kind,X in [('PRICE',XP),('FLOW',XF)]:\n pr=np.full((len(rows),4),np.nan);week=7*24*H;offset=4*24*H\n for wk in sorted(set(((T-offset)//week)*week+offset)):\n  if wk-T.min()<60*24*H:continue\n  tr=(T>=wk-120*24*H)&(T+48*H<=wk)&np.isfinite(Y).all(axis=1);te=(T>=wk)&(T<wk+week)\n  if tr.sum()<400 or not te.any():continue\n  mu=X[tr].mean(axis=0);sd=np.maximum(X[tr].std(axis=0),1e-9);A=np.c_[np.ones(tr.sum()),np.clip((X[tr]-mu)/sd,-5,5)];B=np.c_[np.ones(te.sum()),np.clip((X[te]-mu)/sd,-5,5)]\n  pen=np.eye(A.shape[1])*.05*len(A);pen[0,0]=0;pr[te]=B@np.linalg.solve(A.T@A+pen,A.T@Y[tr])\n pred[kind]=pr\nfor name,kind,net,win in [('WF_PRICE','PRICE',.005,.55),('WF_FLOW','FLOW',.005,.55),('WF_FLOW_STRICT','FLOW',.01,.6)]:\n for t,ids in bytime.items():\n  c=[]\n  for j in ids:\n   a=pred[kind][j]\n   if np.isfinite(a).all():\n    for d in (0,1):\n     if a[d]>=net and a[d+2]>=win:c.append((float(a[d]),j,1 if d==0 else -1))\n  if c:rules[name][t]=max(c)\nout={}\nfor name,tape in rules.items():\n exits=[('TP5_STOP4',.05,.04)] if name.startswith('WF') else [('TP5_STOP4',.05,.04),('TP8_STOP8',.08,.08),('TIME48_STOP8',0,.08)]\n for ex,tp,sl in exits:\n  key=name+'/'+ex;out[key]={}\n  for per in bt.PERIODS:\n   a=[(j,d) for t,(score,j,d) in tape.items() if rows[j]['x']['period']==per and t+48*H<endof(per)]\n   z=[q for j,d in a if (q:=trade(rows[j]['x'],d,tp,sl)) is not None]\n   w={str(f):compact(bt.wallet(z,per,f,ms)) for f in (10,30)}\n   out[key][per]={'intentions':len(a),'unpriced':len(a)-len(z),'wallet':w,'mean_net_pct':float(100*np.mean([q['rawReturn']-.003 for q in z])) if z else None}\n  print('BT',key,[(round(v['wallet']['30']['terminal_jpy']),round(v['wallet']['30']['max_dd_pct'],2),v['wallet']['30']['n'],v['wallet']['30']['wins'],v['unpriced']) for v in out[key].values()],flush=True)\nO.write_text(json.dumps({'protocol':p,'protocol_sha256':hashlib.sha256(P.read_bytes()).hexdigest(),'feature_rows':len(rows),'snapshots':len(bytime),'diagnostics':D,'results':out,'selected':{name:[{**rows[j]['x'],'side':d,'score':score} for t,(score,j,d) in tape.items()] for name,tape in rules.items()}},indent=2,allow_nan=False),encoding='utf8')\nprint('SAVED',hashlib.sha256(O.read_bytes()).hexdigest(),flush=True)\n","sha256":{"Y06_R11_FLOW_BARRIER_RESULTS_20261127.json":"4b07674184c7f7a93f524437802441a86b5f5d86f4c8650cdeae2911844a0566","y06_r11_flow_barrier_20261127.py":"bb8ad2e99f7f2abd5b4f8fc0e2456b03910e36b39fee2e36c2bed8a04d7a668e"}}
