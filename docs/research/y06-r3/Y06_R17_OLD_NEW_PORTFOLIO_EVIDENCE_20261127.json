261126');SRC=R/'y06_r3_bear_retest_research_v2.py'\nsp=importlib.util.spec_from_file_location('r3',SRC);r3=importlib.util.module_from_spec(sp);sp.loader.exec_module(r3)\nbt=r3.bt;H=bt.H;M=bt.M\nP=R/'Y06_R17_OLD_NEW_PORTFOLIO_PROTOCOL_20261127.json';O=R/'Y06_R17_OLD_NEW_PORTFOLIO_RESULTS_20261127.json';assert not P.exists() and not O.exists()\nold=R/'Y06_STRUCTURE_REDESIGN_M5_V2_Q75_20261126.json';new=R/'Y06_R15_BINANCE_NORMALIZED_RESULTS_20261127.json'\np={'status':'RESEARCH_ONLY','parents':{x.name:hashlib.sha256(x.read_bytes()).hexdigest() for x in (old,new)},'comparison':'Legacy DOWNTREND_BREAK NATIVE_STYLE H24 vs independent ASTER_H1 H48 TP8 and Binance continuation M5 H48. Common overlapping legacy dates PRE/TARGET/FORWARD ending Nov8 UTC; QA at entry rechecked; exact same data and two-slot .30 gross. Compare no cooldown legacy vs common12h. Joint portfolio never adds slots or leverage. No live changes.','arms':['OLD24','NEW48','BIN48','OLD_NEW','OLD_BIN','NEW_BIN','ALL3'],'exit':'STOP8, legacy H24 fixed, NEW48 TP8, BIN48 fixed. 10/30bps. Same-symbol exclusivity, no duplicate entries, chronological tie-break symbol then route. Funding not included.','limits':'All periods previously inspected, research only; legacy tape generated under older data quality/coverage assumptions; exact old published result not guaranteed under current QA; no clean OOS.'}\nP.write_text(json.dumps(p,indent=2),encoding='utf8')\nbt.PERIODS['FORWARD_INSPECTED']=(bt.T('2026-10-01T00:00:00Z'),bt.T('2026-11-08T00:00:00Z'))\nhs={};ms={};qa={}\nfor sym in bt.SYMS[1:]:\n h,_=bt.data(sym,'1h');m,_=bt.data(sym,'5m');hs[sym]=h;ms[sym]=m;qa[sym]=r3.prepare_qa(h,m)[0];print('LOAD',sym,flush=True)\ndef endof(per):return bt.PERIODS[per][1]\nsrc=(R/'y06_r14_binance_cross_venue_20261127.py').read_text();tr=ast.parse(src)\nexec(compile(ast.Module(body=[x for x in tr.body if isinstance(x,ast.FunctionDef) and x.name in ('trade','compact')],type_ignores=[]),str(R/'y06_r14_binance_cross_venue_20261127.py'),'exec'))\nd=json.loads(old.read_text());n=json.loads(new.read_text());tapes=collections.defaultdict(list);counts=collections.Counter()\nfor x in d['records']:\n if x['policy']!='DOWNTREND_BREAK' or x['exit_mode']!='NATIVE_STYLE':continue\n s=x['symbol'].removesuffix('USDT');t=x['entry'];per='FORWARD_INSPECTED' if x['period']=='FORWARD' else x['period']\n if s not in ms or per not in bt.PERIODS:continue\n if not bt.PERIODS[per][0]<=t<endof(per):continue\n counts['old_raw']+=1;i=(t-bt.HS)//H\n if not qa[s][i]:counts['old_qa_reject']+=1;continue\n z=trade(dict(symbol=s,period=per,entryTs=t,route='OLD24'),24,0)\n if z:tapes['OLD24'].append(z)\nfor name,route,tp in [('ASTER_H1','NEW48',.08),('BINANCE_CONT_M5','BIN48',0)]:\n for x in n['tapes'][name]:\n  if not bt.PERIODS[x['period']][0]<=x['entryTs']<endof(x['period']):continue\n  z=trade({**x,'route':route},48,tp)\n  if z:tapes[route].append(z)\nprint('COUNTS',dict(counts),{k:len(v) for k,v in tapes.items()},flush=True)\n# Independent portfolio implementation preserving original accounting but strict common period ends.\ndef wallet(cands,per,fee,coolhr):\n begin,end=bt.PERIODS[per];eq=np.full((end-begin)//M+1,10000.);active=[];cool={};acc=[];blocked=collections.Counter()\n for x in sorted(cands,key=lambda y:(y['entryTs'],y['symbol'],y['route'])):\n  t=x['entryTs'];e=x['exitTs'];s=x['symbol'];active=[a for a in active if a['exitTs']>t]\n  if not(begin<=t<e<end):continue\n  if len(active)>=2:blocked['SLOTS']+=1;continue\n  if any(a['symbol']==s for a in active):blocked['SAME_SYMBOL']+=1;continue\n  if t<cool.get(s,0):blocked['COOLDOWN']+=1;continue\n  i=(t-begin)//M;j=(e-begin)//M;mi=(t-bt.MS)//M;nt=.30*eq[i];px=ms[s][mi:mi+j-i,0]\n  if nt<=0 or len(px)!=j-i or not np.isfinite(px).all():continue\n  eq[i:j]+=nt*(1-px/x['entry']-fee/20000);net=nt*(x['rawReturn']-fee/10000);eq[j:]+=net\n  active.append(x);cool[s]=e+coolhr*H;acc.append((x['route'],float(net)))\n peak=np.maximum.accumulate(np.r_[10000.,eq])[1:];win=sum(v>0 for a,v in acc);pos=sum(v for a,v in acc if v>0);neg=-sum(v for a,v in acc if v<0)\n return {'terminal_jpy':float(eq[-1]),'max_dd_pct':float(100*np.max(1-eq/peak)),'n':len(acc),'wins':win,'win_pct':100*win/len(acc) if acc else None,'pf':pos/neg if neg else None,'route_pnl':{k:sum(v for a,v in acc if a==k) for k in tapes},'blocked':dict(blocked)}\narms={'OLD24':['OLD24'],'NEW48':['NEW48'],'BIN48':['BIN48'],'OLD_NEW':['OLD24','NEW48'],'OLD_BIN':['OLD24','BIN48'],'NEW_BIN':['NEW48','BIN48'],'ALL3':['OLD24','NEW48','BIN48']}\nout={}\nfor arm,names in arms.items():\n cs=[x for name in names for x in tapes[name]]\n for cool in (0,12):\n  key=arm+'/cool'+str(cool);out[key]={}\n  for per in bt.PERIODS:out[key][per]={str(f):wallet([x for x in cs if x['period']==per],per,f,cool) for f in (10,30)}\n  print('BT',key,[(round(v['10']['terminal_jpy']),round(v['30']['terminal_jpy']),round(v['30']['max_dd_pct'],2),v['30']['n'],v['30']['wins']) for v in out[key].values()],flush=True)\nO.write_text(json.dumps({'protocol':p,'protocol_sha256':hashlib.sha256(P.read_bytes()).hexdigest(),'counts':dict(counts),'results':out},indent=2,allow_nan=False),encoding='utf8')\nprint('SAVED',hashlib.sha256(O.read_bytes()).hexdigest(),flush=True)\n","sha256":{"Y06_R17_OLD_NEW_PORTFOLIO_RESULTS_20261127.json":"855649907c331f8429d31fb6bc033b1e57735436ae1eaf66e4958723f7010a66","y06_r17_old_new_portfolio_20261127.py":"20593173b6a875ca51d95a35a93ea062a34c10daf531204b561900d1925f942e"}}
