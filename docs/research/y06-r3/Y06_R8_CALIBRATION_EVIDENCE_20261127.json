"SHORT":9,"LONG":2}},"30":{"n":11,"wins":4,"win_pct":36.36363636363637,"terminal_jpy":9943.722265795594,"max_dd_pct":5.012236063975761,"profit_factor":0.8864849152615558,"stop_count":0,"target_count":0,"blocked":{"SAME_SYMBOL":4,"COOLDOWN":3,"SLOTS_TWO":4},"by_direction":{"SHORT":9,"LONG":2}}},"candidate_mean_net_pct":0.042791768718514,"long_candidates":5,"matched":{"pairs":16,"actual":{"n":10,"wins":4,"win_pct":40,"terminal_jpy":9619.440177086837,"max_dd_pct":7.077654947157653,"profit_factor":0.45507800522902625,"stop_count":2,"target_count":0,"blocked":{"SAME_SYMBOL":2,"COOLDOWN":2,"SLOTS_TWO":2},"by_direction":{"SHORT":8,"LONG":2}},"mean_terminal":9732.423643363407,"mean_dd":6.693812925099591,"beats":9,"delta_pp":1.8519627367577827}},"TARGET":{"candidates":178,"unpriced":0,"boundary_excluded":0,"wallet":{"10":{"n":105,"wins":59,"win_pct":56.19047619047619,"terminal_jpy":11372.97585596756,"max_dd_pct":13.270601025704876,"profit_factor":1.2413447284699695,"stop_count":8,"target_count":0,"blocked":{"SLOTS_TWO":32,"SAME_SYMBOL":30,"COOLDOWN":11},"by_direction":{"SHORT":100,"LONG":5}},"30":{"n":105,"wins":55,"win_pct":52.38095238095238,"terminal_jpy":10679.301619538222,"max_dd_pct":14.565204822549171,"profit_factor":1.1166213375945508,"stop_count":8,"target_count":0,"blocked":{"SLOTS_TWO":32,"SAME_SYMBOL":30,"COOLDOWN":11},"by_direction":{"SHORT":100,"LONG":5}}},"candidate_mean_net_pct":-0.12875960450306925,"long_candidates":8,"matched":{"pairs":163,"actual":{"n":103,"wins":54,"win_pct":52.42718446601942,"terminal_jpy":10013.404922852227,"max_dd_pct":14.57275973851624,"profit_factor":1.0024752408031552,"stop_count":8,"target_count":0,"blocked":{"SLOTS_TWO":30,"SAME_SYMBOL":19,"COOLDOWN":11},"by_direction":{"SHORT":98,"LONG":5}},"mean_terminal":9000.608866084138,"mean_dd":18.088643878622115,"beats":31,"delta_pp":0.3826788837837925}},"FORWARD_INSPECTED":{"candidates":5,"unpriced":0,"boundary_excluded":0,"wallet":{"10":{"n":3,"wins":0,"win_pct":0,"terminal_jpy":9650.655390781876,"max_dd_pct":4.67829697565838,"profit_factor":0,"stop_count":1,"target_count":0,"blocked":{"SLOTS_TWO":2},"by_direction":{"SHORT":3}},"30":{"n":3,"wins":0,"win_pct":0,"terminal_jpy":9632.947363868674,"max_dd_pct":4.79657232345625,"profit_factor":0,"stop_count":1,"target_count":0,"blocked":{"SLOTS_TWO":2},"by_direction":{"SHORT":3}}},"candidate_mean_net_pct":-3.78354005763575,"long_candidates":0,"matched":{"pairs":5,"actual":{"n":3,"wins":0,"win_pct":0,"terminal_jpy":9632.947363868674,"max_dd_pct":4.79657232345625,"profit_factor":0,"stop_count":1,"target_count":0,"blocked":{"SLOTS_TWO":2},"by_direction":{"SHORT":3}},"mean_terminal":9712.43664900907,"mean_dd":3.9645378224987122,"beats":7,"delta_pp":-0.9473109703151337}}}}},"source":"import pathlib,json,hashlib,importlib.util,collections,numpy as np,math,datetime\nR=pathlib.Path(r'C:\\tmp\\disdex-d126-crossrunner-research-20261126')\nSRC=R/'y06_r3_bear_retest_research_v2.py'\nsp=importlib.util.spec_from_file_location('r3',SRC);r3=importlib.util.module_from_spec(sp);sp.loader.exec_module(r3)\nbt=r3.bt;H=bt.H;M=bt.M\nP=R/'Y06_R8_CALIBRATION_PROTOCOL_20261127.json';O=R/'Y06_R8_CALIBRATION_RESULTS_20261127.json'\nassert not P.exists() and not O.exists()\np={'status':'RESEARCH_ONLY_HISTORIC_WALK_FORWARD_NOT_UNTOUCHED','source_sha256':hashlib.sha256(SRC.read_bytes()).hexdigest(),'features':'At UTC 0/6/12/18 closed H1: asset returns 1/3/6/12/24/72/168h, BTC 6/24/72/168h, relative 6/24/72h, 24h directional efficiency, location in trailing 24h high-low, ATR14/price, volume ratio recent6 to previous18, cross-sectional fraction peers negative24h. No future bars or labels. Native ASTER R3 QA.','labels':'Independent long and short STOP8/24h net return 30bps and win, adverse opening gap; full data. Train past 90d only, 24h label embargo, min 400 rows and 60d history. Weekly retraining fixed UTC Monday boundary. Standardize using training only and clip z at +/-5; ridge regression multioutput lambda 0.05*n on slopes, intercept unpenalized. No tuning.','arms':{'R7_EXPECTANCY':'estimated net >=0.3%, win estimate >=52%; choose highest predicted net among independently eligible long/short across symbols per 6h timestamp','R7_STRICT':'estimated net >=0.6%, win estimate >=58%, same selection','R7_DIRECTIONAL':'R7_EXPECTANCY plus BTC and asset trailing 24h return same sign as side'},'wallet':'0.30x, 2-slot, 12h post-exit cooldown, 10/30bps. Same one candidate per timestamp; no alternate after rejection. PRE begins only after 60d warmup; no lookahead or tuning. No funding.','control':'32 fixed draws on each arm matched to same snapshot time, same side, same BTC and asset 24h sign, randomly choose alternative symbol among QA candidates, equal exit and wallet. Separate per-trade and account comparison. Not independent trials.','limitations':'All historical dates already researched; not a clean independent OOS. Model predictions are uncalibrated linear estimates. No production change.'}\np.update({'correction':'All causally QA-eligible features are retained irrespective of future M5 path completeness. Training only uses resolved historical labels before embargo cutoff. Pick first without future label access; unresolved selected candidate separately logged and excluded from priced PnL, never substituted.','additional_arms':{'R8_SHORT_ONLY':'Strict independently predicted SHORT only, no LONG flip','R8_ONLINE60':'Strict candidate only if its direction has >=20 resolved shadow candidates in preceding60d, mean net>0, win>=50%','R8_ONLINE30':'Same, preceding30d and >=12 candidates','R8_SHORT_ONLINE60':'SHORT_ONLY with 60d gate','R8_CONFIDENCE60':'Both sides 60d >=20, mean net >0.5 standard errors, win>=50%'},'adaptation':'Shadow scores use prior STRICT intentions, including rejected and out-of-wallet signals, only labels whose full scheduled 24h horizon has elapsed; no selected-trade hindsight. Thresholds frozen before results. PRE has initial fit warmup plus calibration warmup.','caveat':'All source dates already inspected. The R7 result was observed before R8 design, so exploratory. No guarantee of accuracy or positive return. Unpriced selected entries imply no complete portfolio reconstruction.'})\nP.write_text(json.dumps(p,indent=2),encoding='utf8')\nbtc,_=bt.data('BTC','1h');hs={};ms={};qa={}\nfor sym in bt.SYMS[1:]:\n h,_=bt.data(sym,'1h');m,_=bt.data(sym,'5m');hs[sym]=h;ms[sym]=m;qa[sym]=r3.prepare_qa(h,m)[0];print('LOAD',sym,flush=True)\ndef perof(t):return next((k for k,(a,b) in bt.PERIODS.items() if a<=t<b),None)\ndef endof(per):return bt.PERIODS[per][1] if per!='FORWARD_INSPECTED' else bt.T('2026-11-26T00:00:00Z')\ndef ret(h,i,w):return h[i-1,3]/h[i-1-w,3]-1\ndef make_trades(sym,t,per):\n m=ms[sym];k=(t-bt.MS)//M;j=k+288\n if k<0 or j>=len(m) or not np.isfinite(m[k:j+1,:4]).all():return None\n ep=float(m[k,0]);out=[]\n for side in (1,-1):\n  stop=ep*(1-side*.08);hit=np.flatnonzero(m[k:j,2]<=stop) if side==1 else np.flatnonzero(m[k:j,1]>=stop)\n  et=bt.MS+j*M;xp=float(m[j,0]);reason='TIME24'\n  if len(hit):\n   q=k+int(hit[0]);et=bt.MS+(q+1)*M;xp=float(min(m[q,0],stop) if side==1 else max(m[q,0],stop));reason='HARD_STOP8'\n  out.append(dict(symbol=sym,period=per,entryTs=t,exitTs=et,entry=ep,exitPrice=xp,direction='LONG' if side==1 else 'SHORT',rawReturn=side*(xp/ep-1),exitReason=reason))\n return out\n# generate labeled data, including warmup outside PRE where possible. Predictors never use labels.\nrows=[];bytime=collections.defaultdict(list)\nfor i in range(220,len(btc)):\n t=bt.HS+i*H\n if t%(6*H) or not np.isfinite(btc[i-169:i,3]).all():continue\n per=perof(t)\n if not per:continue\n br=[ret(btc,i,w) for w in (6,24,72,168)]\n peers=[ret(h,i,24) for h in hs.values() if np.isfinite(h[i-25:i,3]).all()]\n if len(peers)<8:continue\n breadth=float(np.mean(np.array(peers)<0))\n for sym,h in hs.items():\n  if not qa[sym][i] or not np.isfinite(h[i-169:i,:5]).all():continue\n  ar=[ret(h,i,w) for w in (1,3,6,12,24,72,168)]\n  z=h[i-25:i,3];d=float(np.abs(np.diff(z)).sum());eff=float((z[-1]-z[0])/d) if d>0 else 0.\n  lo=float(h[i-24:i,2].min());hi=float(h[i-24:i,1].max());loc=(z[-1]-lo)/(hi-lo) if hi>lo else .5\n  atr=r3.calc_atr(h,i)\n  v1=float(h[i-6:i,4].mean());v0=float(h[i-24:i-6,4].mean())\n  if atr is None or atr<=0 or v0<=0:continue\n  feat=ar+br+[ar[2]-br[0],ar[4]-br[1],ar[5]-br[2],eff,loc,atr/z[-1],min(v1/v0,10),breadth]\n  if not np.isfinite(feat).all():continue\n  trades=make_trades(sym,t,per)\n  idx=len(rows);rows.append({'t':t,'sym':sym,'per':per,'feat':feat,'signs':(br[1]>=0,ar[4]>=0),'trades':trades});bytime[t].append(idx)\nX=np.array([x['feat'] for x in rows]);T=np.array([x['t'] for x in rows],dtype=np.int64);Y0=np.array([[z['rawReturn']-.003 for z in x['trades']] if x['trades'] is not None else [np.nan,np.nan] for x in rows]);Y=np.c_[Y0,np.where(np.isfinite(Y0),(Y0>0).astype(float),np.nan)]\n# Training and predictions are explicitly embargoed before each weekly fit.\nstart=min(T);pred=np.full((len(rows),4),np.nan);fits=[];week=7*24*H;offset=4*24*H\nfor wk in sorted(set(((T-offset)//week)*week+offset)):\n if wk-start<60*24*H:continue\n tr=(T>=wk-90*24*H)&(T+24*H<=wk)&np.isfinite(Y).all(axis=1)\n te=(T>=wk)&(T<wk+week)\n if tr.sum()<400 or not te.any():continue\n mu=X[tr].mean(axis=0);sd=np.maximum(X[tr].std(axis=0),1e-9);A=np.clip((X[tr]-mu)/sd,-5,5);A=np.c_[np.ones(len(A)),A]\n D=np.eye(A.shape[1])*.05*len(A);D[0,0]=0\n b=np.linalg.solve(A.T@A+D,A.T@Y[tr]);B=np.c_[np.ones(te.sum()),np.clip((X[te]-mu)/sd,-5,5)]\n pred[te]=B@b\n fits.append({'train_end_latest_label':int(T[tr].max()+24*H),'week_start':int(wk),'train_n':int(tr.sum()),'test_n':int(te.sum())})\nassert all(x['train_end_latest_label']<=x['week_start'] for x in fits)\nprint('FEATURE_ROWS',len(rows),'FITS',len(fits),'PREDICTED',int(np.isfinite(pred[:,0]).sum()),flush=True)\narms={k:[] for k in p['arms']};unpriced=collections.Counter();shadow=[];border=collections.Counter()\nfor t,ii in bytime.items():\n for arm in arms:\n  choices=[]\n  for j in ii:\n   y=pred[j];x=rows[j]\n   if not np.isfinite(y).all():continue\n   for d in (0,1):\n    v,pr=y[d],y[2+d]\n    floor=.006 if arm=='R7_STRICT' else .003;win=.58 if arm=='R7_STRICT' else .52\n    if v<floor or pr<win:continue\n    if arm=='R7_DIRECTIONAL' and x['signs']!=((True,True) if d==0 else (False,False)):continue\n    choices.append((float(v),float(pr),j,d))\n  if choices:\n   v,pr,j,d=max(choices,key=lambda z:(z[0],z[1],rows[z[2]]['sym']))\n   x=rows[j]\n   z=x['trades'][d] if x['trades'] is not None else None\n   if arm=='R7_STRICT':shadow.append((j,d,z,v,pr))\n   if z is None:unpriced[arm+'/'+x['per']]+=1;continue\n   if z['exitTs']>=endof(x['per']):border[arm+'/'+x['per']]+=1;continue\n   arms[arm].append((j,d,{**z,'pred_net':v,'pred_win':pr}))\n\ndef compact(w):return {k:v for k,v in w.items() if k!='accepted'}\ndef stats(t,d,days):\n yy=np.array([z['rawReturn']-.003 for j,dd,z,v,pr in shadow if dd==d and z is not None and t-days*24*H<=rows[j]['t'] and rows[j]['t']+24*H<=t])\n if len(yy)<2:return len(yy),None,None,None\n return len(yy),float(yy.mean()),float(np.mean(yy>0)),float(yy.std(ddof=1)/np.sqrt(len(yy)))\nfor arm in p['additional_arms']:arms[arm]=[]\nfor j,d,z,v,pr in shadow:\n t=rows[j]['t'];per=rows[j]['per']\n n60,mu60,w60,se60=stats(t,d,60);n30,mu30,w30,se30=stats(t,d,30)\n g60=n60>=20 and mu60>0 and w60>=.5\n g30=n30>=12 and mu30>0 and w30>=.5\n checks={'R8_SHORT_ONLY':d==1,'R8_ONLINE60':g60,'R8_ONLINE30':g30,'R8_SHORT_ONLINE60':d==1 and g60,'R8_CONFIDENCE60':g60 and mu60>.5*se60}\n for a,ok in checks.items():\n  if not ok:continue\n  if z is None:unpriced[a+'/'+per]+=1;continue\n  if z['exitTs']>=endof(per):border[a+'/'+per]+=1;continue\n  arms[a].append((j,d,{**z,'pred_net':v,'pred_win':pr,'cal_n60':n60,'cal_mu60':mu60,'cal_win60':w60,'cal_n30':n30,'cal_mu30':mu30}))\nout={};rng=np.random.default_rng(2026112709)\nfor arm,items in arms.items():\n out[arm]={}\n for per in bt.PERIODS:\n  picks=[(j,d,z) for j,d,z in items if z['period']==per];ts=[z for j,d,z in picks]\n  wallets={str(f):compact(bt.wallet(ts,per,f,ms)) for f in (10,30)}\n  pairs=[]\n  for j,d,z in picks:\n   r=rows[j];alts=[rows[k]['trades'][d] for k in bytime[r['t']] if k!=j and rows[k]['signs']==r['signs'] and rows[k]['trades'] is not None and rows[k]['trades'][d]['exitTs']<endof(per)]\n   if len(alts)>=2:pairs.append((z,alts))\n  aw=compact(bt.wallet([z for z,a in pairs],per,30,ms))\n  ds=[compact(bt.wallet([a[rng.integers(len(a))] for z,a in pairs],per,30,ms)) for _ in range(32)]\n  vals=[d['terminal_jpy'] for d in ds]\n  out[arm][per]={'candidates':len(ts),'unpriced':unpriced[arm+'/'+per],'boundary_excluded':border[arm+'/'+per],'wallet':wallets,'candidate_mean_net_pct':float(np.mean([100*(z['rawReturn']-.003) for z in ts])) if ts else None,'long_candidates':sum(z['direction']=='LONG' for z in ts),'matched':{'pairs':len(pairs),'actual':aw,'mean_terminal':float(np.mean(vals)),'mean_dd':float(np.mean([d['max_dd_pct'] for d in ds])),'beats':sum(aw['terminal_jpy']>v for v in vals),'delta_pp':float(np.mean([100*(z['rawReturn']-np.mean([a['rawReturn'] for a in aa])) for z,aa in pairs])) if pairs else None,'draws':ds}}\n  q=wallets['30'];m=out[arm][per]['matched'];print('BT',arm,per,'CAND',len(ts),'UNPRICED',unpriced[arm+'/'+per],'N',q['n'],'W',q['wins'],'TERM',round(q['terminal_jpy'],2),'DD',round(q['max_dd_pct'],2),'PF',q['profit_factor'],'MATCH',m['pairs'],round(aw['terminal_jpy'],2),round(m['mean_terminal'],2),m['beats'],flush=True)\nO.write_text(json.dumps({'protocol':p,'protocol_sha256':hashlib.sha256(P.read_bytes()).hexdigest(),'feature_rows':len(rows),'missing_labels':int(np.sum(~np.isfinite(Y).all(axis=1))),'fits':fits,'unpriced':dict(unpriced),'boundary_excluded':dict(border),'results':out,'signals':{k:[z for j,d,z in v] for k,v in arms.items()}},indent=2,allow_nan=False),encoding='utf8')\nprint('SAVED',hashlib.sha256(O.read_bytes()).hexdigest(),flush=True)\n","sha256":{"Y06_R8_CALIBRATION_RESULTS_20261127.json":"5b21a909986cdd44b9233359859b4a006c1f1293daa168f8fe8b42da554e5926","y06_r8_calibrated_entry_20261127.py":"9687d44044854e3a71fdbf57de197a693654ca7f0402703c4ec9789cf348d82c"}}
