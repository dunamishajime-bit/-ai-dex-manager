def months() -> list[pd.Period]:
    return list(pd.period_range(START_MONTH, END_MONTH, freq="M"))


def parse_timestamp(values: pd.Series) -> pd.Series:
    x = pd.to_numeric(values, errors="coerce")
    if x.notna().sum() == 0:
        return pd.to_datetime(values, utc=True, errors="coerce", format="mixed")
    med = x.dropna().median()
    if med > 1e16:
        unit = "ns"
    elif med > 1e13:
        unit = "us"
    elif med > 1e11:
        unit = "ms"
    else:
        unit = "s"
    return pd.to_datetime(x, unit=unit, utc=True, errors="coerce")


def read_zip_csv(raw: bytes) -> bytes | None:
    with zipfile.ZipFile(io.BytesIO(raw)) as archive:
        names = [n for n in archive.namelist() if n.lower().endswith(".csv")]
        return archive.read(names[0]) if names else None


def parse_kline(raw: bytes) -> pd.DataFrame:
    cols = [
        "open_time", "open", "high", "low", "close", "volume",
        "close_time", "quote_volume", "trades", "taker_buy_base",
        "taker_buy_quote", "ignore",
    ]
    df = pd.read_csv(io.BytesIO(raw), header=None)
    # Newer archive files can include a header row.
    if str(df.iloc[0, 0]).lower() in {"open_time", "open time"}:
        df = pd.read_csv(io.BytesIO(raw))
        df.columns = [str(c).strip().lower().replace(" ", "_") for c in df.columns]
    else:
        df = df.iloc[:, : min(len(cols), df.shape[1])]
        df.columns = cols[: df.shape[1]]
    tcol = "open_time" if "open_time" in df else df.columns[0]
    out = pd.DataFrame({"timestamp": parse_timestamp(df[tcol])})
    for col in ["open", "high", "low", "close", "volume", "quote_volume", "taker_buy_quote"]:
        if col in df:
            out[col] = pd.to_numeric(df[col], errors="coerce")
    if "quote_volume" not in out:
        out["quote_volume"] = out["volume"] * out["close"]
    if "taker_buy_quote" not in out:
        out["taker_buy_quote"] = np.nan
    out = out.dropna(subset=["timestamp", "open", "high", "low", "close", "quote_volume"])
    out = out.loc[(out[["open", "high", "low", "close"]] > 0).all(axis=1)]
    out = out.loc[out["quote_volume"] > 0]
    return out.drop_duplicates("timestamp", keep="last").sort_values("timestamp")


def download_kline(symbol: str, period: pd.Period) -> tuple[str, pd.DataFrame | None]:
    CACHE.mkdir(parents=True, exist_ok=True)
    stamp = period.strftime("%Y-%m")
    cached = CACHE / f"{symbol}-15m-{stamp}.csv"
    if cached.exists() and cached.stat().st_size > 0:
        frame = pd.read_csv(cached)
        frame["timestamp"] = pd.to_datetime(frame["timestamp"], utc=True, format="mixed")
        return symbol, frame
    url = (
        "https://data.binance.vision/data/futures/um/monthly/klines/"
        f"{symbol}/15m/{symbol}-15m-{stamp}.zip"
    )
    session = requests.Session()
    session.headers.update({"User-Agent": "disdex-range-research/1.0"})
    for attempt in range(3):
        try:
            response = session.get(url, timeout=75)
            if response.status_code == 404:
                return symbol, None
            response.raise_for_status()
            content = read_zip_csv(response.content)
            if content is None:
                return symbol, None
            frame = parse_kline(content)
            if not frame.empty:
                frame.to_csv(cached, index=False)
            return symbol, frame
        except Exception as exc:
            if attempt == 2:
                print(f"WARN kline {symbol} {stamp}: {exc}")
                return symbol, None
            time.sleep(0.75 * (attempt + 1))
    return symbol, None


def parse_funding(raw: bytes) -> pd.DataFrame:
    named = pd.read_csv(io.BytesIO(raw))
    named.columns = [str(c).strip().lower() for c in named.columns]
    tcols = [c for c in named if "time" in c]
    rcols = [c for c in named if "rate" in c and "interval" not in c]
    if tcols and rcols:
        times, rates = named[tcols[0]], named[rcols[0]]
    else:
        pos = pd.read_csv(io.BytesIO(raw), header=None)
        if pos.shape[1] < 2:
            return pd.DataFrame(columns=["timestamp", "funding_rate"])
        times = pos.iloc[:, 0]
        rates = pos.iloc[:, 2 if pos.shape[1] >= 3 else 1]
    out = pd.DataFrame({
        "timestamp": parse_timestamp(times),
        "funding_rate": pd.to_numeric(rates, errors="coerce"),
    }).dropna()
    out = out.loc[out["funding_rate"].abs() < 0.05]
    return out.drop_duplicates("timestamp", keep="last").sort_values("timestamp")


def download_funding(symbol: str, period: pd.Period) -> tuple[str, pd.DataFrame | None]:
    FUNDING_CACHE.mkdir(parents=True, exist_ok=True)
    stamp = period.strftime("%Y-%m")
    cached = FUNDING_CACHE / f"{symbol}-funding-{stamp}.csv"
    if cached.exists() and cached.stat().st_size > 0:
        frame = pd.read_csv(cached)
        frame["timestamp"] = pd.to_datetime(frame["timestamp"], utc=True, format="mixed")
        return symbol, frame
