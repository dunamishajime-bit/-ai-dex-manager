#!/usr/bin/env python3
"""Multi-asset, risk-sized leveraged range-reversion research.

The exchange leverage setting (10x/15x/20x) is treated as a margin ceiling, not
as permission to risk the whole account. Position notional is sized from a
fixed account-risk budget and an ATR stop, then capped by isolated-margin and
portfolio-gross limits.

Selection periods:
- development: 2021-01-01 through 2022-12-31
- validation: 2023-01-01 through 2023-12-31
- untouched holdout: 2024-01-01 through 2026-06-30

Execution assumptions:
- signals use completed 15-minute bars;
- entry occurs at the next valid 15-minute open;
- if stop and target are touched in the same bar, stop is assumed first;
- actual settled funding is charged at the funding event;
- no averaging down, no martingale, maximum three simultaneous positions;
- daily loss and consecutive-loss gates block new entries.
"""
from __future__ import annotations

import io
import json
import math
import time
import zipfile
from concurrent.futures import ThreadPoolExecutor, as_completed
from dataclasses import asdict, dataclass
from pathlib import Path

import numpy as np
import pandas as pd
import requests

OUT = Path("backtest_output_multi_asset_range")
CACHE = Path(".cache/range_15m")
FUNDING_CACHE = Path(".cache/range_funding")
START_MONTH = "2021-01"
END_MONTH = "2026-06"
START = pd.Timestamp("2021-01-01", tz="UTC")
DEV_END = pd.Timestamp("2023-01-01", tz="UTC")
VAL_END = pd.Timestamp("2024-01-01", tz="UTC")
FINAL_END = pd.Timestamp("2026-07-01", tz="UTC")
BARS_PER_DAY = 96
ANNUAL_BARS = BARS_PER_DAY * 365.25
BASE_COST = 0.0006
MAINT_MARGIN = 0.005

# Includes failed/delisted contracts where public files exist, reducing pure
# survivor-only selection. Symbols are selected point-in-time by liquidity.
UNIVERSE = [
    "BTCUSDT", "ETHUSDT", "BNBUSDT", "XRPUSDT", "ADAUSDT", "DOGEUSDT",
    "SOLUSDT", "LINKUSDT", "LTCUSDT", "DOTUSDT", "AVAXUSDT", "BCHUSDT",
    "LUNAUSDT", "FTTUSDT",
]


