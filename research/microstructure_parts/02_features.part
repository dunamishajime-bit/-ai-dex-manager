
def load_symbol(symbol):
    jobs=[]
    for p in periods():
        jobs += [
            (symbol,p,"klines","5m"),(symbol,p,"premiumIndexKlines","5m"),
            (symbol,p,"metrics",None),(symbol,p,"fundingRate",None),
            (symbol,p,"liquidationSnapshot",None),
        ]
    raw={k:[] for k in ["klines","premiumIndexKlines","metrics","fundingRate","liquidationSnapshot"]}
    with ThreadPoolExecutor(max_workers=12) as ex:
        futs=[ex.submit(fetch_dataset,*j) for j in jobs]
        for f in as_completed(futs):
            kind,_,_,df=f.result()
            if df is not None and not df.empty: raw[kind].append(df)
    def catparse(items, parser):
        parsed=[parser(x) for x in items]
        parsed=[x for x in parsed if x is not None and len(x)]
        if not parsed:return None
        z=pd.concat(parsed).sort_index(); return z[~z.index.duplicated(keep="last")]
    k=catparse(raw["klines"],parse_kline)
    m=catparse(raw["premiumIndexKlines"],parse_kline)
    met=catparse(raw["metrics"],parse_metrics)
    funding=catparse(raw["fundingRate"],parse_funding)
    liq=catparse(raw["liquidationSnapshot"],parse_liq)
    if k is None: raise RuntimeError(f"no klines {symbol}")
    idx=k.index[(k.index>=pd.Timestamp(f"{START_MONTH}-01",tz="UTC"))&(k.index<END_TS)]
    x=k.reindex(idx).copy()
    x=x.rename(columns={c:f"trade_{c}" for c in x.columns})
    if m is not None:
        x["mark_close"]=m["close"].reindex(idx).ffill()
    else:x["mark_close"]=np.nan
    if met is not None:
        for c in met.columns:x[c]=met[c].reindex(idx).ffill(limit=3)
    if funding is not None:x["funding"]=funding.reindex(idx).ffill()
    else:x["funding"]=0.0
    if liq is not None:
        x=x.join(liq.reindex(idx).fillna(0.0),how="left")
    else:
        x["long_liq"]=np.nan; x["short_liq"]=np.nan
    x["ret1"]=x["trade_open"].shift(-1)/x["trade_open"]-1
    x["basis"]=(x["mark_close"]/x["trade_close"]-1).replace([np.inf,-np.inf],np.nan)
    x["taker_imb"]=(2*x["trade_taker_buy_quote"]/x["trade_quote_volume"]-1).clip(-1,1)
    if "taker_ratio" in x:
        x["taker_imb"]=x["taker_imb"].fillna((x["taker_ratio"]-1)/(x["taker_ratio"]+1))
    x["range"]=(x["trade_high"]-x["trade_low"])/x["trade_close"]
    x["volume_log"]=np.log1p(x["trade_quote_volume"])
    return x

def rz(s,window,minp=None):
    minp=minp or max(20,window//3)
    mu=s.rolling(window,min_periods=minp).mean(); sd=s.rolling(window,min_periods=minp).std()
    return ((s-mu)/sd.replace(0,np.nan)).clip(-10,10)

def make_features(x):
    z=x.copy()
    w=7*BARS_DAY
    z["basis_z"]=rz(z["basis"],w)
    z["funding_chg"]=z["funding"].diff()
    z["funding_z"]=rz(z["funding_chg"],30*BARS_DAY)
    if "oi" in z:
        z["oi_chg_1h"]=z["oi"].pct_change(12)
        z["oi_z"]=rz(z["oi_chg_1h"],w)
    else:z["oi_z"]=np.nan
    z["imb_z"]=rz(z["taker_imb"],3*BARS_DAY)
    z["range_z"]=rz(z["range"],w)
    z["volume_z"]=rz(z["volume_log"],w)
    if z["long_liq"].notna().any():
        total=z["long_liq"].fillna(0)+z["short_liq"].fillna(0)
        z["liq_z"]=rz(np.log1p(total),30*BARS_DAY)
        z["liq_side"]=(z["short_liq"].fillna(0)-z["long_liq"].fillna(0))/total.replace(0,np.nan)
    else:z["liq_z"]=np.nan; z["liq_side"]=np.nan
    for h in [1,3,12,48]:z[f"fwd_{h}"]=z["trade_open"].shift(-h)/z["trade_open"].shift(-1)-1
    return z

def signal_for(f,rule):
    t=rule.threshold
    if rule.family=="basis_revert":
        raw=np.where(f["basis_z"]>t,-1,np.where(f["basis_z"]<-t,1,0))
    elif rule.family=="funding_revert":
        raw=np.where(f["funding_z"]>t,-1,np.where(f["funding_z"]<-t,1,0))
    elif rule.family=="oi_imb_cont":
        raw=np.where((f["oi_z"]>t)&(f["imb_z"]>t),1,np.where((f["oi_z"]>t)&(f["imb_z"]<-t),-1,0))
    elif rule.family=="oi_imb_revert":
        raw=np.where((f["oi_z"]>t)&(f["imb_z"]>t),-1,np.where((f["oi_z"]>t)&(f["imb_z"]<-t),1,0))
    elif rule.family=="liquidation_revert":
        raw=np.where((f["liq_z"]>t)&(f["liq_side"]>0),-1,np.where((f["liq_z"]>t)&(f["liq_side"]<0),1,0))
    elif rule.family=="liquidation_cont":
        raw=np.where((f["liq_z"]>t)&(f["liq_side"]>0),1,np.where((f["liq_z"]>t)&(f["liq_side"]<0),-1,0))
    elif rule.family=="liquidity_revert":
        raw=np.where((f["range_z"]>t)&(f["volume_z"]>0)&(f["imb_z"]>0),-1,np.where((f["range_z"]>t)&(f["volume_z"]>0)&(f["imb_z"]<0),1,0))
    else: raise ValueError(rule.family)
    return pd.Series(raw,index=f.index,dtype=float)

def simulate(f,rule):
    sig=signal_for(f,rule)
    pos=np.zeros(len(sig)); event=np.zeros(len(sig),dtype=int); cooldown=0
    a=sig.to_numpy()
    for i in range(len(a)-rule.hold_bars-2):
        if cooldown>0: cooldown-=1; continue
        if a[i]!=0:
            pos[i+1:i+1+rule.hold_bars]=a[i]; event[i+1]=1; cooldown=rule.hold_bars
    p=pd.Series(pos,index=f.index)
    turnover=p.diff().abs().fillna(p.abs())
    ret=p*f["ret1"].fillna(0)-ONE_WAY_COST*turnover
    return Sim(ret,p,pd.Series(event,index=f.index))

def stats(sim,start,end=None):
    r=sim.returns.loc[sim.returns.index>=start]
    if end is not None:r=r.loc[r.index<end]
    if r.empty:return {"total_return":0,"cagr":0,"max_dd":0,"sharpe":0,"events":0,"hit_rate":0}
    eq=(1+r).cumprod(); years=max((r.index[-1]-r.index[0]).total_seconds()/31557600,1/365.25)
    ev=sim.events.reindex(r.index).fillna(0).astype(bool)
    event_rets=[]
    starts=np.flatnonzero(ev.to_numpy())
    for i in starts:
        j=min(i+1+int((sim.positions.reindex(r.index).iloc[i:]!=0).cumprod().sum()),len(r))
        event_rets.append(float((1+r.iloc[i:j]).prod()-1))
    sd=r.std()
    return {"total_return":float(eq.iloc[-1]-1),"cagr":float(eq.iloc[-1]**(1/years)-1),"max_dd":float((eq/eq.cummax()-1).min()),"sharpe":float(r.mean()/sd*math.sqrt(ANNUAL)) if sd>0 else 0.0,"events":int(ev.sum()),"hit_rate":float(np.mean(np.array(event_rets)>0)) if event_rets else 0.0}
