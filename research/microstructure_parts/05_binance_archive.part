
# Binance Futures REST can return HTTP 451 on some hosted runners. Historical
# Binance inputs therefore come from Binance's official data.binance.vision
# monthly archives. Aster continues to use its public REST history.
_api_fetch_klines = fetch_klines
_api_fetch_funding = fetch_funding


def _vision_bytes(url: str) -> bytes | None:
    for attempt in range(4):
        try:
            response = SESSION.get(url, timeout=120)
            if response.status_code == 404:
                return None
            response.raise_for_status()
            with zipfile.ZipFile(io.BytesIO(response.content)) as archive:
                names = [n for n in archive.namelist() if n.lower().endswith(".csv")]
                if not names:
                    return None
                return archive.read(names[0])
        except Exception as exc:
            if attempt == 3:
                print(f"WARN Binance Vision failed {url}: {exc}")
                return None
            time.sleep(1.0 + attempt)
    return None


def _vision_kline_frame(raw: bytes) -> pd.DataFrame:
    cols = [
        "open_time", "open", "high", "low", "close", "volume",
        "close_time", "quote_volume", "trades", "taker_buy_base",
        "taker_buy_quote", "ignore",
    ]
    frame = pd.read_csv(io.BytesIO(raw), header=None)
    if frame.empty:
        return pd.DataFrame()
    # Some archives contain a header while older ones do not.
    first = str(frame.iloc[0, 0]).strip().lower()
    if first in {"open_time", "opentime", "open time"} or not first.replace(".", "", 1).isdigit():
        frame = frame.iloc[1:].reset_index(drop=True)
    frame = frame.iloc[:, : min(frame.shape[1], len(cols))]
    frame.columns = cols[: frame.shape[1]]
    numeric_time = pd.to_numeric(frame["open_time"], errors="coerce")
    median = numeric_time.dropna().median()
    unit = "us" if pd.notna(median) and median > 10**14 else "ms"
    frame["timestamp"] = pd.to_datetime(numeric_time, unit=unit, utc=True, errors="coerce")
    for column in ["open", "high", "low", "close", "volume", "quote_volume", "trades", "taker_buy_base", "taker_buy_quote"]:
        if column in frame:
            frame[column] = pd.to_numeric(frame[column], errors="coerce")
    keep = [c for c in ["timestamp", "open", "high", "low", "close", "volume", "quote_volume", "trades", "taker_buy_base", "taker_buy_quote"] if c in frame]
    return frame[keep].dropna(subset=["timestamp", "close"])


def _vision_klines(dataset: str, symbol: str, start: pd.Timestamp, end: pd.Timestamp) -> pd.DataFrame:
    CACHE.mkdir(parents=True, exist_ok=True)
    cached = CACHE / f"vision_{dataset}_{symbol}_{INTERVAL}_{start.date()}_{end.date()}.csv"
    if cached.exists() and cached.stat().st_size > 100:
        return pd.read_csv(cached, parse_dates=["timestamp"]).set_index("timestamp")
    frames = []
    for period in month_iter(start, end):
        stamp = period.strftime("%Y-%m")
        if dataset == "klines":
            filename = f"{symbol}-{INTERVAL}-{stamp}.zip"
        else:
            filename = f"{symbol}-{dataset}-{INTERVAL}-{stamp}.zip"
        url = f"{VISION}/{dataset}/{symbol}/{INTERVAL}/{filename}"
        raw = _vision_bytes(url)
        if raw is None:
            print(f"SKIP Binance Vision {dataset} {symbol} {stamp}")
            continue
        parsed = _vision_kline_frame(raw)
        if not parsed.empty:
            frames.append(parsed)
    if not frames:
        return pd.DataFrame()
    frame = pd.concat(frames, ignore_index=True)
    frame = frame[(frame["timestamp"] >= start) & (frame["timestamp"] < end)]
    frame = frame.drop_duplicates("timestamp", keep="last").sort_values("timestamp")
    frame.to_csv(cached, index=False)
    print(f"binance-vision {symbol} {dataset}: {len(frame):,} bars")
    return frame.set_index("timestamp")


def _vision_funding_frame(raw: bytes) -> pd.DataFrame:
    # Funding archives normally contain named columns, but tolerate positional CSVs.
    named = pd.read_csv(io.BytesIO(raw))
    lower = {str(c).strip().lower(): c for c in named.columns}
    time_candidates = [original for key, original in lower.items() if "time" in key]
    rate_candidates = [original for key, original in lower.items() if "rate" in key and "interval" not in key]
    if time_candidates and rate_candidates:
        time_values = pd.to_numeric(named[time_candidates[0]], errors="coerce")
        rate_values = pd.to_numeric(named[rate_candidates[0]], errors="coerce")
    else:
        positional = pd.read_csv(io.BytesIO(raw), header=None)
        if positional.shape[1] < 2:
            return pd.DataFrame()
        time_values = pd.to_numeric(positional.iloc[:, 0], errors="coerce")
        # Current archive format is timestamp, interval-hours, funding rate.
        rate_index = 2 if positional.shape[1] >= 3 else 1
        rate_values = pd.to_numeric(positional.iloc[:, rate_index], errors="coerce")
    median = time_values.dropna().median()
    unit = "us" if pd.notna(median) and median > 10**14 else "ms"
    result = pd.DataFrame({
        "timestamp": pd.to_datetime(time_values, unit=unit, utc=True, errors="coerce"),
        "funding_rate": rate_values,
    })
    return result.dropna().drop_duplicates("timestamp").sort_values("timestamp")


def _vision_funding(symbol: str, start: pd.Timestamp, end: pd.Timestamp) -> pd.DataFrame:
    CACHE.mkdir(parents=True, exist_ok=True)
    cached = CACHE / f"vision_funding_{symbol}_{start.date()}_{end.date()}.csv"
    if cached.exists() and cached.stat().st_size > 50:
        return pd.read_csv(cached, parse_dates=["timestamp"]).set_index("timestamp")
    frames = []
    for period in month_iter(start, end):
        stamp = period.strftime("%Y-%m")
        url = f"{VISION}/fundingRate/{symbol}/{symbol}-fundingRate-{stamp}.zip"
        raw = _vision_bytes(url)
        if raw is None:
            print(f"SKIP Binance Vision funding {symbol} {stamp}")
            continue
        parsed = _vision_funding_frame(raw)
        if not parsed.empty:
            frames.append(parsed)
    if not frames:
        return pd.DataFrame()
    frame = pd.concat(frames, ignore_index=True)
    frame = frame[(frame["timestamp"] >= start) & (frame["timestamp"] < end)]
    frame = frame.drop_duplicates("timestamp", keep="last").sort_values("timestamp")
    frame.to_csv(cached, index=False)
    print(f"binance-vision {symbol} funding: {len(frame):,} rows")
    return frame.set_index("timestamp")


def fetch_klines(base: str, endpoint: str, symbol: str, start: pd.Timestamp, end: pd.Timestamp) -> pd.DataFrame:
    if base == BINANCE:
        dataset = "markPriceKlines" if endpoint.endswith("markPriceKlines") else "klines"
        return _vision_klines(dataset, symbol, start, end)
    return _api_fetch_klines(base, endpoint, symbol, start, end)


def fetch_funding(base: str, symbol: str, start: pd.Timestamp, end: pd.Timestamp) -> pd.DataFrame:
    if base == BINANCE:
        return _vision_funding(symbol, start, end)
    return _api_fetch_funding(base, symbol, start, end)
