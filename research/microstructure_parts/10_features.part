

def venue_symbol_available(base: str, symbol: str) -> bool:
    payload = get_json(base + "/fapi/v1/exchangeInfo")
    if not payload:
        return False
    return any(x.get("symbol") == symbol and x.get("status", "TRADING") in ("TRADING", "PENDING_TRADING") for x in payload.get("symbols", []))


def align_funding(frame: pd.DataFrame, index: pd.DatetimeIndex, name: str) -> pd.Series:
    if frame.empty:
        return pd.Series(np.nan, index=index, name=name)
    s = frame["funding_rate"].sort_index().reindex(index, method="ffill", tolerance=pd.Timedelta("12h"))
    s.name = name
    return s


def rolling_z(s: pd.Series, bars: int = 7 * 24 * 12, min_bars: int = 3 * 24 * 12) -> pd.Series:
    mean = s.rolling(bars, min_periods=min_bars).mean()
    std = s.rolling(bars, min_periods=min_bars).std(ddof=0).replace(0, np.nan)
    return ((s - mean) / std).clip(-8, 8)


def safe_flow(frame: pd.DataFrame) -> pd.Series:
    if "taker_buy_quote" not in frame or "quote_volume" not in frame:
        return pd.Series(np.nan, index=frame.index)
    q = frame["quote_volume"].replace(0, np.nan)
    return (2.0 * frame["taker_buy_quote"] / q - 1.0).clip(-1, 1)


def load_symbol(symbol: str) -> tuple[pd.DataFrame, dict]:
    coverage = {"symbol": symbol}
    if not venue_symbol_available(ASTER, symbol):
        coverage.update({"status": "not_listed_on_aster"})
        return pd.DataFrame(), coverage
    a = fetch_klines(ASTER, "/fapi/v1/klines", symbol, START, END)
    am = fetch_klines(ASTER, "/fapi/v1/markPriceKlines", symbol, START, END)
    b = fetch_klines(BINANCE, "/fapi/v1/klines", symbol, START, END)
    bm = fetch_klines(BINANCE, "/fapi/v1/markPriceKlines", symbol, START, END)
    af = fetch_funding(ASTER, symbol, START, END)
    bf = fetch_funding(BINANCE, symbol, START, END)
    met = fetch_binance_metrics(symbol, START, END)
    liq = fetch_binance_liquidations(symbol, START, END)
    coverage.update({
        "aster_bars": len(a), "binance_bars": len(b), "aster_mark_bars": len(am),
        "binance_mark_bars": len(bm), "aster_funding_rows": len(af),
        "binance_funding_rows": len(bf), "metrics_rows": len(met),
        "liquidation_rows": len(liq),
    })
    if a.empty or b.empty:
        coverage["status"] = "missing_core_price_data"
        return pd.DataFrame(), coverage
    index = a.index.intersection(b.index)
    index = index[(index >= START) & (index < END)]
    if len(index) < 30 * 24 * 12:
        coverage["status"] = "insufficient_overlap"
        return pd.DataFrame(), coverage
    df = pd.DataFrame(index=index)
    for prefix, frame in [("a", a), ("b", b)]:
        for c in ["open", "high", "low", "close", "quote_volume", "trades", "taker_buy_quote"]:
            if c in frame:
                df[f"{prefix}_{c}"] = frame[c].reindex(index)
        df[f"{prefix}_flow"] = safe_flow(frame).reindex(index)
    df["a_mark"] = am["close"].reindex(index).ffill() if not am.empty else np.nan
    df["b_mark"] = bm["close"].reindex(index).ffill() if not bm.empty else np.nan
    df["a_funding"] = align_funding(af, index, "a_funding")
    df["b_funding"] = align_funding(bf, index, "b_funding")
    if not met.empty:
        met5 = met.resample("5min").last().reindex(index, method="ffill", tolerance=pd.Timedelta("15min"))
        for c in met5.columns:
            df[f"b_{c}"] = met5[c]
    if not liq.empty:
        l5 = liq.resample("5min").sum().reindex(index).fillna(0.0)
        df["long_liq"] = l5["long_liq"]
        df["short_liq"] = l5["short_liq"]
    else:
        df["long_liq"] = np.nan
        df["short_liq"] = np.nan
    coverage["start"] = str(index.min())
    coverage["end"] = str(index.max())
    coverage["status"] = "ok"
    return build_features(df), coverage


def build_features(df: pd.DataFrame) -> pd.DataFrame:
    out = df.copy()
    out["a_ret"] = np.log(out["a_close"]).diff()
    out["b_ret"] = np.log(out["b_close"]).diff()
    out["a_ret_15m"] = np.log(out["a_close"] / out["a_close"].shift(3))
    out["b_ret_15m"] = np.log(out["b_close"] / out["b_close"].shift(3))
    out["a_ret_1h"] = np.log(out["a_close"] / out["a_close"].shift(12))
    out["b_ret_1h"] = np.log(out["b_close"] / out["b_close"].shift(12))

    # Cross-venue trade and mark-price dislocations.
    out["price_gap_bps"] = 1e4 * np.log(out["a_close"] / out["b_close"])
    out["price_gap_z"] = rolling_z(out["price_gap_bps"])
    out["aster_basis_bps"] = 1e4 * (out["a_mark"] / out["a_close"] - 1.0)
    out["binance_basis_bps"] = 1e4 * (out["b_mark"] / out["b_close"] - 1.0)
    out["basis_gap_bps"] = out["aster_basis_bps"] - out["binance_basis_bps"]
    out["basis_gap_z"] = rolling_z(out["basis_gap_bps"])

    # Funding innovations. Historical API exposes settled/latest rates, not the full
    # intra-period prediction path; therefore this is a conservative proxy.
    out["funding_gap"] = out["a_funding"] - out["b_funding"]
    out["funding_gap_z"] = rolling_z(out["funding_gap"], 30 * 24 * 12, 10 * 24 * 12)
    out["a_funding_jump"] = out["a_funding"].diff(96)  # change versus prior 8h block
    out["funding_jump_z"] = rolling_z(out["a_funding_jump"], 30 * 24 * 12, 10 * 24 * 12)

    # Aggressive-flow imbalance from taker-buy quote volume.
    out["flow_mean"] = 0.5 * (out["a_flow"] + out["b_flow"])
    out["flow_diff"] = out["b_flow"] - out["a_flow"]
    out["flow_mean_z"] = rolling_z(out["flow_mean"], 3 * 24 * 12, 24 * 12)
    out["flow_diff_z"] = rolling_z(out["flow_diff"], 3 * 24 * 12, 24 * 12)

    # Binance leads Aster when Binance has already moved but Aster has not.
    out["lead_residual"] = out["b_ret_15m"] - out["a_ret_15m"]
    out["lead_residual_z"] = rolling_z(out["lead_residual"], 7 * 24 * 12, 3 * 24 * 12)

    # Range/volume proxy. It is explicitly not called historical spread/depth.
    out["range_illiquidity"] = ((out["a_high"] - out["a_low"]) / out["a_close"]) / np.sqrt(out["a_quote_volume"].clip(lower=1.0))
    out["illiquidity_z"] = rolling_z(np.log(out["range_illiquidity"].clip(lower=1e-14)), 7 * 24 * 12, 3 * 24 * 12)

    if "b_open_interest_value" in out:
        out["oi_change_1h"] = np.log(out["b_open_interest_value"] / out["b_open_interest_value"].shift(12))
        out["oi_change_z"] = rolling_z(out["oi_change_1h"], 14 * 24 * 12, 5 * 24 * 12)
    elif "b_open_interest" in out:
        out["oi_change_1h"] = np.log(out["b_open_interest"] / out["b_open_interest"].shift(12))
        out["oi_change_z"] = rolling_z(out["oi_change_1h"], 14 * 24 * 12, 5 * 24 * 12)
    else:
        out["oi_change_1h"] = np.nan
        out["oi_change_z"] = np.nan

    if out[["long_liq", "short_liq"]].notna().any().any():
        total = out["long_liq"].fillna(0) + out["short_liq"].fillna(0)
        out["liq_direction"] = (out["short_liq"].fillna(0) - out["long_liq"].fillna(0)) / total.replace(0, np.nan)
        med = total.rolling(7 * 24 * 12, min_periods=24 * 12).median().replace(0, np.nan)
        out["liq_intensity"] = np.log1p(total / med)
        out["liq_intensity_z"] = rolling_z(out["liq_intensity"], 14 * 24 * 12, 5 * 24 * 12)
    else:
        out["liq_direction"] = np.nan
        out["liq_intensity"] = np.nan
        out["liq_intensity_z"] = np.nan

    # Pre-specified directional sleeves. Positive means long Aster.
    out["sig_price_mr"] = -out["price_gap_z"]
    out["sig_basis_mr"] = -out["basis_gap_z"]
    out["sig_funding_contra"] = -0.5 * out["funding_gap_z"] - 0.5 * out["funding_jump_z"]
    out["sig_flow_cont"] = out["flow_mean_z"]
    out["sig_lead_follow"] = out["lead_residual_z"]
    out["sig_oi_cont"] = np.sign(out["b_ret_1h"]) * out["oi_change_z"].clip(lower=0)
    aligned = np.sign(out["b_ret_1h"]) * np.sign(out["flow_mean"])
    out.loc[aligned < 0, "sig_oi_cont"] *= -1.0
    out["sig_liq_cont"] = out["liq_direction"] * out["liq_intensity_z"].clip(lower=0)
    out["sig_liq_reversal"] = -out["sig_liq_cont"].shift(3)

    # High illiquidity suppresses entries rather than supplying direction.
    out["liquidity_multiplier"] = np.where(out["illiquidity_z"] > 2.5, 0.25, np.where(out["illiquidity_z"] > 1.5, 0.60, 1.0))
    return out.replace([np.inf, -np.inf], np.nan)
