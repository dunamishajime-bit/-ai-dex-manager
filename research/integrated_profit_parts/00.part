def periods() -> list[pd.Period]:
    return list(pd.period_range(START_MONTH, END_MONTH, freq="M"))


def parse_timestamp(values: pd.Series) -> pd.Series:
    numeric = pd.to_numeric(values, errors="coerce")
    if numeric.notna().sum() == 0:
        return pd.to_datetime(values, utc=True, errors="coerce")
    median = numeric.dropna().median()
    if median > 10**16:
        unit = "ns"
    elif median > 10**13:
        unit = "us"
    elif median > 10**11:
        unit = "ms"
    else:
        unit = "s"
    return pd.to_datetime(numeric, unit=unit, utc=True, errors="coerce")


def parse_funding_csv(raw: bytes) -> pd.DataFrame:
    named = pd.read_csv(io.BytesIO(raw))
    named.columns = [str(c).strip().lower() for c in named.columns]
    tcols = [c for c in named.columns if "time" in c]
    rcols = [c for c in named.columns if "rate" in c and "interval" not in c]
    if tcols and rcols:
        times = named[tcols[0]]
        rates = named[rcols[0]]
    else:
        positional = pd.read_csv(io.BytesIO(raw), header=None)
        if positional.shape[1] < 2:
            return pd.DataFrame(columns=["timestamp", "funding_rate"])
        times = positional.iloc[:, 0]
        rates = positional.iloc[:, 2 if positional.shape[1] >= 3 else 1]
    out = pd.DataFrame({
        "timestamp": parse_timestamp(times),
        "funding_rate": pd.to_numeric(rates, errors="coerce"),
    }).dropna()
    out = out.loc[out["funding_rate"].abs() < 0.05]
    return out.drop_duplicates("timestamp", keep="last").sort_values("timestamp")


def funding_one(symbol: str, period: pd.Period) -> tuple[str, pd.DataFrame | None]:
    FUNDING_CACHE.mkdir(parents=True, exist_ok=True)
    stamp = period.strftime("%Y-%m")
    cached = FUNDING_CACHE / f"{symbol}-funding-{stamp}.csv"
    if cached.exists() and cached.stat().st_size > 0:
        frame = pd.read_csv(cached, parse_dates=["timestamp"])
        frame["timestamp"] = pd.to_datetime(frame["timestamp"], utc=True)
