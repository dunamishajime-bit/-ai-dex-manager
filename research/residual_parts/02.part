    w = 1 / x
    return sign * w / w.sum() * gross


def targets(panel: dict[str, pd.DataFrame], c: Candidate) -> pd.DataFrame:
    close, volume, logret, funding = panel["close"], panel["quote_volume"], panel["logret"], panel["funding"]
    out = pd.DataFrame(0.0, index=close.index, columns=close.columns)
    warm = max(180, c.beta_days, c.slow_days) * BPD
    step = c.rebalance_days * BPD
    for i in range(warm, len(close) - 1):
        if i % step:
            out.iloc[i] = out.iloc[i - 1]
            continue
        hist_ok = close.iloc[max(0, i - 150 * BPD):i].notna().sum() >= 120 * BPD
        available = [s for s in ALTS if s in close and bool(hist_ok.get(s, False)) and pd.notna(close.iloc[i].get(s))]
        if len(available) < 5:
            out.iloc[i] = out.iloc[i - 1]
            continue
        liquid = volume.iloc[max(0, i - 30 * BPD):i][available].median().nlargest(min(7, len(available))).index.tolist()
        hist = logret.iloc[max(0, i - c.beta_days * BPD):i][HEDGES + liquid]
        betas, residuals, eth_beta = factors(hist, liquid)
        score, rvol = score_snapshot(residuals, funding, volume, i, c)
        score = score.reindex(liquid).dropna().sort_values()
        if len(score) < 2 * c.k:
            out.iloc[i] = out.iloc[i - 1]
            continue
        shorts = [s for s in score.head(c.k).index if score[s] < -0.10]
        longs = [s for s in score.tail(c.k).index if score[s] > 0.10]
        if not longs or not shorts:
            out.iloc[i] = out.iloc[i - 1] * 0.5
            continue
        w = pd.Series(0.0, index=close.columns)
        lw, sw = invvol(longs, rvol, 0.5, 1), invvol(shorts, rvol, 0.5, -1)
        w.loc[lw.index], w.loc[sw.index] = lw, sw
        e1 = sum(w[s] * betas.get(s, (0, 0))[0] for s in liquid)
        e2 = sum(w[s] * betas.get(s, (0, 0))[1] for s in liquid)
        w["ETHUSDT"] = -e2
        w["BTCUSDT"] = -e1 + e2 * eth_beta
        active = w[w.abs() > 1e-10].index
        h = panel["asset_return"].iloc[max(0, i - 45 * BPD):i][active].dropna(how="all")
        if len(active) >= 2 and len(h) >= 30:
            cov = h.cov().fillna(0).to_numpy(float) * ANNUAL
            vec = w[active].to_numpy(float)
            est = math.sqrt(max(float(vec @ cov @ vec), 1e-10))
            w *= min(c.target_vol / est, 3.0)
        gross = float(w.abs().sum())
        if gross > c.max_gross:
            w *= c.max_gross / gross
        w = w.clip(-c.max_weight, c.max_weight)
        prev = out.iloc[i - 1]
        w.loc[(w - prev).abs() < 0.025] = prev.loc[(w - prev).abs() < 0.025]
        out.iloc[i] = w
    return out.ffill().fillna(0.0)


def simulate(panel: dict[str, pd.DataFrame], target: pd.DataFrame, scale=1.0, cost=COST, funding_mult=1.0, overlay=True) -> Sim:
    planned = (target.shift(1).fillna(0) * scale).clip(-0.8, 0.8)
    p, rr, fr = planned.to_numpy(float), panel["asset_return"].reindex_like(planned).fillna(0).to_numpy(float), panel["funding"].reindex_like(planned).fillna(0).to_numpy(float)
    ret = np.zeros(len(planned)); turn = np.zeros(len(planned)); tc = np.zeros(len(planned)); fp = np.zeros(len(planned)); dm = np.ones(len(planned)); actual = np.zeros_like(p)
    eq = peak = 1.0; prev = np.zeros(planned.shape[1])
    for i in range(len(planned)):
        dd = eq / peak - 1
        mult = 1.0
        if overlay:
            mult = 0.25 if dd <= -0.30 else 0.50 if dd <= -0.20 else 0.75 if dd <= -0.12 else 1.0
        pos = p[i] * mult
        t = float(np.abs(pos - prev).sum()); trade = cost * t; fund = -float(np.nansum(pos * fr[i])) * funding_mult
        r = max(float(np.nansum(pos * rr[i])) - trade + fund, -0.95)
        ret[i], turn[i], tc[i], fp[i], dm[i], actual[i] = r, t, trade, fund, mult, pos
        eq *= 1 + r; peak = max(peak, eq); prev = pos
    rs = pd.Series(ret, index=planned.index, name="strategy_return")
    return Sim(rs, (1 + rs).cumprod(), pd.DataFrame(actual, index=planned.index, columns=planned.columns), pd.Series(turn, index=planned.index), pd.Series(tc, index=planned.index), pd.Series(fp, index=planned.index), pd.Series(dm, index=planned.index))


def cut(s: pd.Series, start: pd.Timestamp, end: pd.Timestamp | None = None) -> pd.Series:
    return s.loc[s.index >= start] if end is None else s.loc[(s.index >= start) & (s.index < end)]


def stats(sim: Sim, start: pd.Timestamp, end: pd.Timestamp | None = None) -> dict:
    r = cut(sim.returns, start, end); eq = (1 + r).cumprod(); monthly = (1 + r).resample("ME").prod() - 1
    years = max((r.index[-1] - r.index[0]).total_seconds() / (365.25 * 86400), 1 / 365.25)
    sd = float(r.std(ddof=1)); downside = float(np.sqrt((r.where(r < 0, 0) ** 2).mean()))
    pos = sim.positions.loc[r.index]
    return {
        "total_return": float((1 + r).prod() - 1),
        "cagr": float((1 + r).prod() ** (1 / years) - 1) if float((1 + r).prod()) > 0 else -1,
        "max_drawdown": float((eq / eq.cummax() - 1).min()),
        "sharpe": float(r.mean() / sd * math.sqrt(ANNUAL)) if sd > 0 else float("nan"),
        "sortino": float(r.mean() / downside * math.sqrt(ANNUAL)) if downside > 0 else float("nan"),
        "best_month": float(monthly.max()), "worst_month": float(monthly.min()), "median_month": float(monthly.median()),
        "positive_month_ratio": float((monthly > 0).mean()), "months_ge_50pct": int((monthly >= 0.5).sum()),
        "annual_turnover": float(cut(sim.turnover, start, end).sum() / years),
        "average_gross": float(pos.abs().sum(axis=1).mean()), "average_net": float(pos.sum(axis=1).mean()),
        "trading_cost_total": float(cut(sim.trading_cost, start, end).sum()), "funding_pnl_total": float(cut(sim.funding_pnl, start, end).sum()),
    }


def select_score(st: dict, annual: pd.Series) -> float:
    if len(annual) < 3:
        return -999
    return 1.2 * float(annual.median()) + 0.75 * float(annual.min()) + 0.55 * st["cagr"] + 0.12 * np.nan_to_num(st["sharpe"], nan=-3) + 0.08 * np.nan_to_num(st["sortino"], nan=-3) + 0.8 * st["max_drawdown"] - 0.0008 * st["annual_turnover"]


def pct(x: float) -> str:
    return "n/a" if not np.isfinite(x) else f"{x * 100:.2f}%"


def num(x: float) -> str:
    return "n/a" if not np.isfinite(x) else f"{x:.2f}"


def table(rows: list[dict], cols: list[tuple[str, str, str]]) -> str:
    lines = ["| " + " | ".join(x[1] for x in cols) + " |", "| " + " | ".join("---" for _ in cols) + " |"]
    for row in rows:
        vals = []
        for key, _, kind in cols:
            v = row[key]
            vals.append(pct(float(v)) if kind == "pct" else num(float(v)) if kind == "num" else str(v))
        lines.append("| " + " | ".join(vals) + " |")
    return "\n".join(lines)
