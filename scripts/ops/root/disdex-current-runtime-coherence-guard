#!/usr/bin/env bash
set -Eeuo pipefail

umask 077
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

TRADING_ROOT="${DISDEX_TRADING_ROOT:-/home/deploy/disdex-trading}"
TRADING_RELEASES="${TRADING_ROOT}/releases"
TRADING_CURRENT="${TRADING_ROOT}/current"
RUNTIME_ENV_DIR="/etc/disdex/current-runtime"
HEALTH_DROPIN="/etc/systemd/system/disdex-runner-health-snapshot.service.d/zzzzzzzzzzzzzzzzzzzz-current-release.conf"
WATCHDOG_DROPIN="/etc/systemd/system/disdex-runner-watchdog.service.d/zzzzzzzzzzzzzzzzzzzz-current-release.conf"
ALERT_DROPIN="/etc/systemd/system/disdex-runner-health-alert.service.d/zzzzzzzzzzzzzzzzzzzz-current-release.conf"
V4_OPERATOR_ACTIVATION_PATH="/var/lib/disdex/shared/operator-activation/v12-v4-full.json"
MONITOR_RUNTIME_SHA=""
MONITOR_RUNTIME_ROOT=""

FAMILIES=(
  "disdex-v12-x1-all"
  "disdex-pengu-dual-ls-v2"
  "disdex-quality102-causal-v1"
  "disdex-v52-aster-only"
  "disdex-fet-brk48"
  "disdex-hype-long"
  "disdex-idle-priority-short"
  "disdex-shared-crypto-risk"
  "disdex-v12-v52-margin-guard"
)
HEARTBEATS=(
  "v12-x1-all.json"
  "pengu-v8.json"
  "quality102-causal-v1.json"
  "v52.json"
  "fet-brk48-residual.json"
  "hype-trend-long.json"
  "idle-priority-short.json"
)
LEGACY_LIVE_UNITS=(
  "disdex-v96-live.service"
  "disdex-v96-v52-live.service"
  "disdex-v13d-v11eq-v96.service"
  "disdex-v46-live.service"
  "disdex-pengu-dual-ls-v2-v20.service"
  "disdex-v12-x1-all.service"
  "disdex-pengu-dual-ls-v2.service"
  "disdex-quality102-causal-v1.service"
  "disdex-fet-brk48.service"
  "disdex-v52-aster-only.service"
  "disdex-shared-crypto-risk.service"
  "disdex-v12-v52-margin-guard.service"
  "disdex-idle-priority-short.service"
)
declare -A EXPECTED_SHA_BY_UNIT=()
declare -A EXPECTED_ROOT_BY_UNIT=()

usage() { printf '%s\n' 'Usage: disdex-current-runtime-coherence-guard [--check|--repair|--auto]'; }

resolve_current() {
  [[ -L "$TRADING_CURRENT" ]] || { echo "current symlink missing" >&2; return 1; }
  CURRENT_RELEASE="$(readlink -f -- "$TRADING_CURRENT")"
  [[ "$CURRENT_RELEASE" == "$TRADING_RELEASES"/* ]] || { echo "current outside release root" >&2; return 1; }
  DEPLOYED_SHA="$(basename -- "$CURRENT_RELEASE")"
  [[ "$DEPLOYED_SHA" =~ ^[0-9a-f]{40}$ ]] || { echo "current is not exact SHA" >&2; return 1; }
  [[ "$(tr -d '[:space:]' < "$CURRENT_RELEASE/.disdex-release-sha")" == "$DEPLOYED_SHA" ]] || {
    echo "current release marker mismatch" >&2
    return 1
  }
  HEALTH_ENV="$RUNTIME_ENV_DIR/$DEPLOYED_SHA.health-snapshot.env"
  WATCHDOG_ENV="$RUNTIME_ENV_DIR/$DEPLOYED_SHA.watchdog.env"
  PRIMARY_V12_MODE_FILE="$RUNTIME_ENV_DIR/$DEPLOYED_SHA.v12-primary.env"
  PRIMARY_V12_MODE="LEGACY"
  if [[ -f "$PRIMARY_V12_MODE_FILE" ]]; then
    PRIMARY_V12_MODE="$(sed -n 's/^DISDEX_PRIMARY_V12_RUNNER=//p' "$PRIMARY_V12_MODE_FILE" | tail -n1)"
  fi
  [[ "$PRIMARY_V12_MODE" == "LEGACY" || "$PRIMARY_V12_MODE" == "V4" ]] || {
    echo "invalid primary V12 mode" >&2
    return 1
  }
  if [[ "$PRIMARY_V12_MODE" == "V4" ]]; then
    V4_PRIMARY_SHA="$(sed -n 's/^DISDEX_V12_V4_PRIMARY_SHA=//p' "$PRIMARY_V12_MODE_FILE" | tail -n1)"
    [[ "$V4_PRIMARY_SHA" =~ ^[0-9a-f]{40}$ ]] || { echo "V4 primary SHA pin is missing or invalid" >&2; return 1; }
    V4_PRIMARY_RELEASE="$TRADING_RELEASES/$V4_PRIMARY_SHA"
    [[ -d "$V4_PRIMARY_RELEASE" && ! -L "$V4_PRIMARY_RELEASE" && -f "$V4_PRIMARY_RELEASE/.disdex-release-sha" && ! -L "$V4_PRIMARY_RELEASE/.disdex-release-sha" ]] || { echo "V4 primary release or marker is missing or unsafe" >&2; return 1; }
    [[ "$(tr -d '[:space:]' < "$V4_PRIMARY_RELEASE/.disdex-release-sha")" == "$V4_PRIMARY_SHA" ]] || {
      echo "V4 primary release marker mismatch" >&2
      return 1
    }
    FAMILIES[0]="disdex-v12-v4"
    HEARTBEATS[0]="v12-v4.json"
    MONITOR_RUNTIME_SHA="$V4_PRIMARY_SHA"
    MONITOR_RUNTIME_ROOT="$V4_PRIMARY_RELEASE"
    V12_EXPECTED_UNIT="disdex-v12-v4@$V4_PRIMARY_SHA.service"
    V12_OPERATOR_RUNNER="V12_V4"
  else
    V4_PRIMARY_SHA=""
    V4_PRIMARY_RELEASE=""
    MONITOR_RUNTIME_SHA="$DEPLOYED_SHA"
    MONITOR_RUNTIME_ROOT="$CURRENT_RELEASE"
    FAMILIES[0]="disdex-v12-x1-all"
    HEARTBEATS[0]="v12-x1-all.json"
    V12_EXPECTED_UNIT="disdex-v12-x1-all@$DEPLOYED_SHA.service"
    V12_OPERATOR_RUNNER="V12_X1_ALL"
  fi
  build_current_units
}

build_current_units() {
  CURRENT_UNITS=()
  HEARTBEAT_EXPECTED_SHAS=()
  EXPECTED_SHA_BY_UNIT=()
  EXPECTED_ROOT_BY_UNIT=()
  local index family sha root unit
  for index in "${!FAMILIES[@]}"; do
    family="${FAMILIES[$index]}"
    sha="$DEPLOYED_SHA"
    root="$CURRENT_RELEASE"
    if [[ "$PRIMARY_V12_MODE" == "V4" && "$index" -eq 0 ]]; then
      sha="$V4_PRIMARY_SHA"
      root="$V4_PRIMARY_RELEASE"
    fi
    unit="${family}@${sha}.service"
    CURRENT_UNITS+=("$unit")
    EXPECTED_SHA_BY_UNIT["$unit"]="$sha"
    EXPECTED_ROOT_BY_UNIT["$unit"]="$root"
    if [[ "$index" -lt "${#HEARTBEATS[@]}" ]]; then HEARTBEAT_EXPECTED_SHAS+=("$sha"); fi
  done
}

is_expected_unit() {
  [[ -n "${EXPECTED_SHA_BY_UNIT[$1]:-}" ]]
}

exec_start_matches_expected_root() {
  local unit="$1" expected_root="$2" exec_start="$3"
  [[ "$exec_start" == *"$expected_root/"* ]] && return 0

  # Margin Guard is intentionally launched by the system Python interpreter
  # with a relative script from its release-bound WorkingDirectory.  The
  # WorkingDirectory, /proc/<pid>/cwd, and release-marker checks below remain
  # mandatory; accept only this exact unit/script form here, never arbitrary
  # system-Python commands for other runtime units.
  if [[ "$unit" =~ ^disdex-v12-v52-margin-guard@[0-9a-f]{40}\.service$ ]] \
    && [[ "$exec_start" == *"/usr/bin/python3"* ]] \
    && [[ "$exec_start" == *"scripts/disdex_v96_v52_margin_guard_runtime.py"* ]]; then
    return 0
  fi
  return 1
}

verify_current_units_active() {
  local unit pid cwd expected_root expected_sha working_directory exec_start marker
  for unit in "${CURRENT_UNITS[@]}"; do
    [[ "$(systemctl show "$unit" -p LoadState --value 2>/dev/null || true)" == "loaded" ]] || return 1
    [[ "$(systemctl show "$unit" -p ActiveState --value 2>/dev/null || true)" == "active" ]] || return 1
    [[ "$(systemctl show "$unit" -p SubState --value 2>/dev/null || true)" == "running" ]] || return 1
    pid="$(systemctl show "$unit" -p MainPID --value 2>/dev/null || true)"
    [[ "$pid" =~ ^[1-9][0-9]*$ ]] || return 1
    expected_root="${EXPECTED_ROOT_BY_UNIT[$unit]}"
    expected_sha="${EXPECTED_SHA_BY_UNIT[$unit]}"
    working_directory="$(systemctl show "$unit" -p WorkingDirectory --value 2>/dev/null || true)"
    [[ "$working_directory" == "$expected_root" ]] || return 1
    exec_start="$(systemctl show "$unit" -p ExecStart --value 2>/dev/null || true)"
    exec_start_matches_expected_root "$unit" "$expected_root" "$exec_start" || return 1
    cwd="$(readlink -f -- "/proc/$pid/cwd" 2>/dev/null || true)"
    [[ "$cwd" == "$expected_root" ]] || return 1
    marker="$(tr -d '[:space:]' < "$expected_root/.disdex-release-sha" 2>/dev/null || true)"
    [[ "$marker" == "$expected_sha" ]] || return 1
  done
}

verify_current_units_enabled() {
  local unit
  for unit in "${CURRENT_UNITS[@]}"; do
    [[ "$(systemctl is-enabled "$unit" 2>/dev/null || true)" == "enabled" ]] || return 1
  done
}

list_stale_noninactive_units() {
  local unit active
  while read -r unit _; do
    [[ "$unit" =~ ^disdex-(v12-x1-all|v12-v4|v12-v4-canary|pengu-dual-ls-v2|quality102-causal-v1|v52-aster-only|fet-brk48|hype-long|idle-priority-short|shared-crypto-risk|v12-v52-margin-guard)@([0-9a-f]{40})\.service$ ]] || continue
    is_expected_unit "$unit" && continue
    active="$(systemctl show "$unit" -p ActiveState --value 2>/dev/null || true)"
    [[ "$active" == "inactive" || "$active" == "failed" || -z "$active" ]] && continue
    printf '%s\n' "$unit"
  done < <(systemctl list-units --all --type=service --no-legend --no-pager 2>/dev/null || true)
}

list_stale_enabled_units() {
  local link unit
  for link in /etc/systemd/system/multi-user.target.wants/disdex-*@*.service; do
    [[ -L "$link" ]] || continue
    unit="$(basename "$link")"
    [[ "$unit" =~ ^disdex-(v12-x1-all|v12-v4|v12-v4-canary|pengu-dual-ls-v2|quality102-causal-v1|v52-aster-only|fet-brk48|hype-long|idle-priority-short|shared-crypto-risk|v12-v52-margin-guard)@([0-9a-f]{40})\.service$ ]] || continue
    is_expected_unit "$unit" && continue
    printf '%s\n' "$unit"
  done
}

legacy_units_inactive() {
  local unit state
  for unit in "${LEGACY_LIVE_UNITS[@]}"; do
    state="$(systemctl show "$unit" -p ActiveState --value 2>/dev/null || true)"
    [[ "$state" != "active" && "$state" != "activating" && "$state" != "deactivating" ]] || return 1
  done
}

monitor_pins_current() {
  [[ -f "$HEALTH_ENV" && -f "$WATCHDOG_ENV" && -f "$HEALTH_DROPIN" && -f "$WATCHDOG_DROPIN" && -f "$ALERT_DROPIN" ]] || return 1
  grep -Fxq "DISDEX_HEALTH_SNAPSHOT_EXPECTED_SHA=$MONITOR_RUNTIME_SHA" "$HEALTH_ENV" || return 1
  grep -Fxq "DISDEX_HEALTH_SNAPSHOT_RELEASE_ROOT=$MONITOR_RUNTIME_ROOT" "$HEALTH_ENV" || return 1
  grep -Fxq "DISDEX_WATCHDOG_EXPECTED_SHA=$MONITOR_RUNTIME_SHA" "$WATCHDOG_ENV" || return 1
  grep -Fxq "DISDEX_WATCHDOG_APPROVED_SHA=$MONITOR_RUNTIME_SHA" "$WATCHDOG_ENV" || return 1
  grep -Fxq "DISDEX_WATCHDOG_RELEASE_ROOT=$MONITOR_RUNTIME_ROOT" "$WATCHDOG_ENV" || return 1
  local sleeve
  for sleeve in V12 PENGU V52 Q102 FET HYPE IDLE; do
    local expected_sha="$DEPLOYED_SHA"
    if [[ "$PRIMARY_V12_MODE" == "V4" && "$sleeve" == "V12" ]]; then expected_sha="$V4_PRIMARY_SHA"; fi
    grep -Fxq "DISDEX_HEALTH_SNAPSHOT_${sleeve}_EXPECTED_SHA=$expected_sha" "$HEALTH_ENV" || return 1
    grep -Fxq "DISDEX_WATCHDOG_${sleeve}_EXPECTED_SHA=$expected_sha" "$WATCHDOG_ENV" || return 1
  done
  grep -Fq "EnvironmentFile=$HEALTH_ENV" "$HEALTH_DROPIN" || return 1
  grep -Fq "WorkingDirectory=$MONITOR_RUNTIME_ROOT" "$HEALTH_DROPIN" || return 1
  grep -Fq "EnvironmentFile=$WATCHDOG_ENV" "$WATCHDOG_DROPIN" || return 1
  grep -Fq "WorkingDirectory=$MONITOR_RUNTIME_ROOT" "$WATCHDOG_DROPIN" || return 1
  grep -Fq "ExecStart=/usr/bin/node $MONITOR_RUNTIME_ROOT/scripts/ops/root/disdex-runner-watchdog-current.mjs" "$WATCHDOG_DROPIN" || return 1
  grep -Fq "ExecStart=/usr/bin/node $MONITOR_RUNTIME_ROOT/scripts/ops/root/disdex-runner-health-snapshot-current.mjs" "$HEALTH_DROPIN" || return 1
  grep -Fxq "DISDEX_HEALTH_SNAPSHOT_SHARED_RISK_SERVICE_UNIT=disdex-shared-crypto-risk@$DEPLOYED_SHA.service" "$HEALTH_ENV" || return 1
  grep -Fxq "DISDEX_HEALTH_SNAPSHOT_MARGIN_SERVICE_UNIT=disdex-v12-v52-margin-guard@$DEPLOYED_SHA.service" "$HEALTH_ENV" || return 1
  grep -Fxq "DISDEX_HEALTH_SNAPSHOT_V12_MODE=$PRIMARY_V12_MODE" "$HEALTH_ENV" || return 1
  grep -Fxq "DISDEX_WATCHDOG_V12_MODE=$PRIMARY_V12_MODE" "$WATCHDOG_ENV" || return 1
  grep -Fxq "DISDEX_WATCHDOG_V12_SERVICE_UNIT=$V12_EXPECTED_UNIT" "$WATCHDOG_ENV" || return 1
  if [[ "$PRIMARY_V12_MODE" == "V4" ]]; then
    grep -Fxq "DISDEX_HEALTH_SNAPSHOT_V12_RELEASE_ROOT=$V4_PRIMARY_RELEASE" "$HEALTH_ENV" || return 1
    grep -Fxq "DISDEX_WATCHDOG_V12_RELEASE_ROOT=$V4_PRIMARY_RELEASE" "$WATCHDOG_ENV" || return 1
    grep -Fxq "DISDEX_WATCHDOG_V12_OPERATOR_ACTIVATION_PATH=$V4_OPERATOR_ACTIVATION_PATH" "$WATCHDOG_ENV" || return 1
    grep -Fxq "Environment=DISDEX_ALERT_V12_EXPECTED_SHA=$V4_PRIMARY_SHA" "$ALERT_DROPIN" || return 1
    grep -Fxq "Environment=DISDEX_ALERT_V12_SERVICE_UNIT=$V12_EXPECTED_UNIT" "$ALERT_DROPIN" || return 1
    grep -Fq "WorkingDirectory=$V4_PRIMARY_RELEASE" "$ALERT_DROPIN" || return 1
    grep -Fq "ExecStart=$V4_PRIMARY_RELEASE/node_modules/.bin/tsx $V4_PRIMARY_RELEASE/scripts/ops/root/disdex-runner-health-alert.ts" "$ALERT_DROPIN" || return 1
    grep -Fxq "ExecStartPre=/usr/bin/test -f $V4_PRIMARY_RELEASE/.disdex-release-sha" "$ALERT_DROPIN" || return 1
    grep -Fxq "ExecStartPre=/usr/bin/grep -Fxq $V4_PRIMARY_SHA $V4_PRIMARY_RELEASE/.disdex-release-sha" "$ALERT_DROPIN" || return 1
    grep -Fxq "DISDEX_HEALTH_SNAPSHOT_V12_STATE_PATH=/var/lib/disdex/v12-v4/heartbeat.json" "$HEALTH_ENV" || return 1
  else
    grep -Fxq "Environment=DISDEX_ALERT_V12_EXPECTED_SHA=$DEPLOYED_SHA" "$ALERT_DROPIN" || return 1
  fi
}

heartbeat_identity_current() {
  local args=() index
  for index in "${!HEARTBEATS[@]}"; do
    args+=("${HEARTBEATS[$index]}" "${HEARTBEAT_EXPECTED_SHAS[$index]}" "${CURRENT_UNITS[$index]}")
  done
  python3 "${args[@]}" <<'PY'
import json,pathlib,sys
for index in range(1,len(sys.argv),3):
    name,sha,unit=sys.argv[index:index+3]
    path=pathlib.Path("/var/lib/disdex/runner-health/heartbeats")/name
    if not path.is_file():
        raise SystemExit(1)
    data=json.loads(path.read_text())
    if data.get("runtimeSha") != sha or data.get("expectedSha") != sha:
        raise SystemExit(1)
    if data.get("serviceUnit") != unit:
        raise SystemExit(1)
PY
}

timer_waiting() {
  local unit="$1"
  [[ "$(systemctl show "$unit" -p ActiveState --value 2>/dev/null || true)" == "active" ]] || return 1
  local sub_state
  sub_state="$(systemctl show "$unit" -p SubState --value 2>/dev/null || true)"
  # A timer is also armed while its triggered oneshot is executing.
  [[ "$sub_state" == "waiting" || "$sub_state" == "running" ]] || return 1
}

operator_ready() {
  local runner gate
  if [[ "$PRIMARY_V12_MODE" == "V4" ]]; then
    gate="$V4_PRIMARY_RELEASE/scripts/ops/root/disdex-live-operator-activation-gate.mjs"
    [[ -f "$gate" ]] || return 1
    /usr/bin/node "$gate" --release-root "$V4_PRIMARY_RELEASE" --sha "$V4_PRIMARY_SHA" --runner V12_V4 --activation-path "$V4_OPERATOR_ACTIVATION_PATH" >/dev/null 2>&1 || return 1
  else
    gate="$CURRENT_RELEASE/scripts/ops/root/disdex-live-operator-activation-gate.mjs"
    [[ -f "$gate" ]] || return 1
    /usr/bin/node "$gate" --release-root "$CURRENT_RELEASE" --sha "$DEPLOYED_SHA" --runner "$V12_OPERATOR_RUNNER" --activation-path /var/lib/disdex/shared/operator-activation/current.json >/dev/null 2>&1 || return 1
  fi
  for runner in PENGU_V8 QUALITY102_CAUSAL_V1 V52 FET_BRK48_RESIDUAL HYPE_TREND_LONG IDLE_PRIORITY_SHORT; do
    gate="$CURRENT_RELEASE/scripts/ops/root/disdex-live-operator-activation-gate.mjs"
    /usr/bin/node "$gate" --release-root "$CURRENT_RELEASE" --sha "$DEPLOYED_SHA" --runner "$runner" --activation-path /var/lib/disdex/shared/operator-activation/current.json >/dev/null 2>&1 || return 1
  done
  return 0
}

support_runtime_current() {
  timer_waiting disdex-runner-health-snapshot.timer || return 1
  timer_waiting disdex-runner-health-alert.timer || return 1
  timer_waiting disdex-trade-fill-notifier.timer || return 1
  if operator_ready; then
    timer_waiting disdex-runner-watchdog.timer || return 1
    if [[ "$PRIMARY_V12_MODE" == "LEGACY" ]]; then
      timer_waiting disdex-runner-position-recovery.timer || return 1
      timer_waiting disdex-v12-three-hour-health-check.timer || return 1
      [[ "$(systemctl show disdex-v12-kill-switch-auto-repair.path -p ActiveState --value 2>/dev/null || true)" == "active" ]] || return 1
    else
      [[ "$(systemctl show disdex-runner-position-recovery.timer -p ActiveState --value 2>/dev/null || true)" != "active" ]] || return 1
      [[ "$(systemctl show disdex-v12-three-hour-health-check.timer -p ActiveState --value 2>/dev/null || true)" != "active" ]] || return 1
      [[ "$(systemctl show disdex-v12-kill-switch-auto-repair.path -p ActiveState --value 2>/dev/null || true)" != "active" ]] || return 1
    fi
  fi
}

legacy_v12_persistently_retired() {
  [[ "$PRIMARY_V12_MODE" == "V4" ]] || return 0
  local unit active enabled previous_target previous_sha
  {
    printf 'disdex-v12-x1-all@%s.service\n' "$DEPLOYED_SHA"
    if [[ -L "$TRADING_ROOT/previous" ]]; then
      previous_target="$(readlink -f -- "$TRADING_ROOT/previous" 2>/dev/null || true)"
      previous_sha="$(basename -- "$previous_target")"
      [[ "$previous_sha" =~ ^[0-9a-f]{40}$ ]] && printf 'disdex-v12-x1-all@%s.service\n' "$previous_sha"
    fi
    systemctl list-unit-files 'disdex-v12-x1-all@*.service' --no-legend --no-pager 2>/dev/null | awk '{print $1}'
    systemctl list-units --all --type=service --no-legend --no-pager 'disdex-v12-x1-all@*.service' 2>/dev/null | awk '{print $1}'
  } | grep -E '^disdex-v12-x1-all@[0-9a-f]{40}\.service$' | sort -u | while read -r unit; do
    active="$(systemctl show "$unit" -p ActiveState --value 2>/dev/null || true)"
    [[ "$active" != "active" && "$active" != "activating" && "$active" != "deactivating" ]] || return 1
    enabled="$(systemctl is-enabled "$unit" 2>/dev/null || true)"
    [[ "$enabled" == "masked" ]] || return 1
  done
}


q102_observer_singleton() {
  local expected="disdex-quality102-ranking-observer@$DEPLOYED_SHA.timer" unit count=0
  timer_waiting "$expected" || return 1
  while read -r unit; do
    [[ "$unit" =~ ^disdex-quality102-ranking-observer@([0-9a-f]{40})\.timer$ ]] || continue
    [[ "$unit" == "$expected" ]] || return 1
    count=$((count + 1))
  done < <(
    {
      find /etc/systemd/system/timers.target.wants -maxdepth 1 -type l -name 'disdex-quality102-ranking-observer@*.timer' -printf '%f\n' 2>/dev/null || true
      systemctl list-units --all --type=timer --no-legend --no-pager 2>/dev/null | awk '{print $1}' | grep -E '^disdex-quality102-ranking-observer@[0-9a-f]{40}\.timer$' || true
    } | sort -u
  )
  [[ "$count" -eq 1 ]]
}

check_coherent() {
  verify_current_units_active || return 1
  verify_current_units_enabled || return 1
  monitor_pins_current || return 1
  heartbeat_identity_current || return 1
  legacy_units_inactive || return 1
  legacy_v12_persistently_retired || return 1
  [[ -z "$(list_stale_noninactive_units)" ]] || return 1
  [[ -z "$(list_stale_enabled_units)" ]] || return 1
  q102_observer_singleton || return 1
  support_runtime_current || return 1
}

retire_stale_units() {
  local unit
  mapfile -t stale < <(list_stale_noninactive_units)
  for unit in "${stale[@]}"; do
    systemctl disable --now "$unit" >/dev/null 2>&1 || true
    systemctl reset-failed "$unit" >/dev/null 2>&1 || true
    printf 'DISDEX_COHERENCE_RETIRED_STALE unit=%s\n' "$unit"
  done
  mapfile -t stale_enabled < <(list_stale_enabled_units)
  for unit in "${stale_enabled[@]}"; do
    systemctl disable --now "$unit" >/dev/null 2>&1 || true
    systemctl reset-failed "$unit" >/dev/null 2>&1 || true
    printf 'DISDEX_COHERENCE_DISABLED_STALE unit=%s\n' "$unit"
  done
}

repair_coherence() {
  [[ "$(id -u)" == "0" ]] || { echo "repair requires root" >&2; return 1; }
  verify_current_units_active || return 20
  DISDEX_PRIMARY_V12_RUNNER="$PRIMARY_V12_MODE" DISDEX_V12_V4_PRIMARY_SHA="$V4_PRIMARY_SHA" /usr/local/sbin/disdex-current-runtime-wiring --apply
  retire_stale_units
  systemctl daemon-reload
  systemctl reset-failed >/dev/null 2>&1 || true
  systemctl start disdex-runner-health-snapshot.service
  systemctl start disdex-runner-watchdog.service
  sleep 1
  check_coherent
  printf 'DISDEX_CURRENT_RUNTIME_COHERENCE_REPAIRED sha=%s\n' "$DEPLOYED_SHA"
}

main() {
  local mode="${1:---check}"
  if [[ "$mode" == "--self-test-v4-mixed-sha" ]]; then
    DEPLOYED_SHA="ce1edeead8d0f9e5d88e829d415057117502a335"
    CURRENT_RELEASE="/home/deploy/disdex-trading/releases/$DEPLOYED_SHA"
    PRIMARY_V12_MODE="V4"
    V4_PRIMARY_SHA="428ddfae4df7bcecdab46604013855bea746262b"
    V4_PRIMARY_RELEASE="/home/deploy/disdex-trading/releases/$V4_PRIMARY_SHA"
    FAMILIES[0]="disdex-v12-v4"
    build_current_units
    [[ "${CURRENT_UNITS[0]}" == "disdex-v12-v4@$V4_PRIMARY_SHA.service" ]]
    [[ "${EXPECTED_ROOT_BY_UNIT[${CURRENT_UNITS[0]}]}" == "$V4_PRIMARY_RELEASE" ]]
    [[ "${EXPECTED_SHA_BY_UNIT[${CURRENT_UNITS[0]}]}" == "$V4_PRIMARY_SHA" ]]
    for index in "${!CURRENT_UNITS[@]}"; do
      if [[ "$index" -gt 0 ]]; then
        [[ "${CURRENT_UNITS[$index]}" == *"@$DEPLOYED_SHA.service" ]]
        [[ "${EXPECTED_ROOT_BY_UNIT[${CURRENT_UNITS[$index]}]}" == "$CURRENT_RELEASE" ]]
      fi
    done
    is_expected_unit "disdex-v12-v4@$V4_PRIMARY_SHA.service"
    ! is_expected_unit "disdex-v12-v4@80b3a6211f168691a85da511bedaa0c7df664f64.service"
    ! is_expected_unit "disdex-v12-v4-canary@e8bdd2f522612179b148147d4f76951b2e30f9d7.service"
    [[ "${HEARTBEAT_EXPECTED_SHAS[0]}" == "$V4_PRIMARY_SHA" ]]
    [[ "${HEARTBEAT_EXPECTED_SHAS[1]}" == "$DEPLOYED_SHA" ]]
    printf 'V4_MIXED_SHA_COHERENCE_SELFTEST_PASS\n'
    exit 0
  fi
  if [[ "$mode" == "--self-test-margin-guard-exec" ]]; then
    local test_sha="30a3fa9934e1ff5d8a9438062ea7177f2bf9bb0e"
    local test_root="/home/deploy/disdex-trading/releases/$test_sha"
    local test_unit="disdex-v12-v52-margin-guard@$test_sha.service"
    local valid_exec="{ path=/usr/bin/python3 ; argv[]=/usr/bin/python3 scripts/disdex_v96_v52_margin_guard_runtime.py --mode live --daemon ; }"
    local invalid_exec="{ path=/usr/bin/python3 ; argv[]=/usr/bin/python3 /tmp/disdex_v96_v52_margin_guard_runtime.py --mode live --daemon ; }"
    exec_start_matches_expected_root "$test_unit" "$test_root" "$valid_exec"
    ! exec_start_matches_expected_root "$test_unit" "$test_root" "$invalid_exec"
    ! exec_start_matches_expected_root "disdex-v12-v4@$test_sha.service" "$test_root" "$valid_exec"
    printf 'MARGIN_GUARD_EXECSTART_COHERENCE_SELFTEST_PASS\n'
    exit 0
  fi
  resolve_current
  case "$mode" in
    --check)
      check_coherent && printf 'DISDEX_CURRENT_RUNTIME_COHERENCE_PASS sha=%s\n' "$DEPLOYED_SHA" || {
        printf 'DISDEX_CURRENT_RUNTIME_COHERENCE_DRIFT sha=%s\n' "$DEPLOYED_SHA" >&2
        exit 1
      }
      ;;
    --repair)
      repair_coherence
      ;;
    --auto)
      if check_coherent; then
        printf 'DISDEX_CURRENT_RUNTIME_COHERENCE_PASS sha=%s\n' "$DEPLOYED_SHA"
        exit 0
      fi
      if ! verify_current_units_active; then
        printf 'DISDEX_CURRENT_RUNTIME_COHERENCE_DEFERRED sha=%s reason=current-units-not-fully-active\n' "$DEPLOYED_SHA"
        exit 0
      fi
      repair_coherence
      ;;
    -h|--help) usage ;;
    *) usage >&2; exit 2 ;;
  esac
}

main "$@"
