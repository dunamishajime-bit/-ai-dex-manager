#!/usr/bin/env bash
set -Eeuo pipefail

umask 077
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

TRADING_ROOT="${DISDEX_TRADING_ROOT:-/home/deploy/disdex-trading}"
TRADING_RELEASES="${TRADING_ROOT}/releases"
TRADING_CURRENT="${TRADING_ROOT}/current"
RUNTIME_ENV_DIR="/etc/disdex/current-runtime"
HEALTH_DROPIN="/etc/systemd/system/disdex-runner-health-snapshot.service.d/zzzzzzzzzzzz-current-release.conf"
WATCHDOG_DROPIN="/etc/systemd/system/disdex-runner-watchdog.service.d/zzzzzzzzzzzz-current-release.conf"

FAMILIES=(
  "disdex-v12-x1-all"
  "disdex-pengu-dual-ls-v2"
  "disdex-quality102-causal-v1"
  "disdex-v52-aster-only"
  "disdex-fet-brk48"
  "disdex-hype-long"
  "disdex-idle-priority-short"
  "disdex-shared-crypto-risk"
  "disdex-v12-v52-margin-guard"
)
HEARTBEATS=(
  "v12-x1-all.json"
  "pengu-v8.json"
  "quality102-causal-v1.json"
  "v52.json"
  "fet-brk48.json"
  "hype-zec-long.json"
  "idle-priority-short.json"
)
LEGACY_LIVE_UNITS=(
  "disdex-v96-live.service"
  "disdex-v96-v52-live.service"
  "disdex-v13d-v11eq-v96.service"
  "disdex-v46-live.service"
  "disdex-pengu-dual-ls-v2-v20.service"
  "disdex-v12-x1-all.service"
  "disdex-pengu-dual-ls-v2.service"
  "disdex-quality102-causal-v1.service"
  "disdex-fet-brk48.service"
  "disdex-v52-aster-only.service"
  "disdex-shared-crypto-risk.service"
  "disdex-v12-v52-margin-guard.service"
  "disdex-idle-priority-short.service"
)

usage() { printf '%s\n' 'Usage: disdex-current-runtime-coherence-guard [--check|--repair|--auto]'; }

resolve_current() {
  [[ -L "$TRADING_CURRENT" ]] || { echo "current symlink missing" >&2; return 1; }
  CURRENT_RELEASE="$(readlink -f -- "$TRADING_CURRENT")"
  [[ "$CURRENT_RELEASE" == "$TRADING_RELEASES"/* ]] || { echo "current outside release root" >&2; return 1; }
  DEPLOYED_SHA="$(basename -- "$CURRENT_RELEASE")"
  [[ "$DEPLOYED_SHA" =~ ^[0-9a-f]{40}$ ]] || { echo "current is not exact SHA" >&2; return 1; }
  [[ "$(tr -d '[:space:]' < "$CURRENT_RELEASE/.disdex-release-sha")" == "$DEPLOYED_SHA" ]] || {
    echo "current release marker mismatch" >&2
    return 1
  }
  HEALTH_ENV="$RUNTIME_ENV_DIR/$DEPLOYED_SHA.health-snapshot.env"
  WATCHDOG_ENV="$RUNTIME_ENV_DIR/$DEPLOYED_SHA.watchdog.env"
  CURRENT_UNITS=()
  local family
  for family in "${FAMILIES[@]}"; do CURRENT_UNITS+=("${family}@${DEPLOYED_SHA}.service"); done
}

verify_current_units_active() {
  local unit pid cwd
  for unit in "${CURRENT_UNITS[@]}"; do
    [[ "$(systemctl show "$unit" -p LoadState --value 2>/dev/null || true)" == "loaded" ]] || return 1
    [[ "$(systemctl show "$unit" -p ActiveState --value 2>/dev/null || true)" == "active" ]] || return 1
    [[ "$(systemctl show "$unit" -p SubState --value 2>/dev/null || true)" == "running" ]] || return 1
    pid="$(systemctl show "$unit" -p MainPID --value 2>/dev/null || true)"
    [[ "$pid" =~ ^[1-9][0-9]*$ ]] || return 1
    cwd="$(readlink -f -- "/proc/$pid/cwd" 2>/dev/null || true)"
    [[ "$cwd" == "$CURRENT_RELEASE" ]] || return 1
  done
}

verify_current_units_enabled() {
  local unit
  for unit in "${CURRENT_UNITS[@]}"; do
    [[ "$(systemctl is-enabled "$unit" 2>/dev/null || true)" == "enabled" ]] || return 1
  done
}

list_stale_noninactive_units() {
  local unit active
  while read -r unit _; do
    [[ "$unit" =~ ^disdex-(v12-x1-all|pengu-dual-ls-v2|quality102-causal-v1|v52-aster-only|fet-brk48|hype-long|idle-priority-short|shared-crypto-risk|v12-v52-margin-guard)@([0-9a-f]{40})\.service$ ]] || continue
    [[ "${BASH_REMATCH[2]}" == "$DEPLOYED_SHA" ]] && continue
    active="$(systemctl show "$unit" -p ActiveState --value 2>/dev/null || true)"
    [[ "$active" == "inactive" || "$active" == "failed" || -z "$active" ]] && continue
    printf '%s\n' "$unit"
  done < <(systemctl list-units --all --type=service --no-legend --no-pager 2>/dev/null || true)
}

list_stale_enabled_units() {
  local link unit
  for link in /etc/systemd/system/multi-user.target.wants/disdex-*@*.service; do
    [[ -L "$link" ]] || continue
    unit="$(basename "$link")"
    [[ "$unit" =~ ^disdex-(v12-x1-all|pengu-dual-ls-v2|quality102-causal-v1|v52-aster-only|fet-brk48|hype-long|idle-priority-short|shared-crypto-risk|v12-v52-margin-guard)@([0-9a-f]{40})\.service$ ]] || continue
    [[ "${BASH_REMATCH[2]}" == "$DEPLOYED_SHA" ]] && continue
    printf '%s\n' "$unit"
  done
}

legacy_units_inactive() {
  local unit state
  for unit in "${LEGACY_LIVE_UNITS[@]}"; do
    state="$(systemctl show "$unit" -p ActiveState --value 2>/dev/null || true)"
    [[ "$state" != "active" && "$state" != "activating" && "$state" != "deactivating" ]] || return 1
  done
}

monitor_pins_current() {
  [[ -f "$HEALTH_ENV" && -f "$WATCHDOG_ENV" && -f "$HEALTH_DROPIN" && -f "$WATCHDOG_DROPIN" ]] || return 1
  grep -Fxq "DISDEX_HEALTH_SNAPSHOT_EXPECTED_SHA=$DEPLOYED_SHA" "$HEALTH_ENV" || return 1
  grep -Fxq "DISDEX_WATCHDOG_EXPECTED_SHA=$DEPLOYED_SHA" "$WATCHDOG_ENV" || return 1
  grep -Fxq "DISDEX_WATCHDOG_APPROVED_SHA=$DEPLOYED_SHA" "$WATCHDOG_ENV" || return 1
  local sleeve
  for sleeve in V12 PENGU V52 Q102 FET HYPE IDLE; do
    grep -Fxq "DISDEX_HEALTH_SNAPSHOT_${sleeve}_EXPECTED_SHA=$DEPLOYED_SHA" "$HEALTH_ENV" || return 1
    grep -Fxq "DISDEX_WATCHDOG_${sleeve}_EXPECTED_SHA=$DEPLOYED_SHA" "$WATCHDOG_ENV" || return 1
  done
  grep -Fq "EnvironmentFile=$HEALTH_ENV" "$HEALTH_DROPIN" || return 1
  grep -Fq "WorkingDirectory=$CURRENT_RELEASE" "$HEALTH_DROPIN" || return 1
  grep -Fq "EnvironmentFile=$WATCHDOG_ENV" "$WATCHDOG_DROPIN" || return 1
  grep -Fq "WorkingDirectory=$CURRENT_RELEASE" "$WATCHDOG_DROPIN" || return 1
  grep -Fxq "DISDEX_HEALTH_SNAPSHOT_SHARED_RISK_SERVICE_UNIT=disdex-shared-crypto-risk@$DEPLOYED_SHA.service" "$HEALTH_ENV" || return 1
  grep -Fxq "DISDEX_HEALTH_SNAPSHOT_MARGIN_SERVICE_UNIT=disdex-v12-v52-margin-guard@$DEPLOYED_SHA.service" "$HEALTH_ENV" || return 1
}

heartbeat_identity_current() {
  python3 - "$DEPLOYED_SHA" "${HEARTBEATS[@]}" <<'PY'
import json,pathlib,sys
sha=sys.argv[1]
for name in sys.argv[2:]:
    path=pathlib.Path("/var/lib/disdex/runner-health/heartbeats")/name
    if not path.is_file():
        raise SystemExit(1)
    data=json.loads(path.read_text())
    if data.get("runtimeSha") != sha or data.get("expectedSha") != sha:
        raise SystemExit(1)
    if not str(data.get("serviceUnit","")).endswith(f"@{sha}.service"):
        raise SystemExit(1)
PY
}

timer_waiting() {
  local unit="$1"
  [[ "$(systemctl show "$unit" -p ActiveState --value 2>/dev/null || true)" == "active" ]] || return 1
  [[ "$(systemctl show "$unit" -p SubState --value 2>/dev/null || true)" == "waiting" ]] || return 1
}

operator_ready() {
  python3 - "$DEPLOYED_SHA" <<'PY'
import json,sys
try:
    d=json.load(open("/var/lib/disdex/shared/operator-activation/current.json"))
except Exception:
    raise SystemExit(1)
sha=sys.argv[1]
if d.get("approvedSha") != sha or d.get("ordersEnabled") is not True:
    raise SystemExit(1)
expected={"V12_X1.00_ALL","PENGU_DUAL_LS_V2_FINAL","QUALITY102_CAUSAL_V1","V52_ASTER_ONLY","FET_BRK48_RESIDUAL","HYPE_TREND_LONG","IDLE_PRIORITY_SHORT"}
if not expected.issubset(set(d.get("enabledRunners") or [])):
    raise SystemExit(1)
PY
}

support_runtime_current() {
  timer_waiting disdex-runner-health-snapshot.timer || return 1
  timer_waiting disdex-runner-health-alert.timer || return 1
  timer_waiting disdex-trade-fill-notifier.timer || return 1
  if operator_ready; then
    timer_waiting disdex-runner-watchdog.timer || return 1
    timer_waiting disdex-runner-position-recovery.timer || return 1
    timer_waiting disdex-v12-three-hour-health-check.timer || return 1
    [[ "$(systemctl show disdex-v12-kill-switch-auto-repair.path -p ActiveState --value 2>/dev/null || true)" == "active" ]] || return 1
  fi
}

q102_observer_singleton() {
  local expected="disdex-quality102-ranking-observer@$DEPLOYED_SHA.timer" unit count=0
  timer_waiting "$expected" || return 1
  while read -r unit; do
    [[ "$unit" =~ ^disdex-quality102-ranking-observer@([0-9a-f]{40})\.timer$ ]] || continue
    [[ "$unit" == "$expected" ]] || return 1
    count=$((count + 1))
  done < <(
    {
      find /etc/systemd/system/timers.target.wants -maxdepth 1 -type l -name 'disdex-quality102-ranking-observer@*.timer' -printf '%f\n' 2>/dev/null || true
      systemctl list-units --all --type=timer --no-legend --no-pager 2>/dev/null | awk '{print $1}' | grep -E '^disdex-quality102-ranking-observer@[0-9a-f]{40}\.timer$' || true
    } | sort -u
  )
  [[ "$count" -eq 1 ]]
}

check_coherent() {
  verify_current_units_active || return 1
  verify_current_units_enabled || return 1
  monitor_pins_current || return 1
  heartbeat_identity_current || return 1
  legacy_units_inactive || return 1
  [[ -z "$(list_stale_noninactive_units)" ]] || return 1
  [[ -z "$(list_stale_enabled_units)" ]] || return 1
  q102_observer_singleton || return 1
  support_runtime_current || return 1
}

retire_stale_units() {
  local unit
  mapfile -t stale < <(list_stale_noninactive_units)
  for unit in "${stale[@]}"; do
    systemctl disable --now "$unit" >/dev/null 2>&1 || true
    systemctl reset-failed "$unit" >/dev/null 2>&1 || true
    printf 'DISDEX_COHERENCE_RETIRED_STALE unit=%s\n' "$unit"
  done
  mapfile -t stale_enabled < <(list_stale_enabled_units)
  for unit in "${stale_enabled[@]}"; do
    systemctl disable --now "$unit" >/dev/null 2>&1 || true
    systemctl reset-failed "$unit" >/dev/null 2>&1 || true
    printf 'DISDEX_COHERENCE_DISABLED_STALE unit=%s\n' "$unit"
  done
}

repair_coherence() {
  [[ "$(id -u)" == "0" ]] || { echo "repair requires root" >&2; return 1; }
  verify_current_units_active || return 20
  "$CURRENT_RELEASE/scripts/ops/root/disdex-current-runtime-wiring" --apply
  retire_stale_units
  systemctl daemon-reload
  systemctl reset-failed >/dev/null 2>&1 || true
  systemctl start disdex-runner-health-snapshot.service
  systemctl start disdex-runner-watchdog.service
  sleep 1
  check_coherent
  printf 'DISDEX_CURRENT_RUNTIME_COHERENCE_REPAIRED sha=%s\n' "$DEPLOYED_SHA"
}

main() {
  local mode="${1:---check}"
  resolve_current
  case "$mode" in
    --check)
      check_coherent && printf 'DISDEX_CURRENT_RUNTIME_COHERENCE_PASS sha=%s\n' "$DEPLOYED_SHA" || {
        printf 'DISDEX_CURRENT_RUNTIME_COHERENCE_DRIFT sha=%s\n' "$DEPLOYED_SHA" >&2
        exit 1
      }
      ;;
    --repair)
      repair_coherence
      ;;
    --auto)
      if check_coherent; then
        printf 'DISDEX_CURRENT_RUNTIME_COHERENCE_PASS sha=%s\n' "$DEPLOYED_SHA"
        exit 0
      fi
      if ! verify_current_units_active; then
        printf 'DISDEX_CURRENT_RUNTIME_COHERENCE_DEFERRED sha=%s reason=current-units-not-fully-active\n' "$DEPLOYED_SHA"
        exit 0
      fi
      repair_coherence
      ;;
    -h|--help) usage ;;
    *) usage >&2; exit 2 ;;
  esac
}

main "$@"
