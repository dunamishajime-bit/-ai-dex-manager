remove_stale_account_config_release_pin_dropins() {
  local current_dropin="${ACCOUNT_CONFIG_DROPIN_DIR}/${CURRENT_SUPPORT_OVERRIDE}"
  local archive_dir="/var/lib/disdex/runtime-wiring-archive/account-config/$(date -u +%Y%m%dT%H%M%SZ)-$$"
  local dropin
  [[ -d "$ACCOUNT_CONFIG_DROPIN_DIR" ]] || return 0
  while IFS= read -r -d '' dropin; do
    [[ "$dropin" == "$current_dropin" ]] && continue
    # Only archive release-pinned account-config overrides.  Preserve
    # unrelated local policy drop-ins rather than treating every .conf file as
    # stale.  The archive is root-owned so rollback remains auditable.
    if grep -Eq '/home/deploy/disdex-trading/releases/[0-9a-f]{40}|DISDEX_CONFIG_RUNTIME_SHA=[0-9a-f]{40}' "$dropin"; then
      install -d -o root -g root -m 0700 "$archive_dir"
      mv -f -- "$dropin" "$archive_dir/"
      chown root:root "$archive_dir/$(basename -- "$dropin")"
      chmod 0600 "$archive_dir/$(basename -- "$dropin")"
      printf 'DISDEX_ACCOUNT_CONFIG_STALE_DROPIN_ARCHIVED path=%s archive=%s\n' "$dropin" "$archive_dir/$(basename -- "$dropin")"
    fi
  done < <(find "$ACCOUNT_CONFIG_DROPIN_DIR" -maxdepth 1 -type f -name '*.conf' -print0)
}

write_atomic_preserve_existing() {
  local target="$1" content="$2" directory temporary backup
  directory="$(dirname -- "$target")"
  install -d -o root -g root -m 0755 "$directory"
  [[ ! -L "$target" ]] || { printf 'refusing symlink runtime artifact: %s\n' "$target" >&2; return 1; }
  temporary="$(mktemp "${directory}/.current-runtime-wiring.XXXXXX")"
  trap 'rm -f -- "$temporary"' RETURN
  printf '%s\n' "$content" > "$temporary"
  chmod 0644 "$temporary"
  chown root:root "$temporary"
  if [[ -e "$target" ]]; then
    [[ -f "$target" ]] || { printf 'runtime artifact is not a regular file: %s\n' "$target" >&2; return 1; }
    if cmp -s -- "$temporary" "$target"; then
      rm -f -- "$temporary"
      trap - RETURN
      return 0
    fi
    backup="${target}.before-v4-$(date -u +%Y%m%dT%H%M%SZ)-$$"
    cp -a -- "$target" "$backup"
    printf 'DISDEX_V4_RUNTIME_ARTIFACT_BACKUP path=%s\n' "$backup"
  fi
  mv -f -- "$temporary" "$target"
  trap - RETURN
}

