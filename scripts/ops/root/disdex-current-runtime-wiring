ensure_v4_canary_permit_runtime_access() {
  [[ "$PRIMARY_V12_MODE" == "V4" && "$V4_OPERATION_MODE" == "CANARY" ]] || return 0
  local permit=/etc/disdex/v12-v4-production-canary-permit.json
  [[ -f "$permit" && ! -L "$permit" ]] || {
    printf 'V4 canary permit is missing or symlinked: %s\n' "$permit" >&2
    return 1
  }
  # The approval remains root-owned and non-writable by non-root. The V4
  # daemon runs as deploy and its reader explicitly accepts the process GID;
  # this makes the intended runtime projection durable across restart without
  # making the approval artifact mutable by deploy.
  chown root:deploy "$permit"
  chmod 0640 "$permit"
  [[ "$(stat -c '%U:%G:%a' "$permit")" == "root:deploy:640" ]] || {
    printf 'V4 canary permit runtime ownership/mode is unsafe: %s\n' "$(stat -c '%U:%G:%a' "$permit")" >&2
    return 1
  }
  printf 'DISDEX_V4_CANARY_PERMIT_RUNTIME_ACCESS_PASS path=%s owner=root group=deploy mode=640\n' "$permit"
}

ensure_v4_time_stop_approval_runtime_access() {
  [[ "$PRIMARY_V12_MODE" == "V4" ]] || return 0
  local approval
  for approval in \
    /etc/disdex/v12-v4-production-certification.json \
    /etc/disdex/v12-v4-time-stop-approval.json; do
    [[ -f "$approval" && ! -L "$approval" ]] || {
      printf 'V4 root-managed approval is missing or symlinked: %s\n' "$approval" >&2
      return 1
    }
    # The JSON remains root-owned and non-writable by deploy. The V4 daemon
    # runs as deploy and its readers accept the process group, so project only
    # read access at cutover time without changing approved JSON contents.
    chown root:deploy "$approval"
    chmod 0640 "$approval"
    [[ "$(stat -c '%U:%G:%a' "$approval")" == "root:deploy:640" ]] || {
      printf 'V4 root-managed approval runtime ownership/mode is unsafe: %s\n' "$(stat -c '%U:%G:%a' "$approval")" >&2
      return 1
    }
  done
  printf 'DISDEX_V4_ROOT_APPROVAL_RUNTIME_ACCESS_PASS owner=root group=deploy mode=640\n'
}

