}

ensure_idle_parity_certificate_access() {
  local certificate
  for certificate in \
    "${SHARED_ROOT}/idle-priority-parity-cert.json" \
    "${SHARED_ROOT}/idle-residual-long-parity-cert.json"; do
    [[ -e "$certificate" ]] || continue
    [[ ! -L "$certificate" && -f "$certificate" ]] || {
      printf 'Idle parity certificate is not a regular file: %s\n' "$certificate" >&2
      return 1
    }
    # These certificates contain no credentials.  The deploy-owned Idle
    # daemons must be able to read them, while root remains the sole writer.
    chown root:root "$certificate"
    chmod 0644 "$certificate"
  done
}

resolve_current() {
  [[ -L "$TRADING_CURRENT" ]] || {
    printf 'current release link is missing: %s\n' "$TRADING_CURRENT" >&2
    return 1
  }
  CURRENT_RELEASE="$(readlink -f -- "$TRADING_CURRENT")"
  [[ "$CURRENT_RELEASE" == "$TRADING_RELEASES"/* ]] || {
    printf 'current release is outside release root: %s\n' "$CURRENT_RELEASE" >&2
    return 1
  }
  DEPLOYED_SHA="$(basename -- "$CURRENT_RELEASE")"
  [[ "$DEPLOYED_SHA" =~ ^[0-9a-f]{40}$ ]] || {
    printf 'current release directory is not an exact SHA: %s\n' "$DEPLOYED_SHA" >&2
    return 1
  }
  [[ -f "$CURRENT_RELEASE/.disdex-release-sha" ]] || {
    printf 'release marker is missing: %s/.disdex-release-sha\n' "$CURRENT_RELEASE" >&2
    return 1
  }
  MARKER_SHA="$(tr -d '[:space:]' < "$CURRENT_RELEASE/.disdex-release-sha")"
  [[ "$MARKER_SHA" == "$DEPLOYED_SHA" ]] || {
    printf 'release marker mismatch: directory=%s marker=%s\n' "$DEPLOYED_SHA" "$MARKER_SHA" >&2
    return 1
  }
  local canonical_target_file="${CURRENT_RELEASE}/docs/production/current-live-target.json"
  [[ -f "$canonical_target_file" && ! -L "$canonical_target_file" ]] || {
    printf 'canonical production target is missing or symlinked: %s\n' "$canonical_target_file" >&2
    return 1
  }
  [[ "$(/usr/bin/jq -er '.deploymentTarget // empty' "$canonical_target_file")" == "$DEPLOYMENT_TARGET" ]] || {
    printf 'canonical deployment target mismatch: expected=%s file=%s\n' "$DEPLOYMENT_TARGET" "$canonical_target_file" >&2
    return 1
  }
  OPERATOR_TARGET="$(/usr/bin/jq -er '.operatorTarget // .formalBacktest.selectedCase // empty' "$canonical_target_file")"
  [[ -n "$OPERATOR_TARGET" ]] || {
    printf 'canonical operator target is missing: %s\n' "$canonical_target_file" >&2
    return 1
  }
  [[ -d "$CURRENT_RELEASE/scripts" ]] || {
    printf 'release scripts directory is missing: %s/scripts\n' "$CURRENT_RELEASE" >&2
    return 1
  }
  PRIMARY_V12_MODE_FILE="${RUNTIME_CONTRACT_ENV_DIR}/${DEPLOYED_SHA}.v12-primary.env"
  PRIMARY_V12_MODE="${DISDEX_PRIMARY_V12_RUNNER:-}"
  if [[ -z "$PRIMARY_V12_MODE" && -f "$PRIMARY_V12_MODE_FILE" ]]; then
    PRIMARY_V12_MODE="$(sed -n 's/^DISDEX_PRIMARY_V12_RUNNER=//p' "$PRIMARY_V12_MODE_FILE" | tail -n1)"
  fi
  PRIMARY_V12_MODE="${PRIMARY_V12_MODE:-LEGACY}"
  [[ "$PRIMARY_V12_MODE" == "LEGACY" || "$PRIMARY_V12_MODE" == "V4" || "$PRIMARY_V12_MODE" == "DISABLED" ]] || {
    printf 'invalid primary V12 mode: %s\n' "$PRIMARY_V12_MODE" >&2
    return 1
  }
  if [[ "$PRIMARY_V12_MODE" == "V4" ]]; then
    V4_OPERATION_MODE="${DISDEX_V12_V4_OPERATION_MODE:-}"
    if [[ -z "$V4_OPERATION_MODE" && -f "$PRIMARY_V12_MODE_FILE" ]]; then
      V4_OPERATION_MODE="$(sed -n 's/^DISDEX_V12_V4_OPERATION_MODE=//p' "$PRIMARY_V12_MODE_FILE" | tail -n1)"
    fi
    V4_OPERATION_MODE="${V4_OPERATION_MODE:-CERTIFIED}"
    [[ "$V4_OPERATION_MODE" == "CERTIFIED" || "$V4_OPERATION_MODE" == "CANARY" ]] || {
      printf 'invalid V4 operation mode: %s\n' "$V4_OPERATION_MODE" >&2
      return 1
    }
    V4_PRIMARY_SHA="${DISDEX_V12_V4_PRIMARY_SHA:-}"
    if [[ -z "$V4_PRIMARY_SHA" && -f "$PRIMARY_V12_MODE_FILE" ]]; then
      V4_PRIMARY_SHA="$(sed -n 's/^DISDEX_V12_V4_PRIMARY_SHA=//p' "$PRIMARY_V12_MODE_FILE" | tail -n1)"
    fi
    [[ "$V4_PRIMARY_SHA" =~ ^[0-9a-f]{40}$ ]] || {
      printf 'V4 primary SHA is missing or invalid; refusing mixed-SHA wiring\n' >&2
      return 1
    }
    V4_PRIMARY_RELEASE="${TRADING_RELEASES}/${V4_PRIMARY_SHA}"
    [[ -d "$V4_PRIMARY_RELEASE" && ! -L "$V4_PRIMARY_RELEASE" && -f "$V4_PRIMARY_RELEASE/.disdex-release-sha" && ! -L "$V4_PRIMARY_RELEASE/.disdex-release-sha" ]] || {
      printf 'V4 primary release is missing or unsafe: %s\n' "$V4_PRIMARY_RELEASE" >&2
      return 1
    }
    [[ "$(tr -d '[:space:]' < "$V4_PRIMARY_RELEASE/.disdex-release-sha")" == "$V4_PRIMARY_SHA" ]] || {
      printf 'V4 primary release marker mismatch: %s\n' "$V4_PRIMARY_RELEASE" >&2
      return 1
    }
    [[ -f "$V4_PRIMARY_RELEASE/scripts/v12-v4-production-runner.ts" && -f "$V4_PRIMARY_RELEASE/deploy/systemd/disdex-v12-v4@.service" ]] || {
      printf 'V4 primary release is missing production runner artifacts: %s\n' "$V4_PRIMARY_RELEASE" >&2
      return 1
    }
    V4_CONTRACT_ENV_FILE="${RUNTIME_CONTRACT_ENV_DIR}/${V4_PRIMARY_SHA}.env"
    V4_OPERATOR_ACTIVATION_PATH="${SHARED_ROOT}/operator-activation/v12-v4-full.json"
    HEALTH_ALERT_EXEC_ROOT="$V4_PRIMARY_RELEASE"
    MONITOR_RUNTIME_SHA="$V4_PRIMARY_SHA"
    MONITOR_RUNTIME_ROOT="$V4_PRIMARY_RELEASE"
  else
    V4_OPERATION_MODE=""
    V4_PRIMARY_SHA=""
    V4_PRIMARY_RELEASE=""
    V4_CONTRACT_ENV_FILE=""
    V4_OPERATOR_ACTIVATION_PATH="${OPERATOR_ACTIVATION_PATH}"
    HEALTH_ALERT_EXEC_ROOT="$CURRENT_RELEASE"
    MONITOR_RUNTIME_SHA="$DEPLOYED_SHA"
    MONITOR_RUNTIME_ROOT="$CURRENT_RELEASE"
  fi
  load_runner_pin_manifest
  validate_runner_pin_releases
  validate_release_artifacts
  NODE_MODULES_SOURCE_SHA="$(dependency_source_sha "$CURRENT_RELEASE/node_modules")"
  PYTHON_RUNTIME_SOURCE_SHA="$(dependency_source_sha "$CURRENT_RELEASE/.venv2")"
}

dependency_source_sha() {
  local dependency_path="$1" resolved target_root target_marker
  if [[ -L "$dependency_path" ]]; then
    resolved="$(readlink -f -- "$dependency_path")"
    target_root="$(dirname -- "$resolved")"
    target="$(basename -- "$target_root")"
    target_marker="$(tr -d '[:space:]' < "$target_root/.disdex-release-sha")"
    [[ "$target" == "$target_marker" ]] || {
      printf 'dependency source marker mismatch: %s -> %s marker=%s\n' "$dependency_path" "$target_root" "$target_marker" >&2
      return 1
    }
    printf '%s' "$target"
    return 0
  fi
  printf '%s' "$DEPLOYED_SHA"
}

