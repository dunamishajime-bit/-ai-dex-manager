migrate_v4_telemetry_lineage() {
  [[ "$PRIMARY_V12_MODE" == "V4" ]] || return 0
  local execution_path=/var/lib/disdex/v12-v4/orders.json
  [[ -f "$execution_path" && ! -L "$execution_path" ]] || return 0

  local telemetry_path from_sha backup_path temporary observed_at migrated=0
  for telemetry_path in \
    /var/lib/disdex/v12-v4/realtime-decision.json \
    /var/lib/disdex/v12-v4/gate-telemetry.json; do
    [[ -e "$telemetry_path" ]] || continue
    [[ -f "$telemetry_path" && ! -L "$telemetry_path" ]] || {
      printf 'V4 telemetry is not a regular file: %s\n' "$telemetry_path" >&2
      return 1
    }
    from_sha="$(/usr/bin/jq -r '.runtimeSha // .releaseSha // .runtimeCommitSha // empty' "$telemetry_path" 2>/dev/null || true)"
    [[ "$from_sha" =~ ^[0-9a-f]{40}$ ]] || {
      printf 'V4 telemetry runtime SHA is missing or invalid: %s\n' "$telemetry_path" >&2
      return 1
    }
    [[ "$from_sha" == "$V4_PRIMARY_SHA" ]] && continue

    # Decision/gate telemetry is derived state, not an execution ledger.  It
    # is nevertheless consumed by HP and monitoring, so an old SHA must never
    # be presented as a current decision after a cutover.  Only reset stale
    # telemetry when the V4 execution store is flat and has no pending
    # intent/protection; an active V4 position requires a venue-backed
    # execution migration instead.  Do this check only after discovering a
    # stale telemetry file so an already-current non-flat V4 is not blocked by
    # an unnecessary derived-state rewrite.
    if ! /usr/bin/jq -e '
      ((.state.legs // {}) | length) == 0 and
      ((.intents // {}) | length) == 0 and
      ((.protections // {}) | length) == 0 and
      ((.pending // null) == null) and
      ((.state.pending // null) == null)
    ' "$execution_path" >/dev/null 2>&1; then
      # A non-flat execution ledger is normally a hard stop: derived
      # telemetry must never be reset to make an active position look flat.
      # The one safe exception is an already signed venue-backed execution
      # lineage rebind.  In that case the ledger itself proves the current
      # SHA, preserves every legacy release that produced the venue client
      # ids, and the append-only root audit proves that the transition used
      # signed read-back with zero mutations.  Only then may stale derived
      # telemetry be marked stale for HP/monitoring while the active legs stay
      # untouched.
      local lineage_audit=/var/lib/disdex/v12-v4/active-lineage-rebind.jsonl
      local lineage_allowed=0
      if [[ -f "$lineage_audit" && ! -L "$lineage_audit" ]] &&
         [[ "$(stat -c '%u:%a' "$lineage_audit" 2>/dev/null || true)" == 0:* ]] &&
         /usr/bin/jq -e --arg current "$V4_PRIMARY_SHA" --arg old "$from_sha" '
           .releaseSha == $current and
           ((.legacyReleaseShas // []) | index($old) != null)
         ' "$execution_path" >/dev/null 2>&1 &&
         /usr/bin/jq -s -e --arg current "$V4_PRIMARY_SHA" '
           any(.[]; .status == "APPLIED" and .newSha == $current and
             .mutationCalls == 0 and .ordersSent == 0 and
             .cancelsSent == 0 and .positionChangesSent == 0)
         ' "$lineage_audit" >/dev/null 2>&1; then
        lineage_allowed=1
      fi
      if [[ "$lineage_allowed" != 1 ]]; then
        printf 'V4_TELEMETRY_LINEAGE_MIGRATION_NOT_FLAT ordersSent=0 cancelsSent=0 positionChangesSent=0\n' >&2
        return 1
      fi
      printf 'V4_TELEMETRY_LINEAGE_SIGNED_EXECUTION_REBIND_ALLOWED sourceSha=%s targetSha=%s ordersSent=0 cancelsSent=0 positionChangesSent=0\n' \
        "$from_sha" "$V4_PRIMARY_SHA"
    fi

    backup_path="${telemetry_path}.before-${V4_PRIMARY_SHA}"
    if [[ -e "$backup_path" ]]; then
      [[ -f "$backup_path" && ! -L "$backup_path" ]] || {
        printf 'V4 telemetry backup is not a regular file: %s\n' "$backup_path" >&2
        return 1
      }
      cmp -s "$telemetry_path" "$backup_path" || {
        printf 'V4 telemetry backup mismatch: %s\n' "$backup_path" >&2
        return 1
      }
    else
      cp -p -- "$telemetry_path" "$backup_path"
      chown root:root "$backup_path"
      chmod 0600 "$backup_path"
    fi

    observed_at="$(date +%s%3N)"
    temporary="${telemetry_path}.${V4_PRIMARY_SHA}.$$.tmp"
    /usr/bin/jq \
      --arg old "$from_sha" \
      --arg new "$V4_PRIMARY_SHA" \
      --arg operationMode "$V4_OPERATION_MODE" \
      --argjson observedAt "$observed_at" \
      'del(.signal, .decision, .candidate, .score, .ranking, .rank, .symbol,
          .side, .entryPrice, .exitPrice, .blockReason, .gateReason, .selected,
          .candidates) |
       . + {
         sourceRuntimeSha: $old,
         runtimeSha: $new,
         releaseSha: $new,
         operationMode: $operationMode,
         status: "STALE_RESET",
         stale: true,
          staleReason: "V4_TELEMETRY_LINEAGE_MIGRATION_AFTER_SIGNED_EXECUTION_REBIND",
         updatedAt: $observedAt
       }' "$telemetry_path" > "$temporary"
    chown deploy:deploy "$temporary"
    chmod 0600 "$temporary"
    mv -f -- "$temporary" "$telemetry_path"
    printf 'V4_TELEMETRY_LINEAGE_MIGRATION path=%s fromSha=%s toSha=%s backup=%s ordersSent=0 cancelsSent=0 positionChangesSent=0\n' \
      "$telemetry_path" "$from_sha" "$V4_PRIMARY_SHA" "$backup_path"
    migrated=1
  done
  [[ "$migrated" == 1 ]] || printf 'V4_TELEMETRY_LINEAGE_CURRENT sha=%s ordersSent=0 cancelsSent=0 positionChangesSent=0\n' "$V4_PRIMARY_SHA"
}

