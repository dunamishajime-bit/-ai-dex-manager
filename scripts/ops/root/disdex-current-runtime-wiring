ensure_safety_daemon_active() {
  local unit="$1" load_state active_state
  load_state="$(systemctl show "$unit" -p LoadState --value 2>/dev/null || true)"
  [[ "$load_state" == "loaded" ]] || {
    printf 'required safety daemon is not loaded: %s\n' "$unit" >&2
    return 1
  }
  active_state="$(systemctl show "$unit" -p ActiveState --value 2>/dev/null || true)"
  if [[ "$active_state" != "active" ]]; then
    systemctl reset-failed "$unit" >/dev/null 2>&1 || true
    systemctl start "$unit"
    active_state="$(systemctl show "$unit" -p ActiveState --value 2>/dev/null || true)"
  fi
  [[ "$active_state" == "active" ]] || {
    printf 'required safety daemon failed to become active: %s state=%s\n' "$unit" "$active_state" >&2
    return 1
  }
  printf 'DISDEX_SAFETY_DAEMON_ACTIVE unit=%s ordersSent=0 cancelSent=0 positionChangesSent=0\n' "$unit"
}

ensure_monitor_timer_active() {
  local unit="$1" load_state active_state sub_state attempt
  load_state="$(systemctl show "$unit" -p LoadState --value 2>/dev/null || true)"
  [[ "$load_state" == "loaded" ]] || {
    printf 'required monitor timer is not loaded: %s\n' "$unit" >&2
    return 1
  }
  active_state="$(systemctl show "$unit" -p ActiveState --value 2>/dev/null || true)"
  sub_state="$(systemctl show "$unit" -p SubState --value 2>/dev/null || true)"
  if [[ "$active_state" != "active" ]]; then
    systemctl reset-failed "$unit" >/dev/null 2>&1 || true
    systemctl restart "$unit"
  fi
  for attempt in $(seq 1 15); do
    active_state="$(systemctl show "$unit" -p ActiveState --value 2>/dev/null || true)"
    sub_state="$(systemctl show "$unit" -p SubState --value 2>/dev/null || true)"
    if [[ "$active_state" == "active" && "$sub_state" == "waiting" ]]; then
      printf 'DISDEX_MONITOR_TIMER_ARMED unit=%s state=%s subState=%s attempt=%s ordersSent=0 cancelSent=0 positionChangesSent=0\n' "$unit" "$active_state" "$sub_state" "$attempt"
      return 0
    fi
    if [[ "$active_state" == "active" && "$sub_state" == "running" ]]; then
      printf 'DISDEX_MONITOR_TIMER_BUSY_WAIT unit=%s attempt=%s\n' "$unit" "$attempt"
      # Its oneshot is executing. Waiting here deadlocks the coherence
      # guard when it revalidates its own timer during a repair.
      printf 'DISDEX_MONITOR_TIMER_RUNNING unit=%s state=%s subState=%s ordersSent=0 cancelSent=0 positionChangesSent=0\n' "$unit" "$active_state" "$sub_state"
      return 0
    fi
    if [[ "$active_state" == "activating" ]]; then
      printf 'DISDEX_MONITOR_TIMER_ACTIVATING_WAIT unit=%s attempt=%s subState=%s\n' "$unit" "$attempt" "$sub_state"
      sleep 1
      continue
    fi
    break
  done
  printf 'required monitor timer failed to arm: %s state=%s subState=%s\n' "$unit" "$active_state" "$sub_state" >&2
  return 1
}

retarget_quality102_ranking_observer() {
