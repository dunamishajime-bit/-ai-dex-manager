}

retire_stale_release_enabled_units() {
  local link unit sha
  for link in /etc/systemd/system/multi-user.target.wants/disdex-*@*.service; do
    [[ -L "$link" ]] || continue
    unit="$(basename "$link")"
    [[ "$unit" =~ ^disdex-(v12-x1-all|v12-v4|v12-v4-canary|pengu-dual-ls-v2|quality102-causal-v1|fet-brk48|hype-long|v52-aster-only|shared-crypto-risk|v12-v52-margin-guard|idle-priority-short)@([0-9a-f]{40})\.service$ ]] || continue
    sha="${BASH_REMATCH[2]}"
    is_expected_runtime_unit "$unit" && continue
    systemctl disable --now "$unit" >/dev/null 2>&1 || true
    systemctl reset-failed "$unit" >/dev/null 2>&1 || true
    printf 'DISDEX_STALE_RELEASE_UNIT_RETIRED unit=%s\n' "$unit"
