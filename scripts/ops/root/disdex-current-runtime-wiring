main() {
  local mode="${1:---check}"
  case "$mode" in
    --self-test)
      self_test
      ;;
    --check|--apply)
      resolve_current
      set_units
      if [[ "$mode" == "--apply" ]]; then
        prepare_managed_unit_templates_for_apply
      fi
      show_plan
      check_units
      assert_no_legacy_live_units
      if [[ "$mode" == "--apply" ]]; then
        apply_wiring
      fi
      ;;
    -h|--help)
      usage
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
}

main "$@"
