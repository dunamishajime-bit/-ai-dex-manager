      return 1
    fi
    rm "$SELF_TEST_FIXTURE/node_modules"
  else
    rm -rf "$SELF_TEST_FIXTURE/node_modules"
  fi
  mv "$SELF_TEST_FIXTURE/node_modules-real" "$SELF_TEST_FIXTURE/node_modules"
  printf 'DISDEX_CURRENT_RUNTIME_WIRING_ARTIFACT_SELFTEST_PASS\n'
  grep -q -- '--all --activation-path ${OPERATOR_ACTIVATION_PATH}' "$0"
