runner_pin_field() {
  local runner_id="$1" field="$2"
  [[ -n "$RUNNER_PIN_MANIFEST_JSON" ]] || {
    printf 'runner-pin manifest has not been loaded\n' >&2
    return 1
  }
  /usr/bin/jq -er --arg runner "$runner_id" --arg field "$field" \
    '.runners[$runner][$field] // empty' <<<"$RUNNER_PIN_MANIFEST_JSON"
}

load_runner_pin_manifest() {
  local validator="$CURRENT_RELEASE/scripts/ops/root/disdex-runner-pin-manifest.mjs"
  [[ -f "$validator" && ! -L "$validator" ]] || {
    printf 'runner-pin manifest validator is missing or symlinked: %s\n' "$validator" >&2
    return 1
  }
  [[ -f "$RUNNER_PINS_PATH" && ! -L "$RUNNER_PINS_PATH" ]] || {
    printf 'root-owned runner-pin manifest is missing or symlinked: %s\n' "$RUNNER_PINS_PATH" >&2
    return 1
  }
  local metadata
  metadata="$(stat -c '%u:%g:%a' -- "$RUNNER_PINS_PATH")"
  [[ "$metadata" =~ ^0:0:([0-7]{3}|[0-7]{4})$ ]] || {
    printf 'runner-pin manifest must be root-owned and non-writable: %s (%s)\n' "$RUNNER_PINS_PATH" "$metadata" >&2
    return 1
  }
  local mode="${BASH_REMATCH[1]}"
  [[ "$((8#${mode} & 8#0022))" == "0" ]] || {
    printf 'runner-pin manifest is writable by a non-root class: %s (%s)\n' "$RUNNER_PINS_PATH" "$metadata" >&2
    return 1
  }
  RUNNER_PIN_MANIFEST_JSON="$(/usr/bin/node "$validator" --validate "$RUNNER_PINS_PATH")" || {
    printf 'runner-pin manifest validation failed: %s\n' "$RUNNER_PINS_PATH" >&2
    return 1
  }
  [[ -n "$RUNNER_PIN_MANIFEST_JSON" ]] || {
    printf 'runner-pin manifest validation returned no data: %s\n' "$RUNNER_PINS_PATH" >&2
    return 1
  }
}

validate_runner_pin_releases() {
  local runner_id runner_sha runner_root runner_marker
  for runner_id in V12_V4 PENGU_V8 QUALITY102_CAUSAL_V1 V52 FET_BRK48_RESIDUAL HYPE_TREND_LONG IDLE_PRIORITY_SHORT SHARED_CRYPTO_RISK MARGIN_GUARD; do
    runner_sha="$(runner_pin_field "$runner_id" sha)"
    runner_root="$(runner_pin_field "$runner_id" releaseRoot)"
    runner_marker="$runner_root/.disdex-release-sha"
    [[ -d "$runner_root" && ! -L "$runner_root" && -f "$runner_marker" && ! -L "$runner_marker" ]] || {
      printf 'runner-pin release is missing or unsafe: runner=%s root=%s\n' "$runner_id" "$runner_root" >&2
      return 1
    }
    [[ "$(tr -d '[:space:]' < "$runner_marker")" == "$runner_sha" ]] || {
      printf 'runner-pin release marker mismatch: runner=%s root=%s expected=%s\n' "$runner_id" "$runner_root" "$runner_sha" >&2
      return 1
    }
  done
}

usage() {
