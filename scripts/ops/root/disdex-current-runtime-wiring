prune_stale_runtime_metadata() {
  local previous_sha="" target base sha unit state path
  if [[ "$PRIMARY_V12_MODE" == "V4" ]]; then
    printf 'DISDEX_V4_MIXED_SHA_RUNTIME_METADATA_PRUNE_SKIPPED\n'
    return 0
  fi
  if [[ -L "$TRADING_ROOT/previous" ]]; then
    target="$(readlink -f -- "$TRADING_ROOT/previous" 2>/dev/null || true)"
    if [[ "$target" == "$TRADING_RELEASES"/* ]]; then
      base="$(basename -- "$target")"
      [[ "$base" =~ ^[0-9a-f]{40}$ ]] && previous_sha="$base"
    fi
  fi
  for path in "$RUNTIME_CONTRACT_ENV_DIR"/*; do
    [[ -f "$path" && ! -L "$path" ]] || continue
    base="$(basename -- "$path")"
    sha="${base:0:40}"
    [[ "$sha" =~ ^[0-9a-f]{40}$ ]] || continue
    is_expected_runtime_sha "$sha" || {
      [[ -n "$previous_sha" && "$sha" == "$previous_sha" ]] && continue
    }
    rm -f -- "$path"
    printf 'DISDEX_STALE_RUNTIME_ENV_REMOVED path=%s\n' "$path"
  done
  for path in /etc/systemd/system/disdex-*@*.service.d; do
    [[ -d "$path" && ! -L "$path" ]] || continue
    base="$(basename -- "$path")"
    [[ "$base" =~ @([0-9a-f]{40})\.service\.d$ ]] || continue
    sha="${BASH_REMATCH[1]}"
    is_expected_runtime_sha "$sha" || {
      [[ -n "$previous_sha" && "$sha" == "$previous_sha" ]] && continue
    }
    unit="${base%.d}"
    state="$(systemctl show "$unit" -p ActiveState --value 2>/dev/null || true)"
    [[ "$state" != "active" && "$state" != "activating" && "$state" != "deactivating" ]] || {
      printf 'stale runtime metadata still belongs to a live unit: %s state=%s\n' "$unit" "$state" >&2
      return 1
    }
    rm -rf -- "$path"
    printf 'DISDEX_STALE_RUNTIME_DROPIN_REMOVED path=%s\n' "$path"
  done
}

reset_stale_release_failed_units() {
  local unit
  while read -r unit _; do
    [[ -n "$unit" ]] || continue
    [[ "$unit" =~ ^disdex-(v12-x1-all|v12-v4|pengu-dual-ls-v2|quality102-causal-v1|fet-brk48|hype-long|v52-aster-only|shared-crypto-risk|v12-v52-margin-guard|idle-priority-short)@[0-9a-f]{40}\.service$ ]] || continue
    is_expected_runtime_unit "$unit" && continue
    systemctl reset-failed "$unit" >/dev/null 2>&1 || true
  done < <(systemctl list-units --all --type=service --state=failed --no-legend 2>/dev/null || true)
}

ensure_safety_daemon_active() {
  local unit="$1" load_state active_state
  load_state="$(systemctl show "$unit" -p LoadState --value 2>/dev/null || true)"
  [[ "$load_state" == "loaded" ]] || {
    printf 'required safety daemon is not loaded: %s\n' "$unit" >&2
    return 1
  }
  active_state="$(systemctl show "$unit" -p ActiveState --value 2>/dev/null || true)"
  if [[ "$active_state" != "active" ]]; then
    systemctl reset-failed "$unit" >/dev/null 2>&1 || true
    systemctl start "$unit"
    active_state="$(systemctl show "$unit" -p ActiveState --value 2>/dev/null || true)"
  fi
  [[ "$active_state" == "active" ]] || {
    printf 'required safety daemon failed to become active: %s state=%s\n' "$unit" "$active_state" >&2
    return 1
  }
  # Safety daemons must survive a host/systemd restart as well as the current
  # cutover.  Leaving a started template instance disabled makes the
  # coherence guard defer forever after every deployment and can silently
  # remove the risk/margin authority on the next boot.
  systemctl enable "$unit" >/dev/null 2>&1 || {
    printf 'required safety daemon is not enabled: %s\n' "$unit" >&2
    return 1
  }
  [[ "$(systemctl is-enabled "$unit" 2>/dev/null || true)" == "enabled" ]] || {
    printf 'required safety daemon enablement could not be verified: %s\n' "$unit" >&2
    return 1
  }
  printf 'DISDEX_SAFETY_DAEMON_ACTIVE unit=%s ordersSent=0 cancelSent=0 positionChangesSent=0\n' "$unit"
}

ensure_monitor_timer_active() {
  local unit="$1" load_state active_state sub_state attempt
  load_state="$(systemctl show "$unit" -p LoadState --value 2>/dev/null || true)"
  [[ "$load_state" == "loaded" ]] || {
    printf 'required monitor timer is not loaded: %s\n' "$unit" >&2
    return 1
  }
  active_state="$(systemctl show "$unit" -p ActiveState --value 2>/dev/null || true)"
  sub_state="$(systemctl show "$unit" -p SubState --value 2>/dev/null || true)"
  if [[ "$active_state" != "active" ]]; then
    systemctl reset-failed "$unit" >/dev/null 2>&1 || true
    systemctl restart "$unit"
  fi
  for attempt in $(seq 1 15); do
    active_state="$(systemctl show "$unit" -p ActiveState --value 2>/dev/null || true)"
    sub_state="$(systemctl show "$unit" -p SubState --value 2>/dev/null || true)"
    if [[ "$active_state" == "active" && "$sub_state" == "waiting" ]]; then
      printf 'DISDEX_MONITOR_TIMER_ARMED unit=%s state=%s subState=%s attempt=%s ordersSent=0 cancelSent=0 positionChangesSent=0\n' "$unit" "$active_state" "$sub_state" "$attempt"
      return 0
    fi
    if [[ "$active_state" == "active" && "$sub_state" == "running" ]]; then
      printf 'DISDEX_MONITOR_TIMER_BUSY_WAIT unit=%s attempt=%s\n' "$unit" "$attempt"
      # Its oneshot is executing. Waiting here deadlocks the coherence
      # guard when it revalidates its own timer during a repair.
      printf 'DISDEX_MONITOR_TIMER_RUNNING unit=%s state=%s subState=%s ordersSent=0 cancelSent=0 positionChangesSent=0\n' "$unit" "$active_state" "$sub_state"
      return 0
    fi
    if [[ "$active_state" == "activating" ]]; then
      printf 'DISDEX_MONITOR_TIMER_ACTIVATING_WAIT unit=%s attempt=%s subState=%s\n' "$unit" "$attempt" "$sub_state"
      sleep 1
      continue
    fi
    break
  done
  printf 'required monitor timer failed to arm: %s state=%s subState=%s\n' "$unit" "$active_state" "$sub_state" >&2
  return 1
}

v52_is_intentionally_disabled_flat() {
  local state_path=/var/lib/disdex/v52-aster-only/runner-live.json
  # Any exposed position/pending state is DISABLED_PEER_NOT_FLAT and must not
  # be treated as a harmless limited-scope peer.
  [[ -f "$state_path" && ! -L "$state_path" ]] || return 1
  /usr/bin/jq -e '
    (.strategyId == "DISDEX_V52_V11EQ_V50_ASTER_ONLY_PLUS_CRYPTO_V96") and
    (.mode == "DISABLED") and
    (.status == "intentional-stop") and
    (.ordersAllowed == false) and
    (.newOrdersAllowed == false) and
    (.orderEnabled == false) and
    ((.positions // {}) | length == 0) and
    ((.pending // null) == null) and
    ((.manualReview // null) == null)
  ' "$state_path" >/dev/null
}

limited_overlay_scope_without_v52_preemption() {
  [[ "$PRIMARY_V12_MODE" == "V4" ]] || return 1
  [[ -f "$OPERATOR_ACTIVATION_PATH" && ! -L "$OPERATOR_ACTIVATION_PATH" ]] || return 1
  /usr/bin/jq -e --arg sha "$DEPLOYED_SHA" '
    (.approvedSha == $sha) and
    (.activationClass == "LIMITED_OVERLAY_LIVE") and
    (.ordersEnabled == true) and
    (.v4CanaryAuthorized == true) and
    ((.unchangedPeerRunners // []) | index("V52") != null) and
    ((.unchangedPeerRunners // []) | index("FET_BRK48_RESIDUAL") != null) and
    (.formalCertification == false) and
    (.venueLifecycleCertified == false)
  ' "$OPERATOR_ACTIVATION_PATH" >/dev/null || return 1
  v52_is_intentionally_disabled_flat
}

ensure_v52_intentional_stop_marker() {
  limited_overlay_scope_without_v52_preemption || return 1
  local marker_dir marker_tmp
  marker_dir="$(dirname -- "$V52_INTENTIONAL_STOP_MARKER")"
  marker_tmp="${V52_INTENTIONAL_STOP_MARKER}.tmp.$$"
  install -d -o root -g root -m 0755 "$marker_dir"
  printf '{"schema":"disdex-v52-intentional-stop/v1","runtimeSha":"%s","reason":"LIMITED_OVERLAY_SCOPE_V52_PEER_DISABLED","createdAt":%s}\n' \
    "$DEPLOYED_SHA" "$(date +%s%3N)" > "$marker_tmp"
  chown root:deploy "$marker_tmp"
  chmod 0640 "$marker_tmp"
  mv -f -- "$marker_tmp" "$V52_INTENTIONAL_STOP_MARKER"
  printf 'DISDEX_V52_INTENTIONAL_STOP_MARKER_READY path=%s sha=%s ordersSent=0 cancelSent=0 positionChangesSent=0\n' "$V52_INTENTIONAL_STOP_MARKER" "$DEPLOYED_SHA"
}

archive_v52_intentional_stop_marker() {
  [[ -e "$V52_INTENTIONAL_STOP_MARKER" ]] || return 0
  [[ ! -L "$V52_INTENTIONAL_STOP_MARKER" && -f "$V52_INTENTIONAL_STOP_MARKER" ]] || {
    printf 'V52 intentional-stop marker is not a regular file: %s\n' "$V52_INTENTIONAL_STOP_MARKER" >&2
    return 1
  }
  local archive_dir="$(dirname -- "$V52_INTENTIONAL_STOP_MARKER")/archive"
  local archive_path="${archive_dir}/v52.intentional-stop.before-${DEPLOYED_SHA}-$(date -u +%Y%m%dT%H%M%SZ)-$$.json"
  install -d -o root -g root -m 0755 "$archive_dir"
  mv -T -- "$V52_INTENTIONAL_STOP_MARKER" "$archive_path"
  chown root:root "$archive_path"
  chmod 0640 "$archive_path"
  printf 'DISDEX_V52_INTENTIONAL_STOP_MARKER_ARCHIVED path=%s archive=%s ordersSent=0 cancelSent=0 positionChangesSent=0\n' \
    "$V52_INTENTIONAL_STOP_MARKER" "$archive_path"
}

full_live_operator_artifact_for_v52() {
  [[ -f "$OPERATOR_ACTIVATION_PATH" && ! -L "$OPERATOR_ACTIVATION_PATH" ]] || return 1
  /usr/bin/jq -e --arg sha "$DEPLOYED_SHA" '
    (.approvedSha == $sha) and
    (.activationClass == "FULL_LIVE") and
    (.ordersEnabled == true) and
    (.fetCorePreemptionReady == true) and
    ((.approvedRunners // []) | index("V52") != null) and
    ((.approvedRunners // []) | index("FET_BRK48_RESIDUAL") != null)
  ' "$OPERATOR_ACTIVATION_PATH" >/dev/null
}

promote_v52_full_live_flat_state() {
  # A DISABLED V52 state is valid only for the limited overlay. Full LIVE
  # promotion is a separate audited transaction and only accepts the exact
  # flat marker; positioned, pending, reviewed, or unknown state fails closed.
  if limited_overlay_scope_without_v52_preemption; then
    printf 'DISDEX_V52_FULL_LIVE_STATE_PROMOTE_SKIPPED_LIMITED_SCOPE ordersSent=0 cancelSent=0 positionChangesSent=0\n'
    return 0
  fi
  full_live_operator_artifact_for_v52 || {
    printf 'V52 full-live operator artifact is not exact, full-live, and FET-ready\n' >&2
    return 1
  }
  local state_path=/var/lib/disdex/v52-aster-only/runner-live.json
  [[ -f "$state_path" && ! -L "$state_path" ]] || {
    printf 'V52 full-live state is missing or symlinked: %s\n' "$state_path" >&2
    return 1
  }
  /usr/bin/jq -e --arg sha "$DEPLOYED_SHA" '
    (.runtimeCommitSha == $sha) and
    (.strategyId == "DISDEX_V52_V11EQ_V50_ASTER_ONLY_PLUS_CRYPTO_V96") and
    (.mode == "DISABLED") and
    (.status == "intentional-stop") and
    (.disabledReason == "LIMITED_OVERLAY_SCOPE_V52_PEER_DISABLED") and
    (.positions | type == "object" and length == 0) and
    (.pending // null) == null and
    (.manualReview // null) == null and
    (.ordersAllowed == false) and
    (.newOrdersAllowed == false) and
    (.orderEnabled == false)
  ' "$state_path" >/dev/null || {
    if /usr/bin/jq -e --arg sha "$DEPLOYED_SHA" '
      (.runtimeCommitSha == $sha) and
      (.strategyId == "DISDEX_V52_V11EQ_V50_ASTER_ONLY_PLUS_CRYPTO_V96") and
      (.mode == "LIVE") and
      (.status == "ready") and
      (.disabledReason // null) == null and
      (.positions | type == "object" and length == 0) and
      (.pending // null) == null and
      (.manualReview // null) == null and
      (.ordersAllowed == true) and
      (.newOrdersAllowed == true) and
      (.orderEnabled == true)
    ' "$state_path" >/dev/null; then
      printf 'V52_FULL_LIVE_STATE_PROMOTE_ALREADY_READY path=%s sha=%s ordersSent=0 cancelSent=0 positionChangesSent=0\n' \
        "$state_path" "$DEPLOYED_SHA"
      return 0
    fi
    printf 'V52_FULL_LIVE_STATE_PROMOTE_NOT_FLAT path=%s ordersSent=0 cancelSent=0 positionChangesSent=0\n' "$state_path" >&2
    return 1
  }
  local backup_path="${state_path}.before-full-live-${DEPLOYED_SHA}"
  if [[ -e "$backup_path" ]]; then
    cmp -s "$state_path" "$backup_path" || {
      printf 'V52 full-live backup already exists but is not the exact pre-promotion state: %s\n' "$backup_path" >&2
      return 1
    }
  else
    cp -a "$state_path" "$backup_path"
  fi
  local uid gid mode temporary
  uid="$(stat -c '%u' "$state_path")"
  gid="$(stat -c '%g' "$state_path")"
  mode="$(stat -c '%a' "$state_path")"
  temporary="$(mktemp "${state_path}.full-live.XXXXXX")"
  if ! /usr/bin/jq --arg sha "$DEPLOYED_SHA" '
    .runtimeCommitSha=$sha |
    .mode="LIVE" |
    .status="ready" |
    .disabledReason=null |
    .ordersAllowed=true |
    .newOrdersAllowed=true |
    .orderEnabled=true |
    .operatorReviewRequired=false |
    .lastReconciledAt=(now * 1000 | floor) |
    .updatedAt=(now * 1000 | floor)
  ' "$state_path" > "$temporary"; then
    rm -f -- "$temporary"
    return 1
  fi
  chown "$uid:$gid" "$temporary"
  chmod "$mode" "$temporary"
  mv -Tf "$temporary" "$state_path"
  /usr/bin/jq -e --arg sha "$DEPLOYED_SHA" '
    (.runtimeCommitSha == $sha) and
    (.strategyId == "DISDEX_V52_V11EQ_V50_ASTER_ONLY_PLUS_CRYPTO_V96") and
    (.mode == "LIVE") and
    (.status == "ready") and
    (.disabledReason == null) and
    (.positions | type == "object" and length == 0) and
    (.pending // null) == null and
    (.manualReview // null) == null and
    (.ordersAllowed == true) and
    (.newOrdersAllowed == true) and
    (.orderEnabled == true)
  ' "$state_path" >/dev/null || {
    printf 'V52_FULL_LIVE_STATE_PROMOTE_READBACK_FAIL path=%s backup=%s\n' "$state_path" "$backup_path" >&2
    return 1
  }
  printf 'V52_FULL_LIVE_STATE_PROMOTE_PASS path=%s backup=%s sha=%s ordersSent=0 cancelSent=0 positionChangesSent=0\n' \
    "$state_path" "$backup_path" "$DEPLOYED_SHA"
}

ensure_trading_unit_running() {
  local unit="$1" load_state active_state sub_state attempt
  load_state="$(systemctl show "$unit" -p LoadState --value 2>/dev/null || true)"
  [[ "$load_state" == "loaded" ]] || {
    printf 'required trading unit is not loaded: %s\n' "$unit" >&2
    return 1
  }
  # Limited Overlay LIVE deliberately leaves the unchanged V52 peer disabled.
  # Its flat state is still attested by V4; starting the unit here would turn a
  # safe disabled peer into an unauthorised full-V52 activation attempt.
  if [[ "$unit" == "$V52_UNIT" ]] && v52_is_intentionally_disabled_flat && limited_overlay_scope_without_v52_preemption; then
    systemctl disable --now "$unit" >/dev/null 2>&1 || true
    printf 'DISDEX_TRADING_UNIT_DISABLED_INTENTIONAL unit=%s reason=LIMITED_OVERLAY_SCOPE_V52_PEER_DISABLED ordersSent=0 cancelSent=0 positionChangesSent=0\n' "$unit"
    return 0
  fi
  systemctl enable "$unit" >/dev/null 2>&1 || true
  systemctl reset-failed "$unit" >/dev/null 2>&1 || true
  # Start once and let the unit's bounded RestartSec handle a transient venue
  # rate-budget/read-only preflight failure.  Repeated manual starts here would
  # amplify the same Aster request burst that caused the failure.
  systemctl start "$unit" >/dev/null 2>&1 || true
  for attempt in $(seq 1 90); do
    active_state="$(systemctl show "$unit" -p ActiveState --value 2>/dev/null || true)"
    sub_state="$(systemctl show "$unit" -p SubState --value 2>/dev/null || true)"
    if [[ "$active_state" == "active" && "$sub_state" == "running" ]]; then
      printf 'DISDEX_TRADING_UNIT_RUNNING unit=%s attempt=%s ordersSent=0 cancelSent=0 positionChangesSent=0\n' "$unit" "$attempt"
      return 0
    fi
    sleep 1
  done
  printf 'required trading unit failed to become active: %s state=%s subState=%s\n' "$unit" "$active_state" "$sub_state" >&2
  return 1
}

wait_aster_rate_budget_quiet() {
  local label="$1" attempt=0 consecutive=0
  local budget_path="${DISDEX_ASTER_GLOBAL_RATE_BUDGET_PATH:-${SHARED_ROOT}/aster-rate-budget.json}"
  local quiet_horizon_ms="${DISDEX_CURRENT_RUNTIME_RATE_BUDGET_QUIET_HORIZON_MS:-500}"
  local max_attempts="${DISDEX_CURRENT_RUNTIME_RATE_BUDGET_QUIET_MAX_ATTEMPTS:-40}"
  while (( attempt < max_attempts )); do
    attempt=$((attempt + 1))
    if /usr/bin/python3 - "$budget_path" "$quiet_horizon_ms" <<'PY'
import json, math, os, sys, time

path = sys.argv[1]
quiet_horizon_ms = int(sys.argv[2])
if os.path.exists(path + ".lock") or os.path.exists(path + ".lock.recovery"):
    raise SystemExit(2)
try:
    with open(path, encoding="utf-8") as handle:
        state = json.load(handle)
except FileNotFoundError:
    raise SystemExit(3)
except Exception:
    raise SystemExit(3)
if not isinstance(state, dict) or state.get("schema") != "disdex-aster-rate-budget/v1":
    raise SystemExit(3)
try:
    next_allowed_at = float(state["nextAllowedAt"])
    cooldown_until = float(state.get("cooldownUntil", 0))
except (KeyError, TypeError, ValueError):
    raise SystemExit(3)
if not math.isfinite(next_allowed_at) or next_allowed_at < 0 or not math.isfinite(cooldown_until) or cooldown_until < 0:
    raise SystemExit(3)
blocked_until = max(next_allowed_at, cooldown_until)
now_ms = time.time() * 1000
raise SystemExit(0 if max(0, blocked_until - now_ms) <= quiet_horizon_ms else 2)
PY
    then
      consecutive=$((consecutive + 1))
      printf 'DISDEX_RATE_BUDGET_QUIET label=%s attempt=%s consecutive=%s\n' "$label" "$attempt" "$consecutive"
      if (( consecutive >= 3 )); then
        return 0
      fi
    else
      local rc=$?
      if (( rc == 3 )); then
        printf 'shared Aster rate-budget state is missing or malformed: %s\n' "$budget_path" >&2
        return 1
      fi
      consecutive=0
      printf 'DISDEX_RATE_BUDGET_BUSY label=%s attempt=%s\n' "$label" "$attempt"
    fi
    sleep 1
  done
  printf 'shared Aster rate-budget did not become quiet: %s\n' "$label" >&2
  return 1
}

