    scripts/ops/root/disdex-vps-retention-cleanup \
    scripts/ops/root/disdex-ui-retention-cleanup; do
    : > "$SELF_TEST_FIXTURE/$required_file"
  done
  printf '#!/bin/sh\n' > "$SELF_TEST_FIXTURE/node_modules/.bin/tsx"
  printf '#!/bin/sh\n' > "$SELF_TEST_FIXTURE/.venv2/bin/python"
  chmod +x "$SELF_TEST_FIXTURE/node_modules/.bin/tsx" "$SELF_TEST_FIXTURE/.venv2/bin/python"
  validate_release_artifacts
  AUTO_REPAIR_DROPIN_DIR="$SELF_TEST_FIXTURE/auto-repair-dropins"
  V52_UNIT="disdex-v52-aster-only@${sample_sha}.service"
  mkdir -p "$AUTO_REPAIR_DROPIN_DIR"
  printf '[Service]\nEnvironment=DISDEX_V52_SERVICE_UNIT=%s\n' "$V52_UNIT" > "$AUTO_REPAIR_DROPIN_DIR/zzzzzzzzzzzz-current-release.conf"
  printf '[Service]\nEnvironment=DISDEX_V52_SERVICE_UNIT=disdex-v52-aster-only@aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.service\n' > "$AUTO_REPAIR_DROPIN_DIR/stale.conf"
  printf '[Service]\nEnvironment=UNRELATED=true\n' > "$AUTO_REPAIR_DROPIN_DIR/unrelated.conf"
  remove_stale_auto_repair_unit_pin_dropins
  [[ -f "$AUTO_REPAIR_DROPIN_DIR/zzzzzzzzzzzz-current-release.conf" ]]
  [[ ! -e "$AUTO_REPAIR_DROPIN_DIR/stale.conf" ]]
  [[ -f "$AUTO_REPAIR_DROPIN_DIR/unrelated.conf" ]]
  printf 'DISDEX_CURRENT_RUNTIME_WIRING_STALE_AUTO_REPAIR_DROPIN_SELFTEST_PASS\n'
  WATCHDOG_DROPIN_DIR="$SELF_TEST_FIXTURE/watchdog-dropins"
  SNAPSHOT_DROPIN_DIR="$SELF_TEST_FIXTURE/snapshot-dropins"
  POSITION_RECOVERY_DROPIN_DIR="$SELF_TEST_FIXTURE/position-recovery-dropins"
  FILL_NOTIFIER_DROPIN_DIR="$SELF_TEST_FIXTURE/fill-notifier-dropins"
  for fixture in "$WATCHDOG_DROPIN_DIR" "$SNAPSHOT_DROPIN_DIR" "$POSITION_RECOVERY_DROPIN_DIR" "$FILL_NOTIFIER_DROPIN_DIR"; do
    mkdir -p "$fixture"
    printf '[Service]\nWorkingDirectory=%s\n' "$CURRENT_RELEASE" > "$fixture/$CURRENT_SUPPORT_OVERRIDE"
    printf '[Service]\nWorkingDirectory=/home/deploy/disdex-trading/releases/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\n' > "$fixture/stale-release.conf"
    printf '[Service]\nEnvironment=UNRELATED=true\n' > "$fixture/unrelated.conf"
  done
  printf '[Service]\nWorkingDirectory=/home/deploy/disdex-trading/position-recovery/releases/bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\n' > "$POSITION_RECOVERY_DROPIN_DIR/stale-position-release.conf"
  remove_stale_support_release_pin_dropins
  for fixture in "$WATCHDOG_DROPIN_DIR" "$SNAPSHOT_DROPIN_DIR" "$POSITION_RECOVERY_DROPIN_DIR" "$FILL_NOTIFIER_DROPIN_DIR"; do
    [[ -f "$fixture/$CURRENT_SUPPORT_OVERRIDE" ]]
    [[ ! -e "$fixture/stale-release.conf" ]]
    [[ -f "$fixture/unrelated.conf" ]]
  done
  [[ ! -e "$POSITION_RECOVERY_DROPIN_DIR/stale-position-release.conf" ]]
  printf 'DISDEX_CURRENT_RUNTIME_WIRING_STALE_SUPPORT_DROPIN_SELFTEST_PASS\n'
  mv "$SELF_TEST_FIXTURE/node_modules" "$SELF_TEST_FIXTURE/node_modules-real"
  ln -s "$SELF_TEST_FIXTURE/node_modules-real" "$SELF_TEST_FIXTURE/node_modules"
  if [[ -L "$SELF_TEST_FIXTURE/node_modules" ]]; then
    if validate_release_artifacts; then
      printf 'artifact symlink validation unexpectedly passed\n' >&2
      return 1
    fi
    rm "$SELF_TEST_FIXTURE/node_modules"
  else
    rm -rf "$SELF_TEST_FIXTURE/node_modules"
  fi
  mv "$SELF_TEST_FIXTURE/node_modules-real" "$SELF_TEST_FIXTURE/node_modules"
  printf 'DISDEX_CURRENT_RUNTIME_WIRING_ARTIFACT_SELFTEST_PASS\n'
  grep -q -- '--all --require-runner-sha-map --activation-path ${OPERATOR_ACTIVATION_PATH}' "$0"
  grep -q 'systemctl disable --now disdex-runner-position-recovery.timer' "$0"
  grep -q 'systemctl disable --now disdex-v12-three-hour-health-check.timer' "$0"
  grep -q 'systemctl enable --now disdex-runner-position-recovery.timer' "$0"
  grep -q 'systemctl enable --now disdex-v12-three-hour-health-check.timer' "$0"
  grep -q 'systemctl enable --now "$IDLE_UNIT"' "$0"
  grep -q 'IDLE_PRIORITY_SHORT' "$0"
  grep -q 'DISDEX_HEALTH_SNAPSHOT_IDLE_EXPECTED_SHA=${IDLE_SHA}' "$0"
  grep -q 'DISDEX_HEALTH_SNAPSHOT_IDLE_STATE_PATH=${IDLE_PRIORITY_STATE_ROOT}/state.json' "$0"
  grep -q 'DISDEX_WATCHDOG_IDLE_EXPECTED_SHA=${IDLE_SHA}' "$0"
  grep -q 'DISDEX_WATCHDOG_IDLE_SERVICE_UNIT=${IDLE_UNIT}' "$0"
  grep -q 'V12_OPERATOR_RUNNER="V12_V4"' "$0"
  grep -Fq 'V4_OPERATION_MODE="${DISDEX_V12_V4_OPERATION_MODE:-}"' "$0"
  grep -Fq 'DISDEX_V12_V4_OPERATION_MODE=${V4_OPERATION_MODE}' "$0"
  grep -Fq 'persistently_disable_v12' "$0"
  grep -Fq 'DISDEX_HEALTH_SNAPSHOT_V12_DISABLED_REASON=' "$0"
  grep -Fq 'DISDEX_WATCHDOG_V12_DISABLED_REASON=' "$0"
  grep -q 'DISDEX_HEALTH_SNAPSHOT_V12_MODE=${PRIMARY_V12_MODE}' "$0"
  grep -q 'DISDEX_WATCHDOG_V12_MODE=${PRIMARY_V12_MODE}' "$0"
  grep -q 'DISDEX_V12_V4_LEGACY_PERSISTENT_MASK' "$0"
  grep -q 'DISDEX_V12_V4_LEGACY_RECOVERY_AUTOMATION_DISABLED' "$0"
  grep -q 'DISDEX_MONITOR_TIMER_BUSY_WAIT' "$0"
  grep -q 'for attempt in $(seq 1 15)' "$0"
  printf 'DISDEX_CURRENT_RUNTIME_OPERATOR_AUTOMATION_SELFTEST_PASS\n'
  printf 'DISDEX_CURRENT_RUNTIME_WIRING_SELFTEST_PASS\n'
}

main() {
  local mode="${1:---check}"
  case "$mode" in
    --self-test)
      self_test
      ;;
    --check|--apply)
      resolve_current
      set_units
      if [[ "$mode" == "--apply" ]]; then
        prepare_managed_unit_templates_for_apply
      fi
      show_plan
      check_units
      assert_no_legacy_live_units
      if [[ "$mode" == "--apply" ]]; then
        apply_wiring
      fi
      ;;
    -h|--help)
      usage
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
}

main "$@"
