is_expected_runtime_unit() {
  local unit="$1" expected
  [[ -n "$unit" ]] || return 1
  for expected in \
    "$V12_UNIT" \
    "$PENGU_UNIT" \
    "$Q102_UNIT" \
    "$Q102_RANKING_OBSERVER_SERVICE" \
    "$FET_UNIT" \
    "$HYPE_UNIT" \
    "$V52_UNIT" \
    "$MARGIN_UNIT" \
    "$SHARED_RISK_UNIT" \
    "$IDLE_UNIT"; do
    [[ -n "$expected" && "$unit" == "$expected" ]] && return 0
  done
  return 1
}

is_expected_runtime_sha() {
  local sha="$1" expected
  [[ -n "$sha" ]] || return 1
  for expected in \
    "$DEPLOYED_SHA" \
    "$V4_PRIMARY_SHA" \
    "$PENGU_SHA" \
    "$Q102_SHA" \
    "$V52_SHA" \
    "$FET_SHA" \
    "$HYPE_SHA" \
    "$IDLE_SHA" \
    "$SHARED_RISK_SHA" \
    "$MARGIN_SHA" \
    "$NODE_MODULES_SOURCE_SHA" \
