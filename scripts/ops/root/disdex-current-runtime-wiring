    active="$(systemctl show "$unit" -p ActiveState --value 2>/dev/null || true)"
    [[ "$active" != "active" && "$active" != "activating" && "$active" != "deactivating" ]] || {
      printf 'V4 canary must be stopped before full primary wiring: %s state=%s\n' "$unit" "$active" >&2
      return 1
    }
  done < <(systemctl list-units --all --type=service --no-legend --no-pager 'disdex-v12-v4-canary@*.service' 2>/dev/null || true)
  while read -r unit _; do
    [[ "$unit" =~ ^disdex-v12-v4@([0-9a-f]{40})\.service$ ]] || continue
    active="$(systemctl show "$unit" -p ActiveState --value 2>/dev/null || true)"
    [[ "$active" != "active" && "$active" != "activating" && "$active" != "deactivating" ]] || {
      [[ "$unit" == "$V12_UNIT" ]] || {
        printf 'competing V4 production authority is active: %s state=%s\n' "$unit" "$active" >&2
        return 1
      }
    }
  done < <(systemctl list-units --all --type=service --no-legend --no-pager 'disdex-v12-v4@*.service' 2>/dev/null || true)
  while read -r unit _; do
    [[ "$unit" =~ ^disdex-v12-x1-all@[0-9a-f]{40}\.service$ ]] || continue
    active="$(systemctl show "$unit" -p ActiveState --value 2>/dev/null || true)"
    [[ "$active" != "active" && "$active" != "activating" && "$active" != "deactivating" ]] || {
      printf 'legacy V12 authority is active during V4 primary wiring: %s state=%s\n' "$unit" "$active" >&2
      return 1
    }
  done < <(systemctl list-units --all --type=service --no-legend --no-pager 'disdex-v12-x1-all@*.service' 2>/dev/null || true)
}

normalize_position_recovery_state_lineage() {
  local root=/var/lib/disdex/runner-recovery
  local state="$root/position-recovery.json"
  local prior_sha backup tmp
  install -d -o root -g root -m 0700 "$root"
  [[ -e "$state" ]] || return 0
  [[ -f "$state" && ! -L "$state" ]] || {
    printf 'position recovery state is not a regular file: %s\n' "$state" >&2
    return 1
  }
  if /usr/bin/jq -e --arg sha "$DEPLOYED_SHA" 'type == "object" and .schema == "disdex-runner-position-recovery/v1" and .releaseSha == $sha and (.runners | type == "object")' "$state" >/dev/null 2>&1; then
    chown root:root "$state"
    chmod 0600 "$state"
    return 0
  fi
  prior_sha="$(/usr/bin/jq -r 'if type == "object" and .schema == "disdex-runner-position-recovery/v1" and (.releaseSha | type == "string") and (.runners | type == "object") then .releaseSha else empty end' "$state" 2>/dev/null || true)"
  [[ "$prior_sha" =~ ^[0-9a-f]{40}$ ]] || {
    printf 'position recovery state is malformed and will not be rewritten: %s\n' "$state" >&2
    return 1
  }
  backup="$state.before-$DEPLOYED_SHA-$(date -u +%Y%m%dT%H%M%SZ)"
  cp -a -- "$state" "$backup"
  chown root:root "$backup"
  chmod 0600 "$backup"
  tmp="$state.$$.tmp"
  printf '{"schema":"disdex-runner-position-recovery/v1","releaseSha":"%s","runners":{}}\n' "$DEPLOYED_SHA" > "$tmp"
  chown root:root "$tmp"
  chmod 0600 "$tmp"
  mv -f -- "$tmp" "$state"
  printf 'DISDEX_POSITION_RECOVERY_STATE_MIGRATED fromSha=%s toSha=%s backup=%s\n' "$prior_sha" "$DEPLOYED_SHA" "$backup"
}

normalize_live_state_ownership() {
  local state_path
  # Trading daemons run as deploy and must be able to read/write the shared
  # reservation registry.  Keep the same fail-closed 0600 contract as the
  # per-runner state files; root retains access for migration/recovery.
  for state_path in "${LIVE_STATE_FILES[@]}" "$PENDING_EXPOSURE_REGISTRY_PATH"; do
    [[ -e "$state_path" ]] || continue
    [[ -f "$state_path" && ! -L "$state_path" ]] || {
      printf 'LIVE state path is not a regular file: %s\n' "$state_path" >&2
      return 1
    }
    # This changes metadata only; it never rewrites or recreates LIVE state.
    chown deploy:deploy "$state_path"
    chmod 0600 "$state_path"
  done
}

remove_stale_auto_repair_unit_pin_dropins() {
  local current_dropin="${AUTO_REPAIR_DROPIN_DIR}/zzzzzzzzzzzz-current-release.conf"
