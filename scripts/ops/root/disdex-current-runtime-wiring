load_runtime_migration_environment() {
  set -a
  for env_file in \
    /etc/disdex/disdex-v13d-v11eq-v96.env \
    /etc/disdex/disdex-v12-pengu-v2-v52.env \
    /etc/disdex/disdex-v12-x1-all.env \
    /etc/disdex/disdex-quality102-causal-v1.env \
    "$CONTRACT_ENV_FILE"; do
    [[ -f "$env_file" ]] && . "$env_file"
  done
  set +a
}

state_runtime_sha() {
  local state_path="$1"
  /usr/bin/jq -r '.runtimeCommitSha // .runtimeSha // empty' "$state_path"
}

migrate_quality102_state_lineage() {
  local state_path=/var/lib/disdex/quality102-causal-v1/state.json
  [[ -f "$state_path" ]] || return 0
  local from_sha
  from_sha="$(state_runtime_sha "$state_path")"
  [[ "$from_sha" == "$DEPLOYED_SHA" ]] && return 0
  "$CURRENT_RELEASE/node_modules/.bin/tsx" \
    "$CURRENT_RELEASE/scripts/disdex-quality102-causal-v1-state-migrate.ts" \
    --state-path "$state_path" \
    --from-sha "$from_sha" \
    --to-sha "$DEPLOYED_SHA"
}

migrate_v12_state_lineage() {
  local state_path=/var/lib/disdex/v12-x1-all/runner.json
  [[ -f "$state_path" ]] || return 0
  local from_sha manual_review kill_active
  from_sha="$(state_runtime_sha "$state_path")"
  [[ "$from_sha" == "$DEPLOYED_SHA" ]] && return 0
  manual_review="$(/usr/bin/jq -r '.manualReview // empty' "$state_path")"
  kill_active="$(/usr/bin/jq -r '.killSwitch.active // false' "$state_path")"
  if [[ "$manual_review" == "QUALITY102_OWNERSHIP_RUNTIME_SHA_MISMATCH" && "$kill_active" == "true" ]]; then
    load_runtime_migration_environment
    "$CURRENT_RELEASE/node_modules/.bin/tsx" \
      "$CURRENT_RELEASE/scripts/disdex-v12-runtime-lineage-recovery.ts" \
      --sha "$DEPLOYED_SHA" \
      --ack I_ACK_V12_RUNTIME_LINEAGE_RECOVERY_AFTER_READONLY_FLAT
    return 0
  fi
  if /usr/bin/jq -e '((.activePositions // (if .active then [.active] else [] end)) | length) > 0' "$state_path" >/dev/null; then
    [[ "${DISDEX_ALLOW_V12_ACTIVE_SHA_MIGRATION:-false}" == "true" ]] || {
      printf 'V12 active state migration is not explicitly authorized for this cutover\n' >&2
      return 1
    }
    load_runtime_migration_environment
    "$CURRENT_RELEASE/node_modules/.bin/tsx" \
      "$CURRENT_RELEASE/scripts/disdex-v12-active-state-sha-migrate.ts" \
      --from-sha "$from_sha" \
      --to-sha "$DEPLOYED_SHA" \
      --state-path "$state_path" \
      --ack I_ACK_V12_ACTIVE_STATE_SHA_MIGRATION_AFTER_READONLY_RECONCILIATION
    return 0
  fi
  "$CURRENT_RELEASE/node_modules/.bin/tsx" \
    "$CURRENT_RELEASE/scripts/disdex-flat-state-sha-migrate.ts" \
    --strategy V12 \
    --state-path "$state_path" \
    --from-sha "$from_sha" \
    --to-sha "$DEPLOYED_SHA"
}

