#!/usr/bin/env bash
set -Eeuo pipefail

umask 077
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
[[ "$(id -u)" == "0" ]] || { printf 'V12_LIVE_STATUS_REQUIRES_ROOT\n' >&2; exit 1; }
sha="${1:-}"
mode="${2:-final}"
[[ "$sha" =~ ^[0-9a-f]{40}$ ]] || { printf 'V12_LIVE_STATUS_INVALID_SHA\n' >&2; exit 2; }
[[ "$mode" == "pre-enable" || "$mode" == "final" ]] || { printf 'V12_LIVE_STATUS_INVALID_MODE\n' >&2; exit 2; }
release="/home/deploy/disdex-trading/releases/$sha"
current=/home/deploy/disdex-trading/current
[[ -d "$release" && ! -L "$release" ]] || { printf 'V12_LIVE_STATUS_RELEASE_INVALID\n' >&2; exit 2; }
[[ -L "$current" && "$(readlink -f "$current")" == "$release" ]] || { printf 'V12_LIVE_STATUS_CURRENT_MISMATCH\n' >&2; exit 2; }
[[ -f "$release/.disdex-release-sha" && "$(tr -d '[:space:]' < "$release/.disdex-release-sha")" == "$sha" ]] || { printf 'V12_LIVE_STATUS_RELEASE_MARKER_MISMATCH\n' >&2; exit 2; }
[[ -f "$release/.disdex-release-source-tree" ]] || { printf 'V12_LIVE_STATUS_SOURCE_TREE_MISSING\n' >&2; exit 2; }
source_tree="$(tr -d '[:space:]' < "$release/.disdex-release-source-tree")"
[[ "$source_tree" =~ ^[0-9a-f]{40}$ ]] || { printf 'V12_LIVE_STATUS_SOURCE_TREE_INVALID\n' >&2; exit 2; }

target="disdex-v12-pengu-v2-v52@$sha.target"
auto_repair_path=disdex-v12-kill-switch-auto-repair.path
v12="disdex-v12-x1-all@$sha.service"
pengu="disdex-pengu-dual-ls-v2@$sha.service"
v52="disdex-v52-aster-only@$sha.service"
risk="disdex-shared-crypto-risk@$sha.service"
margin="disdex-v12-v52-margin-guard@$sha.service"
known_old_units=(disdex-v96-v52-live.service disdex-v13d-v11eq-v96.service)
present_old_units=()

state_of() { systemctl is-active "$1" 2>/dev/null || true; }
pid_of() { systemctl show "$1" --property MainPID --value 2>/dev/null || printf '0'; }
restarts_of() { systemctl show "$1" --property NRestarts --value 2>/dev/null || printf '0'; }
unit_exists() { systemctl cat "$1" >/dev/null 2>&1; }
require_active() {
  local unit="$1" state pid
  state="$(state_of "$unit")"; pid="$(pid_of "$unit")"
  [[ "$state" == "active" && "$pid" != "0" ]] || { printf 'V12_LIVE_STATUS_REQUIRED_UNIT_NOT_ACTIVE unit=%s state=%s pid=%s\n' "$unit" "$state" "$pid" >&2; return 1; }
}
run_readonly_oneshot() {
  local unit="$1" label="$2"
  systemctl reset-failed "$unit" >/dev/null 2>&1 || true
  if ! systemctl start "$unit"; then
    printf 'V12_LIVE_STATUS_READONLY_CHECK_FAILED label=%s unit=%s\n' "$label" "$unit" >&2
    journalctl -u "$unit" --no-pager -n 120 >&2 || true
    return 1
  fi
  [[ "$(systemctl show "$unit" --property Result --value)" == "success" ]] || {
    printf 'V12_LIVE_STATUS_READONLY_CHECK_RESULT_FAILED label=%s unit=%s\n' "$label" "$unit" >&2
    journalctl -u "$unit" --no-pager -n 120 >&2 || true
    return 1
  }
}

for unit in "$v12" "$pengu" "$v52" "$risk" "$margin"; do require_active "$unit"; done
[[ "$(state_of "$target")" == "active" ]] || { printf 'V12_LIVE_STATUS_TARGET_NOT_ACTIVE\n' >&2; exit 3; }
if [[ "$mode" == "pre-enable" ]]; then
  systemctl is-enabled --quiet "$target" 2>/dev/null && { printf 'V12_LIVE_STATUS_TARGET_PREMATURELY_ENABLED\n' >&2; exit 3; }
else
  systemctl is-enabled --quiet "$target" || { printf 'V12_LIVE_STATUS_TARGET_NOT_ENABLED\n' >&2; exit 3; }
  [[ "$(state_of "$auto_repair_path")" == "active" ]] || { printf 'V12_LIVE_STATUS_AUTO_REPAIR_PATH_NOT_ACTIVE\n' >&2; exit 3; }
fi

for unit in "${known_old_units[@]}"; do
  if unit_exists "$unit"; then
    present_old_units+=("$unit")
    [[ "$(state_of "$unit")" != "active" && "$(pid_of "$unit")" == "0" ]] || { printf 'V12_LIVE_STATUS_V96_STILL_ACTIVE unit=%s\n' "$unit" >&2; exit 3; }
    systemctl is-enabled --quiet "$unit" 2>/dev/null && { printf 'V12_LIVE_STATUS_V96_STILL_ENABLED unit=%s\n' "$unit" >&2; exit 3; }
    systemctl cat "$unit" 2>/dev/null | grep -Fq 'ExecStartPre=/usr/local/libexec/disdex-v96-refuse-while-v12-active' || {
      printf 'V12_LIVE_STATUS_V96_REVERSE_INTERLOCK_MISSING unit=%s\n' "$unit" >&2
      exit 3
    }
  fi
done
(( ${#present_old_units[@]} >= 1 )) || { printf 'V12_LIVE_STATUS_NO_KNOWN_V96_SUPERVISOR_PRESENT\n' >&2; exit 3; }
if pgrep -af '[d]isdex-v96-live-runner\.ts' >/dev/null 2>&1 || pgrep -af '[d]isdex-v13d-v11eq-v96-live-runner\.ts' >/dev/null 2>&1; then
  printf 'V12_LIVE_STATUS_ORPHAN_V96_PROCESS\n' >&2
  exit 3
fi

# Each check uses production credentials only for authenticated reads. They do
# not evaluate a strategy entry or submit/cancel an order.
run_readonly_oneshot "disdex-v12-runtime-status@$sha.service" V12_RUNTIME
run_readonly_oneshot "disdex-pengu-v2-readiness@$sha.service" PENGU_V2
run_readonly_oneshot "disdex-v52-v12-readiness@$sha.service" V52

if [[ "$mode" == "pre-enable" ]]; then
  printf 'STATUS: LIVE_RUNTIME_VERIFIED_PRE_ENABLE\n'
  boot_enabled=FALSE
else
  printf 'STATUS: LIVE_ACTIVATED_VERIFIED\n'
  boot_enabled=TRUE
fi
printf 'releaseSha=%s\nsourceTree=%s\ncurrentRelease=%s\nverificationMode=%s\n' "$sha" "$source_tree" "$(readlink -f "$current")" "$mode"
printf 'presentLegacyV96Units=%s\n' "${present_old_units[*]}"
printf 'V96_STOPPED=TRUE\nV12_LIVE_STARTED=TRUE\nPENGU_V2_RUNNING=TRUE\nV52_RUNNING=TRUE\n'
printf 'SHARED_CRYPTO_RISK_RUNNING=TRUE\nFULL_UNIVERSE_MARGIN_GUARD_RUNNING=TRUE\n'
printf 'V12_RUNTIME_RECONCILIATION_PASS=TRUE\nPENGU_V2_READINESS_PASS=TRUE\nV52_READINESS_PASS=TRUE\n'
printf 'V96_REVERSE_INTERLOCK_VERIFIED=TRUE\nV96_V12_SIMULTANEOUS_LIVE=FALSE\nV12_BOOT_TARGET_ENABLED=%s\nORDERS_SENT_FOR_TESTING=0\n' "$boot_enabled"
printf 'V12_KILL_SWITCH_AUTO_REPAIR=EVENT_DRIVEN\nV12_HOURLY_INSPECTION_TIMER=REMOVED\n'
printf 'v12MainPid=%s\nv12Restarts=%s\npenguMainPid=%s\npenguRestarts=%s\nv52MainPid=%s\nv52Restarts=%s\n' \
  "$(pid_of "$v12")" "$(restarts_of "$v12")" \
  "$(pid_of "$pengu")" "$(restarts_of "$pengu")" \
  "$(pid_of "$v52")" "$(restarts_of "$v52")"
printf '%s\n' '--- V12 runtime evidence ---'
journalctl -u "disdex-v12-runtime-status@$sha.service" --no-pager -n 20 | grep -E 'V12_RUNTIME_RECONCILIATION_(PASS|FAILED)' || true
printf '%s\n' '--- PENGU V2 evidence ---'
journalctl -u "disdex-pengu-v2-readiness@$sha.service" --no-pager -n 20 | grep -E 'PENGU_V2_LIVE_READINESS_(PASS|FAILED)' || true
printf '%s\n' '--- V52 evidence ---'
journalctl -u "disdex-v52-v12-readiness@$sha.service" --no-pager -n 30 | tail -n 10
