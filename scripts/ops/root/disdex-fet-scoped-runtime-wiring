#!/usr/bin/env bash
set -Eeuo pipefail

umask 077
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

TRADING_ROOT="${DISDEX_TRADING_ROOT:-/home/deploy/disdex-trading}"
TRADING_RELEASES="${TRADING_ROOT}/releases"
TRADING_CURRENT="${TRADING_ROOT}/current"
SHARED_ROOT="${DISDEX_SHARED_ROOT:-/var/lib/disdex/shared}"
RUNTIME_ENV_DIR="/etc/disdex/current-runtime"
SCOPE_ENV_FILE=""
CURRENT_SHA=""
FET_SHA=""
FET_RELEASE_ROOT=""
ACTIVATION_PATH="${SHARED_ROOT}/operator-activation/fet-brk48.json"
MODE="--check"

HEALTH_DROPIN_DIR="/etc/systemd/system/disdex-runner-health-snapshot.service.d"
WATCHDOG_DROPIN_DIR="/etc/systemd/system/disdex-runner-watchdog.service.d"
ALERT_DROPIN_DIR="/etc/systemd/system/disdex-runner-health-alert.service.d"
DROPIN_NAME="zzzzzzzzzzzzzzzzzzzz-current-release.conf"
FET_INSTANCE_DROPIN_NAME="zzzzzz-fet-scoped-runtime.conf"

usage() {
  printf '%s\n' \
    'Usage: disdex-fet-scoped-runtime-wiring --current-sha SHA --fet-sha SHA [--fet-release-root PATH] [--activation-path PATH] [--check|--apply|--self-test]' \
    '  This helper changes only FET runtime scope, monitor pins, and the FET unit template.'
}

exact_sha() { [[ "${1:-}" =~ ^[0-9a-f]{40}$ ]]; }

require_root_for_apply() {
  [[ "$(id -u)" == "0" ]] || { printf 'FET scoped wiring apply must run as root\n' >&2; return 1; }
}

write_atomic() {
  local target="$1" content="$2" directory temporary
  directory="$(dirname -- "$target")"
  install -d -o root -g root -m 0755 "$directory"
  [[ ! -L "$target" ]] || { printf 'refusing symlink runtime artifact: %s\n' "$target" >&2; return 1; }
  temporary="$(mktemp "${directory}/.fet-scoped-wiring.XXXXXX")"
  trap 'rm -f -- "$temporary"' RETURN
  printf '%s\n' "$content" > "$temporary"
  chown root:root "$temporary"
  chmod 0644 "$temporary"
  mv -f -- "$temporary" "$target"
  trap - RETURN
}

set_env_value() {
  local file="$1" key="$2" value="$3" temporary
  temporary="$(mktemp "${file}.tmp.XXXXXX")"
  trap 'rm -f -- "$temporary"' RETURN
  awk -v key="$key" -v value="$value" '
    index($0, key "=") == 1 { print key "=" value; found=1; next }
    { print }
    END { if (!found) print key "=" value }
  ' "$file" > "$temporary"
  chown root:root "$temporary"
  chmod 0644 "$temporary"
  mv -f -- "$temporary" "$file"
  trap - RETURN
}

validate_release() {
  local sha="$1" root="$2"
  exact_sha "$sha" || { printf 'invalid release SHA: %s\n' "$sha" >&2; return 1; }
  [[ "$root" == "$TRADING_RELEASES/$sha" ]] || { printf 'release root is not exact: %s\n' "$root" >&2; return 1; }
  [[ -d "$root" && ! -L "$root" && -f "$root/.disdex-release-sha" && ! -L "$root/.disdex-release-sha" ]] || { printf 'release or marker is missing/unsafe: %s\n' "$root" >&2; return 1; }
  [[ "$(tr -d '[:space:]' < "$root/.disdex-release-sha")" == "$sha" ]] || { printf 'release marker mismatch: %s\n' "$root" >&2; return 1; }
  [[ -f "$root/scripts/disdex-fet-brk48-live-runner.ts" ]] || { printf 'FET runner is missing: %s\n' "$root" >&2; return 1; }
  [[ -f "$root/ops/systemd/disdex-fet-brk48@.service" ]] || { printf 'FET service template is missing: %s\n' "$root" >&2; return 1; }
  [[ -f "$root/scripts/ops/root/disdex-current-runtime-coherence-guard" ]] || { printf 'coherence guard is missing from FET release\n' >&2; return 1; }
  [[ -f "$root/scripts/ops/root/disdex-runner-watchdog-current.mjs" ]] || { printf 'watchdog monitor is missing from FET release\n' >&2; return 1; }
  [[ -f "$root/scripts/ops/root/disdex-runner-health-snapshot-current.mjs" ]] || { printf 'health monitor is missing from FET release\n' >&2; return 1; }
}

validate_inputs() {
  validate_release "$CURRENT_SHA" "$TRADING_RELEASES/$CURRENT_SHA"
  validate_release "$FET_SHA" "$FET_RELEASE_ROOT"
  [[ -L "$TRADING_CURRENT" ]] || { printf 'current symlink is missing: %s\n' "$TRADING_CURRENT" >&2; return 1; }
  [[ "$(readlink -f -- "$TRADING_CURRENT")" == "$TRADING_RELEASES/$CURRENT_SHA" ]] || {
    printf 'current symlink is not changed/expected: %s\n' "$TRADING_CURRENT" >&2
    return 1
  }
  [[ "$ACTIVATION_PATH" == "$SHARED_ROOT/operator-activation/fet-brk48.json" ]] || {
    printf 'FET activation path must remain the dedicated path: %s\n' "$ACTIVATION_PATH" >&2
    return 1
  }
  [[ ! -L "$ACTIVATION_PATH" ]] || { printf 'FET activation artifact must not be symlinked\n' >&2; return 1; }
  SCOPE_ENV_FILE="${DISDEX_CURRENT_RUNTIME_COHERENCE_SCOPE_ENV_FILE:-$RUNTIME_ENV_DIR/$CURRENT_SHA.fet-scope.env}"
  [[ "$SCOPE_ENV_FILE" == "$RUNTIME_ENV_DIR/$CURRENT_SHA.fet-scope.env" ]] || {
    printf 'FET scope environment path is not canonical: %s\n' "$SCOPE_ENV_FILE" >&2
    return 1
  }
}

read_primary_v12() {
  PRIMARY_MODE="LEGACY"
  V4_SHA=""
  V4_ROOT=""
  local mode_file="$RUNTIME_ENV_DIR/$CURRENT_SHA.v12-primary.env"
  if [[ -f "$mode_file" && ! -L "$mode_file" ]]; then
    PRIMARY_MODE="$(sed -n 's/^DISDEX_PRIMARY_V12_RUNNER=//p' "$mode_file" | tail -n1)"
    V4_SHA="$(sed -n 's/^DISDEX_V12_V4_PRIMARY_SHA=//p' "$mode_file" | tail -n1)"
  fi
  [[ "$PRIMARY_MODE" == "LEGACY" || "$PRIMARY_MODE" == "V4" || "$PRIMARY_MODE" == "DISABLED" ]] || {
    printf 'invalid primary V12 mode: %s\n' "$PRIMARY_MODE" >&2
    return 1
  }
  if [[ "$PRIMARY_MODE" == "V4" ]]; then
    exact_sha "$V4_SHA" || { printf 'V4 primary SHA is missing or invalid\n' >&2; return 1; }
    V4_ROOT="$TRADING_RELEASES/$V4_SHA"
    validate_release "$V4_SHA" "$V4_ROOT"
  fi
}

write_scope_env() {
  write_atomic "$SCOPE_ENV_FILE" "DISDEX_FET_SCOPED_SHA=$FET_SHA
DISDEX_FET_SCOPED_RELEASE_ROOT=$FET_RELEASE_ROOT
DISDEX_RUNTIME_COMMIT_SHA=$FET_SHA
DISDEX_RELEASE_SHA=$FET_SHA
DISDEX_FET_OPERATOR_ACTIVATION_PATH=$ACTIVATION_PATH"
}

write_fet_instance_dropin() {
  local directory="/etc/systemd/system/disdex-fet-brk48@${FET_SHA}.service.d"
  write_atomic "$directory/$FET_INSTANCE_DROPIN_NAME" "[Service]
EnvironmentFile=$SCOPE_ENV_FILE"
}

patch_monitor_environment() {
  local health="$RUNTIME_ENV_DIR/$CURRENT_SHA.health-snapshot.env"
  local watchdog="$RUNTIME_ENV_DIR/$CURRENT_SHA.watchdog.env"
  [[ -f "$health" && ! -L "$health" ]] || { printf 'health environment is missing/unsafe: %s\n' "$health" >&2; return 1; }
  [[ -f "$watchdog" && ! -L "$watchdog" ]] || { printf 'watchdog environment is missing/unsafe: %s\n' "$watchdog" >&2; return 1; }

  set_env_value "$health" DISDEX_HEALTH_SNAPSHOT_EXPECTED_SHA "$FET_SHA"
  set_env_value "$health" DISDEX_HEALTH_SNAPSHOT_RELEASE_ROOT "$FET_RELEASE_ROOT"
  set_env_value "$health" DISDEX_HEALTH_SNAPSHOT_V12_EXPECTED_SHA "${V4_SHA:-$CURRENT_SHA}"
  set_env_value "$health" DISDEX_HEALTH_SNAPSHOT_V12_RELEASE_ROOT "${V4_ROOT:-$TRADING_RELEASES/$CURRENT_SHA}"
  set_env_value "$health" DISDEX_HEALTH_SNAPSHOT_PENGU_EXPECTED_SHA "$CURRENT_SHA"
  set_env_value "$health" DISDEX_HEALTH_SNAPSHOT_PENGU_RELEASE_ROOT "$TRADING_RELEASES/$CURRENT_SHA"
  set_env_value "$health" DISDEX_HEALTH_SNAPSHOT_Q102_EXPECTED_SHA "$CURRENT_SHA"
  set_env_value "$health" DISDEX_HEALTH_SNAPSHOT_Q102_RELEASE_ROOT "$TRADING_RELEASES/$CURRENT_SHA"
  set_env_value "$health" DISDEX_HEALTH_SNAPSHOT_V52_EXPECTED_SHA "$CURRENT_SHA"
  set_env_value "$health" DISDEX_HEALTH_SNAPSHOT_V52_RELEASE_ROOT "$TRADING_RELEASES/$CURRENT_SHA"
  set_env_value "$health" DISDEX_HEALTH_SNAPSHOT_FET_EXPECTED_SHA "$FET_SHA"
  set_env_value "$health" DISDEX_HEALTH_SNAPSHOT_FET_RELEASE_ROOT "$FET_RELEASE_ROOT"
  set_env_value "$health" DISDEX_HEALTH_SNAPSHOT_HYPE_EXPECTED_SHA "$CURRENT_SHA"
  set_env_value "$health" DISDEX_HEALTH_SNAPSHOT_HYPE_RELEASE_ROOT "$TRADING_RELEASES/$CURRENT_SHA"
  set_env_value "$health" DISDEX_HEALTH_SNAPSHOT_IDLE_EXPECTED_SHA "$CURRENT_SHA"
  set_env_value "$health" DISDEX_HEALTH_SNAPSHOT_IDLE_RELEASE_ROOT "$TRADING_RELEASES/$CURRENT_SHA"

  set_env_value "$watchdog" DISDEX_WATCHDOG_RELEASE_ROOT "$FET_RELEASE_ROOT"
  set_env_value "$watchdog" DISDEX_WATCHDOG_EXPECTED_SHA "$FET_SHA"
  set_env_value "$watchdog" DISDEX_WATCHDOG_APPROVED_SHA "$FET_SHA"
  set_env_value "$watchdog" DISDEX_WATCHDOG_RUNNER_SHA "$FET_SHA"
  set_env_value "$watchdog" DISDEX_WATCHDOG_RUNNER_ROOT "$FET_RELEASE_ROOT"
  set_env_value "$watchdog" DISDEX_WATCHDOG_V12_EXPECTED_SHA "${V4_SHA:-$CURRENT_SHA}"
  set_env_value "$watchdog" DISDEX_WATCHDOG_V12_RELEASE_ROOT "${V4_ROOT:-$TRADING_RELEASES/$CURRENT_SHA}"
  set_env_value "$watchdog" DISDEX_WATCHDOG_PENGU_EXPECTED_SHA "$CURRENT_SHA"
  set_env_value "$watchdog" DISDEX_WATCHDOG_PENGU_RELEASE_ROOT "$TRADING_RELEASES/$CURRENT_SHA"
  set_env_value "$watchdog" DISDEX_WATCHDOG_Q102_EXPECTED_SHA "$CURRENT_SHA"
  set_env_value "$watchdog" DISDEX_WATCHDOG_Q102_RELEASE_ROOT "$TRADING_RELEASES/$CURRENT_SHA"
  set_env_value "$watchdog" DISDEX_WATCHDOG_V52_EXPECTED_SHA "$CURRENT_SHA"
  set_env_value "$watchdog" DISDEX_WATCHDOG_V52_RELEASE_ROOT "$TRADING_RELEASES/$CURRENT_SHA"
  set_env_value "$watchdog" DISDEX_WATCHDOG_FET_EXPECTED_SHA "$FET_SHA"
  set_env_value "$watchdog" DISDEX_WATCHDOG_FET_RELEASE_ROOT "$FET_RELEASE_ROOT"
  set_env_value "$watchdog" DISDEX_WATCHDOG_FET_SERVICE_UNIT "disdex-fet-brk48@$FET_SHA.service"
  set_env_value "$watchdog" DISDEX_WATCHDOG_FET_OPERATOR_ACTIVATION_PATH "$ACTIVATION_PATH"
  set_env_value "$watchdog" DISDEX_WATCHDOG_HYPE_EXPECTED_SHA "$CURRENT_SHA"
  set_env_value "$watchdog" DISDEX_WATCHDOG_HYPE_RELEASE_ROOT "$TRADING_RELEASES/$CURRENT_SHA"
  set_env_value "$watchdog" DISDEX_WATCHDOG_IDLE_EXPECTED_SHA "$CURRENT_SHA"
  set_env_value "$watchdog" DISDEX_WATCHDOG_IDLE_RELEASE_ROOT "$TRADING_RELEASES/$CURRENT_SHA"
}

write_monitor_dropins() {
  write_atomic "$HEALTH_DROPIN_DIR/$DROPIN_NAME" "[Service]
EnvironmentFile=
EnvironmentFile=$RUNTIME_ENV_DIR/$CURRENT_SHA.health-snapshot.env
WorkingDirectory=$FET_RELEASE_ROOT
ExecStartPre=
ExecStartPre=/usr/bin/test -f $FET_RELEASE_ROOT/.disdex-release-sha
ExecStartPre=/usr/bin/grep -Fxq $FET_SHA $FET_RELEASE_ROOT/.disdex-release-sha
ExecStart=
ExecStart=/usr/bin/node $FET_RELEASE_ROOT/scripts/ops/root/disdex-runner-health-snapshot-current.mjs"
  write_atomic "$WATCHDOG_DROPIN_DIR/$DROPIN_NAME" "[Service]
EnvironmentFile=
EnvironmentFile=$RUNTIME_ENV_DIR/$CURRENT_SHA.watchdog.env
WorkingDirectory=$FET_RELEASE_ROOT
ExecStartPre=
ExecStartPre=/usr/bin/test -f $FET_RELEASE_ROOT/.disdex-release-sha
ExecStartPre=/usr/bin/grep -Fxq $FET_SHA $FET_RELEASE_ROOT/.disdex-release-sha
ExecStart=
ExecStart=/usr/bin/node $FET_RELEASE_ROOT/scripts/ops/root/disdex-runner-watchdog-current.mjs"
  write_atomic "$ALERT_DROPIN_DIR/$DROPIN_NAME" "[Service]
WorkingDirectory=$FET_RELEASE_ROOT
ExecStart=
ExecStart=$FET_RELEASE_ROOT/node_modules/.bin/tsx $FET_RELEASE_ROOT/scripts/ops/root/disdex-runner-health-alert.ts
Environment=DISDEX_TRADING_ROOT=$FET_RELEASE_ROOT
Environment=DISDEX_ALERT_OPERATOR_ACTIVATION_PATH=$SHARED_ROOT/operator-activation/current.json
Environment=DISDEX_ALERT_V12_SERVICE_UNIT=disdex-v12-v4@${V4_SHA:-$CURRENT_SHA}.service
Environment=DISDEX_ALERT_V12_EXPECTED_SHA=${V4_SHA:-$CURRENT_SHA}
Environment=DISDEX_ALERT_PENGU_V8_SERVICE_UNIT=disdex-pengu-dual-ls-v2@$CURRENT_SHA.service
Environment=DISDEX_ALERT_QUALITY102_SERVICE_UNIT=disdex-quality102-causal-v1@$CURRENT_SHA.service
Environment=DISDEX_ALERT_V52_SERVICE_UNIT=disdex-v52-aster-only@$CURRENT_SHA.service
Environment=DISDEX_ALERT_FET_BRK48_SERVICE_UNIT=disdex-fet-brk48@$FET_SHA.service
Environment=DISDEX_ALERT_HYPE_SERVICE_UNIT=disdex-hype-long@$CURRENT_SHA.service
Environment=DISDEX_ALERT_IDLE_SERVICE_UNIT=disdex-idle-priority-short@$CURRENT_SHA.service
Environment=DISDEX_ALERT_SHARED_CRYPTO_RISK_SERVICE_UNIT=disdex-shared-crypto-risk@$CURRENT_SHA.service
Environment=DISDEX_ALERT_MARGIN_GUARD_SERVICE_UNIT=disdex-v12-v52-margin-guard@$CURRENT_SHA.service
ExecStartPre=/usr/bin/test -f $FET_RELEASE_ROOT/.disdex-release-sha
ExecStartPre=/usr/bin/grep -Fxq $FET_SHA $FET_RELEASE_ROOT/.disdex-release-sha"
}

install_runtime_helpers() {
  install -d -o root -g root -m 0755 /usr/local/sbin
  install -o root -g root -m 0755 "$FET_RELEASE_ROOT/scripts/ops/root/disdex-current-runtime-coherence-guard" /usr/local/sbin/disdex-current-runtime-coherence-guard
  install -o root -g root -m 0755 "$FET_RELEASE_ROOT/scripts/ops/root/disdex-fet-scoped-runtime-wiring" /usr/local/sbin/disdex-fet-scoped-runtime-wiring
}

write_fet_systemd_template() {
  install -o root -g root -m 0644 "$FET_RELEASE_ROOT/ops/systemd/disdex-fet-brk48@.service" /etc/systemd/system/disdex-fet-brk48@.service
}

show_plan() {
  printf 'DISDEX_FET_SCOPED_RUNTIME_WIRING\n'
  printf 'currentSymlink=%s\n' "$TRADING_CURRENT"
  printf 'currentSha=%s\n' "$CURRENT_SHA"
  printf 'fetSha=%s\n' "$FET_SHA"
  printf 'fetReleaseRoot=%s\n' "$FET_RELEASE_ROOT"
  printf 'scopeEnv=%s\n' "$SCOPE_ENV_FILE"
  printf 'activationPath=%s\n' "$ACTIVATION_PATH"
  printf 'primaryV12Mode=%s\n' "$PRIMARY_MODE"
  printf 'v4PrimarySha=%s\n' "${V4_SHA:-none}"
  printf 'ordersSent=0 cancelSent=0 positionChangesSent=0\n'
}

self_test() {
  exact_sha "0123456789abcdef0123456789abcdef01234567"
  [[ "/home/deploy/disdex-trading/releases/0123456789abcdef0123456789abcdef01234567" == "/home/deploy/disdex-trading/releases/0123456789abcdef0123456789abcdef01234567" ]]
  [[ "$ACTIVATION_PATH" == "/var/lib/disdex/shared/operator-activation/fet-brk48.json" ]]
  printf 'DISDEX_FET_SCOPED_RUNTIME_WIRING_SELFTEST_PASS\n'
}

parse_args() {
  while (($#)); do
    case "$1" in
      --current-sha) CURRENT_SHA="${2:-}"; shift 2 ;;
      --fet-sha) FET_SHA="${2:-}"; shift 2 ;;
      --fet-release-root) FET_RELEASE_ROOT="${2:-}"; shift 2 ;;
      --activation-path) ACTIVATION_PATH="${2:-}"; shift 2 ;;
      --check|--apply|--self-test) MODE="$1"; shift ;;
      -h|--help) usage; exit 0 ;;
      *) printf 'unknown argument: %s\n' "$1" >&2; usage >&2; exit 2 ;;
    esac
  done
  if [[ "$MODE" == "--self-test" ]]; then return 0; fi
  SCOPE_ENV_FILE="${DISDEX_CURRENT_RUNTIME_COHERENCE_SCOPE_ENV_FILE:-${SCOPE_ENV_FILE:-}}"
  if [[ -z "$CURRENT_SHA" && -L "$TRADING_CURRENT" ]]; then
    CURRENT_SHA="$(basename -- "$(readlink -f -- "$TRADING_CURRENT")")"
  fi
  if [[ -z "$FET_SHA" && -n "$SCOPE_ENV_FILE" && -f "$SCOPE_ENV_FILE" && ! -L "$SCOPE_ENV_FILE" ]]; then
    FET_SHA="$(sed -n 's/^DISDEX_FET_SCOPED_SHA=//p' "$SCOPE_ENV_FILE" | tail -n1)"
    FET_RELEASE_ROOT="$(sed -n 's/^DISDEX_FET_SCOPED_RELEASE_ROOT=//p' "$SCOPE_ENV_FILE" | tail -n1)"
    ACTIVATION_PATH="$(sed -n 's/^DISDEX_FET_OPERATOR_ACTIVATION_PATH=//p' "$SCOPE_ENV_FILE" | tail -n1)"
  fi
  exact_sha "$CURRENT_SHA" || { printf -- '--current-sha is required and must be exact\n' >&2; exit 2; }
  exact_sha "$FET_SHA" || { printf -- '--fet-sha is required and must be exact\n' >&2; exit 2; }
  FET_RELEASE_ROOT="${FET_RELEASE_ROOT:-$TRADING_RELEASES/$FET_SHA}"
}

main() {
  parse_args "$@"
  if [[ "$MODE" == "--self-test" ]]; then self_test; return; fi
  validate_inputs
  read_primary_v12
  show_plan
  [[ "$MODE" == "--check" ]] && return 0
  require_root_for_apply
  write_scope_env
  patch_monitor_environment
  write_monitor_dropins
  write_fet_systemd_template
  write_fet_instance_dropin
  install_runtime_helpers
  systemctl daemon-reload
  printf 'DISDEX_FET_SCOPED_RUNTIME_WIRING_APPLIED currentSha=%s fetSha=%s ordersSent=0 cancelSent=0 positionChangesSent=0\n' "$CURRENT_SHA" "$FET_SHA"
}

main "$@"
