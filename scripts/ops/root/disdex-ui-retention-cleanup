#!/usr/bin/env python3
from __future__ import annotations

import argparse
import fcntl
import json
import os
import re
import shutil
import subprocess
import time
from dataclasses import dataclass
from pathlib import Path

ROOT = Path("/home/deploy/disdex-trading/ui-releases")
SERVICE = "ai-dex-manager-ui.service"
LOCK = Path("/home/deploy/disdex-ops/ui-retention.lock")
SHA = re.compile(r"^[0-9a-f]{40}$")
KEEP_NONCURRENT = 2
MIN_AGE_SECONDS = 24 * 60 * 60
PRESSURE_PERCENT = 85.0
SYSTEMD_REFERENCE_ROOTS = (Path("/etc/systemd/system"), Path("/usr/lib/systemd/system"), Path("/etc/disdex"))
SYMLINK_SCAN_ROOT = Path("/home/deploy")
PROCESS_ROOT = Path("/proc")


@dataclass(frozen=True)
class ReferenceAudit:
    safe: bool
    references: dict[str, tuple[str, ...]]
    reasons: tuple[str, ...]


def audit_ui_release_references(
    path: Path,
    *,
    systemd_reference_roots: tuple[Path, ...] = SYSTEMD_REFERENCE_ROOTS,
    symlink_scan_root: Path = SYMLINK_SCAN_ROOT,
    process_root: Path = PROCESS_ROOT,
    symlink_references: dict[str, tuple[str, ...]] | None = None,
    symlink_scan_error: str | None = None,
) -> ReferenceAudit:
    references: dict[str, list[str]] = {"systemd": [], "symlink": [], "process": []}
    unavailable: list[str] = []
    path_text = str(path)

    for root in systemd_reference_roots:
        if not root.exists():
            continue
        try:
            for file in root.rglob("*"):
                if file.is_file() and not file.is_symlink():
                    try:
                        if path_text in file.read_text(encoding="utf-8", errors="ignore"):
                            references["systemd"].append(str(file))
                    except OSError:
                        unavailable.append(f"systemd:{file}")
        except OSError:
            unavailable.append(f"systemd:{root}")

    if symlink_scan_error:
        unavailable.append(f"symlink:{symlink_scan_error}")
    else:
        try:
            if symlink_references is None:
                references["symlink"].extend(find_ui_symlink_references(path, symlink_scan_root))
            else:
                references["symlink"].extend(symlink_references.get(str(path), ()))
        except (OSError, RuntimeError) as error:
            unavailable.append(f"symlink:{error}")

    if not process_root.exists():
        unavailable.append(f"process:{process_root}")
    else:
        try:
            for proc in process_root.glob("[0-9]*"):
                try:
                    cwd = (proc / "cwd").resolve(strict=False)
                except OSError:
                    continue
                if cwd == path or str(cwd).startswith(path_text + os.sep):
                    references["process"].append(f"{proc.name} cwd={cwd}")
                try:
                    for fd in (proc / "fd").iterdir():
                        target = os.readlink(fd)
                        if target == path_text or target.startswith(path_text + os.sep):
                            references["process"].append(f"{proc.name} fd={fd.name} -> {target}")
                except OSError:
                    continue
        except OSError:
            unavailable.append(f"process:{process_root}")

    frozen = {key: tuple(values) for key, values in references.items()}
    reasons = tuple([f"{key}={value}" for key, values in frozen.items() if (value := values)] + unavailable)
    return ReferenceAudit(not reasons, frozen, reasons)


def find_ui_symlink_references(path: Path, root: Path) -> list[str]:
    if not root.exists():
        raise RuntimeError(f"scan root missing: {root}")
    find = shutil.which("find")
    if not find:
        raise RuntimeError("find command missing")
    result = subprocess.run(
        [find, str(root), "-xdev", "-type", "l", "(", "-lname", str(path), "-o", "-lname", f"{path}/*", ")", "-print"],
        capture_output=True,
        text=True,
        timeout=30,
        check=False,
    )
    if result.returncode != 0:
        raise RuntimeError(f"find exited {result.returncode}")
    references: list[str] = []
    for line in result.stdout.splitlines():
        candidate = Path(line)
        target = candidate.resolve(strict=False)
        if target == path or str(target).startswith(str(path) + os.sep):
            references.append(f"{candidate} -> {target}")
    return sorted(references)


def find_ui_symlink_references_for_paths(paths: tuple[Path, ...], root: Path) -> dict[str, tuple[str, ...]]:
    """Scan the deployment root once, then index references by UI release."""
    if not paths:
        return {}
    if not root.exists():
        raise RuntimeError(f"scan root missing: {root}")
    find = shutil.which("find")
    if not find:
        raise RuntimeError("find command missing")
    release_root = paths[0].parent
    result = subprocess.run(
        [find, str(root), "-xdev", "-type", "l", "-lname", f"{release_root}/*", "-print"],
        capture_output=True,
        text=True,
        timeout=30,
        check=False,
    )
    if result.returncode != 0:
        raise RuntimeError(f"find exited {result.returncode}")
    indexed: dict[str, list[str]] = {str(path): [] for path in paths}
    for line in result.stdout.splitlines():
        candidate = Path(line)
        target = candidate.resolve(strict=False)
        for path in paths:
            if target == path or str(target).startswith(str(path) + os.sep):
                indexed[str(path)].append(f"{candidate} -> {target}")
                break
    return {key: tuple(sorted(values)) for key, values in indexed.items()}


def release_sha(path: Path) -> str | None:
    if path.is_symlink() or not path.is_dir() or not path.name.startswith("ui-"):
        return None
    values: list[str] = []
    for marker_name in (".disdex-ui-release-sha", ".disdex-ui-sha"):
        marker = path / marker_name
        if marker.is_symlink():
            return None
        if not marker.is_file():
            continue
        try:
            value = marker.read_text(encoding="utf-8").strip()
        except OSError:
            return None
        if not SHA.fullmatch(value):
            return None
        values.append(value)
    if not values or any(value != values[0] for value in values[1:]):
        return None
    return values[0]

def service_working_directory() -> Path:
    value = subprocess.check_output(
        ["systemctl", "show", SERVICE, "--property=WorkingDirectory", "--value"],
        text=True,
        timeout=10,
    ).strip()
    path = Path(value).resolve(strict=True)
    if path.parent != ROOT.resolve() or not release_sha(path):
        raise RuntimeError("UI service WorkingDirectory is not a marker-backed immutable UI release")
    return path


def releases() -> list[Path]:
    if not ROOT.is_dir():
        raise RuntimeError("UI release root is missing")
    rows = [path for path in ROOT.iterdir() if release_sha(path)]
    return sorted(rows, key=lambda item: item.stat().st_mtime, reverse=True)


def all_ui_release_dirs() -> list[Path]:
    if not ROOT.is_dir():
        raise RuntimeError("UI release root is missing")
    return sorted(
        [path for path in ROOT.iterdir() if path.is_dir() and not path.is_symlink() and path.name.startswith("ui-")],
        key=lambda item: item.stat().st_mtime,
        reverse=True,
    )


def path_size(path: Path) -> int:
    return sum(
        file.stat().st_size
        for file in path.rglob("*")
        if file.is_file() and not file.is_symlink()
    )

def main() -> int:
    parser = argparse.ArgumentParser()
    mode = parser.add_mutually_exclusive_group(required=True)
    mode.add_argument("--dry-run", action="store_true")
    mode.add_argument("--apply", action="store_true")
    args = parser.parse_args()

    LOCK.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    with LOCK.open("a+", encoding="utf-8") as lock:
        try:
            fcntl.flock(lock.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            print(json.dumps({"status": "DISDEX_UI_RETENTION_SKIPPED", "reason": "lock_busy"}))
            return 0

        current = service_working_directory()
        rows = releases()
        all_rows = all_ui_release_dirs()
        if current not in rows:
            raise RuntimeError("current UI release failed immutable marker validation")
        protected = {current}
        protected_records: list[dict[str, object]] = [
            {"path": str(current), "reason": "current UI"}
        ]
        for release in rows:
            if release != current and len(protected) < KEEP_NONCURRENT + 1:
                protected.add(release)
                protected_records.append({"path": str(release), "reason": "rollback retention"})

        parent_marker = current / ".disdex-ui-parent-sha"
        parent_sha = parent_marker.read_text(encoding="utf-8").strip() if parent_marker.is_file() else ""
        if parent_marker.is_file() and not SHA.fullmatch(parent_sha):
            raise RuntimeError("current UI parent marker is invalid")
        if parent_sha:
            for release in rows:
                if release_sha(release) == parent_sha:
                    protected.add(release)
                    protected_records.append({"path": str(release), "reason": "current UI parent"})

        usage = shutil.disk_usage(ROOT)
        used_percent = 100.0 * usage.used / usage.total
        under_pressure = used_percent >= PRESSURE_PERCENT
        now = time.time()
        symlink_references: dict[str, tuple[str, ...]] = {}
        symlink_scan_error: str | None = None
        try:
            symlink_references = find_ui_symlink_references_for_paths(tuple(rows), SYMLINK_SCAN_ROOT)
        except (OSError, RuntimeError) as error:
            symlink_scan_error = str(error)
        candidates: list[Path] = []
        reclaimed = 0
        unverified: list[dict[str, object]] = []
        for release in all_rows:
            if release not in rows:
                unverified.append({
                    "path": str(release),
                    "size": path_size(release),
                    "markerSha": None,
                    "parentSha": None,
                    "reason": "UNVERIFIED_PROTECTED:no valid identity marker or marker conflict",
                    "references": {},
                })
        for release in rows:
            if release in protected:
                continue
            if not under_pressure and now - release.stat().st_mtime < MIN_AGE_SECONDS:
                continue
            audit = audit_ui_release_references(
                release,
                symlink_references=symlink_references,
                symlink_scan_error=symlink_scan_error,
            )
            if not audit.safe:
                unverified.append({
                    "path": str(release),
                    "size": path_size(release),
                    "markerSha": release_sha(release),
                    "parentSha": None,
                    "reason": "UNVERIFIED_PROTECTED:external reference or scan uncertainty",
                    "references": audit.references,
                })
                protected.add(release)
                continue
            candidates.append(release)
            reclaimed += path_size(release)
            if args.apply:
                shutil.rmtree(release)

        payload = {
            "status": "DISDEX_UI_RETENTION_PASS",
            "dryRun": not args.apply,
            "filesystemUsedPct": round(used_percent, 2),
            "underPressure": under_pressure,
            "currentRelease": str(current),
            "protectedReleases": [str(path) for path in sorted(protected)],
            "protected": protected_records,
            "deleteCandidates": [
                {"path": str(path), "size": path_size(path), "reason": "all strict deletion checks passed"}
                for path in candidates
            ],
            "unverifiedProtected": unverified,
            "deletedReleases": [str(path) for path in candidates],
            "bytesReclaimed": reclaimed,
            "tradingReleaseDeleted": False,
            "runtimeStateDeleted": False,
            "approvalDeleted": False,
            "killSwitchDeleted": False,
            "ordersSent": False,
            "cancelSent": False,
            "positionChangesSent": False,
        }
        print(json.dumps(payload, sort_keys=True))
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except Exception as error:
        print(f"DISDEX_UI_RETENTION_FAIL_CLOSED:{error}", file=__import__("sys").stderr)
        raise SystemExit(1)
