#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

[[ "$(id -u)" == "0" ]] || { echo "DISDEX_ROOT_REQUIRED" >&2; exit 1; }

usage() {
  echo "usage: install-disdex-v4-evidence-refresh --release-root /home/deploy/disdex-trading/releases/<sha>" >&2
  exit 2
}

release_root=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --release-root)
      [[ $# -eq 2 ]] || usage
      release_root="$2"
      shift 2
      ;;
    *)
      usage
      ;;
  esac
done

[[ "$release_root" =~ ^/home/deploy/disdex-trading/releases/[0-9a-f]{40}$ ]] || {
  echo "DISDEX_RELEASE_ROOT_INVALID" >&2
  exit 1
}
sha="${release_root##*/}"
[[ -d "$release_root" && ! -L "$release_root" ]] || {
  echo "DISDEX_RELEASE_DIRECTORY_INVALID" >&2
  exit 1
}
[[ "$(stat -c '%U:%G' "$release_root")" == "root:root" ]] || {
  echo "DISDEX_RELEASE_DIRECTORY_OWNER_INVALID" >&2
  exit 1
}
release_mode="$(stat -c '%a' "$release_root")"
(( (0$release_mode & 022) == 0 )) || {
  echo "DISDEX_RELEASE_DIRECTORY_WRITABLE" >&2
  exit 1
}
marker="$release_root/.disdex-release-sha"
[[ -f "$marker" && ! -L "$marker" ]] || {
  echo "DISDEX_RELEASE_MARKER_MISSING" >&2
  exit 1
}
[[ "$(stat -c '%U:%G' "$marker")" == "root:root" ]] || {
  echo "DISDEX_RELEASE_MARKER_METADATA_INVALID" >&2
  exit 1
}
marker_mode="$(stat -c '%a' "$marker")"
(( (0$marker_mode & 0222) == 0 )) || {
  echo "DISDEX_RELEASE_MARKER_WRITABLE" >&2
  exit 1
}
[[ "$(tr -d '\r\n' < "$marker")" == "$sha" ]] || {
  echo "DISDEX_RELEASE_MARKER_MISMATCH" >&2
  exit 1
}

for source in \
  scripts/ops/root/disdex-v4-dynamic-evidence-refresh.ts \
  scripts/ops/root/disdex-v4-evidence-refresh-activate \
  ops/systemd/disdex-v4-dynamic-evidence-refresh@.service \
  ops/systemd/disdex-v4-dynamic-evidence-refresh@.timer; do
  [[ -f "$release_root/$source" && ! -L "$release_root/$source" ]] || {
    echo "DISDEX_V4_REFRESH_SOURCE_MISSING:$source" >&2
    exit 1
  }
done

# Stage the lease directory and the exact template units only. This command
# never enables, starts, stops, restarts, or changes a trading Runner.
install -d -o root -g root -m 0750 /var/lib/disdex/unified-deploy/refresh-leases/v4
install -o root -g root -m 0644 \
  "$release_root/ops/systemd/disdex-v4-dynamic-evidence-refresh@.service" \
  /etc/systemd/system/disdex-v4-dynamic-evidence-refresh@.service
install -o root -g root -m 0644 \
  "$release_root/ops/systemd/disdex-v4-dynamic-evidence-refresh@.timer" \
  /etc/systemd/system/disdex-v4-dynamic-evidence-refresh@.timer
/usr/bin/systemctl daemon-reload

printf 'DISDEX_V4_REFRESH_SCHEDULE_STAGED sha=%s scope=V4_EVIDENCE_REFRESH_ONLY ordersEnabled=false\n' "$sha"
