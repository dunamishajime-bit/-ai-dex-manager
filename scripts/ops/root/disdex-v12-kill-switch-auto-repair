#!/usr/bin/env bash
set -Eeuo pipefail

umask 077
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

[[ "$(id -u)" == "0" ]] || { printf 'V12_AUTO_REPAIR_ROOT_REQUIRED\n' >&2; exit 1; }
current_link=/home/deploy/disdex-trading/current
current="$(readlink -f "$current_link" 2>/dev/null || true)"
[[ "$current" == /home/deploy/disdex-trading/releases/* && -d "$current" && ! -L "$current" ]] || {
  printf 'V12_AUTO_REPAIR_CURRENT_INVALID\n' >&2
  exit 2
}
sha="$(basename "$current")"
[[ "$sha" =~ ^[0-9a-f]{40}$ ]] || { printf 'V12_AUTO_REPAIR_CURRENT_SHA_INVALID\n' >&2; exit 2; }
[[ -f "$current/.disdex-release-sha" && "$(tr -d '[:space:]' < "$current/.disdex-release-sha")" == "$sha" ]] || {
  printf 'V12_AUTO_REPAIR_RELEASE_MARKER_MISMATCH\n' >&2
  exit 2
}
cd "$current"
target="disdex-v12-pengu-v2-v52@$sha.target"
kill_file="${DISDEX_SHARED_KILL_SWITCH_FILE:-/home/deploy/ai-dex-manager-v96-paper/.runtime-state/disdex-v13d-v11eq-v96/kill-switch.json}"
repair_mode="${V12_AUTO_REPAIR_MODE:-CODEX_THREAD_HANDOFF}"

# A known flatten/restart recovery must quiesce the composition first because
# the audited recovery programs require the account and open-order view to be
# stable. Unknown/manual reasons are never stopped or auto-cleared.
if [[ "$repair_mode" == "DETERMINISTIC" ]]; then
  kill_active=false
  kill_reason=""
  if [[ -f "$kill_file" ]]; then
    kill_active="$(/usr/bin/jq -r 'if .active == true then "true" else "false" end' "$kill_file" 2>/dev/null || printf 'false')"
    kill_reason="$(/usr/bin/jq -r '.reason // ""' "$kill_file" 2>/dev/null || true)"
  fi
  case "$kill_reason" in
    "V96/V52 trading supervisor exited unexpectedly with status 1"|"V52 margin-aware fatal tick error:"*)
      if [[ "$kill_active" == "true" ]]; then
        systemctl stop "$target" 2>/dev/null || true
        for _ in 1 2 3 4 5 6; do
          [[ "$(systemctl is-active "$target" 2>/dev/null || true)" != "active" ]] || { sleep 1; continue; }
          break
        done
        [[ "$(systemctl is-active "$target" 2>/dev/null || true)" != "active" ]] || {
          printf 'V12_AUTO_REPAIR_TARGET_QUIESCE_FAILED target=%s\n' "$target" >&2
          exit 3
        }
      fi
      ;;
  esac
fi

tmp="$(mktemp /tmp/disdex-v12-auto-repair.XXXXXX)"
trap 'rm -f "$tmp"' EXIT
if ! runuser -u deploy --preserve-environment -- env HOME=/home/deploy NODE_ENV=production PYTHONPATH=/home/deploy/dis-dex-manager/.venv-stock/lib/python3.12/site-packages \
  "$current/node_modules/.bin/tsx" "$current/scripts/disdex-v12-kill-switch-auto-repair.ts" "$sha" >"$tmp" 2>&1; then
  cat "$tmp" >&2
  exit 4
fi
cat "$tmp"
if grep -Fq '"status":"V12_CODEX_THREAD_HANDOFF_PENDING"' "$tmp"; then
  printf 'V12_CODEX_THREAD_ACTION_REQUIRED=true\ntargetThreadId=%s\nordersSent=false\n' "${V12_CODEX_REPAIR_THREAD_ID:-01a0261e-6073-7381-bfb5-3807db374e2a}" >&2
  exit 0
fi
if ! grep -Fq '"status":"V12_AUTO_REPAIR_READY"' "$tmp"; then
  printf 'V12_AUTO_REPAIR_NO_LIVE_RESUME status=not-ready target=%s\n' "$target" >&2
  exit 0
fi

if ! systemctl is-enabled --quiet "$target" 2>/dev/null; then
  printf 'V12_AUTO_REPAIR_TARGET_DISABLED_OPERATOR_REVIEW_REQUIRED target=%s\n' "$target" >&2
  exit 5
fi
if ! systemctl start "$target"; then
  runuser -u deploy --preserve-environment -- env HOME=/home/deploy NODE_ENV=production \
    "$current/node_modules/.bin/tsx" "$current/scripts/disdex-v12-kill-switch-auto-repair.ts" "$sha" --fail-closed V12_AUTO_REPAIR_TARGET_START_FAILED || true
  exit 6
fi
if [[ "$(systemctl is-active "$target" 2>/dev/null || true)" != "active" ]]; then
  runuser -u deploy --preserve-environment -- env HOME=/home/deploy NODE_ENV=production \
    "$current/node_modules/.bin/tsx" "$current/scripts/disdex-v12-kill-switch-auto-repair.ts" "$sha" --fail-closed V12_AUTO_REPAIR_TARGET_NOT_ACTIVE || true
  exit 7
fi
printf 'V12_AUTO_REPAIR_LIVE_RESUMED=true\nreleaseSha=%s\ntarget=%s\nordersSent=false\n' "$sha" "$target"
