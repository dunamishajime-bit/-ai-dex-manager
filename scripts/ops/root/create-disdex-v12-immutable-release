#!/usr/bin/env bash
set -Eeuo pipefail

umask 077
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

[[ "$(id -u)" == "0" ]] || { printf 'V12_RELEASE_BUILD_REQUIRES_ROOT\n' >&2; exit 1; }
source_repo="${1:-}"
sha="${2:-}"
[[ "$source_repo" == /* && -d "$source_repo" && ! -L "$source_repo" ]] || {
  printf 'usage: create-disdex-v12-immutable-release /absolute/trusted/git/repo <40-char-sha>\n' >&2
  exit 2
}
[[ "$sha" =~ ^[0-9a-f]{40}$ ]] || { printf 'V12_RELEASE_BUILD_INVALID_SHA\n' >&2; exit 2; }
id deploy >/dev/null 2>&1 || { printf 'V12_RELEASE_BUILD_DEPLOY_USER_MISSING\n' >&2; exit 2; }
command -v runuser >/dev/null || { printf 'V12_RELEASE_BUILD_RUNUSER_MISSING\n' >&2; exit 2; }
command -v git >/dev/null || { printf 'V12_RELEASE_BUILD_GIT_MISSING\n' >&2; exit 2; }
command -v tar >/dev/null || { printf 'V12_RELEASE_BUILD_TAR_MISSING\n' >&2; exit 2; }
command -v npm >/dev/null || { printf 'V12_RELEASE_BUILD_NPM_MISSING\n' >&2; exit 2; }

# The candidate must already exist in the trusted local clone. This command does
# not fetch remote code as root and therefore does not depend on root GitHub
# credentials. A caller may fetch the branch/commit as deploy beforehand.
resolved="$(runuser -u deploy -- git -C "$source_repo" rev-parse --verify "${sha}^{commit}" 2>/dev/null || true)"
[[ "$resolved" == "$sha" ]] || { printf 'V12_RELEASE_BUILD_COMMIT_NOT_AVAILABLE_LOCALLY sha=%s\n' "$sha" >&2; exit 3; }
source_tree="$(runuser -u deploy -- git -C "$source_repo" rev-parse "${sha}^{tree}")"
[[ "$source_tree" =~ ^[0-9a-f]{40}$ ]] || { printf 'V12_RELEASE_BUILD_TREE_INVALID\n' >&2; exit 3; }

release_root=/home/deploy/disdex-trading/releases
release="$release_root/$sha"
staging="$release_root/.staging-$sha-$$"
build_root=/home/deploy/disdex-v12-release-build
archive="$build_root/$sha-$$.tar"

# Do not modify ownership/mode of existing operations directories. The only new
# writable build workspace is dedicated to this immutable-release builder.
[[ -d /home/deploy/disdex-trading && ! -L /home/deploy/disdex-trading ]] || { printf 'V12_RELEASE_BUILD_TRADING_ROOT_INVALID\n' >&2; exit 3; }
[[ -d "$release_root" && ! -L "$release_root" ]] || { printf 'V12_RELEASE_BUILD_RELEASE_ROOT_INVALID\n' >&2; exit 3; }
install -d -o deploy -g deploy -m 0700 "$build_root"

if [[ -e "$release" || -L "$release" ]]; then
  [[ -d "$release" && ! -L "$release" ]] || { printf 'V12_RELEASE_BUILD_EXISTING_TARGET_INVALID\n' >&2; exit 4; }
  [[ -f "$release/.disdex-release-sha" && ! -L "$release/.disdex-release-sha" ]] || { printf 'V12_RELEASE_BUILD_EXISTING_MARKER_MISSING\n' >&2; exit 4; }
  [[ "$(tr -d '[:space:]' < "$release/.disdex-release-sha")" == "$sha" ]] || { printf 'V12_RELEASE_BUILD_EXISTING_MARKER_MISMATCH\n' >&2; exit 4; }
  [[ -f "$release/.disdex-release-source-tree" && ! -L "$release/.disdex-release-source-tree" ]] || { printf 'V12_RELEASE_BUILD_EXISTING_TREE_MARKER_MISSING\n' >&2; exit 4; }
  [[ "$(tr -d '[:space:]' < "$release/.disdex-release-source-tree")" == "$source_tree" ]] || { printf 'V12_RELEASE_BUILD_EXISTING_TREE_MISMATCH\n' >&2; exit 4; }
  [[ -x "$release/node_modules/.bin/tsx" ]] || { printf 'V12_RELEASE_BUILD_EXISTING_TSX_MISSING\n' >&2; exit 4; }
  printf 'V12_IMMUTABLE_RELEASE_ALREADY_VALID\nsha=%s\nsourceTree=%s\nrelease=%s\nordersSent=false\nservicesChanged=false\n' "$sha" "$source_tree" "$release"
  exit 0
fi

cleanup() {
  local status=$?
  rm -f "$archive" 2>/dev/null || true
  if [[ -d "$staging" && ! -L "$staging" ]]; then rm -rf --one-file-system "$staging" 2>/dev/null || true; fi
  exit "$status"
}
trap cleanup EXIT INT TERM HUP
[[ ! -e "$staging" && ! -L "$staging" ]] || { printf 'V12_RELEASE_BUILD_STAGING_COLLISION\n' >&2; exit 4; }
install -d -o deploy -g deploy -m 0700 "$staging"

# Archive the exact commit object rather than copying a potentially dirty
# worktree. Uncommitted or VPS-only source changes cannot silently enter the new
# immutable release.
runuser -u deploy -- git -C "$source_repo" archive --format=tar --output="$archive" "$sha"
runuser -u deploy -- tar -xf "$archive" -C "$staging"

# Inventory only committed extracted source, before node_modules/.next/markers
# are introduced. This supports later inspection without pretending generated
# build output is part of the Git tree.
manifest_tmp="$build_root/.disdex-source-manifest-$sha-$$"
(
  cd "$staging"
  find . -type f -print0 | sort -z | xargs -0 sha256sum
) > "$manifest_tmp"
mv "$manifest_tmp" "$staging/.disdex-release-source-files.sha256"
chown deploy:deploy "$staging/.disdex-release-source-files.sha256"
chmod 0600 "$staging/.disdex-release-source-files.sha256"
printf '%s\n' "$sha" > "$staging/.disdex-release-sha"
printf '%s\n' "$source_tree" > "$staging/.disdex-release-source-tree"
chown deploy:deploy "$staging/.disdex-release-sha" "$staging/.disdex-release-source-tree"
chmod 0600 "$staging/.disdex-release-sha" "$staging/.disdex-release-source-tree"

# The runtime launches TS through tsx, so devDependencies are intentionally
# installed. No production credentials are supplied during release creation.
runuser -u deploy -- env HOME=/home/deploy npm --prefix "$staging" ci
runuser -u deploy -- env HOME=/home/deploy npm --prefix "$staging" run strategy:v12-x1-all:typecheck
runuser -u deploy -- env HOME=/home/deploy npm --prefix "$staging" run strategy:v12-x1-all:selftest
runuser -u deploy -- env HOME=/home/deploy PYTHONPATH="$staging/scripts" python3 "$staging/scripts/disdex_v12_v52_margin_guard_runtime.py" --self-test
runuser -u deploy -- env HOME=/home/deploy PYTHONPATH="$staging/scripts" python3 "$staging/scripts/disdex_v12_v52_live_engine.py" --self-test
runuser -u deploy -- env HOME=/home/deploy PYTHONPATH="$staging/scripts" python3 "$staging/scripts/disdex_v52_reference_recovery_selftest.py"
runuser -u deploy -- env HOME=/home/deploy npm --prefix "$staging" run build

[[ -x "$staging/node_modules/.bin/tsx" ]] || { printf 'V12_RELEASE_BUILD_TSX_MISSING_AFTER_NPM_CI\n' >&2; exit 5; }
[[ -d "$staging/.next" ]] || { printf 'V12_RELEASE_BUILD_NEXT_BUILD_MISSING\n' >&2; exit 5; }
[[ "$(tr -d '[:space:]' < "$staging/.disdex-release-sha")" == "$sha" ]] || { printf 'V12_RELEASE_BUILD_MARKER_MUTATED\n' >&2; exit 5; }
[[ "$(tr -d '[:space:]' < "$staging/.disdex-release-source-tree")" == "$source_tree" ]] || { printf 'V12_RELEASE_BUILD_TREE_MARKER_MUTATED\n' >&2; exit 5; }

# Normalize ownership and make the finalized source/build tree read-only. State,
# logs and secrets live outside the immutable release.
chown -R deploy:deploy "$staging"
find "$staging" -xdev -type d ! -type l -exec chmod a-w {} +
find "$staging" -xdev -type f ! -type l -exec chmod a-w {} +

# Atomic publication. This command never switches /current and never starts or
# stops any trading service.
mv "$staging" "$release"
trap - EXIT INT TERM HUP
rm -f "$archive"

printf 'V12_IMMUTABLE_RELEASE_BUILD_PASS\n'
printf 'sha=%s\nsourceTree=%s\nrelease=%s\n' "$sha" "$source_tree" "$release"
printf 'linuxBuild=PASS\nv12Selftest=PASS\nordersSent=false\nservicesChanged=false\ncurrentChanged=false\n'
