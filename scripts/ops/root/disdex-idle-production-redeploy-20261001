decision=get("/api/system/decision-status?refresh=1")
units=(decision.get("runtime") or {}).get("units",[])
row=[x for x in units if x.get("id")=="IDLE_PRIORITY_SHORT"]
if len(row)!=1 or row[0].get("releaseSha")!=sha or row[0].get("status")!="LIVE":
