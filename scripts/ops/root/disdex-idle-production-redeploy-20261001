        chown root:root "$p"
        chmod 0644 "$p"
        echo "ROLLBACK_SYSTEMD_TEMPLATE_RESTORED=$p"
      fi
    done
    systemctl daemon-reload
    tmp_link="$ROOT/.current-rollback-$REQUEST_ID"
    rm -f "$tmp_link"
    ln -s "$OLD_RELEASE" "$tmp_link"
    mv -Tf "$tmp_link" "$CURRENT"
    if [[ "$rollback_mode" == V12_ACTIVE && -x "$RELEASE/node_modules/.bin/tsx" && -f "$RELEASE/scripts/disdex-v12-active-state-sha-migrate.ts" ]]; then
