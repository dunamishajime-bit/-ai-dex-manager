import json,sys,urllib.request
sha=sys.argv[1]
base="http://127.0.0.1:3001"
def get(path):
    req=urllib.request.Request(base+path,headers={
        "Cookie":"disdex_auth=1",
        "User-Agent":"DisDex-Production-Cutover-Verify",
    })
    with urllib.request.urlopen(req,timeout=30) as r:
        if r.status!=200:
            raise RuntimeError("HP_HTTP_"+path+"_"+str(r.status))
        return json.loads(r.read(1500000))
live=get("/api/system/live-runtime")
if live.get("releaseSha")!=sha:
    raise RuntimeError("HP_LIVE_RUNTIME_SHA_MISMATCH")
idle=get("/api/system/idle-priority-status")
if idle.get("releaseSha")!=sha or idle.get("status")!="LIVE":
    raise RuntimeError("HP_IDLE_NOT_LIVE")
decision=get("/api/system/decision-status?refresh=1")
units=(decision.get("runtime") or {}).get("units",[])
row=[x for x in units if x.get("id")=="IDLE_PRIORITY_SHORT"]
if len(row)!=1 or row[0].get("releaseSha")!=sha or row[0].get("status")!="LIVE":
    raise RuntimeError("HP_IDLE_OVERVIEW_NOT_LIVE")
print("POSTDEPLOY_HP_IDLE_LIVE=PASS")
