#!/usr/bin/env bash
set -Eeuo pipefail
umask 022

: "${FROM_SHA:?FROM_SHA required}"
: "${TARGET_SHA:?TARGET_SHA required}"
: "${REQUEST_ID:?REQUEST_ID required}"
: "${SOURCE_SHA256:?SOURCE_SHA256 required}"
: "${CERT_SHA256:?CERT_SHA256 required}"

ROOT=/home/deploy/disdex-trading
RELEASES="$ROOT/releases"
CURRENT="$ROOT/current"
OLD_RELEASE="$RELEASES/$FROM_SHA"
RELEASE="$RELEASES/$TARGET_SHA"
STAGE="$RELEASES/.${TARGET_SHA}.stage-$REQUEST_ID"
SOURCE_FILE="/tmp/disdex-source-$REQUEST_ID.tgz"
CERT_FILE="/tmp/idle-parity-v3-$REQUEST_ID.json"
SHARED=/var/lib/disdex/shared
BACKUP="/var/lib/disdex/deploy-backups/idle-$REQUEST_ID"
LOCK=/run/lock/disdex-idle-production-redeploy.lock

[[ "$FROM_SHA" =~ ^[a-f0-9]{40}$ ]]
[[ "$TARGET_SHA" =~ ^[a-f0-9]{40}$ ]]
[[ "$REQUEST_ID" =~ ^[0-9]+$ ]]

exec 9>"$LOCK"
flock -n 9 || { echo "DEPLOY_CONCURRENT_LOCK"; exit 40; }

[[ "$(tr -d '[:space:]' < "$CURRENT/.disdex-release-sha")" == "$FROM_SHA" ]]
[[ "$(readlink -f "$CURRENT")" == "$OLD_RELEASE" ]]
[[ -f "$SOURCE_FILE" && -f "$CERT_FILE" ]]
echo "$SOURCE_SHA256  $SOURCE_FILE" | sha256sum -c -
echo "$CERT_SHA256  $CERT_FILE" | sha256sum -c -
[[ ! -e "$RELEASE" && ! -e "$STAGE" ]]

NAMES=(
  disdex-v12-x1-all
  disdex-pengu-dual-ls-v2
  disdex-quality102-causal-v1
  disdex-v52-aster-only
  disdex-fet-brk48
  disdex-hype-long
  disdex-idle-priority-short
  disdex-shared-crypto-risk
  disdex-v12-v52-margin-guard
)
CORE=(
  disdex-v12-x1-all
  disdex-pengu-dual-ls-v2
  disdex-quality102-causal-v1
  disdex-v52-aster-only
  disdex-fet-brk48
)
STATE_PATHS=(
  /var/lib/disdex/v12-x1-all/runner.json
  /var/lib/disdex/pengu-dual-ls-v2/runner-live.json
  /var/lib/disdex/quality102-causal-v1/state.json
  /var/lib/disdex/v52-aster-only/runner-live.json
  /var/lib/disdex/fet-brk48-residual/state.json
  /var/lib/disdex/hype-zec-long/runner.json
  /var/lib/disdex/idle-priority/state.json
  /var/lib/disdex/shared/operator-activation/current.json
  /var/lib/disdex/shared/operator-activation/runtime.json
  /var/lib/disdex/shared/idle-priority-parity-cert.json
)
SYSTEMD_TEMPLATE_PATHS=(
  /etc/systemd/system/disdex-v12-x1-all@.service
  /etc/systemd/system/disdex-pengu-dual-ls-v2@.service
)

load_runtime_env() {
  set -a
  for f in \
    /etc/disdex/disdex-v13d-v11eq-v96.env \
    /etc/disdex/disdex-v12-pengu-v2-v52.env \
    /etc/disdex/disdex-v12-x1-all.env \
    /etc/disdex/disdex-quality102-causal-v1.env \
    "/etc/disdex/current-runtime/$FROM_SHA.env"; do
    [[ -f "$f" ]] && . "$f"
  done
  set +a
}

require_shared_safe() {
  python3 - <<'PY'
import json
def load(p):
    with open(p,encoding="utf-8") as f:
        return json.load(f)
kill=load("/var/lib/disdex/shared/kill-switch.json")
if kill.get("active") is not False:
    raise SystemExit("CUTOVER_KILL_SWITCH_ACTIVE")
guard=load("/var/lib/disdex/shared/margin-risk/guard-live.json")
if guard.get("stage")!="HEALTHY" or guard.get("ordersAllowed") is not True:
    raise SystemExit("CUTOVER_MARGIN_NOT_HEALTHY")
risk=load("/var/lib/disdex/shared/crypto-daily-risk.json")
updated=int(risk.get("updatedAt") or 0)
now=int(__import__("time").time()*1000)
if risk.get("tripped") is not False:
    raise SystemExit("CUTOVER_SHARED_RISK_TRIPPED_OR_UNKNOWN")
if risk.get("sourceComplete") is not True:
    raise SystemExit("CUTOVER_SHARED_RISK_SOURCE_INCOMPLETE")
if updated<=0 or updated>now+60_000 or now-updated>90_000:
    raise SystemExit("CUTOVER_SHARED_RISK_STALE")
try:
    pending=load("/var/lib/disdex/shared/pending-exposure.json")
except FileNotFoundError:
    pending={}
entries=pending.get("entries",{}) if isinstance(pending,dict) else {}
if isinstance(entries,dict) and entries:
    raise SystemExit("CUTOVER_PENDING_EXPOSURE_PRESENT")
idle=load("/var/lib/disdex/idle-priority/state.json")
if idle.get("positions") or idle.get("pending") or idle.get("manualReview"):
    raise SystemExit("CUTOVER_IDLE_NOT_FLAT")
print("CUTOVER_SHARED_STATE=PASS")
PY
}

require_flat_account() {
  local runner_root="$1"
  local tmp budget_tmp
  tmp="$(mktemp)"
  budget_tmp="/tmp/disdex-aster-readonly-budget-cutover-$RANDOM-$.json"
  DISDEX_ASTER_GLOBAL_RATE_BUDGET_PATH="$budget_tmp" \
    "$runner_root/node_modules/.bin/tsx" \
    "$runner_root/scripts/disdex-aster-readonly-account-diagnostic.ts" | tee "$tmp"
  python3 - "$tmp" <<'PY'
import json,sys
rows=[x for x in open(sys.argv[1],encoding="utf-8") if x.lstrip().startswith("{")]
x=json.loads(rows[-1])
assert x["status"]=="ASTER_READONLY_ACCOUNT_DIAGNOSTIC_PASS"
if x.get("positions"):
    raise SystemExit("CUTOVER_ASTER_POSITIONS_PRESENT")
if x.get("openOrders"):
    raise SystemExit("CUTOVER_ASTER_OPEN_ORDERS_PRESENT")
assert x.get("ordersSent")==0 and x.get("cancelsSent")==0 and x.get("positionChangesSent")==0
print("CUTOVER_ASTER_FLAT=PASS")
PY
  rm -f "$tmp"
  rm -rf -- "$budget_tmp" "$budget_tmp.lock" "$budget_tmp.lock.recovery"
}

load_runtime_env
require_shared_safe
require_flat_account "$OLD_RELEASE"

for name in "${NAMES[@]}"; do
  unit="$name@$FROM_SHA.service"
  [[ "$(systemctl is-active "$unit" 2>/dev/null || true)" == active ]] || {
    echo "CUTOVER_OLD_UNIT_NOT_ACTIVE=$unit"
    exit 41
  }
  restart_count="$(systemctl show "$unit" -p NRestarts --value)"
  if [[ "$restart_count" != 0 ]]; then
    if [[ "$name" == disdex-shared-crypto-risk && "$restart_count" == 1 ]]; then
      echo "CUTOVER_KNOWN_SHARED_RISK_TRANSIENT_RESTART_ACCEPTED unit=$unit nRestarts=$restart_count currentRiskFresh=true"
    elif [[ "$name" == disdex-v12-x1-all && "$restart_count" == 1 ]]; then
      pid="$(systemctl show "$unit" -p MainPID --value)"
      result="$(systemctl show "$unit" -p Result --value)"
      [[ "$pid" =~ ^[0-9]+$ && "$pid" -gt 0 && "$result" == success ]] || {
        echo "CUTOVER_KNOWN_V12_RESTART_NOT_CURRENTLY_HEALTHY unit=$unit pid=$pid result=$result"
        exit 42
      }
      python3 - "$FROM_SHA" "$pid" <<'PY'
import json,sys,time
sha=sys.argv[1]
pid=int(sys.argv[2])
now=int(time.time()*1000)
state=json.load(open("/var/lib/disdex/v12-x1-all/runner.json",encoding="utf-8"))
runtime=str(state.get("runtimeSha") or state.get("runtimeCommitSha") or "")
updated=int(state.get("updatedAt") or 0)
if runtime!=sha:
    raise SystemExit("CUTOVER_KNOWN_V12_RESTART_STATE_SHA_MISMATCH")
if updated<=0 or updated>now+60000 or now-updated>3*60*60*1000:
    raise SystemExit("CUTOVER_KNOWN_V12_RESTART_STATE_STALE")
if state.get("manualReview"):
    raise SystemExit("CUTOVER_KNOWN_V12_RESTART_MANUAL_REVIEW_ACTIVE")
if state.get("pending"):
    raise SystemExit("CUTOVER_KNOWN_V12_RESTART_PENDING_ACTIVE")
print("CUTOVER_KNOWN_V12_RESTART_STATE_HEALTHY=PASS")
PY
      echo "CUTOVER_KNOWN_V12_SINGLE_RESTART_ACCEPTED unit=$unit nRestarts=$restart_count pid=$pid result=$result"
    elif [[ "$name" == disdex-quality102-causal-v1 && "$restart_count" == 1 ]]; then
      pid="$(systemctl show "$unit" -p MainPID --value)"
      result="$(systemctl show "$unit" -p Result --value)"
      [[ "$pid" =~ ^[0-9]+$ && "$pid" -gt 0 && "$result" == success ]] || {
        echo "CUTOVER_KNOWN_Q102_RESTART_NOT_CURRENTLY_HEALTHY unit=$unit pid=$pid result=$result"
        exit 42
      }
      python3 - "$FROM_SHA" <<'PY'
import json,sys,time
sha=sys.argv[1]
now=int(time.time()*1000)
state=json.load(open("/var/lib/disdex/quality102-causal-v1/state.json",encoding="utf-8"))
runtime=str(state.get("runtimeSha") or state.get("runtimeCommitSha") or "")
updated=int(state.get("updatedAt") or 0)
if runtime!=sha:
    raise SystemExit("CUTOVER_KNOWN_Q102_RESTART_STATE_SHA_MISMATCH")
if updated<=0 or updated>now+60000 or now-updated>3*60*60*1000:
    raise SystemExit("CUTOVER_KNOWN_Q102_RESTART_STATE_STALE")
if state.get("manualReview"):
    raise SystemExit("CUTOVER_KNOWN_Q102_RESTART_MANUAL_REVIEW_ACTIVE")
if state.get("pending"):
    raise SystemExit("CUTOVER_KNOWN_Q102_RESTART_PENDING_ACTIVE")
print("CUTOVER_KNOWN_Q102_RESTART_STATE_HEALTHY=PASS")
PY
      echo "CUTOVER_KNOWN_Q102_SINGLE_RESTART_ACCEPTED unit=$unit nRestarts=$restart_count pid=$pid result=$result"
    else
      echo "CUTOVER_OLD_UNIT_RESTARTED=$unit nRestarts=$restart_count"
      exit 42
    fi
  fi
done

install -d -o root -g root -m 0700 "$BACKUP"
for p in "${STATE_PATHS[@]}"; do
  if [[ -f "$p" && ! -L "$p" ]]; then
    dest="$BACKUP$p"
    install -d -m 0700 "$(dirname "$dest")"
    cp -a -- "$p" "$dest"
  fi
done
for p in "${SYSTEMD_TEMPLATE_PATHS[@]}"; do
  [[ -f "$p" && ! -L "$p" ]] || {
    echo "CUTOVER_SYSTEMD_TEMPLATE_MISSING=$p"
    exit 43
  }
  dest="$BACKUP$p"
  install -d -m 0700 "$(dirname "$dest")"
  cp -a -- "$p" "$dest"
  echo "CUTOVER_SYSTEMD_TEMPLATE_BACKED_UP=$p"
done

rollback() {
  rc=$?
  trap - ERR
  set +e
  echo "DEPLOY_ROLLBACK_TRIGGERED rc=$rc"
  flat=yes
  load_runtime_env
  runner_root="$(readlink -f "$CURRENT" 2>/dev/null || true)"
  if [[ -z "$runner_root" || ! -x "$runner_root/node_modules/.bin/tsx" ]]; then
    runner_root="$OLD_RELEASE"
  fi
  require_flat_account "$runner_root" >/tmp/disdex-rollback-account.log 2>&1 || flat=no
  cat /tmp/disdex-rollback-account.log || true
  if [[ "$flat" == yes ]]; then
    for name in "${NAMES[@]}"; do
      systemctl disable --now "$name@$TARGET_SHA.service" >/dev/null 2>&1 || true
    done
    for p in "${STATE_PATHS[@]}"; do
      src="$BACKUP$p"
      if [[ -f "$src" ]]; then
        mkdir -p -- "$(dirname "$p")"
        cp -a -- "$src" "$p"
      fi
    done
    for state_dir in /var/lib/disdex/pengu-dual-ls-v2 /var/lib/disdex/idle-priority; do
      if [[ -d "$state_dir" && ! -L "$state_dir" ]]; then
        chown deploy:deploy "$state_dir"
        chmod 0700 "$state_dir"
        echo "ROLLBACK_STATE_DIR_NORMALIZED=$state_dir:deploy:deploy:700"
      fi
    done
    rm -f /var/lib/disdex/runner-health/heartbeats/idle-priority-short.json
    for p in "${SYSTEMD_TEMPLATE_PATHS[@]}"; do
      src="$BACKUP$p"
      if [[ -f "$src" ]]; then
        cp -a -- "$src" "$p"
        chown root:root "$p"
        chmod 0644 "$p"
        echo "ROLLBACK_SYSTEMD_TEMPLATE_RESTORED=$p"
      fi
    done
    systemctl daemon-reload
    tmp_link="$ROOT/.current-rollback-$REQUEST_ID"
    rm -f "$tmp_link"
    ln -s "$OLD_RELEASE" "$tmp_link"
    mv -Tf "$tmp_link" "$CURRENT"
    (cd "$OLD_RELEASE" && bash scripts/ops/root/disdex-current-runtime-wiring --apply) || true
    for name in "${NAMES[@]}"; do
      systemctl enable --now "$name@$FROM_SHA.service" >/dev/null 2>&1 || true
    done
    rm -rf -- "$RELEASE" "$STAGE"
    echo "DEPLOY_ROLLBACK_FLAT_ACCOUNT=PASS"
  else
    echo "DEPLOY_ROLLBACK_SKIPPED_EXPOSURE_PRESENT"
  fi
  exit "$rc"
}
trap rollback ERR

systemctl disable --now disdex-runner-watchdog.timer >/dev/null 2>&1 || true
systemctl stop disdex-runner-watchdog.service >/dev/null 2>&1 || true
systemctl disable --now disdex-runner-position-recovery.timer >/dev/null 2>&1 || true
systemctl stop disdex-runner-position-recovery.service >/dev/null 2>&1 || true
systemctl disable --now disdex-v12-kill-switch-auto-repair.path >/dev/null 2>&1 || true
systemctl stop disdex-v12-kill-switch-auto-repair.service >/dev/null 2>&1 || true
systemctl disable --now disdex-v12-three-hour-health-check.timer >/dev/null 2>&1 || true
systemctl stop disdex-v12-three-hour-health-check.service >/dev/null 2>&1 || true

for name in "${NAMES[@]}"; do
  systemctl stop "$name@$FROM_SHA.service"
done
for name in "${NAMES[@]}"; do
  [[ "$(systemctl is-active "$name@$FROM_SHA.service" 2>/dev/null || true)" != active ]]
done

require_flat_account "$OLD_RELEASE"

echo "CUTOVER_RELEASE_PREP_BEGIN"
echo "CUTOVER_RELEASE_PREP_STEP=stage_dir"
install -d -o deploy -g deploy -m 0755 "$STAGE"
echo "CUTOVER_RELEASE_PREP_STEP=extract"
tar --no-same-owner -xzf "$SOURCE_FILE" -C "$STAGE"
echo "CUTOVER_RELEASE_PREP_STEP=manifest_check"
[[ -f "$STAGE/package.json" && -f "$STAGE/package-lock.json" ]]
old_lock_sha="$(sha256sum "$OLD_RELEASE/package-lock.json" | awk '{print $1}')"
stage_lock_sha="$(sha256sum "$STAGE/package-lock.json" | awk '{print $1}')"
echo "CUTOVER_OLD_PACKAGE_LOCK_SHA256=$old_lock_sha"
echo "CUTOVER_STAGE_PACKAGE_LOCK_SHA256=$stage_lock_sha"
python3 - "$OLD_RELEASE/package-lock.json" "$STAGE/package-lock.json" <<'PY'
import json,sys
old_path,new_path=sys.argv[1:]
old=json.load(open(old_path,encoding="utf-8"))
new=json.load(open(new_path,encoding="utf-8"))
if old.get("lockfileVersion") != new.get("lockfileVersion"):
    raise SystemExit("CUTOVER_LOCKFILE_VERSION_MISMATCH")
def resolved_graph(doc):
    packages=doc.get("packages")
    if not isinstance(packages,dict):
        raise SystemExit("CUTOVER_PACKAGE_LOCK_PACKAGES_MISSING")
    # The root package entry contains requested semver ranges. Runtime reuse is
    # safe only when every resolved node_modules package entry is byte-equivalent
    # as parsed JSON; a root range-only relaxation is allowed.
    return {k:v for k,v in packages.items() if k}
if resolved_graph(old) != resolved_graph(new):
    raise SystemExit("CUTOVER_RESOLVED_DEPENDENCY_GRAPH_MISMATCH")
print("CUTOVER_RESOLVED_DEPENDENCY_GRAPH=PASS")
PY
echo "CUTOVER_RELEASE_PREP_STEP=release_marker"
printf '%s\n' "$TARGET_SHA" > "$STAGE/.disdex-release-sha"
echo "CUTOVER_RELEASE_PREP_STEP=ownership"
chown -R deploy:deploy "$STAGE"
echo "CUTOVER_RELEASE_PREP_STEP=dependency_targets"
node_modules_target="$(readlink -f "$OLD_RELEASE/node_modules" 2>/dev/null || true)"
venv_target="$(readlink -f "$OLD_RELEASE/.venv2" 2>/dev/null || true)"
echo "CUTOVER_NODE_MODULES_TARGET=$node_modules_target"
echo "CUTOVER_VENV_TARGET=$venv_target"
[[ -n "$node_modules_target" && -d "$node_modules_target" ]] || {
  echo "CUTOVER_NODE_MODULES_TARGET_INVALID"
  false
}
[[ -n "$venv_target" && -d "$venv_target" ]] || {
  echo "CUTOVER_VENV_TARGET_INVALID"
  false
}
echo "CUTOVER_RELEASE_PREP_STEP=dependency_links"
ln -s "$node_modules_target" "$STAGE/node_modules"
ln -s "$venv_target" "$STAGE/.venv2"
chown -h deploy:deploy "$STAGE/node_modules" "$STAGE/.venv2"
echo "CUTOVER_RELEASE_PREP_STEP=publish"
mv -- "$STAGE" "$RELEASE"
echo "CUTOVER_RELEASE_PREP_PASS release=$RELEASE"

install -o root -g root -m 0644 "$CERT_FILE" "$SHARED/idle-priority-parity-cert.json"

python3 - "$RELEASE" "$TARGET_SHA" "$SHARED/operator-activation/current.json" <<'PY'
import datetime,json,os,sys,tempfile
release,sha,target_path=sys.argv[1:]
readiness=json.load(open(os.path.join(release,"docs/production/current-implementation-readiness.json"),encoding="utf-8"))
if readiness.get("implementationStatus")!="READY":
    raise SystemExit("OPERATOR_ARTIFACT_IMPLEMENTATION_NOT_READY")
artifact={
    "schema":"disdex-live-operator-activation/v1",
    "target":readiness["target"],
    "approvedSha":sha,
    "approvedRunners":[
        "V12_X1_ALL","PENGU_V8","QUALITY102_CAUSAL_V1","V52",
        "FET_BRK48_RESIDUAL","HYPE_TREND_LONG","IDLE_PRIORITY_SHORT"
    ],
    "ordersEnabled":True,
    "operatorAcknowledgement":"I_ACK_REAL_MONEY_LIVE_ACTIVATION",
    "approvedAt":datetime.datetime.now(datetime.timezone.utc).isoformat().replace("+00:00","Z"),
}
directory=os.path.dirname(target_path)
fd,tmp=tempfile.mkstemp(prefix=".operator-activation.",dir=directory,text=True)
with os.fdopen(fd,"w",encoding="utf-8") as f:
    json.dump(artifact,f,indent=2,sort_keys=True)
    f.write("\n")
    f.flush()
    os.fsync(f.fileno())
os.chmod(tmp,0o644)
os.chown(tmp,0,0)
os.replace(tmp,target_path)
print("OPERATOR_ARTIFACT_EXACT_SHA=PASS")
PY

tmp_link="$ROOT/.current-$REQUEST_ID"
ln -s "$RELEASE" "$tmp_link"
mv -Tf "$tmp_link" "$CURRENT"
[[ "$(tr -d '[:space:]' < "$CURRENT/.disdex-release-sha")" == "$TARGET_SHA" ]]
[[ "$(readlink -f "$CURRENT")" == "$RELEASE" ]]

for state_dir in /var/lib/disdex/pengu-dual-ls-v2 /var/lib/disdex/idle-priority; do
  [[ -d "$state_dir" && ! -L "$state_dir" ]] || {
    echo "CUTOVER_STATE_DIR_INVALID=$state_dir"
    false
  }
  chown deploy:deploy "$state_dir"
  chmod 0700 "$state_dir"
  [[ "$(stat -c '%U:%G:%a' "$state_dir")" == "deploy:deploy:700" ]] || {
    echo "CUTOVER_STATE_DIR_MODE_FAILED=$state_dir"
    false
  }
  echo "CUTOVER_STATE_DIR_NORMALIZED=$state_dir:deploy:deploy:700"
done

echo "CUTOVER_WIRING_BEGIN release=$RELEASE"
(cd "$RELEASE" && DISDEX_CURRENT_RUNTIME_DEFER_OPERATOR_AUTOMATION=true bash scripts/ops/root/disdex-current-runtime-wiring --apply)
echo "CUTOVER_WIRING_PASS automation=deferred"

wait_safety_daemons_ready() {
  local required_consecutive=2
  local consecutive=0
  local attempts=0
  while (( attempts < 45 )); do
    attempts=$((attempts + 1))
    if python3 - <<'PY'
import json,time
now=int(time.time()*1000)
with open("/var/lib/disdex/shared/crypto-daily-risk.json",encoding="utf-8") as f:
    risk=json.load(f)
with open("/var/lib/disdex/shared/margin-risk/guard-live.json",encoding="utf-8") as f:
    guard=json.load(f)
risk_at=int(risk.get("updatedAt") or 0)
guard_at=int(guard.get("checkedAt") or 0)
if risk.get("tripped") is True or risk.get("sourceComplete") is not True:
    raise SystemExit(1)
if risk_at<=0 or now-risk_at>120000 or risk_at>now+60000:
    raise SystemExit(1)
if guard.get("stage")!="HEALTHY" or guard.get("ordersAllowed") is not True:
    raise SystemExit(1)
if guard_at<=0 or now-guard_at>120000 or guard_at>now+60000:
    raise SystemExit(1)
PY
    then
      consecutive=$((consecutive + 1))
      echo "CUTOVER_SAFETY_DAEMONS_HEALTHY attempt=$attempts consecutive=$consecutive"
      if (( consecutive >= required_consecutive )); then
        return 0
      fi
    else
      consecutive=0
      echo "CUTOVER_SAFETY_DAEMONS_WAIT attempt=$attempts"
    fi
    sleep 2
  done
  echo "CUTOVER_SAFETY_DAEMONS_NOT_READY"
  return 1
}

# Start safety daemons first.  Wants/After only orders unit startup; it does not
# guarantee their persisted safety snapshots are already fresh when a trader's
# ExecStartPre or first tick reads them.
systemctl enable --now "disdex-shared-crypto-risk@$TARGET_SHA.service"
systemctl enable --now "disdex-v12-v52-margin-guard@$TARGET_SHA.service"
wait_safety_daemons_ready

for name in "${CORE[@]}"; do
  systemctl enable --now "$name@$TARGET_SHA.service"
done
systemctl enable --now "disdex-hype-long@$TARGET_SHA.service"
systemctl enable --now "disdex-idle-priority-short@$TARGET_SHA.service"

echo "CUTOVER_POSTSTART_WIRING_BEGIN"
(cd "$RELEASE" && bash scripts/ops/root/disdex-current-runtime-wiring --apply)
echo "CUTOVER_POSTSTART_WIRING_PASS"

for name in disdex-v12-x1-all disdex-pengu-dual-ls-v2; do
  unit="$name@$TARGET_SHA.service"
  requires="$(systemctl show "$unit" -p Requires --value)"
  wants="$(systemctl show "$unit" -p Wants --value)"
  [[ " $requires " != *" disdex-shared-crypto-risk@$TARGET_SHA.service "* ]] || {
    echo "POSTDEPLOY_SHARED_RISK_HARD_DEPENDENCY_PRESENT=$unit"
    false
  }
  [[ " $wants " == *" disdex-shared-crypto-risk@$TARGET_SHA.service "* ]] || {
    echo "POSTDEPLOY_SHARED_RISK_SOFT_DEPENDENCY_MISSING=$unit"
    false
  }
  [[ " $requires " != *" disdex-v12-v52-margin-guard@$TARGET_SHA.service "* ]] || {
    echo "POSTDEPLOY_MARGIN_GUARD_HARD_DEPENDENCY_PRESENT=$unit"
    false
  }
  [[ " $wants " == *" disdex-v12-v52-margin-guard@$TARGET_SHA.service "* ]] || {
    echo "POSTDEPLOY_MARGIN_GUARD_SOFT_DEPENDENCY_MISSING=$unit"
    false
  }
  echo "POSTDEPLOY_SAFETY_DAEMON_LIFECYCLE_DECOUPLED unit=$unit"
done

for name in "${NAMES[@]}"; do
  systemctl disable "$name@$FROM_SHA.service" >/dev/null 2>&1 || true
done

sleep 5
systemctl reset-failed disdex-runner-health-snapshot.service >/dev/null 2>&1 || true
systemctl start disdex-runner-health-snapshot.service
sleep 3

for name in "${NAMES[@]}"; do
  unit="$name@$TARGET_SHA.service"
  [[ "$(systemctl is-active "$unit" 2>/dev/null || true)" == active ]] || {
    echo "POSTDEPLOY_RUNNER_NOT_ACTIVE=$unit"
    false
  }
  pid="$(systemctl show "$unit" -p MainPID --value)"
  [[ "$pid" =~ ^[0-9]+$ && "$pid" -gt 0 ]]
  [[ "$(readlink -f "/proc/$pid/cwd")" == "$RELEASE" ]] || {
    echo "POSTDEPLOY_CWD_MISMATCH=$unit"
    false
  }
  [[ "$(systemctl show "$unit" -p NRestarts --value)" == 0 ]] || {
    echo "POSTDEPLOY_RESTART_COUNT_NONZERO=$unit"
    false
  }
  echo "POSTDEPLOY_RUNNER unit=$unit pid=$pid nRestarts=0"
done

