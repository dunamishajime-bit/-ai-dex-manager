  rollback_mode=""
  load_runtime_env
  runner_root="$(readlink -f "$CURRENT" 2>/dev/null || true)"
  if [[ -z "$runner_root" || ! -x "$runner_root/node_modules/.bin/tsx" ]]; then
    runner_root="$OLD_RELEASE"
  fi
  if require_flat_account "$runner_root" >/tmp/disdex-rollback-account.log 2>&1; then
    rollback_mode="FLAT"
  elif [[ "$CUTOVER_ACCOUNT_MODE" == V12_ACTIVE && "$V12_ACTIVE_MIGRATION_CODE_PARITY" == 1 ]]; then
    cat /tmp/disdex-rollback-account.log || true
    if [[ "$TRADING_TARGET_STARTED" == 0 ]]; then
      rollback_mode="V12_ACTIVE"
      echo "DEPLOY_ROLLBACK_V12_ACTIVE_PRESTART_REUSE_PREFLIGHT=PASS"
    elif [[ -x "$RELEASE/node_modules/.bin/tsx" && -f "$RELEASE/scripts/disdex-v12-active-state-sha-migrate.ts" ]]; then
      state_sha="$(/usr/bin/jq -r '.runtimeCommitSha // ""' /var/lib/disdex/v12-x1-all/runner.json 2>/dev/null || true)"
      if [[ "$state_sha" == "$TARGET_SHA" ]]; then
        rollback_other_sha="$FROM_SHA"
      elif [[ "$state_sha" == "$FROM_SHA" ]]; then
        rollback_other_sha="$TARGET_SHA"
      else
        rollback_other_sha=""
      fi
      if [[ -n "$rollback_other_sha" ]] && "$RELEASE/node_modules/.bin/tsx"           "$RELEASE/scripts/disdex-v12-active-state-sha-migrate.ts"           --from-sha "$state_sha"           --to-sha "$rollback_other_sha"           --state-path /var/lib/disdex/v12-x1-all/runner.json           --verify-only           --ack I_ACK_V12_ACTIVE_STATE_SHA_MIGRATION_AFTER_READONLY_RECONCILIATION; then
        rollback_mode="V12_ACTIVE"
        echo "DEPLOY_ROLLBACK_V12_ACTIVE_READONLY_REVERIFY=PASS stateSha=$state_sha"
      fi
    fi
  else
    cat /tmp/disdex-rollback-account.log || true
  fi
  if [[ -n "$rollback_mode" ]]; then
    for name in "${NAMES[@]}"; do
      systemctl disable --now "$name@$TARGET_SHA.service" >/dev/null 2>&1 || true
    done
    for p in "${STATE_PATHS[@]}"; do
      src="$BACKUP$p"
