#!/usr/bin/env bash
set -Eeuo pipefail
umask 022

: "${FROM_SHA:?FROM_SHA required}"
: "${TARGET_SHA:?TARGET_SHA required}"
: "${REQUEST_ID:?REQUEST_ID required}"
: "${SOURCE_SHA256:?SOURCE_SHA256 required}"
: "${CERT_SHA256:?CERT_SHA256 required}"
: "${RESIDUAL_CERT_SHA256:?RESIDUAL_CERT_SHA256 required}"
V12_ACTIVE_MIGRATION_CODE_PARITY="${V12_ACTIVE_MIGRATION_CODE_PARITY:-0}"

ROOT=/home/deploy/disdex-trading
RELEASES="$ROOT/releases"
CURRENT="$ROOT/current"
OLD_RELEASE="$RELEASES/$FROM_SHA"
RELEASE="$RELEASES/$TARGET_SHA"
STAGE="$RELEASES/.${TARGET_SHA}.stage-$REQUEST_ID"
SOURCE_FILE="/tmp/disdex-source-$REQUEST_ID.tgz"
CERT_FILE="/tmp/idle-parity-v3-$REQUEST_ID.json"
RESIDUAL_CERT_FILE="/tmp/idle-residual-long-parity-$REQUEST_ID.json"
SHARED=/var/lib/disdex/shared
BACKUP="/var/lib/disdex/deploy-backups/idle-$REQUEST_ID"
PREFLIGHT_BACKUP="/var/lib/disdex/deploy-backups/idle-preflight-$REQUEST_ID"
LOCK=/run/lock/disdex-idle-production-redeploy.lock

[[ "$FROM_SHA" =~ ^[a-f0-9]{40}$ ]]
[[ "$TARGET_SHA" =~ ^[a-f0-9]{40}$ ]]
[[ "$REQUEST_ID" =~ ^[0-9]+$ ]]
[[ "$V12_ACTIVE_MIGRATION_CODE_PARITY" =~ ^[01]$ ]]

exec 9>"$LOCK"
flock -n 9 || { echo "DEPLOY_CONCURRENT_LOCK"; exit 40; }

[[ "$(tr -d '[:space:]' < "$CURRENT/.disdex-release-sha")" == "$FROM_SHA" ]]
[[ "$(readlink -f "$CURRENT")" == "$OLD_RELEASE" ]]
[[ -f "$SOURCE_FILE" && -f "$CERT_FILE" && -f "$RESIDUAL_CERT_FILE" ]]
echo "$SOURCE_SHA256  $SOURCE_FILE" | sha256sum -c -
echo "$CERT_SHA256  $CERT_FILE" | sha256sum -c -
echo "$RESIDUAL_CERT_SHA256  $RESIDUAL_CERT_FILE" | sha256sum -c -
[[ ! -e "$RELEASE" && ! -e "$STAGE" ]]

NAMES=(
  disdex-v12-x1-all
  disdex-pengu-dual-ls-v2
  disdex-quality102-causal-v1
  disdex-v52-aster-only
  disdex-fet-brk48
  disdex-hype-long
  disdex-idle-priority-short
  disdex-shared-crypto-risk
  disdex-v12-v52-margin-guard
)
CORE=(
  disdex-v12-x1-all
  disdex-pengu-dual-ls-v2
  disdex-quality102-causal-v1
  disdex-v52-aster-only
  disdex-fet-brk48
)
STATE_PATHS=(
  /var/lib/disdex/v12-x1-all/runner.json
  /var/lib/disdex/pengu-dual-ls-v2/runner-live.json
  /var/lib/disdex/quality102-causal-v1/state.json
  /var/lib/disdex/v52-aster-only/runner-live.json
  /var/lib/disdex/fet-brk48-residual/state.json
  /var/lib/disdex/hype-zec-long/runner.json
  /var/lib/disdex/idle-priority/state.json
  /var/lib/disdex/shared/operator-activation/current.json
  /var/lib/disdex/shared/operator-activation/runtime.json
  /var/lib/disdex/shared/idle-priority-parity-cert.json
  /var/lib/disdex/shared/idle-residual-long-parity-cert.json
  /var/lib/disdex/idle-priority/residual-long-state.json
  /var/lib/disdex/idle-priority/decision-details.json
)
SYSTEMD_TEMPLATE_PATHS=(
  /etc/systemd/system/disdex-v12-x1-all@.service
  /etc/systemd/system/disdex-pengu-dual-ls-v2@.service
  /etc/systemd/system/disdex-idle-priority-short@.service
  /etc/systemd/system/disdex-runner-health-alert.timer
  /etc/systemd/system/disdex-runner-position-recovery.timer
  /etc/systemd/system/disdex-trade-fill-notifier.timer
)

load_runtime_env() {
  set -a
  for f in \
    /etc/disdex/disdex-v13d-v11eq-v96.env \
    /etc/disdex/disdex-v12-pengu-v2-v52.env \
    /etc/disdex/disdex-v12-x1-all.env \
    /etc/disdex/disdex-quality102-causal-v1.env \
    "/etc/disdex/current-runtime/$FROM_SHA.env"; do
    [[ -f "$f" ]] && . "$f"
  done
  set +a
}

require_shared_safe() {
  python3 - <<'PY'
import json
def load(p):
    with open(p,encoding="utf-8") as f:
        return json.load(f)
kill=load("/var/lib/disdex/shared/kill-switch.json")
if kill.get("active") is not False:
    raise SystemExit("CUTOVER_KILL_SWITCH_ACTIVE")
guard=load("/var/lib/disdex/shared/margin-risk/guard-live.json")
if guard.get("stage")!="HEALTHY" or guard.get("ordersAllowed") is not True:
    raise SystemExit("CUTOVER_MARGIN_NOT_HEALTHY")
now=int(__import__("time").time()*1000)
guard_at=int(guard.get("checkedAt") or 0)
if guard_at<=0 or guard_at>now+60_000 or now-guard_at>360_000:
    raise SystemExit("CUTOVER_MARGIN_STALE")
risk=load("/var/lib/disdex/shared/crypto-daily-risk.json")
updated=int(risk.get("updatedAt") or 0)
if risk.get("tripped") is not False:
    raise SystemExit("CUTOVER_SHARED_RISK_TRIPPED_OR_UNKNOWN")
if risk.get("sourceComplete") is not True:
    raise SystemExit("CUTOVER_SHARED_RISK_SOURCE_INCOMPLETE")
if updated<=0 or updated>now+60_000 or now-updated>90_000:
    raise SystemExit("CUTOVER_SHARED_RISK_STALE")
try:
    pending=load("/var/lib/disdex/shared/pending-exposure.json")
except FileNotFoundError:
    pending={"schema":"disdex-pending-exposure/v1","entries":[]}
if not isinstance(pending,dict) or pending.get("schema")!="disdex-pending-exposure/v1":
    raise SystemExit("CUTOVER_PENDING_EXPOSURE_MALFORMED")
entries=pending.get("entries")
if not isinstance(entries,list):
    raise SystemExit("CUTOVER_PENDING_EXPOSURE_MALFORMED")
active_statuses={"PENDING","SUBMITTED","UNKNOWN"}
valid_statuses=active_statuses|{"RELEASED"}
for row in entries:
    if not isinstance(row,dict) or str(row.get("status") or "").upper() not in valid_statuses:
        raise SystemExit("CUTOVER_PENDING_EXPOSURE_MALFORMED")
active=[row for row in entries if str(row.get("status") or "").upper() in active_statuses]
if active:
    raise SystemExit("CUTOVER_PENDING_EXPOSURE_PRESENT")
idle=load("/var/lib/disdex/idle-priority/state.json")
if idle.get("positions") or idle.get("pending") or idle.get("manualReview"):
    raise SystemExit("CUTOVER_IDLE_NOT_FLAT")
try:
    residual=load("/var/lib/disdex/idle-priority/residual-long-state.json")
except FileNotFoundError:
    residual=None
if residual and (residual.get("position") or residual.get("pending") or residual.get("manualReview")):
    raise SystemExit("CUTOVER_IDLE_RESIDUAL_NOT_FLAT")
print("CUTOVER_SHARED_STATE=PASS")
PY
}

require_flat_account() {
  local runner_root="$1"
  local tmp budget_tmp
  tmp="$(mktemp)"
  budget_tmp="/tmp/disdex-aster-readonly-budget-cutover-$RANDOM-$.json"
  DISDEX_ASTER_GLOBAL_RATE_BUDGET_PATH="$budget_tmp" \
    "$runner_root/node_modules/.bin/tsx" \
    "$runner_root/scripts/disdex-aster-readonly-account-diagnostic.ts" | tee "$tmp"
  python3 - "$tmp" <<'PY'
import json,sys
rows=[x for x in open(sys.argv[1],encoding="utf-8") if x.lstrip().startswith("{")]
x=json.loads(rows[-1])
assert x["status"]=="ASTER_READONLY_ACCOUNT_DIAGNOSTIC_PASS"
if x.get("positions"):
    raise SystemExit("CUTOVER_ASTER_POSITIONS_PRESENT")
if x.get("openOrders"):
    raise SystemExit("CUTOVER_ASTER_OPEN_ORDERS_PRESENT")
assert x.get("ordersSent")==0 and x.get("cancelsSent")==0 and x.get("positionChangesSent")==0
print("CUTOVER_ASTER_FLAT=PASS")
PY
  rm -f "$tmp"
  rm -rf -- "$budget_tmp" "$budget_tmp.lock" "$budget_tmp.lock.recovery"
}

CUTOVER_ACCOUNT_MODE="UNKNOWN"
TRADING_TARGET_STARTED=0
classify_cutover_account_mode() {
  local runner_root="$1"
  local tmp budget_tmp mode
  tmp="$(mktemp)"
  budget_tmp="/tmp/disdex-aster-readonly-budget-cutover-mode-$RANDOM-$.json"
  DISDEX_ASTER_GLOBAL_RATE_BUDGET_PATH="$budget_tmp" \
    "$runner_root/node_modules/.bin/tsx" \
    "$runner_root/scripts/disdex-aster-readonly-account-diagnostic.ts" | tee "$tmp"
  mode="$(python3 - "$tmp" "$FROM_SHA" "$V12_ACTIVE_MIGRATION_CODE_PARITY" <<'PY'
import json,math,sys
diag_path,from_sha,code_parity=sys.argv[1:]
rows=[x for x in open(diag_path,encoding="utf-8") if x.lstrip().startswith("{")]
x=json.loads(rows[-1])
if x.get("status")!="ASTER_READONLY_ACCOUNT_DIAGNOSTIC_PASS":
    raise SystemExit("CUTOVER_ACCOUNT_MODE_DIAGNOSTIC_FAILED")
if x.get("ordersSent")!=0 or x.get("cancelsSent")!=0 or x.get("positionChangesSent")!=0:
    raise SystemExit("CUTOVER_ACCOUNT_MODE_DIAGNOSTIC_MUTATED")
positions=x.get("positions") or []
orders=x.get("openOrders") or []
if not positions and not orders:
    print("FLAT")
    raise SystemExit(0)
if code_parity!="1":
    raise SystemExit("CUTOVER_V12_ACTIVE_CODE_PARITY_BLOCKED")
state=json.load(open("/var/lib/disdex/v12-x1-all/runner.json",encoding="utf-8"))
if state.get("schema") not in {"v12-x1-all-runner-state/v1","v12-x1-all-runner-state/v2"}:
    raise SystemExit("CUTOVER_V12_ACTIVE_STATE_SCHEMA")
if state.get("strategyId")!="V12_X1.00_ALL" or state.get("mode")!="LIVE":
    raise SystemExit("CUTOVER_V12_ACTIVE_STATE_IDENTITY")
if str(state.get("runtimeCommitSha") or "").lower()!=from_sha:
    raise SystemExit("CUTOVER_V12_ACTIVE_STATE_SHA_MISMATCH")
if state.get("pending") or state.get("manualReview") or (state.get("killSwitch") or {}).get("active") is True:
    raise SystemExit("CUTOVER_V12_ACTIVE_STATE_NOT_MIGRATABLE")
managed=state.get("activePositions")
if not isinstance(managed,list) or not managed:
    managed=[state["active"]] if isinstance(state.get("active"),dict) else []
if not managed:
    raise SystemExit("CUTOVER_V12_ACTIVE_STATE_POSITION_MISSING")
if sum(float(p.get("gross") or 0) for p in managed) > 2.0+1e-9:
    raise SystemExit("CUTOVER_V12_ACTIVE_GROSS_INVALID")
actual=[p for p in positions if abs(float(p.get("positionAmt") or 0))>1e-12]
if len(actual)!=len(managed):
    raise SystemExit("CUTOVER_V12_ACTIVE_POSITION_COUNT_MISMATCH")
managed_symbols={str(p.get("symbol") or "").upper() for p in managed}
order_ids=set()
for p in managed:
    symbol=str(p.get("symbol") or "").upper()
    qty=float(p.get("quantity") or 0)
    side=str(p.get("side") or "")
    protection=p.get("protection") or {}
    if protection.get("positionId")!=p.get("positionId"):
        raise SystemExit("CUTOVER_V12_ACTIVE_PROTECTION_ID_MISMATCH")
    if abs(float(protection.get("quantity") or 0)-qty)>max(1e-8,qty*0.001):
        raise SystemExit("CUTOVER_V12_ACTIVE_PROTECTION_QTY_MISMATCH")
    row=next((r for r in actual if str(r.get("symbol") or "").upper()==symbol),None)
    if row is None:
        raise SystemExit("CUTOVER_V12_ACTIVE_POSITION_SYMBOL_MISMATCH")
    actual_qty=float(row.get("positionAmt") or 0)
    actual_side="LONG" if actual_qty>=0 else "SHORT"
    if actual_side!=side or abs(abs(actual_qty)-qty)>max(1e-8,qty*0.01):
        raise SystemExit("CUTOVER_V12_ACTIVE_POSITION_MISMATCH")
    for key in ("stopClientOrderId","takeProfitClientOrderId"):
        cid=str(protection.get(key) or "")
        if not cid:
            raise SystemExit("CUTOVER_V12_ACTIVE_PROTECTION_ORDER_ID_MISSING")
        order_ids.add(cid)
        order=next((o for o in orders if str(o.get("clientOrderId") or "")==cid),None)
        if order is None or order.get("reduceOnly") is not True or str(order.get("status") or "").upper() not in {"NEW","OPEN"}:
            raise SystemExit("CUTOVER_V12_ACTIVE_PROTECTION_ORDER_MISMATCH")
        if abs(float(order.get("origQty") or 0)-qty)>max(1e-8,qty*0.001):
            raise SystemExit("CUTOVER_V12_ACTIVE_PROTECTION_ORDER_QTY_MISMATCH")
if any(str(r.get("symbol") or "").upper() not in managed_symbols for r in actual):
    raise SystemExit("CUTOVER_V12_ACTIVE_UNKNOWN_POSITION")
if any(str(o.get("clientOrderId") or "") not in order_ids for o in orders):
    raise SystemExit("CUTOVER_V12_ACTIVE_UNKNOWN_OPEN_ORDER")
q102=json.load(open("/var/lib/disdex/quality102-causal-v1/state.json",encoding="utf-8"))
if str(q102.get("runtimeCommitSha") or "").lower()!=from_sha or q102.get("pending") or q102.get("position"):
    raise SystemExit("CUTOVER_V12_ACTIVE_Q102_NOT_FLAT_CURRENT")
print("V12_ACTIVE")
PY
)"
  rm -f "$tmp"
  rm -rf -- "$budget_tmp" "$budget_tmp.lock" "$budget_tmp.lock.recovery"
  case "$mode" in
    FLAT)
      CUTOVER_ACCOUNT_MODE="FLAT"
      echo "CUTOVER_ACCOUNT_MODE=FLAT"
      ;;
    V12_ACTIVE)
      CUTOVER_ACCOUNT_MODE="V12_ACTIVE"
      echo "CUTOVER_ACCOUNT_MODE=V12_ACTIVE"
      ;;
    *)
      echo "CUTOVER_ACCOUNT_MODE_UNKNOWN=$mode"
      return 1
      ;;
  esac
}

recover_old_idle_known_rate_budget_state() {
  local state_path="/var/lib/disdex/idle-priority/state.json"
  local backup_path="$PREFLIGHT_BACKUP/state.json"
  install -d -o root -g root -m 0700 "$PREFLIGHT_BACKUP"
  python3 - "$state_path" "$FROM_SHA" "$backup_path" <<'PY'
import json,os,re,stat,sys,tempfile,time
state_path,expected_sha,backup_path=sys.argv[1:]
with open(state_path,"rb") as f:
    before_bytes=f.read()
before=json.loads(before_bytes.decode("utf-8"))
if before.get("schema")!="disdex-idle-priority-state/v2":
    raise SystemExit("CUTOVER_IDLE_PREFLIGHT_SCHEMA_MISMATCH")
if str(before.get("runtimeSha") or "").lower()!=expected_sha:
    raise SystemExit("CUTOVER_IDLE_PREFLIGHT_SHA_MISMATCH")
positions=before.get("positions")
if not isinstance(positions,list) or positions:
    raise SystemExit("CUTOVER_IDLE_PREFLIGHT_POSITION_PRESENT")
if before.get("pending"):
    raise SystemExit("CUTOVER_IDLE_PREFLIGHT_PENDING_PRESENT")
review=before.get("manualReview")
if not review:
    print("NOOP")
    raise SystemExit(0)
if not re.fullmatch(r"IDLE_RUNNER_FAIL_CLOSED:ASTER_GLOBAL_RATE_BUDGET_SATURATED:\d+",str(review)):
    raise SystemExit("CUTOVER_IDLE_PREFLIGHT_UNKNOWN_MANUAL_REVIEW")
st=os.stat(state_path,follow_symlinks=False)
if stat.S_ISLNK(st.st_mode) or not stat.S_ISREG(st.st_mode):
    raise SystemExit("CUTOVER_IDLE_PREFLIGHT_STATE_NOT_REGULAR")
os.makedirs(os.path.dirname(backup_path),exist_ok=True)
fd=os.open(backup_path,os.O_WRONLY|os.O_CREAT|os.O_EXCL,stat.S_IMODE(st.st_mode))
try:
    with os.fdopen(fd,"wb",closefd=True) as f:
        f.write(before_bytes); f.flush(); os.fsync(f.fileno())
except:
    try: os.close(fd)
    except OSError: pass
    raise
os.chown(backup_path,st.st_uid,st.st_gid)
os.chmod(backup_path,stat.S_IMODE(st.st_mode))
with open(backup_path,"rb") as f:
    if f.read()!=before_bytes:
        raise SystemExit("CUTOVER_IDLE_PREFLIGHT_BACKUP_MISMATCH")
now=int(time.time()*1000)
after=dict(before)
after["updatedAt"]=now
after["manualReview"]=None
after["lastDecision"]={"decisionTs":now,"accepted":False,"reason":"IDLE_BENIGN_RATE_BUDGET_RECOVERY"}
failures=list(before.get("failures") or [])
failures.append({"message":"IDLE_BENIGN_RATE_BUDGET_RECOVERY","occurredAt":now})
after["failures"]=failures[-100:]
parent=os.path.dirname(state_path)
tmp=f"{state_path}.{os.getpid()}.{now}.preflight-recovery.tmp"
fd=os.open(tmp,os.O_WRONLY|os.O_CREAT|os.O_EXCL,stat.S_IMODE(st.st_mode))
try:
    with os.fdopen(fd,"w",encoding="utf-8",closefd=True) as f:
        json.dump(after,f,ensure_ascii=False,indent=2); f.write("\n"); f.flush(); os.fsync(f.fileno())
except:
    try: os.close(fd)
    except OSError: pass
    raise
os.chown(tmp,st.st_uid,st.st_gid)
os.chmod(tmp,stat.S_IMODE(st.st_mode))
os.replace(tmp,state_path)
dirfd=os.open(parent,os.O_RDONLY)
try: os.fsync(dirfd)
finally: os.close(dirfd)
with open(state_path,encoding="utf-8") as f:
    readback=json.load(f)
if readback.get("manualReview") is not None or readback.get("positions") or readback.get("pending"):
    raise SystemExit("CUTOVER_IDLE_PREFLIGHT_READBACK_MISMATCH")
if (readback.get("lastDecision") or {}).get("reason")!="IDLE_BENIGN_RATE_BUDGET_RECOVERY":
    raise SystemExit("CUTOVER_IDLE_PREFLIGHT_REASON_MISMATCH")
print("PASS:"+backup_path)
PY
}

restart_stock_reference_current() {
  local phase="${1:-CUTOVER}"
  local expected pid cwd attempt
  if ! systemctl is-active --quiet disdex-stock-reference-free.service; then
    echo "${phase}_STOCK_REFERENCE_INACTIVE=SKIP"
    return 0
  fi
  expected="$(readlink -f "$CURRENT")"
  systemctl restart disdex-stock-reference-free.service
  cwd=""
  pid=""
  for attempt in $(seq 1 15); do
    pid="$(systemctl show disdex-stock-reference-free.service -p MainPID --value 2>/dev/null || true)"
    if [[ "$pid" =~ ^[0-9]+$ && "$pid" -gt 0 ]]; then
      cwd="$(readlink -f "/proc/$pid/cwd" 2>/dev/null || true)"
      if [[ "$cwd" == "$expected" ]]; then
        echo "${phase}_STOCK_REFERENCE_CURRENT=PASS pid=$pid cwd=$cwd"
        return 0
      fi
    fi
    sleep 1
  done
  echo "${phase}_STOCK_REFERENCE_CWD_MISMATCH pid=${pid:-unknown} expected=$expected actual=${cwd:-unknown}"
  return 1
}

load_runtime_env
classify_cutover_account_mode "$OLD_RELEASE"
if [[ "$CUTOVER_ACCOUNT_MODE" == V12_ACTIVE ]]; then
  export DISDEX_ALLOW_V12_ACTIVE_SHA_MIGRATION=true
else
  export DISDEX_ALLOW_V12_ACTIVE_SHA_MIGRATION=false
fi
IDLE_PREFLIGHT_RECOVERY_STATUS="$(recover_old_idle_known_rate_budget_state)"
echo "CUTOVER_IDLE_PREFLIGHT_RECOVERY=$IDLE_PREFLIGHT_RECOVERY_STATUS"
require_shared_safe

for name in "${NAMES[@]}"; do
  unit="$name@$FROM_SHA.service"
  active_state="$(systemctl is-active "$unit" 2>/dev/null || true)"
  if [[ "$active_state" != active ]]; then
    if [[ "$name" == disdex-idle-priority-short && "$active_state" == inactive && "$IDLE_PREFLIGHT_RECOVERY_STATUS" == PASS:* ]]; then
      echo "CUTOVER_KNOWN_IDLE_BENIGN_INACTIVE_ACCEPTED unit=$unit recovery=$IDLE_PREFLIGHT_RECOVERY_STATUS"
      continue
    fi
    echo "CUTOVER_OLD_UNIT_NOT_ACTIVE=$unit state=$active_state"
    exit 41
  fi
  restart_count="$(systemctl show "$unit" -p NRestarts --value)"
  if [[ "$restart_count" != 0 ]]; then
    if [[ "$name" == disdex-shared-crypto-risk && "$restart_count" == 1 ]]; then
      echo "CUTOVER_KNOWN_SHARED_RISK_TRANSIENT_RESTART_ACCEPTED unit=$unit nRestarts=$restart_count currentRiskFresh=true"
    elif [[ "$name" == disdex-v12-x1-all && "$restart_count" == 1 ]]; then
      pid="$(systemctl show "$unit" -p MainPID --value)"
      result="$(systemctl show "$unit" -p Result --value)"
      [[ "$pid" =~ ^[0-9]+$ && "$pid" -gt 0 && "$result" == success ]] || {
        echo "CUTOVER_KNOWN_V12_RESTART_NOT_CURRENTLY_HEALTHY unit=$unit pid=$pid result=$result"
        exit 42
      }
      python3 - "$FROM_SHA" "$pid" <<'PY'
import json,sys,time
sha=sys.argv[1]
pid=int(sys.argv[2])
now=int(time.time()*1000)
state=json.load(open("/var/lib/disdex/v12-x1-all/runner.json",encoding="utf-8"))
runtime=str(state.get("runtimeSha") or state.get("runtimeCommitSha") or "")
updated=int(state.get("updatedAt") or 0)
if runtime!=sha:
    raise SystemExit("CUTOVER_KNOWN_V12_RESTART_STATE_SHA_MISMATCH")
if updated<=0 or updated>now+60000 or now-updated>3*60*60*1000:
    raise SystemExit("CUTOVER_KNOWN_V12_RESTART_STATE_STALE")
if state.get("manualReview"):
    raise SystemExit("CUTOVER_KNOWN_V12_RESTART_MANUAL_REVIEW_ACTIVE")
if state.get("pending"):
    raise SystemExit("CUTOVER_KNOWN_V12_RESTART_PENDING_ACTIVE")
print("CUTOVER_KNOWN_V12_RESTART_STATE_HEALTHY=PASS")
PY
      echo "CUTOVER_KNOWN_V12_SINGLE_RESTART_ACCEPTED unit=$unit nRestarts=$restart_count pid=$pid result=$result"
    elif [[ "$name" == disdex-quality102-causal-v1 && "$restart_count" == 1 ]]; then
      pid="$(systemctl show "$unit" -p MainPID --value)"
      result="$(systemctl show "$unit" -p Result --value)"
      [[ "$pid" =~ ^[0-9]+$ && "$pid" -gt 0 && "$result" == success ]] || {
        echo "CUTOVER_KNOWN_Q102_RESTART_NOT_CURRENTLY_HEALTHY unit=$unit pid=$pid result=$result"
        exit 42
      }
      python3 - "$FROM_SHA" <<'PY'
import json,sys,time
sha=sys.argv[1]
now=int(time.time()*1000)
state=json.load(open("/var/lib/disdex/quality102-causal-v1/state.json",encoding="utf-8"))
runtime=str(state.get("runtimeSha") or state.get("runtimeCommitSha") or "")
updated=int(state.get("updatedAt") or 0)
if runtime!=sha:
    raise SystemExit("CUTOVER_KNOWN_Q102_RESTART_STATE_SHA_MISMATCH")
if updated<=0 or updated>now+60000 or now-updated>3*60*60*1000:
    raise SystemExit("CUTOVER_KNOWN_Q102_RESTART_STATE_STALE")
if state.get("manualReview"):
    raise SystemExit("CUTOVER_KNOWN_Q102_RESTART_MANUAL_REVIEW_ACTIVE")
if state.get("pending"):
    raise SystemExit("CUTOVER_KNOWN_Q102_RESTART_PENDING_ACTIVE")
print("CUTOVER_KNOWN_Q102_RESTART_STATE_HEALTHY=PASS")
PY
      echo "CUTOVER_KNOWN_Q102_SINGLE_RESTART_ACCEPTED unit=$unit nRestarts=$restart_count pid=$pid result=$result"
    else
      echo "CUTOVER_OLD_UNIT_RESTARTED=$unit nRestarts=$restart_count"
      exit 42
    fi
  fi
done

install -d -o root -g root -m 0700 "$BACKUP"
for p in "${STATE_PATHS[@]}"; do
  if [[ -f "$p" && ! -L "$p" ]]; then
