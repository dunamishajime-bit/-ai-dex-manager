        mkdir -p -- "$(dirname "$p")"
        cp -a -- "$src" "$p"
      fi
    done
    for state_dir in /var/lib/disdex/pengu-dual-ls-v2 /var/lib/disdex/idle-priority; do
      if [[ -d "$state_dir" && ! -L "$state_dir" ]]; then
        chown deploy:deploy "$state_dir"
        chmod 0700 "$state_dir"
        echo "ROLLBACK_STATE_DIR_NORMALIZED=$state_dir:deploy:deploy:700"
      fi
    done
    rm -f /var/lib/disdex/runner-health/heartbeats/idle-priority-short.json
    for p in "${SYSTEMD_TEMPLATE_PATHS[@]}"; do
      src="$BACKUP$p"
      if [[ -f "$src" ]]; then
