[Unit]
Description=DisDex Decision Gateway (read-only advisory)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/opt/disdex-decision-gateway/current
Environment=PYTHONUNBUFFERED=1
Environment=DG_BIND=127.0.0.1
Environment=DG_PORT=8765
Environment=DG_MAX_BODY_BYTES=1048576
Environment=DG_TOKEN_FILE=/etc/disdex/decision-gateway.token
ExecStart=/usr/bin/python3 /opt/disdex-decision-gateway/current/vps/server.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
MemoryMax=128M
CPUQuota=25%

[Install]
WantedBy=multi-user.target
