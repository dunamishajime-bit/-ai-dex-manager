[Unit]
Description=DisDex Idle Priority SHORT runner
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/disdex/operator-live-activation.json

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/disdex-trading/current
Environment=NODE_ENV=production
ExecStart=/usr/bin/env npx tsx scripts/idle-priority-short-runner.ts
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/disdex
UMask=0077

[Install]
WantedBy=multi-user.target
