[Unit]
Description=DisDex shared crypto daily-risk refresher (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/opt/disdex/releases/%i
EnvironmentFile=/etc/disdex/disdex-shared-crypto-risk.env
ExecStart=/usr/bin/node scripts/disdex-shared-crypto-risk-writer.ts --daemon
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/disdex/shared

[Install]
WantedBy=multi-user.target
