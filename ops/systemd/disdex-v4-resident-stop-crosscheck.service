[Unit]
Description=Read-only V12 V4 exchange STOP and owner-ledger verification
# Read-only health check uses its signed root pin manifest at runtime;
# no dependency on an obsolete fixed-SHA Shared Risk unit.
After=local-fs.target

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/python3 /usr/local/libexec/disdex-v4-resident-stop-crosscheck.py
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/disdex/shared
ProtectHome=read-only
PrivateTmp=true
PrivateDevices=true
UMask=0077
