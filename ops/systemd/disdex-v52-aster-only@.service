[Unit]
Description=DisDex V52 Aster-only LIVE runner for V12 composition (%i)
After=network-online.target disdex-stock-reference-free.service disdex-v12-v52-margin-guard@%i.service
Wants=network-online.target
Requires=disdex-stock-reference-free.service disdex-v12-v52-margin-guard@%i.service

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/disdex-trading/releases/%i
EnvironmentFile=/etc/disdex/disdex-v13d-v11eq-v96.env
EnvironmentFile=/etc/disdex/disdex-v12-pengu-v2-v52.env
EnvironmentFile=/etc/disdex/ai-dex-manager-mail.env
Environment=NODE_ENV=production
Environment=DISDEX_V52_ALLOW_STALE_REFERENCE_BACKGROUND=true
Environment=DISDEX_V52_STALE_REFERENCE_NOTIFICATIONS_ENABLED=true
Environment=DISDEX_V52_STALE_NOTIFICATION_STATE_PATH=/var/lib/disdex/shared/v52-reference-stale-notification-state.json
Environment=DISDEX_V52_CRYPTO_GROSS_CAP=1.5
Environment=DISDEX_V52_V11_GROSS_CAP=1.5
Environment=DISDEX_V52_V50_GROSS_CAP=1.25
Environment=DISDEX_V52_V50_RANK1_REQUESTED_GROSS=1.0
Environment=DISDEX_V52_V50_RANK1_STRONG_REQUESTED_GROSS=1.25
Environment=DISDEX_V52_V50_RANK2_REQUESTED_GROSS=0.25
Environment=DISDEX_V52_V50_MAX_CONCURRENT_POSITIONS=2
Environment=DISDEX_V52_V50_MAX_DAILY_ENTRIES=3
Environment=DISDEX_SHARED_CRYPTO_MAX_DAILY_LOSS_PCT=7.5
Environment=PYTHONPATH=/home/deploy/dis-dex-manager/.venv-stock/lib/python3.12/site-packages
ExecStartPre=/usr/bin/test -f /home/deploy/disdex-trading/releases/%i/.disdex-release-sha
ExecStartPre=/usr/bin/grep -Fxq %i /home/deploy/disdex-trading/releases/%i/.disdex-release-sha
ExecStart=/usr/bin/python3 scripts/disdex_v12_v52_live_engine_retry.py --mode live --daemon
Restart=on-failure
RestartSec=15s
TimeoutStopSec=90s
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadOnlyPaths=/home/deploy/disdex-trading/releases
ReadWritePaths=/home/deploy/ai-dex-manager-v96-paper/.runtime-state /var/lib/disdex/shared
UMask=0077

[Install]
WantedBy=multi-user.target
