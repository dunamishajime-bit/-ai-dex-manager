[Unit]
Description=DisDex Top3 + FET + Q102 DD Governor shadow (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/disdex-trading/releases/%i
Environment=NODE_ENV=production
Environment=TOP3_FET_Q102_SHADOW_STATE_PATH=/var/lib/disdex/top3-fet-q102-shadow/state.json
Environment=TOP3_FET_Q102_SHADOW_SNAPSHOT_PATH=/var/lib/disdex/top3-fet-q102-shadow/snapshot.json
Environment=V12_DECISION_SNAPSHOT_PATH=/var/lib/disdex/v12-x1-all/decision-snapshot.json
Environment=Q102_MARKET_HISTORY_PATH=/var/lib/disdex/quality102-causal-v1/market-history.json
Environment=DISDEX_GIT_HISTORY_SNAPSHOT_PATH=/home/deploy/ai-dex-manager/data/trade-history-git.json
Environment=DISDEX_SHARED_CRYPTO_DAILY_RISK_PATH=/var/lib/disdex/shared/crypto-daily-risk.json
ExecStartPre=/usr/bin/test -f /home/deploy/disdex-trading/releases/%i/.disdex-release-sha
ExecStartPre=/usr/bin/grep -Fxq %i /home/deploy/disdex-trading/releases/%i/.disdex-release-sha
ExecStart=/home/deploy/disdex-trading/releases/%i/node_modules/.bin/tsx scripts/disdex-top3-fet-q102-shadow.ts
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/home/deploy/disdex-trading/releases /home/deploy/ai-dex-manager/data /var/lib/disdex/v12-x1-all /var/lib/disdex/quality102-causal-v1 /var/lib/disdex/shared
StateDirectory=disdex/top3-fet-q102-shadow
StateDirectoryMode=0700
UMask=0077
