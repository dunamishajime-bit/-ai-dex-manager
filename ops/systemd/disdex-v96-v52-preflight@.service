[Unit]
Description=DisDex V96 plus adaptive-margin V52 authenticated integrated preflight for release %i
After=network-online.target
Wants=network-online.target
Conflicts=disdex-v96-v52-live.service

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/disdex-trading/releases/%i
EnvironmentFile=/etc/disdex/disdex-v13d-v11eq-v96.env
EnvironmentFile=-/etc/disdex/disdex-v96-v52-live-overrides.env
Environment=DISDEX_V96_RUNTIME_COMMIT_SHA=%i
Environment=DISDEX_V96_MAX_GROSS=1.5
Environment=DISDEX_V96_INITIAL_PENGU_GROSS=1.15
Environment=DISDEX_V96_MAX_DAILY_LOSS_PCT=5
Environment=DISDEX_V52_CRYPTO_GROSS_CAP=1.5
Environment=DISDEX_V52_STOCK_GROSS_CAP=1.5
Environment=DISDEX_V52_PORTFOLIO_GROSS_CAP=2.5
Environment=DISDEX_V52_V11_GROSS_CAP=1.5
Environment=DISDEX_V52_V50_GROSS_CAP=1.25
Environment=DISDEX_V52_RESERVED_FIRST_STOCK_GROSS=1.25
Environment=DISDEX_V52_MINIMUM_FIRST_STOCK_GROSS=0.5
Environment=DISDEX_V52_MINIMUM_SECOND_STOCK_GROSS=0.25
Environment=DISDEX_V52_MAX_CONCURRENT_STOCK_POSITIONS=2
Environment=DISDEX_V52_MAX_DAILY_LOSS_PCT=3.5
Environment=DISDEX_V96_V52_REQUIRED_INITIAL_LEVERAGE=5
Environment=DISDEX_V96_V52_MAX_INITIAL_MARGIN_FRACTION=0.70
Environment=DISDEX_V96_V52_MIN_AVAILABLE_BALANCE_FRACTION=0.20
Environment=DISDEX_V96_V52_PREORDER_MARGIN_GUARD_ENABLED=true
Environment=DISDEX_V96_V52_MARGIN_GUARD_STATE_DIR=/home/deploy/ai-dex-manager-v96-paper/.runtime-state/disdex-v13d-v11eq-v96/margin-risk
Environment=DISDEX_V96_V52_MARGIN_GUARD_STATE_FILE=/home/deploy/ai-dex-manager-v96-paper/.runtime-state/disdex-v13d-v11eq-v96/margin-risk/guard-live.json
Environment=DISDEX_V96_V52_MARGIN_GUARD_SCRIPT=scripts/disdex_v96_v52_margin_guard.py
Environment=PENGU_LEGACY_CORE_ENABLED=false
Environment=PENGU_DUAL_LS_V1_MODE=SHADOW
Environment=PENGU_DUAL_LS_V1_ENABLED=false
Environment=PENGU_DUAL_LS_V1_LIVE_TRADING_ENABLED=false
Environment=PENGU_DUAL_LS_V1_LIVE_EXECUTION_ENABLED=false
Environment=PENGU_DUAL_LS_V2_MODE=LIVE
Environment=PENGU_DUAL_LS_V2_ENABLED=true
Environment=PENGU_DUAL_LS_V2_LIVE_TRADING_ENABLED=true
Environment=PENGU_DUAL_LS_V2_LIVE_EXECUTION_ENABLED=true
Environment=PENGU_DUAL_LS_V2_MAX_GROSS=0.9375
Environment=PENGU_DUAL_LS_V2_PORTFOLIO_GROSS_CAP=1.5
Environment=PENGU_DUAL_LS_V2_MAX_DAILY_LOSS_PCT=5
Environment=DISDEX_V96_CONFIG_MIGRATION_MODE=true
Environment=DISDEX_V13D_V11EQ_V96_COMBINED_STATE_ROOT=/home/deploy/ai-dex-manager-v96-paper/.runtime-state/disdex-v13d-v11eq-v96
Environment=DISDEX_V13D_V11EQ_V96_STATE_DIR=/home/deploy/ai-dex-manager-v96-paper/.runtime-state/disdex-v13d-v11eq-v96
Environment=DISDEX_V13D_V11EQ_V96_KILL_SWITCH_FILE=/home/deploy/ai-dex-manager-v96-paper/.runtime-state/disdex-v13d-v11eq-v96/kill-switch.json
Environment=DISDEX_V52_ASTER_ONLY_STATE_DIR=/home/deploy/ai-dex-manager-v96-paper/.runtime-state/disdex-v13d-v11eq-v96/stock
Environment=DISDEX_V52_ASTER_ONLY_KILL_SWITCH_FILE=/home/deploy/ai-dex-manager-v96-paper/.runtime-state/disdex-v13d-v11eq-v96/kill-switch.json
Environment=DISDEX_V96_STATE_DIR=/home/deploy/ai-dex-manager-v96-paper/.runtime-state/disdex-v13d-v11eq-v96/crypto-v96
Environment=DISDEX_V96_KILL_SWITCH_FILE=/home/deploy/ai-dex-manager-v96-paper/.runtime-state/disdex-v13d-v11eq-v96/kill-switch.json
Environment=DISDEX_V96_FORWARD_EVIDENCE_FILE=/home/deploy/ai-dex-manager-v96-paper/.runtime-approval/disdex-v96-forward.json
Environment=DISDEX_V96_EXECUTION_PARITY_FILE=/home/deploy/ai-dex-manager-v96-paper/.runtime-approval/disdex-v96-parity.json
Environment=DISDEX_V96_OPERATOR_OVERRIDE_FILE=/home/deploy/ai-dex-manager-v96-paper/.runtime-approval/disdex-v96-operator-override.json
ExecStart=/usr/bin/env DISDEX_V96_RUNTIME_COMMIT_SHA=%i /usr/bin/bash scripts/ops/disdex-v96-v52-candidate-preflight.sh
TimeoutStartSec=20min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadOnlyPaths=/home/deploy/disdex-trading/releases/%i
ReadOnlyPaths=/home/deploy/ai-dex-manager-v96-paper/.runtime-state
ReadOnlyPaths=/home/deploy/ai-dex-manager-v96-paper/.runtime-approval
UMask=0077
