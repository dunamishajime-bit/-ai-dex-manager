[Unit]
Description=DisDex V96 plus V52 read-only authenticated preflight for release %i
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/disdex-trading/releases/%i
EnvironmentFile=/etc/disdex/disdex-v13d-v11eq-v96.env
EnvironmentFile=/etc/disdex/disdex-v96-v52-live-overrides.env
Environment=DISDEX_V96_RUNTIME_COMMIT_SHA=%i
Environment=DISDEX_V13D_V11EQ_V96_COMBINED_STATE_ROOT=/home/deploy/ai-dex-manager-v96-paper/.runtime-state/disdex-v13d-v11eq-v96
Environment=DISDEX_V13D_V11EQ_V96_STATE_DIR=/home/deploy/ai-dex-manager-v96-paper/.runtime-state/disdex-v13d-v11eq-v96
Environment=DISDEX_V13D_V11EQ_V96_KILL_SWITCH_FILE=/home/deploy/ai-dex-manager-v96-paper/.runtime-state/disdex-v13d-v11eq-v96/kill-switch.json
Environment=DISDEX_V52_ASTER_ONLY_STATE_DIR=/home/deploy/ai-dex-manager-v96-paper/.runtime-state/disdex-v13d-v11eq-v96/stock
Environment=DISDEX_V52_ASTER_ONLY_KILL_SWITCH_FILE=/home/deploy/ai-dex-manager-v96-paper/.runtime-state/disdex-v13d-v11eq-v96/kill-switch.json
Environment=DISDEX_V96_STATE_DIR=/home/deploy/ai-dex-manager-v96-paper/.runtime-state/disdex-v13d-v11eq-v96/crypto-v96
Environment=DISDEX_V96_KILL_SWITCH_FILE=/home/deploy/ai-dex-manager-v96-paper/.runtime-state/disdex-v13d-v11eq-v96/kill-switch.json
Environment=DISDEX_V96_FORWARD_EVIDENCE_FILE=/home/deploy/ai-dex-manager-v96-paper/.runtime-approval/disdex-v96-forward.json
Environment=DISDEX_V96_EXECUTION_PARITY_FILE=/home/deploy/ai-dex-manager-v96-paper/.runtime-approval/disdex-v96-parity.json
Environment=DISDEX_V96_OPERATOR_OVERRIDE_FILE=/home/deploy/ai-dex-manager-v96-paper/.runtime-approval/disdex-v96-operator-override.json
ExecStart=/usr/bin/npm run strategy:disdex-v96-v52:preflight:readonly
TimeoutStartSec=20min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadOnlyPaths=/home/deploy/disdex-trading/releases/%i
ReadOnlyPaths=/home/deploy/ai-dex-manager-v96-paper/.runtime-state
ReadOnlyPaths=/home/deploy/ai-dex-manager-v96-paper/.runtime-approval
UMask=0077
