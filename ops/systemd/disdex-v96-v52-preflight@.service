[Unit]
Description=DisDex V96 plus V52 authenticated no-order preflight for release %i
After=network-online.target disdex-stock-reference-free.service
Wants=network-online.target
Requires=disdex-stock-reference-free.service

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/disdex-trading/releases/%i
EnvironmentFile=/etc/disdex/disdex-v13d-v11eq-v96.env
EnvironmentFile=/etc/disdex/disdex-v96-v52-live-overrides.env
ExecStart=/usr/bin/npm run strategy:disdex-v52:preflight
TimeoutStartSec=20min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadOnlyPaths=/home/deploy/disdex-trading/releases/%i
ReadWritePaths=/home/deploy/ai-dex-manager-v96-paper/.runtime-state
ReadWritePaths=/home/deploy/ai-dex-manager-v96-paper/.runtime-approval
UMask=0077
