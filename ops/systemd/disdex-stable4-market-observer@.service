[Unit]
Description=DisDex adopted R21/P91 public market source (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/disdex-trading/releases/%i
StateDirectory=disdex/stable4-observation/%i
StateDirectoryMode=0700
Environment=NODE_ENV=production
ExecStartPre=/usr/bin/grep -Fxq %i /home/deploy/disdex-trading/releases/%i/.disdex-release-sha
ExecStart=/home/deploy/disdex-trading/releases/%i/node_modules/.bin/tsx scripts/stable4-market-observe.ts %i /var/lib/disdex/stable4-observation/%i/snapshot.json
TimeoutStartSec=8min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
UMask=0077
