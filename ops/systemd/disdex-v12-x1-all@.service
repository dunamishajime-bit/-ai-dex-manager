[Unit]
Description=DisDex V12 X1 ALL LIVE runner (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/opt/disdex/releases/%i
EnvironmentFile=/etc/disdex/disdex-v12-x1-all.env
ExecStart=/usr/bin/node scripts/disdex-v12-x1-all-live-runner.ts --daemon
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/disdex/v12-x1-all /var/lib/disdex/shared

[Install]
WantedBy=multi-user.target
