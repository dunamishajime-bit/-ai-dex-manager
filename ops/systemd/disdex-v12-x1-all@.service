[Unit]
Description=DisDex V12 X1 ALL LIVE runner (%i)
After=network-online.target disdex-shared-crypto-risk@%i.service
Wants=network-online.target
Requires=disdex-shared-crypto-risk@%i.service

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/disdex-trading/releases/%i
EnvironmentFile=/etc/disdex/disdex-v13d-v11eq-v96.env
EnvironmentFile=/etc/disdex/disdex-v12-x1-all.env
Environment=NODE_ENV=production
ExecStartPre=/usr/bin/test -f /home/deploy/disdex-trading/releases/%i/.disdex-release-sha
ExecStartPre=/usr/bin/grep -Fxq %i /home/deploy/disdex-trading/releases/%i/.disdex-release-sha
ExecStart=/home/deploy/disdex-trading/releases/%i/node_modules/.bin/tsx scripts/disdex-v12-x1-all-live-runner.ts --daemon
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/home/deploy/disdex-trading/releases
ReadWritePaths=/var/lib/disdex/v12-x1-all /var/lib/disdex/shared /home/deploy/ai-dex-manager-v96-paper/.runtime-state
UMask=0077

[Install]
WantedBy=multi-user.target
