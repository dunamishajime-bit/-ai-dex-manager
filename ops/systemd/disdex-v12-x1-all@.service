[Unit]
Description=DisDex V12 X1 ALL LIVE runner (%i)
After=network-online.target disdex-shared-crypto-risk@%i.service disdex-v12-v52-margin-guard@%i.service
Wants=network-online.target
Requires=disdex-shared-crypto-risk@%i.service disdex-v12-v52-margin-guard@%i.service

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/disdex-trading/releases/%i
EnvironmentFile=/etc/disdex/disdex-v13d-v11eq-v96.env
EnvironmentFile=/etc/disdex/disdex-v12-pengu-v2-v52.env
EnvironmentFile=/etc/disdex/disdex-v12-x1-all.env
Environment=NODE_ENV=production
Environment=V12_LIVE_GRANDFATHERED_POSITION_ALLOWED=true
Environment=V12_X1_ALL_MAX_GROSS=1.5
ExecStartPre=/usr/bin/test -f /home/deploy/disdex-trading/releases/%i/.disdex-release-sha
ExecStartPre=/usr/bin/grep -Fxq %i /home/deploy/disdex-trading/releases/%i/.disdex-release-sha
ExecStartPre=/usr/bin/bash /home/deploy/disdex-trading/releases/%i/scripts/ops/disdex-v12-mutual-exclusion-preflight.sh %i runtime
ExecStart=/home/deploy/disdex-trading/releases/%i/node_modules/.bin/tsx scripts/disdex-v12-x1-all-live-runner.ts --daemon
Restart=on-failure
RestartPreventExitStatus=2
RestartSec=5s
TimeoutStopSec=30s
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/home/deploy/disdex-trading/releases /home/deploy/ai-dex-manager-v96-paper/.runtime-state
ReadWritePaths=/var/lib/disdex/v12-x1-all /var/lib/disdex/shared /home/deploy/ai-dex-manager-v96-paper/.runtime-state/disdex-v13d-v11eq-v96/margin-risk
UMask=0077

[Install]
WantedBy=multi-user.target
