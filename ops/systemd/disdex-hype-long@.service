[Unit]
Description=DisDex HYPE trend long overlay (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/disdex-trading/releases/%i
EnvironmentFile=/etc/disdex/disdex-v13d-v11eq-v96.env
EnvironmentFile=/etc/disdex/disdex-v12-pengu-v2-v52.env
EnvironmentFile=-/etc/disdex/disdex-quality102-causal-v1.env
EnvironmentFile=-/etc/disdex/current-runtime/%i.env
# The shared contract file deliberately defaults this flag to false.  The
# exact-SHA unit must override it only after all EnvironmentFile entries have
# loaded; otherwise systemd lets the safety default overwrite the approved
# operator activation and the runner loops without ever reaching LIVE.
Environment=DISDEX_HYPE_ZEC_OPERATOR_ARMED=true
Environment=NODE_ENV=production
Environment=DISDEX_RUNTIME_COMMIT_SHA=%i
Environment=DISDEX_RELEASE_SHA=%i
Environment=DISDEX_HYPE_ZEC_MODE=LIVE
Environment=DISDEX_HYPE_ZEC_ENABLED=true
Environment=DISDEX_HYPE_ZEC_LIVE_EXECUTION_ENABLED=true
Environment=DISDEX_HYPE_ZEC_PRODUCTION_CONFIG_LIVE_ENABLED=true
Environment=DISDEX_HYPE_ZEC_SIGNAL_MODE=TREND
Environment=DISDEX_HYPE_ZEC_SYMBOLS=HYPEUSDT
Environment=DISDEX_HYPE_ZEC_MAX_GROSS=1.5
Environment=DISDEX_HYPE_ZEC_RUNTIME_SHA=%i
Environment=DISDEX_HYPE_ZEC_STATE_PATH=/var/lib/disdex/hype-zec-long/runner.json
Environment=DISDEX_HYPE_ZEC_PREEMPTION_ENABLED=false
Environment=DISDEX_ACCOUNT_LOCK_PATH=/var/lib/disdex/shared/account-order.lock
Environment=DISDEX_PENDING_EXPOSURE_REGISTRY_PATH=/var/lib/disdex/shared/pending-exposure.json
ExecStartPre=+/usr/bin/install -d -o deploy -g deploy -m 0700 /var/lib/disdex/hype-zec-long
ExecStartPre=+/bin/sh -c 'if [ -e /var/lib/disdex/hype-zec-long/runner.json ]; then chown deploy:deploy /var/lib/disdex/hype-zec-long/runner.json && chmod 600 /var/lib/disdex/hype-zec-long/runner.json; fi'
ExecStartPre=/usr/bin/test -f /home/deploy/disdex-trading/releases/%i/.disdex-release-sha
ExecStartPre=/usr/bin/grep -Fxq %i /home/deploy/disdex-trading/releases/%i/.disdex-release-sha
ExecStartPre=/home/deploy/disdex-trading/releases/%i/node_modules/.bin/tsx scripts/disdex-current-live-target-readiness.ts --require-implementation-ready
ExecStartPre=+/usr/bin/node /home/deploy/disdex-trading/releases/%i/scripts/ops/root/disdex-live-operator-activation-gate.mjs --release-root /home/deploy/disdex-trading/releases/%i --sha %i --runner HYPE_TREND_LONG --activation-path /var/lib/disdex/shared/operator-activation/current.json
ExecStart=/home/deploy/disdex-trading/releases/%i/node_modules/.bin/tsx scripts/disdex-hype-trend-live-runner.ts --daemon
Restart=on-failure
RestartSec=15s
TimeoutStartSec=10min
TimeoutStopSec=90s
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/home/deploy/disdex-trading/releases
ReadWritePaths=/var/lib/disdex/hype-zec-long /var/lib/disdex/shared
UMask=0077

[Install]
WantedBy=multi-user.target
