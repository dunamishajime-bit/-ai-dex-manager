[Unit]
Description=DisDex bounded VPS log, release and backup retention cleanup
After=local-fs.target
ConditionPathExists=/usr/local/sbin/disdex-vps-retention-cleanup

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/sbin/disdex-vps-retention-cleanup --apply
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/deploy/disdex-trading/releases
ReadWritePaths=/home/deploy/ai-dex-manager-v96-paper/.runtime-state
ReadWritePaths=/home/deploy/ai-dex-manager-v96-paper/.runtime-approval
ReadWritePaths=/home/deploy/disdex-ops
ReadWritePaths=/home/deploy/.pm2/logs
ReadWritePaths=/etc/disdex/systemd-backup
UMask=0077
