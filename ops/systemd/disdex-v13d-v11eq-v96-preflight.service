[Unit]
Description=DisDex V96 plus V13D and V11-EQ combined no-order preflight
After=network-online.target disdex-stock-reference-free.service
Wants=network-online.target
Requires=disdex-stock-reference-free.service

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/dis-dex-manager
EnvironmentFile=/etc/disdex/disdex-v13d-v11eq-v96.env
ExecStart=/usr/bin/npm run strategy:disdex-v13d-v11eq-v96:preflight
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/deploy/dis-dex-manager/.runtime-state
UMask=0077
