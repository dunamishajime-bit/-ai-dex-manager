[Unit]
Description=DisDex H48 R4 STOP8 read-only shadow (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/disdex-trading/releases/%i
EnvironmentFile=/etc/disdex/disdex-v13d-v11eq-v96.env
EnvironmentFile=/etc/disdex/disdex-v12-pengu-v2-v52.env
StateDirectory=disdex/stable4-shadow/%i/h48
StateDirectoryMode=0700
ExecStartPre=/usr/bin/grep -Fxq %i /home/deploy/disdex-trading/releases/%i/.disdex-release-sha
ExecStartPre=/usr/bin/env DISDEX_H48_MODE=SHADOW DISDEX_H48_RUNTIME_SHA=%i DISDEX_H48_JOURNAL_PATH=/var/lib/disdex/stable4-shadow/%i/h48/journal.json DISDEX_ACCOUNT_LOCK_PATH=/var/lib/disdex/shared/account-order.lock /home/deploy/disdex-trading/releases/%i/node_modules/.bin/tsx scripts/disdex-hype-h48-native-shadow.ts --protected-stop8-shadow --initialize-shadow-if-flat
ExecStart=/usr/bin/env DISDEX_H48_MODE=SHADOW DISDEX_H48_RUNTIME_SHA=%i DISDEX_H48_JOURNAL_PATH=/var/lib/disdex/stable4-shadow/%i/h48/journal.json DISDEX_ACCOUNT_LOCK_PATH=/var/lib/disdex/shared/account-order.lock /home/deploy/disdex-trading/releases/%i/node_modules/.bin/tsx scripts/disdex-hype-h48-native-shadow.ts --protected-stop8-shadow --daemon
Restart=on-failure
RestartSec=60s
TimeoutStartSec=2min
TimeoutStopSec=90s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/disdex/shared
UMask=0077

[Install]
WantedBy=multi-user.target
