[Unit]
Description=DisDex verified standalone V96 to combined state migration
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/dis-dex-manager
EnvironmentFile=/etc/disdex/disdex-v13d-v11eq-v96.env
ExecStart=/usr/bin/npm run strategy:disdex-v13d-v11eq-v96:state:migrate
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/deploy/dis-dex-manager/.runtime-state
UMask=0077
