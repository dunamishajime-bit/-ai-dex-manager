# Post-migration common LIVE overrides for V12 + PENGU V2 + V52.
# V12 Top2 residual entry contract.  This changes sleeve sizing only; V12
# signal/indicator logic remains frozen.
V12_X1_ALL_ENTRY_GROSS_CAP=1.50
V12_X1_ALL_PER_POSITION_GROSS_CAP=1.00
V12_X1_ALL_MAX_POSITIONS=2
# No credentials belong in this file. Aster/reference credentials continue to
# come from /etc/disdex/disdex-v13d-v11eq-v96.env until a separately reviewed
# secret-file migration is performed.

# Preserve the existing production state roots for PENGU V2 and V52.
DISDEX_V13D_V11EQ_V96_COMBINED_STATE_ROOT=/home/deploy/ai-dex-manager-v96-paper/.runtime-state/disdex-v13d-v11eq-v96
PENGU_DUAL_LS_V2_STATE_DIR=/home/deploy/ai-dex-manager-v96-paper/.runtime-state/disdex-v13d-v11eq-v96/crypto-v96/pengu-dual-ls-v2-final
DISDEX_V52_ASTER_ONLY_STATE_DIR=/home/deploy/ai-dex-manager-v96-paper/.runtime-state/disdex-v13d-v11eq-v96/stock
DISDEX_V96_V52_MARGIN_GUARD_STATE_DIR=/home/deploy/ai-dex-manager-v96-paper/.runtime-state/disdex-v13d-v11eq-v96/margin-risk
DISDEX_V96_V52_MARGIN_GUARD_STATE_FILE=/home/deploy/ai-dex-manager-v96-paper/.runtime-state/disdex-v13d-v11eq-v96/margin-risk/guard-live.json

# One sticky production Kill Switch. Every alias must resolve to the same path.
DISDEX_SHARED_KILL_SWITCH_FILE=/home/deploy/ai-dex-manager-v96-paper/.runtime-state/disdex-v13d-v11eq-v96/kill-switch.json
DISDEX_V13D_V11EQ_V96_KILL_SWITCH_FILE=/home/deploy/ai-dex-manager-v96-paper/.runtime-state/disdex-v13d-v11eq-v96/kill-switch.json
DISDEX_V52_ASTER_ONLY_KILL_SWITCH_FILE=/home/deploy/ai-dex-manager-v96-paper/.runtime-state/disdex-v13d-v11eq-v96/kill-switch.json
PENGU_DUAL_LS_V2_KILL_SWITCH_FILE=/home/deploy/ai-dex-manager-v96-paper/.runtime-state/disdex-v13d-v11eq-v96/kill-switch.json

# Cross-language account-scoped lock and shared crypto daily-risk state.
# Concurrent waiters are arbitrated P1 risk-reduction -> P2 V52 -> P3 PENGU ->
# P4 V12 inside a short 200ms window. An already-held critical section is never
# preempted. Stale waiter records are discarded after 10 seconds.
DISDEX_ACCOUNT_LOCK_PATH=/var/lib/disdex/shared/account-order.lock
DISDEX_ACCOUNT_LOCK_LEASE_MS=120000
DISDEX_ACCOUNT_LOCK_ARBITRATION_MS=200
DISDEX_ACCOUNT_LOCK_WAITER_TTL_MS=10000
DISDEX_SHARED_CRYPTO_DAILY_RISK_PATH=/var/lib/disdex/shared/crypto-daily-risk.json
DISDEX_SHARED_CRYPTO_RISK_REFRESH_MS=30000
PENGU_DUAL_LS_V2_LOCK_RETRY_MS=5000

# Every exposure-increasing Node order runs a fresh full-universe margin check.
DISDEX_V96_V52_PREORDER_MARGIN_GUARD_ENABLED=true
DISDEX_V96_V52_MARGIN_GUARD_SCRIPT=scripts/disdex_v12_v52_margin_guard_runtime.py

# Fixed portfolio caps. Do not relax during migration.
DISDEX_V52_CRYPTO_GROSS_CAP=1.5
DISDEX_V52_STOCK_GROSS_CAP=1.5
DISDEX_V52_PORTFOLIO_GROSS_CAP=2.5
DISDEX_V52_V11_GROSS_CAP=1.0
DISDEX_V52_V50_GROSS_CAP=1.0
DISDEX_V52_RESERVED_FIRST_STOCK_GROSS=1.0
DISDEX_V52_MINIMUM_FIRST_STOCK_GROSS=0.5
DISDEX_V52_MINIMUM_SECOND_STOCK_GROSS=0.25
DISDEX_V52_MAX_CONCURRENT_STOCK_POSITIONS=2
DISDEX_V52_MAX_DAILY_LOSS_PCT=3.5
DISDEX_V96_V52_REQUIRED_INITIAL_LEVERAGE=5
DISDEX_V96_V52_MAX_INITIAL_MARGIN_FRACTION=0.70
DISDEX_V96_V52_MIN_AVAILABLE_BALANCE_FRACTION=0.20

# PENGU V2 frozen LIVE contract.
PENGU_LEGACY_CORE_ENABLED=false
PENGU_DUAL_LS_V1_MODE=SHADOW
PENGU_DUAL_LS_V1_ENABLED=false
PENGU_DUAL_LS_V1_LIVE_TRADING_ENABLED=false
PENGU_DUAL_LS_V1_LIVE_EXECUTION_ENABLED=false
PENGU_DUAL_LS_V2_MODE=LIVE
PENGU_DUAL_LS_V2_ENABLED=true
PENGU_DUAL_LS_V2_LIVE_TRADING_ENABLED=true
PENGU_DUAL_LS_V2_LIVE_EXECUTION_ENABLED=true
PENGU_DUAL_LS_V2_MAX_GROSS=0.75
PENGU_DUAL_LS_V2_PORTFOLIO_GROSS_CAP=1.5
PENGU_DUAL_LS_V2_COMBINED_PORTFOLIO_GROSS_CAP=2.5
PENGU_DUAL_LS_V2_MAX_DAILY_LOSS_PCT=5

# V52 Aster-only LIVE contract. Reference-quality values remain in the existing
# production base env and must not be weakened.
DISDEX_V52_ASTER_ONLY_RUNNER_MODE=live
DISDEX_V52_ASTER_ONLY_LIVE_EXECUTION_ENABLED=true
DISDEX_V52_ASTER_ONLY_LIVE_ACKNOWLEDGEMENT=I_ACCEPT_REAL_MONEY_V96_V52_ASTER_ONLY
