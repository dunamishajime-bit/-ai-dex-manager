# Quality102 causal-v1 is a separate sleeve. Keep this template inert.
# The historical frozen 102-event selector remains fail-closed; this sleeve is
# the transparent derived HIGH_VOL-only selector and never reads historical
# event timestamps.
QUALITY102_CAUSAL_V1_MODE=SHADOW
QUALITY102_CAUSAL_V1_ENABLED=false
QUALITY102_CAUSAL_V1_LIVE_TRADING_ENABLED=false
QUALITY102_CAUSAL_V1_LIVE_EXECUTION_ENABLED=false
QUALITY102_CAUSAL_V1_OPERATOR_ARMED=false
QUALITY102_CAUSAL_V1_SELECTOR_MODE=DERIVED_HIGH_VOL_ONLY
QUALITY102_CAUSAL_V1_SYMBOLS=
QUALITY102_CAUSAL_V1_MAX_GROSS=0.50
QUALITY102_CAUSAL_V1_MAX_SLIPPAGE_BPS=35
QUALITY102_CAUSAL_V1_MIN_ORDER_NOTIONAL_USD=5
QUALITY102_CAUSAL_V1_MAX_ENTRY_DELAY_MS=7200000
QUALITY102_CAUSAL_V1_MAX_DAILY_LOSS_PCT=5
QUALITY102_CAUSAL_V1_MAX_DATA_AGE_MS=300000
QUALITY102_CAUSAL_V1_STATE_DIR=/var/lib/disdex/quality102-causal-v1
QUALITY102_CAUSAL_V1_STATE_PATH=/var/lib/disdex/quality102-causal-v1/state.json
QUALITY102_CAUSAL_V1_KILL_SWITCH_FILE=/var/lib/disdex/shared/kill-switch.json
QUALITY102_CAUSAL_V1_DAILY_RISK_FILE=/var/lib/disdex/shared/crypto-daily-risk.json
QUALITY102_CAUSAL_V1_ACCOUNT_LOCK_PATH=/var/lib/disdex/shared/account-order.lock
QUALITY102_CAUSAL_V1_LIVE_ACK=
DISDEX_RUNTIME_COMMIT_SHA=
DISDEX_SHARED_CRYPTO_DAILY_RISK_PATH=/var/lib/disdex/shared/crypto-daily-risk.json
DISDEX_SHARED_KILL_SWITCH_FILE=/var/lib/disdex/shared/kill-switch.json
DISDEX_ACCOUNT_LOCK_PATH=/var/lib/disdex/shared/account-order.lock

# Credentials are supplied by a protected EnvironmentFile on the VPS.
# ASTER_USER_ADDRESS=
# ASTER_API_PRIVATE_KEY=
