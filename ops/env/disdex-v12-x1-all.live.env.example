# Explicit V12_X1.00_ALL LIVE activation template.
# Install as /etc/disdex/disdex-v12-x1-all.env only after:
#   1) immutable release verification,
#   2) source/CI/readiness PASS,
#   3) V96 fully-flat migration preflight PASS,
#   4) V96 service stop and Aster recheck.
# This file contains no credentials and must never be used to bypass those gates.

V12_X1_ALL_MODE=LIVE
V12_X1_ALL_ENABLED=true
V12_X1_ALL_LIVE_TRADING_ENABLED=true
V12_X1_ALL_LIVE_EXECUTION_ENABLED=true
DISDEX_V12_LIVE_ALLOW_REAL_ORDERS=true

V12_X1_ALL_STATE_PATH=/var/lib/disdex/v12-x1-all/runner.json
V12_X1_ALL_MAX_SLIPPAGE_BPS=20
V12_X1_ALL_HOURLY_LIMIT=500
V12_X1_ALL_BOUNDARY_DELAY_MS=5000
V12_X1_ALL_LOCK_RETRY_MS=5000

DISDEX_ACCOUNT_LOCK_PATH=/var/lib/disdex/shared/account-order.lock
DISDEX_SHARED_CRYPTO_DAILY_RISK_PATH=/var/lib/disdex/shared/crypto-daily-risk.json
DISDEX_SHARED_KILL_SWITCH_FILE=/home/deploy/ai-dex-manager-v96-paper/.runtime-state/disdex-v13d-v11eq-v96/kill-switch.json

# LIVE VPS uses deterministic, audited recovery rules for the historical V12
# failure reasons. Unknown/manual/daily-loss reasons remain fail-closed.
V12_AUTO_REPAIR_MODE=DETERMINISTIC
