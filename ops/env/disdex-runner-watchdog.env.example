# Non-secret watchdog configuration. The installer replaces the sample SHA/root.
DISDEX_RUNNER_HEALTH_ROOT=/var/lib/disdex/runner-health
DISDEX_RUNNER_RELEASE_ROOT=/home/deploy/disdex-trading/releases/0123456789abcdef0123456789abcdef01234567
DISDEX_RUNNER_EXPECTED_SHA=0123456789abcdef0123456789abcdef01234567

DISDEX_RUNNER_V12_SERVICE_UNIT=disdex-v12-x1-all@0123456789abcdef0123456789abcdef01234567.service
DISDEX_RUNNER_PENGU_V8_SERVICE_UNIT=disdex-v96-v52-live.service
DISDEX_RUNNER_V52_SERVICE_UNIT=disdex-v96-v52-live.service
DISDEX_RUNNER_QUALITY102_CAUSAL_V1_SERVICE_UNIT=disdex-quality102-causal-v1@0123456789abcdef0123456789abcdef01234567.service

DISDEX_RUNNER_WATCHDOG_HEARTBEAT_TIMEOUT_MS=300000
DISDEX_RUNNER_WATCHDOG_ATTEMPT_WINDOW_MS=1800000
DISDEX_RUNNER_WATCHDOG_MAX_ATTEMPTS=3
DISDEX_RUNNER_WATCHDOG_BACKOFF_MS=15000,60000,300000
