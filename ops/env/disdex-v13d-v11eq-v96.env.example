# Combined runner
DISDEX_V13D_V11EQ_V96_RUNNER_MODE=paper
DISDEX_V13D_V11EQ_V96_STATE_DIR=/home/deploy/dis-dex-manager/.runtime-state/disdex-v13d-v11eq-v96
DISDEX_V13D_V11EQ_V96_KILL_SWITCH_FILE=/home/deploy/dis-dex-manager/.runtime-state/disdex-v13d-v11eq-v96/kill-switch.json
DISDEX_V13D_V11EQ_V96_MAX_DAILY_LOSS_PCT=2
DISDEX_STOCK_SLEEVE_CAPITAL_USD=200
DISDEX_V13D_LEG_NOTIONAL_USD=100
DISDEX_V11EQ_NOTIONAL_USD=200

# Required only for real orders
DISDEX_V13D_V11EQ_V96_LIVE_EXECUTION_ENABLED=false
DISDEX_V13D_V11EQ_V96_LIVE_ACKNOWLEDGEMENT=

# Existing Crypto V96 live gates remain required
DISDEX_V96_LIVE_EXECUTION_ENABLED=false
DISDEX_V96_LIVE_ACKNOWLEDGEMENT=
DISDEX_V96_RUNTIME_COMMIT_SHA=
DISDEX_V96_FORWARD_EVIDENCE_FILE=
DISDEX_V96_EXECUTION_PARITY_FILE=
DISDEX_V96_OPERATOR_OVERRIDE_FILE=
DISDEX_V96_CONFIG_MIGRATION_MODE=false

# Aster credentials shared by Crypto V96 and Stock Aster leg
ASTER_FUTURES_BASE_URL=https://fapi3.asterdex.com
ASTER_PUBLIC_FUTURES_BASE_URL=https://fapi.asterdex.com
ASTER_USER_ADDRESS=
ASTER_API_PRIVATE_KEY=

# Hyperliquid official SDK credentials for xyz: stock-perpetual hedge.
# ACCOUNT_ADDRESS is the funded master/subaccount address, not the API wallet address.
# API_PRIVATE_KEY is the private key of a newly approved Hyperliquid API wallet.
HYPERLIQUID_API_URL=https://api.hyperliquid.xyz
HYPERLIQUID_ACCOUNT_ADDRESS=
HYPERLIQUID_API_PRIVATE_KEY=

# Alpaca authenticated real-time stock reference stream.
# Use sip for consolidated US exchange coverage. iex is allowed for Paper diagnostics only.
ALPACA_DATA_API_KEY=
ALPACA_DATA_API_SECRET=
ALPACA_DATA_FEED=sip
DISDEX_STOCK_REFERENCE_BIND=127.0.0.1
DISDEX_STOCK_REFERENCE_PORT=8797
DISDEX_STOCK_REFERENCE_PROXY_MAX_AGE_MS=1400

# Local authenticated reference adapter output: {"price":123.45,"timestamp":1780000000000,...}
DISDEX_STOCK_REFERENCE_MODE=external
DISDEX_STOCK_REFERENCE_URL_TEMPLATE=http://127.0.0.1:8797/quote?symbol={symbol}
DISDEX_STOCK_REFERENCE_PRICE_PATH=price
DISDEX_STOCK_REFERENCE_TIMESTAMP_PATH=timestamp
DISDEX_STOCK_REFERENCE_HEADERS_JSON={}
DISDEX_STOCK_REFERENCE_TIMEOUT_MS=1500

# Execution assumptions and limits
ASTER_STOCK_MAKER_FEE_BPS=0
ASTER_STOCK_TAKER_FEE_BPS=6
DISDEX_V11EQ_COST_SAFETY_BUFFER_BPS=5
DISDEX_V13D_NORMAL_CYCLE_COST_BPS=10
DISDEX_V13D_XYZ_MAX_SLIPPAGE_BPS=20
DISDEX_STOCK_ASTER_MAX_SLIPPAGE_BPS=25
DISDEX_STOCK_IDLE_INTERVAL_MS=5000
DISDEX_V96_RUNNER_INTERVAL_MS=30000
