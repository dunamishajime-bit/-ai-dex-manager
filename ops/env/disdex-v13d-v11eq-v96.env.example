# V96 + V52 combined supervisor. Template remains Paper/disabled until the
# immutable LIVE systemd units and exact-commit approval apply the fixed policy.
DISDEX_V13D_V11EQ_V96_RUNNER_MODE=paper
DISDEX_V13D_V11EQ_V96_STATE_DIR=/home/deploy/ai-dex-manager-v96-paper/.runtime-state/disdex-v13d-v11eq-v96
DISDEX_V13D_V11EQ_V96_COMBINED_STATE_ROOT=/home/deploy/ai-dex-manager-v96-paper/.runtime-state/disdex-v13d-v11eq-v96
DISDEX_V13D_V11EQ_V96_KILL_SWITCH_FILE=/home/deploy/ai-dex-manager-v96-paper/.runtime-state/disdex-v13d-v11eq-v96/kill-switch.json
DISDEX_V13D_V11EQ_V96_MAX_DAILY_LOSS_PCT=5

# Shared adaptive Margin Guard.
# LIVE fixed policy enables the order-time check. The daemon polls every five
# minutes while HEALTHY and every one minute after WARNING. Thresholds are
# frozen in scripts/disdex_v96_v52_margin_risk_policy.py.
DISDEX_V96_V52_PREORDER_MARGIN_GUARD_ENABLED=false
DISDEX_V96_V52_MARGIN_GUARD_STATE_DIR=/home/deploy/ai-dex-manager-v96-paper/.runtime-state/disdex-v13d-v11eq-v96/margin-risk
DISDEX_V96_V52_MARGIN_GUARD_STATE_FILE=/home/deploy/ai-dex-manager-v96-paper/.runtime-state/disdex-v13d-v11eq-v96/margin-risk/guard-live.json
DISDEX_V96_V52_MARGIN_GUARD_SCRIPT=scripts/disdex_v96_v52_margin_guard.py
DISDEX_V96_V52_REQUIRED_INITIAL_LEVERAGE=5
DISDEX_V96_V52_MAX_INITIAL_MARGIN_FRACTION=0.70
DISDEX_V96_V52_MIN_AVAILABLE_BALANCE_FRACTION=0.20

# V52 Stock child: V11-EQ at 10:30 plus V50 at 11:30/12:30/13:30 New York.
DISDEX_V52_ASTER_ONLY_RUNNER_MODE=paper
DISDEX_V52_ASTER_ONLY_STATE_DIR=/home/deploy/ai-dex-manager-v96-paper/.runtime-state/disdex-v13d-v11eq-v96/stock
DISDEX_V52_ASTER_ONLY_KILL_SWITCH_FILE=/home/deploy/ai-dex-manager-v96-paper/.runtime-state/disdex-v13d-v11eq-v96/kill-switch.json
DISDEX_V52_ASTER_ONLY_LIVE_EXECUTION_ENABLED=false
DISDEX_V52_ASTER_ONLY_LIVE_ACKNOWLEDGEMENT=
DISDEX_V52_CRYPTO_GROSS_CAP=1.5
DISDEX_V52_STOCK_GROSS_CAP=1.5
DISDEX_V52_PORTFOLIO_GROSS_CAP=2.5
DISDEX_V52_V11_GROSS_CAP=1.0
DISDEX_V52_V50_GROSS_CAP=1.0
DISDEX_V52_RESERVED_FIRST_STOCK_GROSS=1.0
DISDEX_V52_MINIMUM_FIRST_STOCK_GROSS=0.5
DISDEX_V52_MINIMUM_SECOND_STOCK_GROSS=0.25
DISDEX_V52_MAX_CONCURRENT_STOCK_POSITIONS=2
DISDEX_V52_MAX_DAILY_LOSS_PCT=3.5
DISDEX_V52_GROSS_TOLERANCE=0.03
DISDEX_V52_MIN_ENTRY_USD=5

# Required only when runner-live.json still contains a legacy active V11 state.position.
DISDEX_V52_ALLOW_V11_STATE_MIGRATION=false
DISDEX_V52_STATE_MIGRATION_ACKNOWLEDGEMENT=

# Existing Crypto V96 live gates remain required.
DISDEX_V96_LIVE_EXECUTION_ENABLED=false
DISDEX_V96_LIVE_ACKNOWLEDGEMENT=
DISDEX_V96_RUNTIME_COMMIT_SHA=
DISDEX_V96_FORWARD_EVIDENCE_FILE=/home/deploy/ai-dex-manager-v96-paper/.runtime-approval/disdex-v96-forward.json
DISDEX_V96_EXECUTION_PARITY_FILE=/home/deploy/ai-dex-manager-v96-paper/.runtime-approval/disdex-v96-parity.json
DISDEX_V96_OPERATOR_OVERRIDE_FILE=/home/deploy/ai-dex-manager-v96-paper/.runtime-approval/disdex-v96-operator-override.json
DISDEX_V96_CONFIG_MIGRATION_MODE=true
DISDEX_V96_ONE_TIME_SKIP_REFERENCE_TS=1785024000000
DISDEX_V96_CASH_RESERVE_PCT=10
DISDEX_V96_ROUND_TRIP_FEE_BPS=8
DISDEX_V96_MIN_EXECUTION_HEADROOM_USD=4
DISDEX_V96_CLOSE_UNMANAGED_POSITIONS=false
DISDEX_V96_INITIAL_PENGU_GROSS=1.15
DISDEX_V96_MAX_GROSS=1.5
DISDEX_V96_MAX_DAILY_LOSS_PCT=5

# Official standalone V96 -> combined state migration.
DISDEX_V96_SOURCE_SERVICE_NAME=
DISDEX_V96_SOURCE_STATE_DIR=/home/deploy/ai-dex-manager-v96-paper/.runtime-state/disdex-v96
DISDEX_V96_COMBINED_MIGRATION_ACKNOWLEDGEMENT=

# Formal no-order reconciliation for stale legacy position metadata such as PENGUUSDT -3.
# Keep false until authenticated Aster positions and the migration manifest have been reviewed.
DISDEX_V96_POSITION_RECONCILIATION_ALLOW_FLAT=false
DISDEX_V96_POSITION_RECONCILIATION_ACKNOWLEDGEMENT=

# Aster credentials shared by Crypto V96 and both Stock slots.
ASTER_FUTURES_BASE_URL=https://fapi3.asterdex.com
ASTER_PUBLIC_FUTURES_BASE_URL=https://fapi.asterdex.com
ASTER_USER_ADDRESS=
ASTER_API_PRIVATE_KEY=

# Pyth Core primary plus Alpaca free IEX validator.
PYTH_HERMES_URL=https://hermes.pyth.network
PYTH_API_KEY=
PYTH_EQUITY_FEED_IDS_JSON=
DISDEX_PYTH_MAX_AGE_MS=1200
DISDEX_IEX_MAX_AGE_MS=1500
DISDEX_PYTH_MAX_CONFIDENCE_BPS=10
DISDEX_REFERENCE_MAX_CROSS_SOURCE_BPS=20
ALPACA_DATA_API_KEY=
ALPACA_DATA_API_SECRET=
ALPACA_DATA_FEED=iex
DISDEX_STOCK_REFERENCE_BIND=127.0.0.1
DISDEX_STOCK_REFERENCE_PORT=8797
DISDEX_STOCK_REFERENCE_MODE=external
DISDEX_STOCK_REFERENCE_URL_TEMPLATE=http://127.0.0.1:8797/quote?symbol={symbol}
DISDEX_STOCK_REFERENCE_PRICE_PATH=price
DISDEX_STOCK_REFERENCE_TIMESTAMP_PATH=timestamp
DISDEX_STOCK_REFERENCE_HEADERS_JSON={}
DISDEX_STOCK_REFERENCE_TIMEOUT_MS=1500

# Execution quality and loop settings.
DISDEX_V11EQ_MIN_NET_EDGE_BPS=20
ASTER_STOCK_MAKER_FEE_BPS=0
ASTER_STOCK_TAKER_FEE_BPS=6
DISDEX_V11EQ_COST_SAFETY_BUFFER_BPS=5
DISDEX_STOCK_ASTER_MAX_SLIPPAGE_BPS=25
DISDEX_STOCK_IDLE_INTERVAL_MS=5000
DISDEX_V96_RUNNER_INTERVAL_MS=30000
