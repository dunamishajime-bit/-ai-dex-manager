# PENGU_DUAL_LS_V1 + V52 combined supervisor. Safe defaults remain Paper/disabled.
DISDEX_V13D_V11EQ_V96_RUNNER_MODE=paper
DISDEX_V13D_V11EQ_V96_STATE_DIR=/home/deploy/dis-dex-manager/.runtime-state/disdex-v13d-v11eq-v96
DISDEX_V13D_V11EQ_V96_COMBINED_STATE_ROOT=/home/deploy/dis-dex-manager/.runtime-state/disdex-v13d-v11eq-v96
DISDEX_V13D_V11EQ_V96_KILL_SWITCH_FILE=/home/deploy/dis-dex-manager/.runtime-state/disdex-v13d-v11eq-v96/kill-switch.json
DISDEX_RUNTIME_COMMIT_SHA=

# Production crypto boundary. Legacy V96 is audit/reconciliation only and must never be LIVE-enabled.
DISDEX_ENABLE_LEGACY_V96_LIVE=false
PENGU_LEGACY_CORE_ENABLED=false
PENGU_DUAL_LS_V1_ENABLED=true
PENGU_DUAL_LS_V1_MODE=SHADOW
PENGU_DUAL_LS_V1_LIVE_TRADING_ENABLED=false
PENGU_DUAL_LS_V1_LIVE_EXECUTION_ENABLED=false
PENGU_DUAL_LS_V1_STATE_DIR=/home/deploy/dis-dex-manager/.runtime-state/disdex-v13d-v11eq-v96/pengu-dual-ls-v1
PENGU_DUAL_LS_V1_LOCK_PATH=/home/deploy/dis-dex-manager/.runtime-state/disdex-v13d-v11eq-v96/pengu-dual-ls-v1/runner-live.lock
PENGU_DUAL_LS_V1_KILL_SWITCH_FILE=/home/deploy/dis-dex-manager/.runtime-state/disdex-v13d-v11eq-v96/kill-switch.json
PENGU_DUAL_LS_V1_PORTFOLIO_DAILY_LOSS_STATE_FILE=/home/deploy/dis-dex-manager/.runtime-state/disdex-v13d-v11eq-v96/crypto-v96/runner-live.json
PENGU_DUAL_LS_V1_PORTFOLIO_GROSS_CAP=2.5
PENGU_DUAL_LS_V1_MAX_DAILY_LOSS_PCT=5

# Legacy V96 durable state remains readable only for formal reconciliation/audit.
# The live runner itself is hard-retired and rejects DISDEX_V96_RUNNER_MODE=live.
DISDEX_V96_STATE_DIR=/home/deploy/dis-dex-manager/.runtime-state/disdex-v13d-v11eq-v96/crypto-v96
DISDEX_V96_KILL_SWITCH_FILE=/home/deploy/dis-dex-manager/.runtime-state/disdex-v13d-v11eq-v96/kill-switch.json
DISDEX_V96_RECONCILE_ACKNOWLEDGEMENT=
PENGU_KILL_SWITCH_RELEASE_ACKNOWLEDGEMENT=

# V52 Stock child: V11-EQ at 10:30 plus V50 at 11:30/12:30/13:30 New York.
DISDEX_V52_ASTER_ONLY_RUNNER_MODE=paper
DISDEX_V52_ASTER_ONLY_STATE_DIR=/home/deploy/dis-dex-manager/.runtime-state/disdex-v13d-v11eq-v96/stock
DISDEX_V52_ASTER_ONLY_KILL_SWITCH_FILE=/home/deploy/dis-dex-manager/.runtime-state/disdex-v13d-v11eq-v96/kill-switch.json
DISDEX_V52_ASTER_ONLY_LIVE_EXECUTION_ENABLED=false
DISDEX_V52_ASTER_ONLY_LIVE_ACKNOWLEDGEMENT=
DISDEX_V52_CRYPTO_GROSS_CAP=2.5
DISDEX_V52_STOCK_GROSS_CAP=1.5
DISDEX_V52_PORTFOLIO_GROSS_CAP=2.5
DISDEX_V52_V11_GROSS_CAP=1.0
DISDEX_V52_V50_GROSS_CAP=1.0
DISDEX_V52_GROSS_TOLERANCE=0.03
DISDEX_V52_MIN_ENTRY_USD=5

# Required only when runner-live.json still contains a legacy active V11 state.position.
DISDEX_V52_ALLOW_V11_STATE_MIGRATION=false
DISDEX_V52_STATE_MIGRATION_ACKNOWLEDGEMENT=

# Aster credentials are used by PENGU and by the formal read-only reconciliation/preflight checks.
ASTER_FUTURES_BASE_URL=https://fapi3.asterdex.com
ASTER_PUBLIC_FUTURES_BASE_URL=https://fapi.asterdex.com
ASTER_USER_ADDRESS=
ASTER_API_PRIVATE_KEY=

# Pyth Core primary plus Alpaca free IEX validator.
PYTH_HERMES_URL=https://hermes.pyth.network
PYTH_API_KEY=
PYTH_EQUITY_FEED_IDS_JSON=
DISDEX_PYTH_MAX_AGE_MS=1200
DISDEX_IEX_MAX_AGE_MS=1500
DISDEX_PYTH_MAX_CONFIDENCE_BPS=10
DISDEX_REFERENCE_MAX_CROSS_SOURCE_BPS=20
ALPACA_DATA_API_KEY=
ALPACA_DATA_API_SECRET=
ALPACA_DATA_FEED=iex
DISDEX_STOCK_REFERENCE_BIND=127.0.0.1
DISDEX_STOCK_REFERENCE_PORT=8797
DISDEX_STOCK_REFERENCE_MODE=external
DISDEX_STOCK_REFERENCE_URL_TEMPLATE=http://127.0.0.1:8797/quote?symbol={symbol}
DISDEX_STOCK_REFERENCE_PRICE_PATH=price
DISDEX_STOCK_REFERENCE_TIMESTAMP_PATH=timestamp
DISDEX_STOCK_REFERENCE_HEADERS_JSON={}
DISDEX_STOCK_REFERENCE_TIMEOUT_MS=1500

# Execution quality and loop settings.
DISDEX_V11EQ_MIN_NET_EDGE_BPS=20
ASTER_STOCK_MAKER_FEE_BPS=0
ASTER_STOCK_TAKER_FEE_BPS=6
DISDEX_V11EQ_COST_SAFETY_BUFFER_BPS=5
DISDEX_STOCK_ASTER_MAX_SLIPPAGE_BPS=25
DISDEX_STOCK_IDLE_INTERVAL_MS=5000

# Email notifications. The ChatGPT Gmail plugin connection is not inherited by the VPS.
# Choose Gmail SMTP (GMAIL_USER + GMAIL_APP_PASSWORD) or SendGrid (SENDGRID_API_KEY).
DISDEX_ORDER_FILL_EMAIL=dunamis.hajime@gmail.com
PENGU_ORDER_FILL_EMAIL=dunamis.hajime@gmail.com
GMAIL_USER=dunamis.hajime@gmail.com
GMAIL_APP_PASSWORD=
# SENDGRID_API_KEY=
