# V12_X1.00_ALL implementation defaults. This file is intentionally inert.
V12_X1_ALL_MODE=SHADOW
V12_X1_ALL_ENABLED=false
V12_X1_ALL_LIVE_TRADING_ENABLED=false
V12_X1_ALL_LIVE_EXECUTION_ENABLED=false
V12_X1_ALL_STATE_PATH=/var/lib/disdex/v12-x1-all/runner.json
DISDEX_ACCOUNT_LOCK_PATH=/var/lib/disdex/shared/account-order.lock
DISDEX_SHARED_CRYPTO_DAILY_RISK_PATH=/var/lib/disdex/shared/crypto-daily-risk.json

# Event-driven deterministic recovery is the only supported mode. Unknown and
# operator-controlled stop reasons remain fail-closed.
V12_AUTO_REPAIR_MODE=DETERMINISTIC

# LIVE activation requires a separate immutable-release review and is not
# enabled by this template.
