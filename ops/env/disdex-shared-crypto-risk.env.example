# Shared crypto daily-risk refresher. Keep credentials in /etc/disdex only.
ASTER_FUTURES_BASE_URL=
ASTER_USER_ADDRESS=
ASTER_API_PRIVATE_KEY=
ASTER_REQUEST_TIMEOUT_MS=10000
ASTER_RECV_WINDOW_MS=5000
DISDEX_SHARED_CRYPTO_DAILY_RISK_PATH=/var/lib/disdex/shared/crypto-daily-risk.json
DISDEX_SHARED_CRYPTO_RISK_REFRESH_MS=30000
