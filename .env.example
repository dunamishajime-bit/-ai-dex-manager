# Win80 / Ultra90 realtime runner
# Default is PAPER. Live requires this env switch AND MAIN_STRATEGY_REAL_TRADING_ENABLED=true in strategyConfig.
WIN80_RUNNER_MODE=paper
WIN80_LIVE_EXECUTION_ENABLED=false
WIN80_RUNNER_INTERVAL_MS=30000
WIN80_RUNNER_STATE_DIR=.runtime-state
WIN80_LOCK_STALE_MS=300000

# Aster Futures API V3
ASTER_FUTURES_BASE_URL=https://fapi3.asterdex.com
ASTER_USER_ADDRESS=
ASTER_API_PRIVATE_KEY=
ASTER_REQUEST_TIMEOUT_MS=10000
ASTER_RECV_WINDOW_MS=5000
ASTER_EXCHANGE_INFO_TTL_MS=900000
ASTER_ORDER_RECONCILE_ATTEMPTS=6
ASTER_ORDER_RECONCILE_DELAY_MS=1500

# Optional comma-separated Aster perpetual universe.
# Empty uses the built-in 30-symbol universe and filters exchangeInfo status=TRADING.
WIN80_ASTER_SYMBOLS=
WIN80_HISTORY_INTERVAL=1h
WIN80_HISTORY_LIMIT=220
WIN80_HISTORY_CACHE_TTL_MS=300000
WIN80_HISTORY_CONCURRENCY=5
WIN80_MAX_MARKET_AGE_MS=30000

# Portfolio and execution controls
WIN80_PAPER_INITIAL_BALANCE_USD=1000
WIN80_PAPER_FEE_BPS_PER_SIDE=6
WIN80_CASH_RESERVE_PCT=2
WIN80_ACCOUNT_NOTIONAL_LEVERAGE=1
WIN80_MAX_INITIAL_NOTIONAL_USD=10000
WIN80_MAX_SLIPPAGE_BPS=35
WIN80_MAX_CONCURRENT_POSITIONS=2
WIN80_MAX_TRANSACTION_RETRIES=5
WIN80_MIN_ORDER_NOTIONAL_USD=5

# Email notifications (choose one provider; never commit secrets).
DISDEX_ORDER_FILL_EMAIL=dunamis.hajime@gmail.com
PENGU_ORDER_FILL_EMAIL=dunamis.hajime@gmail.com
GMAIL_USER=dunamis.hajime@gmail.com
GMAIL_APP_PASSWORD=
# SENDGRID_API_KEY=
