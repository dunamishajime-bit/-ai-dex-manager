[Unit]
Description=DisDex Win80 Ultra90 realtime runner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/disdex-manager
EnvironmentFile=/home/deploy/disdex-manager/.env.runner
ExecStart=/usr/bin/npm run strategy:live:daemon
Restart=always
RestartSec=15
TimeoutStopSec=30
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/deploy/disdex-manager/.runtime-state

[Install]
WantedBy=multi-user.target
