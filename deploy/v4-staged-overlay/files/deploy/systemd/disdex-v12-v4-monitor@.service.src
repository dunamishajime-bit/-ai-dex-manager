# Read-only V4 monitor. This unit cannot authorize or send trading mutations.
[Unit]
Description=DisDex V12 V4 read-only monitor (%i)
After=network-online.target disdex-v4-rate-budget-broker@%i.service
Requires=disdex-v4-rate-budget-broker@%i.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/disdex-trading/releases/%i
EnvironmentFile=/etc/disdex/disdex-v13d-v11eq-v96.env
EnvironmentFile=/etc/disdex/disdex-v12-pengu-v2-v52.env
EnvironmentFile=/etc/disdex/disdex-v12-v4.env
Environment=NODE_ENV=production
Environment=DISDEX_RELEASE_SHA=%i
Environment=V12_V4_LIVE_ACK=%i
Environment=DISDEX_RELEASE_ROOT=/home/deploy/disdex-trading/releases/%i
Environment=DISDEX_ASTER_GLOBAL_RATE_BUDGET_PATH=/var/lib/disdex/shared/aster-rate-budget.json
Environment=DISDEX_ASTER_RATE_BUDGET_PROXY_SOCKET=/run/disdex-v4-budget-%i/budget.sock
Environment=V12_V4_MONITOR_HEALTH_STATE_PATH=/var/lib/disdex/v12-v4/monitor/heartbeat.json
ExecStartPre=/usr/bin/test -f /home/deploy/disdex-trading/releases/%i/.disdex-release-sha
ExecStartPre=/usr/bin/grep -Fxq %i /home/deploy/disdex-trading/releases/%i/.disdex-release-sha
ExecStartPre=/usr/bin/test -f /home/deploy/disdex-trading/releases/%i/node_modules/tsx/dist/cli.mjs
ExecStartPre=/usr/bin/test ! -L /home/deploy/disdex-trading/releases/%i/node_modules/tsx
StateDirectory=disdex/v12-v4/monitor
StateDirectoryMode=0750
ExecStartPre=/usr/bin/test -w /var/lib/disdex/runner-health/ticks
ExecStart=/usr/bin/node /home/deploy/disdex-trading/releases/%i/node_modules/tsx/dist/cli.mjs scripts/v12-v4-monitor-only-runner.ts --daemon
Restart=on-failure
RestartSec=30s
TimeoutStopSec=30s
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/home/deploy/disdex-trading/releases /etc/disdex /var/lib/disdex/shared
ReadWritePaths=/var/lib/disdex/v12-v4/monitor /var/lib/disdex/runner-health/ticks
UMask=0027

[Install]
WantedBy=multi-user.target
