# Candidate template only. Do not install/enable before full V4 LIVE certification.
[Unit]
Description=DisDex V12 V4 production runner (%i)
After=network-online.target disdex-v4-rate-budget-broker@%i.service
Requires=disdex-v4-rate-budget-broker@%i.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/disdex-trading/releases/%i
EnvironmentFile=/etc/disdex/disdex-v13d-v11eq-v96.env
EnvironmentFile=/etc/disdex/disdex-v12-pengu-v2-v52.env
EnvironmentFile=/etc/disdex/disdex-v12-v4.env
EnvironmentFile=/etc/disdex/current-runtime/%i.env
Environment=NODE_ENV=production
Environment=DISDEX_ASTER_GLOBAL_RATE_BUDGET_PATH=/var/lib/disdex/shared/aster-rate-budget.json
Environment=DISDEX_ASTER_RATE_BUDGET_PROXY_SOCKET=/run/disdex-v4-budget-%i/budget.sock
Environment=DISDEX_RELEASE_SHA=%i
Environment=V12_V4_LIVE_ACK=%i
ExecStartPre=/usr/bin/test -f /home/deploy/disdex-trading/releases/%i/.disdex-release-sha
ExecStartPre=/usr/bin/grep -Fxq %i /home/deploy/disdex-trading/releases/%i/.disdex-release-sha
ExecStartPre=/usr/bin/bash /home/deploy/disdex-trading/releases/%i/scripts/ops/disdex-v12-mutual-exclusion-preflight.sh %i runtime
# Full V4 does not modify peer state or a separate canary permit.
# Required root-managed runtime/evidence paths are provisioned by the scoped
# deployment transaction. Missing access fails before this process starts.
ExecStartPre=/usr/bin/test -w /var/lib/disdex/runner-health/ticks
# Separate V4 operator approval; never use existing X1-only acknowledgement.
ExecStartPre=+/usr/bin/node /home/deploy/disdex-trading/releases/%i/scripts/ops/root/disdex-live-operator-activation-gate.mjs --release-root /home/deploy/disdex-trading/releases/%i --sha %i --runner V12_V4 --activation-path /var/lib/disdex/shared/operator-activation/v12-v4-full.json
ExecStart=/usr/bin/node --import /home/deploy/disdex-trading/releases/%i/node_modules/tsx/dist/loader.mjs /home/deploy/disdex-trading/releases/%i/scripts/v12-v4-production-runner.ts --daemon
Restart=on-failure
RestartPreventExitStatus=2
RestartSec=30s
TimeoutStopSec=30s
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/home/deploy/disdex-trading/releases /home/deploy/ai-dex-manager-v96-paper/.runtime-state
ReadWritePaths=/var/lib/disdex/v12-v4 /var/lib/disdex/shared /var/lib/disdex/runner-health/ticks
UMask=0077

[Install]
WantedBy=multi-user.target
