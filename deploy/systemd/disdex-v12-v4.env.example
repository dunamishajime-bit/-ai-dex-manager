V12_V4_TICK_INTERVAL_MS=60000
V12_V4_PEER_STATE_PATHS_JSON='{"V12":"/var/lib/disdex/v12-x1-all/runner.json","PENGU":"/var/lib/disdex/pengu-dual-ls-v2/runner-live.json","Q102":"/var/lib/disdex/quality102-causal-v1/state.json","V52":"/var/lib/disdex/v52-aster-only/runner-live.json","FET":"/var/lib/disdex/fet-brk48-residual/state.json","HYPE_LONG":"/var/lib/disdex/hype-zec-long/runner.json","IDLE":"/var/lib/disdex/idle-priority/state.json","RESIDUAL":"/var/lib/disdex/idle-priority/residual-long-state.json"}'
