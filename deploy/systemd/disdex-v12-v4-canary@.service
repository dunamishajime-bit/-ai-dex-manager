[Unit]
Description=DisDex V12 V4 controlled production canary (%i)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/disdex-trading/releases/%i
EnvironmentFile=/etc/disdex/disdex-v13d-v11eq-v96.env
EnvironmentFile=/etc/disdex/disdex-v12-pengu-v2-v52.env
EnvironmentFile=/etc/disdex/disdex-v12-v4-canary.env
Environment=NODE_ENV=production
Environment=DISDEX_RELEASE_SHA=%i
Environment=V12_V4_LIVE_ACK=%i
Environment=V12_V4_OPERATION_MODE=CANARY
ExecStartPre=/usr/bin/test -f /home/deploy/disdex-trading/releases/%i/.disdex-release-sha
ExecStartPre=/usr/bin/grep -Fxq %i /home/deploy/disdex-trading/releases/%i/.disdex-release-sha
ExecStartPre=/usr/bin/bash /home/deploy/disdex-trading/releases/%i/scripts/ops/disdex-v12-mutual-exclusion-preflight.sh %i runtime
ExecStartPre=+/usr/bin/node /home/deploy/disdex-trading/releases/%i/scripts/ops/root/disdex-live-operator-activation-gate.mjs --release-root /home/deploy/disdex-trading/releases/%i --sha %i --runner V12_V4 --activation-path /var/lib/disdex/shared/operator-activation/v12-v4-canary.json
ExecStart=/home/deploy/disdex-trading/releases/%i/node_modules/.bin/tsx scripts/v12-v4-production-runner.ts --daemon
Restart=on-failure
RestartPreventExitStatus=2
RestartSec=30s
TimeoutStopSec=30s
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/home/deploy/disdex-trading/releases /home/deploy/ai-dex-manager-v96-paper/.runtime-state
ReadWritePaths=/var/lib/disdex/v12-v4 /var/lib/disdex/shared
UMask=0077

[Install]
WantedBy=multi-user.target
