# Copy these non-secret values into the live runner drop-ins.  The Gmail
# credentials belong only to disdex-trade-fill-notifier.service's existing
# EnvironmentFile and must never be copied into a trading runner.
DISDEX_TRADE_FILL_NOTIFICATION_ENABLED=true
DISDEX_TRADE_FILL_NOTIFICATION_MODE=live
DISDEX_TRADE_FILL_NOTIFICATION_SPOOL_PATH=/var/lib/disdex/shared/trade-fill-notifications/inbox.jsonl

